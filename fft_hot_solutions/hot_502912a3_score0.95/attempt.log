#include <time.h>
#define ALIGN64 __attribute__((aligned(64)))
static double now(){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
static double Z[72*8] ALIGN64, C[72*8] ALIGN64, O[72*8] ALIGN64;
__attribute__((noinline)) void mappass(){
    for (int q = 0; q < 36; q++){
        __m512d _zr = _mm512_add_pd(_mm512_load_pd(Z + 16*q), _mm512_load_pd(C + 16*q));
        __m512d _zi = _mm512_add_pd(_mm512_load_pd(Z + 16*q + 8), _mm512_load_pd(C + 16*q + 8));
        __m512d _r2 = _mm512_fmadd_pd(_zr,_zr,_mm512_fmadd_pd(_zi,_zi,_mm512_set1_pd(1e-300)));
        __m512d _y0 = _mm512_rsqrt14_pd(_r2);
        __m512d _h = _mm512_mul_pd(_r2, _mm512_set1_pd(0.5));
        __m512d _w = _mm512_fnmadd_pd(_h, _mm512_mul_pd(_y0,_y0), _mm512_set1_pd(1.5));
        __m512d _y1 = _mm512_mul_pd(_y0,_w);
        _w = _mm512_fnmadd_pd(_h, _mm512_mul_pd(_y1,_y1), _mm512_set1_pd(1.5));
        __m512d _y2 = _mm512_mul_pd(_y1,_w);
        __m512d _s = _mm512_mul_pd(_r2,_y2);
        __m512d _d = _mm512_add_pd(_mm512_set1_pd(1.0), _s);
        __m512d _r0 = _mm512_rcp14_pd(_d);
        _r0 = _mm512_mul_pd(_r0, _mm512_fnmadd_pd(_d,_r0,_mm512_set1_pd(2.0)));
        _r0 = _mm512_mul_pd(_r0, _mm512_fnmadd_pd(_d,_r0,_mm512_set1_pd(2.0)));
        _mm512_store_pd(O + 16*q, _mm512_mul_pd(_zr, _r0));
        _mm512_store_pd(O + 16*q + 8, _mm512_mul_pd(_zi, _r0));
    }
}
int main(){
    for(int i=0;i<72*8;i++){ Z[i]=(i%37)/10.0-1.5; C[i]=(i%17)/100.0; }
    long R=400000;
    mappass();
    double t0=now(); for(long r=0;r<R;r++) mappass(); double t1=now();
    printf("map: %.3f ns/el  %.2f cyc/el (%.0f cyc per 36 pairs)\n",
      (t1-t0)/R/288*1e9, (t1-t0)/R/288*3.1e9, (t1-t0)/R*3.1e9);
    return 0;
}
