import numpy as np

LD = np.longdouble
PI = LD('3.14159265358979323846264338327950288')

def hexd(x):
    """format double as C hex literal"""
    return float(x).hex()

def tw(num, den):
    """cos/sin of -2*pi*num/den computed in long double, num reduced mod den"""
    num = int(num) % int(den)
    ang = LD(-2) * PI * LD(num) / LD(den)
    return float(np.cos(ang)), float(np.sin(ang))

class Emit:
    def __init__(self):
        self.lines = []
        self.n = 0
    def w(self, s):
        self.lines.append(s)
    def tmp(self, pfx='t'):
        self.n += 1
        return f'{pfx}{self.n}'
    def decl(self, name, expr):
        self.w(f'__m512d {name} = {expr};')
        return name
    # vector ops
    def add(self, a, b): return f'_mm512_add_pd({a},{b})'
    def sub(self, a, b): return f'_mm512_sub_pd({a},{b})'
    def mul(self, a, b): return f'_mm512_mul_pd({a},{b})'
    def fmadd(self, a, b, c): return f'_mm512_fmadd_pd({a},{b},{c})'
    def fnmadd(self, a, b, c): return f'_mm512_fnmadd_pd({a},{b},{c})'
    def fmsub(self, a, b, c): return f'_mm512_fmsub_pd({a},{b},{c})'
    def load(self, addr): return f'_mm512_load_pd({addr})'
    def loadu(self, addr): return f'_mm512_loadu_pd({addr})'
    def bc(self, scalar): return f'_mm512_set1_pd({scalar})'
    def store(self, addr, v): self.w(f'_mm512_store_pd({addr}, {v});')
    def storeu(self, addr, v): self.w(f'_mm512_storeu_pd({addr}, {v});')
    def code(self, indent=1):
        pad = '    '*indent
        return '\n'.join(pad + l for l in self.lines)

PRELUDE = r'''
/* ---- my kernel prelude ---- */
#include <immintrin.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#ifndef MYK_COMMON
#define MYK_COMMON
#define ALIGN64 __attribute__((aligned(64)))
static double* myk_alloc(long bytes){
    void* q = aligned_alloc(64, (bytes+63)&~63L);
    memset(q, 0, (bytes+63)&~63L);
    return (double*)q;
}
/* 8x8 double transpose */
#define MTR8(r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7) do{ \
    __m512d _t0=_mm512_unpacklo_pd(r0,r1), _t1=_mm512_unpackhi_pd(r0,r1); \
    __m512d _t2=_mm512_unpacklo_pd(r2,r3), _t3=_mm512_unpackhi_pd(r2,r3); \
    __m512d _t4=_mm512_unpacklo_pd(r4,r5), _t5=_mm512_unpackhi_pd(r4,r5); \
    __m512d _t6=_mm512_unpacklo_pd(r6,r7), _t7=_mm512_unpackhi_pd(r6,r7); \
    __m512d _u0=_mm512_shuffle_f64x2(_t0,_t2,0x44), _u1=_mm512_shuffle_f64x2(_t4,_t6,0x44); \
    __m512d _u2=_mm512_shuffle_f64x2(_t0,_t2,0xee), _u3=_mm512_shuffle_f64x2(_t4,_t6,0xee); \
    __m512d _u4=_mm512_shuffle_f64x2(_t1,_t3,0x44), _u5=_mm512_shuffle_f64x2(_t5,_t7,0x44); \
    __m512d _u6=_mm512_shuffle_f64x2(_t1,_t3,0xee), _u7=_mm512_shuffle_f64x2(_t5,_t7,0xee); \
    o0=_mm512_shuffle_f64x2(_u0,_u1,0x88); o2=_mm512_shuffle_f64x2(_u0,_u1,0xdd); \
    o4=_mm512_shuffle_f64x2(_u2,_u3,0x88); o6=_mm512_shuffle_f64x2(_u2,_u3,0xdd); \
    o1=_mm512_shuffle_f64x2(_u4,_u5,0x88); o3=_mm512_shuffle_f64x2(_u4,_u5,0xdd); \
    o5=_mm512_shuffle_f64x2(_u6,_u7,0x88); o7=_mm512_shuffle_f64x2(_u6,_u7,0xdd); \
}while(0)
#define MYTINY 1e-300
#endif
