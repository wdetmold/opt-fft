import numpy as np
from ir import IR, dft3, dft4, dft5, dft8, dft9, cmul
from glib import hexd

def crt_maps(N1, N2):
    N = N1*N2
    inv = lambda a,m: pow(a, -1, m)
    b = N2*inv(N2% N1, N1)  # ≡1 mod N1, 0 mod N2
    a = N1*inv(N1% N2, N2)  # ≡1 mod N2, 0 mod N1
    nmap = [ (b*n1 + a*n2) % N for n1 in range(N1) for n2 in range(N2) ]  # idx n1*N2+n2 -> n
    # output: X[k] = DFTN1_{q1}(DFTN2_m(...)) where q1 = (N2*k) ... derive: w_N^{b n1 k}: b = N2*invN2: e^{-2pi i b n1 k/N} = e^{-2pi i n1 k invN2... } hmm do numerically below
    return a, b, nmap

def build_pfa(N1, N2, dftA, dftB):
    """returns (nmap, kmap) verified numerically: stageA = DFT_N1 over n1 for each n2;
       stageB = DFT_N2 over n2-index for each q1; output (q1, m) -> k via kmap[q1*N2+m]"""
    N = N1*N2
    inv = lambda a,m: pow(a, -1, m)
    b = N2*inv(N2 % N1, N1)
    a = N1*inv(N1 % N2, N2)
    nmap = [ (b*n1 + a*n2) % N for n1 in range(N1) for n2 in range(N2) ]
    # determine kmap numerically: X[k] = sum_n x[n] w^{nk}
    # A[q1][n2] = sum_n1 x[n1,n2] wN1^{n1 q1}; B[q1][m] = sum_n2 A[q1][n2] wN2^{n2 m}
    # find for each (q1,m) the k with X[k] == B[q1][m]
    rng = np.random.default_rng(1)
    x = rng.standard_normal(N) + 1j*rng.standard_normal(N)
    X = np.fft.fft(x)
    xg = np.array([[x[nmap[n1*N2+n2]] for n2 in range(N2)] for n1 in range(N1)])
    A = np.fft.fft(xg, axis=0)   # over n1
    Bm = np.fft.fft(A, axis=1)   # over n2
    kmap = [None]*N
    for q1 in range(N1):
        for m in range(N2):
            d = np.abs(X - Bm[q1,m])
            k = int(np.argmin(d))
            assert d[k] < 1e-8*max(1,np.abs(X[k])), (q1,m,d[k])
            kmap[q1*N2+m] = k
    assert sorted(kmap) == list(range(N))
    return nmap, kmap

MAPSTORE_DEF = r'''
#ifndef MYMAP_DEFS
#define MYMAP_DEFS
#define MAPSTORE2(addr_r, addr_i, zr_, zi_, car, cai) do{ \
