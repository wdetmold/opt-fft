import time, numpy as np, os
os.sched_setaffinity(0,{0})
_SIZES=(6,8,13,17,23,36,45,64)
for L in _SIZES:
    B = max(1, 400000//L**3)
    x = (np.random.default_rng(1).standard_normal((B,L,L,L)) + 1j*np.random.default_rng(2).standard_normal((B,L,L,L)))
    c = 0.1*x
    # warm
    z = np.fft.fftn(x,axes=(1,2,3))+c; x2 = z/(1+np.abs(z))
    t0=time.perf_counter()
    reps=3
    for r in range(reps):
        z = np.fft.fftn(x,axes=(1,2,3))+c
        x2 = z/(1+np.abs(z))
    t1=time.perf_counter()
    per_el = (t1-t0)/reps/(B*L**3)
    print(f"L={L:3d} B={B:6d} per-element-step {per_el*1e9:8.2f} ns, per volume-step {per_el*L**3*1e6:9.2f} us")
EOF
