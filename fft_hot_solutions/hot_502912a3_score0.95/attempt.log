#include <immintrin.h>
#include <stdio.h>
#include <time.h>
static double now(){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
#define ALIGN64 __attribute__((aligned(64)))
static double Z[72*8] ALIGN64, C[72*8] ALIGN64, O[72*8] ALIGN64;
__attribute__((noinline)) void mapduo(){
    for (int q = 0; q < 36; q += 2){
        __m512d zrA = _mm512_add_pd(_mm512_load_pd(Z + 16*q), _mm512_load_pd(C + 16*q));
        __m512d ziA = _mm512_add_pd(_mm512_load_pd(Z + 16*q + 8), _mm512_load_pd(C + 16*q + 8));
        __m512d zrB = _mm512_add_pd(_mm512_load_pd(Z + 16*q + 16), _mm512_load_pd(C + 16*q + 16));
        __m512d ziB = _mm512_add_pd(_mm512_load_pd(Z + 16*q + 24), _mm512_load_pd(C + 16*q + 24));
        __m512d r2A = _mm512_fmadd_pd(zrA,zrA,_mm512_fmadd_pd(ziA,ziA,_mm512_set1_pd(1e-300)));
        __m512d r2B = _mm512_fmadd_pd(zrB,zrB,_mm512_fmadd_pd(ziB,ziB,_mm512_set1_pd(1e-300)));
        /* packed float rsqrt seed for both */
        __m512 pf = _mm512_insertf32x8(_mm512_castps256_ps512(_mm512_cvtpd_ps(r2A)), _mm512_cvtpd_ps(r2B), 1);
        __m512 ys = _mm512_rsqrt14_ps(pf);
        __m512d y0A = _mm512_cvtps_pd(_mm512_castps512_ps256(ys));
        __m512d y0B = _mm512_cvtps_pd(_mm512_extractf32x8_ps(ys, 1));
        __m512d hA = _mm512_mul_pd(r2A, _mm512_set1_pd(0.5));
        __m512d hB = _mm512_mul_pd(r2B, _mm512_set1_pd(0.5));
        __m512d wA = _mm512_fnmadd_pd(hA, _mm512_mul_pd(y0A,y0A), _mm512_set1_pd(1.5));
        __m512d wB = _mm512_fnmadd_pd(hB, _mm512_mul_pd(y0B,y0B), _mm512_set1_pd(1.5));
        __m512d y1A = _mm512_mul_pd(y0A,wA);
        __m512d y1B = _mm512_mul_pd(y0B,wB);
        wA = _mm512_fnmadd_pd(hA, _mm512_mul_pd(y1A,y1A), _mm512_set1_pd(1.5));
        wB = _mm512_fnmadd_pd(hB, _mm512_mul_pd(y1B,y1B), _mm512_set1_pd(1.5));
        __m512d y2A = _mm512_mul_pd(y1A,wA);
        __m512d y2B = _mm512_mul_pd(y1B,wB);
        __m512d sA = _mm512_mul_pd(r2A,y2A);
        __m512d sB = _mm512_mul_pd(r2B,y2B);
        __m512d dA = _mm512_add_pd(_mm512_set1_pd(1.0), sA);
        __m512d dB = _mm512_add_pd(_mm512_set1_pd(1.0), sB);
        __m512 pg = _mm512_insertf32x8(_mm512_castps256_ps512(_mm512_cvtpd_ps(dA)), _mm512_cvtpd_ps(dB), 1);
        __m512 gs = _mm512_rcp14_ps(pg);
        __m512d gA = _mm512_cvtps_pd(_mm512_castps512_ps256(gs));
        __m512d gB = _mm512_cvtps_pd(_mm512_extractf32x8_ps(gs, 1));
        gA = _mm512_mul_pd(gA, _mm512_fnmadd_pd(dA,gA,_mm512_set1_pd(2.0)));
        gB = _mm512_mul_pd(gB, _mm512_fnmadd_pd(dB,gB,_mm512_set1_pd(2.0)));
        gA = _mm512_mul_pd(gA, _mm512_fnmadd_pd(dA,gA,_mm512_set1_pd(2.0)));
        gB = _mm512_mul_pd(gB, _mm512_fnmadd_pd(dB,gB,_mm512_set1_pd(2.0)));
        _mm512_store_pd(O + 16*q, _mm512_mul_pd(zrA, gA));
        _mm512_store_pd(O + 16*q + 8, _mm512_mul_pd(ziA, gA));
        _mm512_store_pd(O + 16*q + 16, _mm512_mul_pd(zrB, gB));
        _mm512_store_pd(O + 16*q + 24, _mm512_mul_pd(ziB, gB));
    }
}
int main(){
    for(int i=0;i<72*8;i++){ Z[i]=(i%37)/10.0-1.5; C[i]=(i%17)/100.0; }
    long R=400000; mapduo();
    double t0=now(); for(long r=0;r<R;r++) mapduo(); double t1=now();
    printf("mapduo: %.3f ns/el %.2f cyc/el (%.1f cyc/pair)\n",(t1-t0)/R/288*1e9,(t1-t0)/R/288*3.1e9,(t1-t0)/R/36*3.1e9);
    return 0;
}
