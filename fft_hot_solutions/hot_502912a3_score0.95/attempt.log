import numpy as np
from glib import Emit, tw, hexd

def emit_tables(L):
    h = (L-1)//2
    C = np.zeros((h,h)); S = np.zeros((h,h))
    for j in range(1, h+1):
        for k in range(1, h+1):
            c, s = tw(j*k, L)
            C[j-1,k-1] = c; S[j-1,k-1] = -s
    # layout: column k-1 contiguous per j? k-loop wants per k: column [j] values: store k-major: T[(k-1)*h + (j-1)]
    flat_c = [C[j,k] for k in range(h) for j in range(h)]
    flat_s = [S[j,k] for k in range(h) for j in range(h)]
    out = []
    out.append(f'static const double PCT_{L}[{h*h}] ALIGN64 = {{ ' + ', '.join(hexd(x) for x in flat_c) + ' };')
    out.append(f'static const double PST_{L}[{h*h}] ALIGN64 = {{ ' + ', '.join(hexd(x) for x in flat_s) + ' };')
    return '\n'.join(out)

def gen_pencil(L, fused, twophase, name):
    """Emit pencil function. p: double* base; SP: stride in slot-pairs (const);
       fused: add c (cp, stride CS) + map; twophase: stash v and C in scratch."""
    h = (L-1)//2
    e = Emit()
    args = 'double* restrict p, const long SP' + (', const double* restrict cp, const long CS' if fused else '')
    e.w(f'static inline __attribute__((always_inline)) void {name}({args}){{')
    decl_uv = ', '.join(f'u{j}r, u{j}i' for j in range(1,h+1))
    e.w f'' if False else None
    e.w(f'    __m512d {decl_uv};')
    if not twophase:
        e.w('    __m512d ' + ', '.join(f'v{j}r, v{j}i' for j in range(1,h+1)) + ';')
    e.w('    __m512d x0r = _mm512_load_pd(p + 0), x0i = _mm512_load_pd(p + 8);')
    e.w('    __m512d dcr = x0r, dci = x0i;')
    for j in range(1, h+1):
        e.w(f'    {{ __m512d ar = _mm512_load_pd(p + {j}*SP*16), ai = _mm512_load_pd(p + {j}*SP*16 + 8);')
        e.w(f'      __m512d br = _mm512_load_pd(p + {L-j}*SP*16), bi = _mm512_load_pd(p + {L-j}*SP*16 + 8);')
        e.w(f'      u{j}r = _mm512_add_pd(ar, br); u{j}i = _mm512_add_pd(ai, bi);')
        if twophase:
            e.w(f'      _mm512_store_pd(PSCR + {4*(j-1)}*8, _mm512_sub_pd(ar, br));')
            e.w(f'      _mm512_store_pd(PSCR + {4*(j-1)+1}*8, _mm512_sub_pd(ai, bi));')
        else:
            e.w(f'      v{j}r = _mm512_sub_pd(ar, br); v{j}i = _mm512_sub_pd(ai, bi);')
        e.w(f'      dcr = _mm512_add_pd(dcr, u{j}r); dci = _mm512_add_pd(dci, u{j}i); }}')
    if fused:
        e.w('    MAPSTORE(p + 0, dcr, dci, cp + 0, cp + 8);')
    else:
        e.w('    _mm512_store_pd(p + 0, dcr); _mm512_store_pd(p + 8, dci);')
    if not twophase:
        # single k-loop, all resident
        e.w('    {')
        e.w('    const double* tc = PCT_%d; const double* ts = PST_%d;' % (L, L))
        e.w('    double* pk = p + SP*16; double* pl = p + %d*SP*16;' % (L-1))
        if fused:
            e.w('    const double* ck = cp + CS*16; const double* cl = cp + %d*CS*16;' % (L-1))
        e.w('    #pragma GCC unroll 1')
        e.w(f'    for (int k = 0; k < {h}; k++) {{')
        e.w(f'        __m512d Cr = _mm512_fmadd_pd(u1r, _mm512_set1_pd(tc[0]), x0r);')
        e.w(f'        __m512d Ci = _mm512_fmadd_pd(u1i, _mm512_set1_pd(tc[0]), x0i);')
        e.w(f'        __m512d Sr = _mm512_mul_pd(v1r, _mm512_set1_pd(ts[0]));')
        e.w(f'        __m512d Si = _mm512_mul_pd(v1i, _mm512_set1_pd(ts[0]));')
        for j in range(2, h+1):
            e.w(f'        Cr = _mm512_fmadd_pd(u{j}r, _mm512_set1_pd(tc[{j-1}]), Cr);')
            e.w(f'        Ci = _mm512_fmadd_pd(u{j}i, _mm512_set1_pd(tc[{j-1}]), Ci);')
            e.w(f'        Sr = _mm512_fmadd_pd(v{j}r, _mm512_set1_pd(ts[{j-1}]), Sr);')
            e.w(f'        Si = _mm512_fmadd_pd(v{j}i, _mm512_set1_pd(ts[{j-1}]), Si);')
        e.w('        __m512d Xr = _mm512_add_pd(Cr, Si), Xi = _mm512_sub_pd(Ci, Sr);')
        e.w('        __m512d Yr = _mm512_sub_pd(Cr, Si), Yi = _mm512_add_pd(Ci, Sr);')
        if fused:
            e.w('        MAPSTORE(pk, Xr, Xi, ck, ck + 8);')
            e.w('        MAPSTORE(pl, Yr, Yi, cl, cl + 8);')
            e.w('        ck += CS*16; cl -= CS*16;')
        else:
            e.w('        _mm512_store_pd(pk, Xr); _mm512_store_pd(pk + 8, Xi);')
            e.w('        _mm512_store_pd(pl, Yr); _mm512_store_pd(pl + 8, Yi);')
        e.w(f'        pk += SP*16; pl -= SP*16; tc += {h}; ts += {h};')
        e.w('    }')
        e.w('    }')
    else:
        # phase 1: C_k into scratch (after v stash at PSCR[0..4h))
        e.w('    {')
        e.w('    const double* tc = PCT_%d;' % L)
        e.w('    #pragma GCC unroll 1')
        e.w(f'    for (int k = 0; k < {h}; k++) {{')
        e.w(f'        __m512d Cr = _mm512_fmadd_pd(u1r, _mm512_set1_pd(tc[0]), x0r);')
        e.w(f'        __m512d Ci = _mm512_fmadd_pd(u1i, _mm512_set1_pd(tc[0]), x0i);')
        for j in range(2, h+1):
            e.w(f'        Cr = _mm512_fmadd_pd(u{j}r, _mm512_set1_pd(tc[{j-1}]), Cr);')
            e.w(f'        Ci = _mm512_fmadd_pd(u{j}i, _mm512_set1_pd(tc[{j-1}]), Ci);')
        e.w(f'        _mm512_store_pd(CSCR + k*16, Cr); _mm512_store_pd(CSCR + k*16 + 8, Ci);')
        e.w(f'        tc += {h};')
        e.w('    }')
        e.w('    }')
        # reload v
        e.w('    __m512d ' + ', '.join(f'v{j}r, v{j}i' for j in range(1,h+1)) + ';')
        for j in range(1, h+1):
            e.w(f'    v{j}r = _mm512_load_pd(PSCR + {4*(j-1)}*8); v{j}i = _mm512_load_pd(PSCR + {4*(j-1)+1}*8);')
        e.w('    {')
        e.w('    const double* ts = PST_%d;' % L)
        e.w('    double* pk = p + SP*16; double* pl = p + %d*SP*16;' % (L-1))
        if fused:
            e.w('    const double* ck = cp + CS*16; const double* cl = cp + %d*CS*16;' % (L-1))
        e.w('    #pragma GCC unroll 1')
        e.w(f'    for (int k = 0; k < {h}; k++) {{')
        e.w(f'        __m512d Sr = _mm512_mul_pd(v1r, _mm512_set1_pd(ts[0]));')
        e.w(f'        __m512d Si = _mm512_mul_pd(v1i, _mm512_set1_pd(ts[0]));')
        for j in range(2, h+1):
            e.w(f'        Sr = _mm512_fmadd_pd(v{j}r, _mm512_set1_pd(ts[{j-1}]), Sr);')
            e.w(f'        Si = _mm512_fmadd_pd(v{j}i, _mm512_set1_pd(ts[{j-1}]), Si);')
        e.w('        __m512d Cr = _mm512_load_pd(CSCR + k*16), Ci = _mm512_load_pd(CSCR + k*16 + 8);')
        e.w('        __m512d Xr = _mm512_add_pd(Cr, Si), Xi = _mm512_sub_pd(Ci, Sr);')
        e.w('        __m512d Yr = _mm512_sub_pd(Cr, Si), Yi = _mm512_add_pd(Ci, Sr);')
        if fused:
            e.w('        MAPSTORE(pk, Xr, Xi, ck, ck + 8);')
            e.w('        MAPSTORE(pl, Yr, Yi, cl, cl + 8);')
            e.w('        ck += CS*16; cl -= CS*16;')
        else:
            e.w('        _mm512_store_pd(pk, Xr); _mm512_store_pd(pk + 8, Xi);')
            e.w('        _mm512_store_pd(pl, Yr); _mm512_store_pd(pl + 8, Yi);')
        e.w(f'        pk += SP*16; pl -= SP*16; ts += {h};')
        e.w('    }')
        e.w('    }')
    e.w('}')
    return '\n'.join(e.lines)

MAP_MACRO = r'''
#ifndef MAPSTORE
#define MAPSTORE(addr, zr_, zi_, car, cai) do{ \
    __m512d _zr = _mm512_add_pd(zr_, _mm512_load_pd(car)); \
    __m512d _zi = _mm512_add_pd(zi_, _mm512_load_pd(cai)); \
    __m512d _r2 = _mm512_fmadd_pd(_zr,_zr,_mm512_fmadd_pd(_zi,_zi,_mm512_set1_pd(MYTINY))); \
    __m512d _d = _mm512_add_pd(_mm512_set1_pd(1.0), _mm512_sqrt_pd(_r2)); \
    _mm512_store_pd(addr, _mm512_div_pd(_zr, _d)); \
    _mm512_store_pd((addr)+8, _mm512_div_pd(_zi, _d)); \
}while(0)
#endif
'''

def gen_prime_soa(L, twophase):
    h = (L-1)//2
    L2 = L*L; V = L2*L
    parts = [emit_tables(L), MAP_MACRO]
    parts.append(f'static double PSCR[{4*h*8}] ALIGN64;\nstatic double CSCR[{2*h*8}] ALIGN64;' if twophase else f'static double PSCR[{4*h*8}] ALIGN64;\nstatic double CSCR[{2*h*8}] ALIGN64;')
    parts.append(gen_pencil(L, False, twophase, f'p{L}_plain'))
    parts.append(gen_pencil(L, True, twophase, f'p{L}_fused'))
    parts.append(f'''
static void step{L}(double* restrict G, const double* restrict C){{
    for (int x = 0; x < {L}; x++){{
        double* base = G + (long)x*{L2}*16;
        for (int z = 0; z < {L}; z++) p{L}_plain(base + (long)z*16, {L});
        for (int y = 0; y < {L}; y++) p{L}_plain(base + (long)y*{L}*16, 1);
    }}
    for (int p = 0; p < {L2}; p++){{
        p{L}_fused(G + (long)p*16, {L2}, C + (long)p*16, {L2});
    }}
}}
''')
    parts.append(gen_run_soa(L))
    return '\n'.join(parts)

def gen_run_soa(L):
    V = L*L*L
    return f'''
static double* G_{L} = 0;
static double* C_{L} = 0;
void run_{L}(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    if (B < 6) {{ w00_run_{L}(x0, c, out1, outm, B, m); return; }}
    if (!G_{L}) {{ G_{L} = myk_alloc(({V}*16 + 64)*8); C_{L} = myk_alloc(({V}*16 + 64)*8); }}
    double* G = G_{L}; double* C = C_{L};
    const double* src[8]; double* dst[8];
    for (long g0 = 0; g0 < B; g0 += 8) {{
        int nv = (int)(B - g0 < 8 ? B - g0 : 8);
        for (int i = 0; i < 8; i++) src[i] = x0 + (g0 + (i < nv ? i : 0))*{V}*2;
        soaconv_in_{L}(src, nv, G);
        for (int i = 0; i < 8; i++) src[i] = c + (g0 + (i < nv ? i : 0))*{V}*2;
        soaconv_in_{L}(src, nv, C);
        for (long s = 0; s < m; s++) {{
            step{L}(G, C);
            if (s == 0) {{
                for (int i = 0; i < 8; i++) dst[i] = out1 + (g0 + (i < nv ? i : 0))*{V}*2;
                soaconv_out_{L}(G, dst, nv);
            }}
        }}
        for (int i = 0; i < 8; i++) dst[i] = outm + (g0 + (i < nv ? i : 0))*{V}*2;
        soaconv_out_{L}(G, dst, nv);
    }}
}}
'''
EOF
