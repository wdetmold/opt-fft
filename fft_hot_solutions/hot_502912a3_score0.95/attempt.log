// MKL DFTI reference (benchmark-only, NOT part of solution)
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include "mkl_dfti.h"
typedef struct { double re, im; } cplx;
void run_mkl(const double* x0, const double* c, double* out1, double* outm, long B, long m, long L){
    MKL_LONG dims[3] = {L,L,L};
    DFTI_DESCRIPTOR_HANDLE h;
    DftiCreateDescriptor(&h, DFTI_DOUBLE, DFTI_COMPLEX, 3, dims);
    DftiSetValue(h, DFTI_NUMBER_OF_TRANSFORMS, (MKL_LONG)B);
    DftiSetValue(h, DFTI_INPUT_DISTANCE, (MKL_LONG)(L*L*L));
    DftiSetValue(h, DFTI_OUTPUT_DISTANCE, (MKL_LONG)(L*L*L));
    DftiSetValue(h, DFTI_PLACEMENT, DFTI_INPLACE);
    DftiCommitDescriptor(h);
    long N = B*L*L*L;
    double* x = (double*)malloc(16*N);
    memcpy(x, x0, 16*N);
    for(long k=0;k<m;k++){
        DftiComputeForward(h, x);
        for(long i=0;i<N;i++){
            double zr = x[2*i]+c[2*i], zi = x[2*i+1]+c[2*i+1];
            double d = 1.0 + sqrt(zr*zr+zi*zi);
            x[2*i] = zr/d; x[2*i+1] = zi/d;
        }
        if(k==0) memcpy(out1, x, 16*N);
    }
    memcpy(outm, x, 16*N);
    free(x);
    DftiFreeDescriptor(&h);
}
EOF
