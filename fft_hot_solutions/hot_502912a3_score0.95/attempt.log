#include <immintrin.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define ALIGN64 __attribute__((aligned(64)))
static double now(){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
static double A[512] ALIGN64, B[512] ALIGN64;
int main(){
    srand(7);
    for(int i=0;i<512;i++){ A[i] = 0.01 + (rand()%10000)/700.0; B[i] = 0.01 + (rand()%10000)/900.0; }
    { // vdivpd throughput, varied data, 8 independent
      __m512d acc0=_mm512_setzero_pd(), acc1=_mm512_setzero_pd();
      long R=2000000; double t0=now();
      for(long r=0;r<R;r++){
        const double* a=A+((r&7)<<6); const double* b=B+((r&7)<<6);
        acc0=_mm512_add_pd(acc0,_mm512_div_pd(_mm512_load_pd(a),_mm512_load_pd(b)));
        acc1=_mm512_add_pd(acc1,_mm512_div_pd(_mm512_load_pd(a+8),_mm512_load_pd(b+8)));
        acc0=_mm512_add_pd(acc0,_mm512_div_pd(_mm512_load_pd(a+16),_mm512_load_pd(b+16)));
        acc1=_mm512_add_pd(acc1,_mm512_div_pd(_mm512_load_pd(a+24),_mm512_load_pd(b+24)));
      }
      double t1=now();
      printf("vdivpd zmm varied-data thr: %.2f cyc/op\n",(t1-t0)/(4*R)*3.1e9);
      volatile double s=((double*)&acc0)[0]+((double*)&acc1)[0];(void)s;
    }
    { // vsqrtpd
      __m512d acc0=_mm512_setzero_pd(), acc1=_mm512_setzero_pd();
      long R=2000000; double t0=now();
      for(long r=0;r<R;r++){
        const double* a=A+((r&7)<<6);
        acc0=_mm512_add_pd(acc0,_mm512_sqrt_pd(_mm512_load_pd(a)));
        acc1=_mm512_add_pd(acc1,_mm512_sqrt_pd(_mm512_load_pd(a+8)));
        acc0=_mm512_add_pd(acc0,_mm512_sqrt_pd(_mm512_load_pd(a+16)));
        acc1=_mm512_add_pd(acc1,_mm512_sqrt_pd(_mm512_load_pd(a+24)));
      }
      double t1=now();
      printf("vsqrtpd zmm varied-data thr: %.2f cyc/op\n",(t1-t0)/(4*R)*3.1e9);
      volatile double s=((double*)&acc0)[0]+((double*)&acc1)[0];(void)s;
    }
    { // the actual map load: per pair: 1 sqrt + 2 div, varied data, plus FMA filler
      __m512d f0=_mm512_set1_pd(1.000001),f1=f0,f2=f0,f3=f0;
      __m512d kb=_mm512_set1_pd(0.99999), kc=_mm512_set1_pd(1e-9), one=_mm512_set1_pd(1.0);
      __m512d acc0=_mm512_setzero_pd(), acc1=_mm512_setzero_pd();
      long R=1000000; double t0=now();
      for(long r=0;r<R;r++){
        const double* a=A+((r&7)<<6); const double* b=B+((r&7)<<6);
        __m512d zr=_mm512_load_pd(a), zi=_mm512_load_pd(b);
        __m512d r2=_mm512_fmadd_pd(zr,zr,_mm512_mul_pd(zi,zi));
        __m512d d=_mm512_add_pd(one,_mm512_sqrt_pd(r2));
        acc0=_mm512_add_pd(acc0,_mm512_div_pd(zr,d));
        acc1=_mm512_add_pd(acc1,_mm512_div_pd(zi,d));
        for(int k=0;k<2;k++){ f0=_mm512_fmadd_pd(f0,kb,kc); f1=_mm512_fmadd_pd(f1,kb,kc); f2=_mm512_fmadd_pd(f2,kb,kc); f3=_mm512_fmadd_pd(f3,kb,kc); }
      }
      double t1=now();
      printf("map(sqrt+2div)+8FMA filler: %.2f cyc/pair\n",(t1-t0)/R*3.1e9);
      volatile double s=((double*)&acc0)[0]+((double*)&acc1)[0]+((double*)&f0)[0]+((double*)&f1)[0]+((double*)&f2)[0]+((double*)&f3)[0];(void)s;
    }
    return 0;
}
