<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/dev/gen && cat > ir.py <<'EOF'
import numpy as np
from glib import tw, hexd

class IR:
    """op-list IR over vector vars; renders to C intrinsics and executes in numpy for verification"""
    def __init__(self):
        self.ops = []   # (kind, dst, a, b, c)
        self.n = 0
    def v(self, pfx='t'):
        self.n += 1
        return f'{pfx}_{self.n}'
    def add(self, a, b):   d=self.v(); self.ops.append(('add',d,a,b,None)); return d
    def sub(self, a, b):   d=self.v(); self.ops.append(('sub',d,a,b,None)); return d
    def mul(self, a, b):   d=self.v(); self.ops.append(('mul',d,a,b,None)); return d
    def mulc(self, a, c):  d=self.v(); self.ops.append(('mulc',d,a,None,float(c))); return d
    def fmac(self, a, c, acc):  d=self.v(); self.ops.append(('fmac',d,a,acc,float(c))); return d   # d = a*c + acc
    def fnmac(self, a, c, acc): d=self.v(); self.ops.append(('fnmac',d,a,acc,float(c))); return d  # d = acc - a*c
    def render(self, declared=None):
        lines = []
        declared = declared or set()
        for kind,d,a,b,c in self.ops:
            decl = '' if d in declared else '__m512d '
            declared.add(d)
            if kind=='add': lines.append(f'{decl}{d} = _mm512_add_pd({a}, {b});')
            elif kind=='sub': lines.append(f'{decl}{d} = _mm512_sub_pd({a}, {b});')
            elif kind=='mul': lines.append(f'{decl}{d} = _mm512_mul_pd({a}, {b});')
            elif kind=='mulc': lines.append(f'{decl}{d} = _mm512_mul_pd({a}, _mm512_set1_pd({hexd(c)}));')
            elif kind=='fmac': lines.append(f'{decl}{d} = _mm512_fmadd_pd({a}, _mm512_set1_pd({hexd(c)}), {b});')
            elif kind=='fnmac': lines.append(f'{decl}{d} = _mm512_fnmadd_pd({a}, _mm512_set1_pd({hexd(c)}), {b});')
        return lines
    def execute(self, env):
        """env: dict var->complex ndarray... vars here are REAL scalars (split re/im)"""
        for kind,d,a,b,c in self.ops:
            if kind=='add': env[d] = env[a] + env[b]
            elif kind=='sub': env[d] = env[a] - env[b]
            elif kind=='mul': env[d] = env[a] * env[b]
            elif kind=='mulc': env[d] = env[a] * c
            elif kind=='fmac': env[d] = env[a]*c + env[b]
            elif kind=='fnmac': env[d] = env[b] - env[a]*c
        return env

def dft3(ir, x, out_prefix=None):
    """x: list of 3 (re,im) var tuples -> returns 3 (re,im) tuples. forward DFT3"""
    s60 = float(np.sin(np.longdouble(2)*np.longdouble('3.14159265358979323846264338327950288')/3))
    (x0r,x0i),(x1r,x1i),(x2r,x2i) = x
    tr = ir.add(x1r,x2r); ti = ir.add(x1i,x2i)
    mr = ir.fnmac(tr, 0.5, x0r); mi = ir.fnmac(ti, 0.5, x0i)
    dr = ir.sub(x1r,x2r); di = ir.sub(x1i,x2i)
    sr = ir.mulc(dr, s60); si = ir.mulc(di, s60)
    X0r = ir.add(x0r,tr); X0i = ir.add(x0i,ti)
    X1r = ir.add(mr,si); X1i = ir.sub(mi,sr)
    X2r = ir.sub(mr,si); X2i = ir.add(mi,sr)
    return [(X0r,X0i),(X1r,X1i),(X2r,X2i)]

def dft4(ir, x):
    (x0r,x0i),(x1r,x1i),(x2r,x2i),(x3r,x3i) = x
    t0r=ir.add(x0r,x2r); t0i=ir.add(x0i,x2i)
    t1r=ir.sub(x0r,x2r); t1i=ir.sub(x0i,x2i)
    t2r=ir.add(x1r,x3r); t2i=ir.add(x1i,x3i)
    t3r=ir.sub(x1r,x3r); t3i=ir.sub(x1i,x3i)
    X0r=ir.add(t0r,t2r); X0i=ir.add(t0i,t2i)
    X2r=ir.sub(t0r,t2r); X2i=ir.sub(t0i,t2i)
    X1r=ir.add(t1r,t3i); X1i=ir.sub(t1i,t3r)
    X3r=ir.sub(t1r,t3i); X3i=ir.add(t1i,t3r)
    return [(X0r,X0i),(X1r,X1i),(X2r,X2i),(X3r,X3i)]

def dft2(ir, x):
    (x0r,x0i),(x1r,x1i) = x
    return [(ir.add(x0r,x1r), ir.add(x0i,x1i)), (ir.sub(x0r,x1r), ir.sub(x0i,x1i))]

def cmul(ir, x, num, den):
    """multiply by w_den^num (forward: e^{-2pi i num/den})"""
    c, s = tw(num, den)
    xr, xi = x
    # (c + i s)(xr + i xi) = (c xr - s xi) + i(c xi + s xr)
    t1 = ir.mulc(xi, s)
    rr = ir.fmac(xr, c, ir.mulc(t1, -1.0)) if False else None
    # better: rr = c*xr - s*xi via fnmac(xi, s, mulc(xr, c)) -- 2 ops
    a = ir.mulc(xr, c)
    rr = ir.fnmac(xi, s, a)
    b = ir.mulc(xi, c)
    ri = ir.fmac(xr, s, b)
    return (rr, ri)

def dft5(ir, x):
    """Winograd-style DFT5 (forward)"""
    PI = np.longdouble('3.14159265358979323846264338327950288')
    c1 = np.cos(2*PI/5); c2 = np.cos(4*PI/5)
    s1 = np.sin(2*PI/5); s2 = np.sin(4*PI/5)
    (x0r,x0i),(x1r,x1i),(x2r,x2i),(x3r,x3i),(x4r,x4i) = x
    # u1 = x1+x4, v1 = x1-x4, u2 = x2+x3, v2 = x2-x3
    u1r=ir.add(x1r,x4r); u1i=ir.add(x1i,x4i); v1r=ir.sub(x1r,x4r); v1i=ir.sub(x1i,x4i)
    u2r=ir.add(x2r,x3r); u2i=ir.add(x2i,x3i); v2r=ir.sub(x2r,x3r); v2i=ir.sub(x2i,x3i)
    X0r = ir.add(ir.add(u1r,u2r), x0r); X0i = ir.add(ir.add(u1i,u2i), x0i)
    # C1 = x0 + c1 u1 + c2 u2 ; C2 = x0 + c2 u1 + c1 u2
    C1r = ir.fmac(u2r, c2, ir.fmac(u1r, c1, x0r)); C1i = ir.fmac(u2i, c2, ir.fmac(u1i, c1, x0i))
    C2r = ir.fmac(u2r, c1, ir.fmac(u1r, c2, x0r)); C2i = ir.fmac(u2i, c1, ir.fmac(u1i, c2, x0i))
    # S1 = s1 v1 + s2 v2 ; S2 = s2 v1 - s1 v2
    S1r = ir.fmac(v2r, s2, ir.mulc(v1r, s1)); S1i = ir.fmac(v2i, s2, ir.mulc(v1i, s1))
    S2r = ir.fnmac(v2r, s1, ir.mulc(v1r, s2)); S2i = ir.fnmac(v2i, s1, ir.mulc(v1i, s2))
    # X1 = C1 - i S1, X4 = C1 + i S1; X2 = C2 - i S2, X3 = C2 + i S2
    X1r=ir.add(C1r,S1i); X1i=ir.sub(C1i,S1r)
    X4r=ir.sub(C1r,S1i); X4i=ir.add(C1i,S1r)
    X2r=ir.add(C2r,S2i); X2i=ir.sub(C2i,S2r)
    X3r=ir.sub(C2r,S2i); X3i=ir.add(C2i,S2r)
    return [(X0r,X0i),(X1r,X1i),(X2r,X2i),(X3r,X3i),(X4r,X4i)]

def dft9(ir, x):
    """9 = 3x3 Cooley-Tukey DIT: X[3t+j]?? verify numerically. inputs x[0..8]"""
    # stage1: DFT3 over strided triples (n2 mod 3): A_j = DFT3(x[j], x[j+3], x[j+6]) for j=0,1,2
    A = dft3(ir, [x[0], x[3], x[6]])
    B = dft3(ir, [x[1], x[4], x[7]])
    C = dft3(ir, [x[2], x[5], x[8]])
    # twiddle: B[t] *= w9^t, C[t] *= w9^{2t}
    B1 = [B[0], cmul(ir, B[1], 1, 9), cmul(ir, B[2], 2, 9)]
    C1 = [C[0], cmul(ir, C[1], 2, 9), cmul(ir, C[2], 4, 9)]
    # stage2: for each t: DFT3 over (A[t], B1[t], C1[t]) gives X[t], X[t+3], X[t+6]
    out = [None]*9
    for t in range(3):
        Y = dft3(ir, [A[t], B1[t], C1[t]])
        out[t] = Y[0]; out[t+3] = Y[1]; out[t+6] = Y[2]
    return out

def dft8(ir, x):
    """8 = radix-2^3 DIT split-radix-ish; standard: X = DFT8. Use 2x4."""
    # stage: DFT2 pairs (x0,x4),(x1,x5),(x2,x6),(x3,x7)
    a0 = dft2(ir, [x[0], x[4]])
    a1 = dft2(ir, [x[1], x[5]])
    a2 = dft2(ir, [x[2], x[6]])
    a3 = dft2(ir, [x[3], x[7]])
    # even part: DFT4 of (a0[0], a1[0], a2[0], a3[0]) -> X0,X2,X4,X6
    E = dft4(ir, [a0[0], a1[0], a2[0], a3[0]])
    # odd part: twiddle a1[1]*w8^1, a2[1]*w8^2, a3[1]*w8^3 then DFT4 -> X1,X3,X5,X7
    b1 = cmul(ir, a1[1], 1, 8)
    b2 = cmul(ir, a2[1], 2, 8)   # = -i: could be free but keep general
    b3 = cmul(ir, a3[1], 3, 8)
    O = dft4(ir, [a0[1], b1, b2, b3])
    out = [None]*8
    for t in range(4):
        out[2*t] = E[t]; out[2*t+1] = O[t]
    return out

def verify(dft_fn, N, trials=3):
    rng = np.random.default_rng(0)
    for _ in range(trials):
        xs = rng.standard_normal(N) + 1j*rng.standard_normal(N)
        ir = IR()
        xv = [(f'x{j}r', f'x{j}i') for j in range(N)]
        out = dft_fn(ir, xv)
        env = {}
        for j in range(N):
            env[f'x{j}r'] = xs[j].real; env[f'x{j}i'] = xs[j].imag
        ir.execute(env)
        got = np.array([env[r] + 1j*env[i] for (r,i) in out])
        ref = np.fft.fft(xs)
        err = np.abs(got-ref).max()/np.abs(ref).max()
        if err > 1e-14:
            return False, err
    return True, 0.0

if __name__ == '__main__':
    for fn, N in ((dft3,3),(dft4,4),(dft5,5),(dft8,8),(dft9,9)):
        ok, err = verify(fn, N)
        print(f'DFT{N}: {"OK" if ok else "FAIL "+str(err)}')
