One final bounded attempt: L=23 within-volume (L2-resident) with the asm pencil framework, embedded-broadcast constants for h=11:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/dev/gen && cat > genasm23.py <<'EOF'
import numpy as np
from glib import tw, hexd
from genasm3 import A

def pencil23(SP, CS, fused, name):
    """h=11 within-volume pencil, embedded-broadcast constants from PCT_23/PST_23 (k-major [k][j]).
       regs: u 0-21; x0 22,23; C-accs 24-27 (KBC=2); ld-temps 28-31.
       S: v 0-21; accs 24,25 (fused KBS=1) or 24-27 (plain KBS=2); combine 26-29; map temps 24,25,30,31; 0.5/1.5 in 22/23."""
    L, h = 23, 11
    sp = SP*128; cs = CS*128
    o = A()
    o.w('vmovapd (%[p]), %%zmm22')
    o.w('vmovapd 64(%[p]), %%zmm23')
    o.w('vmovapd %%zmm22, %%zmm24')
    o.w('vmovapd %%zmm23, %%zmm25')
    for j in range(1, h+1):
        a = j*sp; b = (L-j)*sp
        o.w(f'vmovapd {a}(%[p]), %%zmm28')
        o.w(f'vmovapd {a+64}(%[p]), %%zmm29')
        o.w(f'vmovapd {b}(%[p]), %%zmm30')
        o.w(f'vmovapd {b+64}(%[p]), %%zmm31')
        o.w(f'vaddpd %%zmm30, %%zmm28, %%zmm{2*(j-1)}')
        o.w(f'vaddpd %%zmm31, %%zmm29, %%zmm{2*(j-1)+1}')
        o.w(f'vsubpd %%zmm30, %%zmm28, %%zmm28')
        o.w(f'vsubpd %%zmm31, %%zmm29, %%zmm29')
        o.w(f'vmovapd %%zmm28, {(j-1)*128}(%[vs])')
        o.w(f'vmovapd %%zmm29, {(j-1)*128+64}(%[vs])')
        o.w(f'vaddpd %%zmm{2*(j-1)}, %%zmm24, %%zmm24')
        o.w(f'vaddpd %%zmm{2*(j-1)+1}, %%zmm25, %%zmm25')
    o.w(f'vmovapd %%zmm24, {h*128}(%[cs])')
    o.w(f'vmovapd %%zmm25, {h*128+64}(%[cs])')
    # C phase KBC=2 (k blocks), embedded bcast constants
    k = 1
    while k <= h:
        kb = min(2, h-k+1)
        for dk in range(kb):
            o.w(f'vmovapd %%zmm22, %%zmm{24+2*dk}')
            o.w(f'vmovapd %%zmm23, %%zmm{25+2*dk}')
        for j in range(1, h+1):
            for dk in range(kb):
                off = ((k+dk-1)*h + (j-1))*8
                o.w(f'vfmadd231pd {off}(%[tc])%{{1to8%}}, %%zmm{2*(j-1)}, %%zmm{24+2*dk}')
                o.w(f'vfmadd231pd {off}(%[tc])%{{1to8%}}, %%zmm{2*(j-1)+1}, %%zmm{25+2*dk}')
        for dk in range(kb):
            o.w(f'vmovapd %%zmm{24+2*dk}, {(k+dk-1)*128}(%[cs])')
            o.w(f'vmovapd %%zmm{25+2*dk}, {(k+dk-1)*128+64}(%[cs])')
        k += kb
    # reload v
    for j in range(1, h+1):
        o.w(f'vmovapd {(j-1)*128}(%[vs]), %%zmm{2*(j-1)}')
        o.w(f'vmovapd {(j-1)*128+64}(%[vs]), %%zmm{2*(j-1)+1}')
    if fused:
        o.w('vbroadcastsd %[c05], %%zmm22')
        o.w('vbroadcastsd %[c15], %%zmm23')
    KBS = 1 if fused else 2
    k = 1
    while k <= h:
        kb = min(KBS, h-k+1)
        for dk in range(kb):
            first = True
            for j in range(1, h+1):
                off = ((k+dk-1)*h + (j-1))*8
                if first:
                    o.w(f'vmulpd {off}(%[ts])%{{1to8%}}, %%zmm{2*(j-1)}, %%zmm{24+2*dk}')
                    o.w(f'vmulpd {off}(%[ts])%{{1to8%}}, %%zmm{2*(j-1)+1}, %%zmm{25+2*dk}')
                    first = False
                else:
                    o.w(f'vfmadd231pd {off}(%[ts])%{{1to8%}}, %%zmm{2*(j-1)}, %%zmm{24+2*dk}')
                    o.w(f'vfmadd231pd {off}(%[ts])%{{1to8%}}, %%zmm{2*(j-1)+1}, %%zmm{25+2*dk}')
        for dk in range(kb):
            kk = k+dk
            Sr = 24+2*dk; Si = 25+2*dk
            o.w(f'vmovapd {(kk-1)*128}(%[cs]), %%zmm30')
            o.w(f'vmovapd {(kk-1)*128+64}(%[cs]), %%zmm31')
            o.w(f'vaddpd %%zmm{Si}, %%zmm30, %%zmm26')   # Xr
            o.w(f'vsubpd %%zmm{Sr}, %%zmm31, %%zmm27')   # Xi
            o.w(f'vsubpd %%zmm{Si}, %%zmm30, %%zmm28')   # Yr
            o.w(f'vaddpd %%zmm{Sr}, %%zmm31, %%zmm29')   # Yi
            if fused:
                map23(o, 'zmm26', 'zmm27', kk*cs, kk*sp)
                map23(o, 'zmm28', 'zmm29', (L-kk)*cs, (L-kk)*sp)
            else:
                o.w(f'vmovapd %%zmm26, {kk*sp}(%[p])')
                o.w(f'vmovapd %%zmm27, {kk*sp+64}(%[p])')
                o.w(f'vmovapd %%zmm28, {(L-kk)*sp}(%[p])')
                o.w(f'vmovapd %%zmm29, {(L-kk)*sp+64}(%[p])')
        k += kb
    o.w(f'vmovapd {h*128}(%[cs]), %%zmm26')
    o.w(f'vmovapd {h*128+64}(%[cs]), %%zmm27')
    if fused:
        map23(o, 'zmm26', 'zmm27', 0, 0)
    else:
        o.w('vmovapd %%zmm26, (%[p])')
        o.w('vmovapd %%zmm27, 64(%[p])')
    args = 'double* restrict p'
    ins = f'[p] "r" (p), [tc] "r" (PCT_23), [ts] "r" (PST_23), [vs] "r" (VSCR_23), [cs] "r" (CSCR_23A)'
    if fused:
        args += ', const double* restrict cp'
        ins += ', [cp] "r" (cp), [c05] "m" (MCONST[0]), [c15] "m" (MCONST[1]), [c20] "m" (MCONST[2]), [c10] "m" (MCONST[3]), [tiny] "m" (MCONST[4])'
    return f'''
static void {name}({args}){{
    __asm__ volatile(
{o.text()}
        :
        : {ins}
        : "memory",
          {', '.join(f'"zmm{i}"' for i in range(32))}
    );
}}
'''

def map23(o, zr, zi, coff, poff):
    """temps zmm24,25,30,31; consts 0.5=zmm22, 1.5=zmm23, 2.0/1.0/tiny embedded"""
    o.w(f'vaddpd {coff}(%[cp]), %%{zr}, %%{zr}')
    o.w(f'vaddpd {coff+64}(%[cp]), %%{zi}, %%{zi}')
    o.w(f'vbroadcastsd %[tiny], %%zmm24')
    o.w(f'vfmadd231pd %%{zi}, %%{zi}, %%zmm24')
    o.w(f'vfmadd231pd %%{zr}, %%{zr}, %%zmm24')
    o.w(f'vrsqrt14pd %%zmm24, %%zmm25')
    o.w(f'vmulpd %%zmm22, %%zmm24, %%zmm30')
    o.w(f'vmulpd %%zmm25, %%zmm25, %%zmm31')
    o.w(f'vfnmadd213pd %%zmm23, %%zmm30, %%zmm31')
    o.w(f'vmulpd %%zmm31, %%zmm25, %%zmm25')
    o.w(f'vmulpd %%zmm25, %%zmm25, %%zmm31')
    o.w(f'vfnmadd213pd %%zmm23, %%zmm30, %%zmm31')
    o.w(f'vmulpd %%zmm31, %%zmm25, %%zmm25')
    o.w(f'vfmadd213pd %[c10]%{{1to8%}}, %%zmm25, %%zmm24')   # d
    o.w(f'vrcp14pd %%zmm24, %%zmm25')
    o.w(f'vmovapd %%zmm24, %%zmm30')
    o.w(f'vfnmadd213pd %[c20]%{{1to8%}}, %%zmm25, %%zmm30')
    o.w(f'vmulpd %%zmm30, %%zmm25, %%zmm25')
    o.w(f'vmovapd %%zmm24, %%zmm30')
    o.w(f'vfnmadd213pd %[c20]%{{1to8%}}, %%zmm25, %%zmm30')
    o.w(f'vmulpd %%zmm30, %%zmm25, %%zmm25')
    o.w(f'vmulpd %%zmm25, %%{zr}, %%{zr}')
    o.w(f'vmulpd %%zmm25, %%{zi}, %%{zi}')
    o.w(f'vmovapd %%{zr}, {poff}(%[p])')
    o.w(f'vmovapd %%{zi}, {poff+64}(%[p])')

def gen23_asm():
    """within-volume layout from gen23 infrastructure + asm pencils"""
    import gen23, genprime3
    base = gen23.gen_23()
    # strip out the intrinsics pencils and step; keep tables(rename CSCR), transposes, conv, run
    # simplest: regenerate needed pieces here
    ROWP, PLROWS = 3, 25
    PLP = PLROWS*ROWP
    parts = []
    parts.append(genprime3.emit_tables(23))
    parts.append(f'static double VSCR_23[{2*11*8}] ALIGN64;\nstatic double CSCR_23A[{2*12*8}] ALIGN64;')
    parts.append(pencil23(ROWP, 0, False, 'c23_y'))
    parts.append(pencil23(1, 0, False, 'c23_z'))
    parts.append(pencil23(PLP, PLP, True, 'c23_x'))
    # reuse gen23's z-strip/conv/run by extracting from its output, but swap pencil calls
    i0 = base.index('static void z23_strip')
    tail = base[i0:]
    tail = tail.replace('p23_plain(TSCR23, 1);', 'c23_z(TSCR23);')
    tail = tail.replace('for (int zv = 0; zv < 3; zv++) p23_plain(base + zv*16, 3);',
                        'for (int zv = 0; zv < 3; zv++) c23_y(base + zv*16);')
    tail = tail.replace('p23_fused(G + (long)q*16, 75, Cv + (long)q*16, 75);',
                        'c23_x(G + (long)q*16, Cv + (long)q*16);')
    parts.append(tail)
    return '\n'.join(parts)
EOF
