import numpy as np
from glib import tw, hexd

def tables(L):
    h = (L-1)//2
    C = np.zeros((h,h)); S = np.zeros((h,h))
    for j in range(1, h+1):
        for k in range(1, h+1):
            c, s = tw(j*k, L)
            C[j-1,k-1] = c; S[j-1,k-1] = -s
    return C, S

class A:
    def __init__(self): self.l=[]
    def w(self,s): self.l.append(s)
    def text(self): return '\n'.join(f'        "{x}\\n\\t"' for x in self.l)

def emit_map(Ao, zr, zi, coff, poff, cptr='ck', optr='pk'):
    """map pair in regs zr/zi: +c at cptr+coff, store at optr+poff.
       consts: zmm0=0.5 zmm1=1.5 zmm2=2.0 zmm3=1.0; temps zmm4-7; tiny: mem"""
    Ao.w(f'vaddpd {coff}(%[{cptr}]), %%{zr}, %%{zr}')
    Ao.w(f'vaddpd {coff+64}(%[{cptr}]), %%{zi}, %%{zi}')
    Ao.w(f'vbroadcastsd %[tiny], %%zmm4')
    Ao.w(f'vfmadd231pd %%{zi}, %%{zi}, %%zmm4')
    Ao.w(f'vfmadd231pd %%{zr}, %%{zr}, %%zmm4')      # r2
    Ao.w(f'vrsqrt14pd %%zmm4, %%zmm5')               # y0
    Ao.w(f'vmulpd %%zmm0, %%zmm4, %%zmm6')           # h = .5 r2
    Ao.w(f'vmulpd %%zmm5, %%zmm5, %%zmm7')
    Ao.w(f'vfnmadd213pd %%zmm1, %%zmm6, %%zmm7')     # 1.5 - h y^2
    Ao.w(f'vmulpd %%zmm7, %%zmm5, %%zmm5')           # y1
    Ao.w(f'vmulpd %%zmm5, %%zmm5, %%zmm7')
    Ao.w(f'vfnmadd213pd %%zmm1, %%zmm6, %%zmm7')
    Ao.w(f'vmulpd %%zmm7, %%zmm5, %%zmm5')           # y2
    Ao.w(f'vfmadd213pd %%zmm3, %%zmm5, %%zmm4')      # d = r2*y2 + 1
    Ao.w(f'vrcp14pd %%zmm4, %%zmm5')
    Ao.w(f'vmovapd %%zmm4, %%zmm6')
    Ao.w(f'vfnmadd213pd %%zmm2, %%zmm5, %%zmm6')
    Ao.w(f'vmulpd %%zmm6, %%zmm5, %%zmm5')
    Ao.w(f'vmovapd %%zmm4, %%zmm6')
    Ao.w(f'vfnmadd213pd %%zmm2, %%zmm5, %%zmm6')
    Ao.w(f'vmulpd %%zmm6, %%zmm5, %%zmm5')           # r = 1/d
    Ao.w(f'vmulpd %%zmm5, %%{zr}, %%{zr}')
    Ao.w(f'vmulpd %%zmm5, %%{zi}, %%{zi}')
    Ao.w(f'vmovapd %%{zr}, {poff}(%[{optr}])')
    Ao.w(f'vmovapd %%{zi}, {poff+64}(%[{optr}])')

def pencil13(SP, CS, fused, name):
    """h=6: u zmm0-11 (C phase), v zmm12-23 (resident!), x0 zmm24/25, dc->CSCR[6].
       C phase: KB=2, accs 26-29, bcasts 30/31.
       S phase: u dead -> consts zmm0-3, temps 4-7; C loads 8/9; X/Y 10,11,24,25; Sacc 26-29; bc 30/31."""
    L, h = 13, 6
    sp = SP*128; cs = CS*128
    o = A()
    # fold
    o.w('vmovapd (%[p]), %%zmm24')
    o.w('vmovapd 64(%[p]), %%zmm25')
    o.w('vmovapd %%zmm24, %%zmm26')
    o.w('vmovapd %%zmm25, %%zmm27')
    for j in range(1, h+1):
        a = j*sp; b = (L-j)*sp
        o.w(f'vmovapd {a}(%[p]), %%zmm28')
        o.w(f'vmovapd {a+64}(%[p]), %%zmm29')
        o.w(f'vmovapd {b}(%[p]), %%zmm30')
        o.w(f'vmovapd {b+64}(%[p]), %%zmm31')
        o.w(f'vaddpd %%zmm30, %%zmm28, %%zmm{2*(j-1)}')
        o.w(f'vaddpd %%zmm31, %%zmm29, %%zmm{2*(j-1)+1}')
        o.w(f'vsubpd %%zmm30, %%zmm28, %%zmm{12+2*(j-1)}')
        o.w(f'vsubpd %%zmm31, %%zmm29, %%zmm{12+2*(j-1)+1}')
        o.w(f'vaddpd %%zmm{2*(j-1)}, %%zmm26, %%zmm26')
        o.w(f'vaddpd %%zmm{2*(j-1)+1}, %%zmm27, %%zmm27')
    o.w(f'vmovapd %%zmm26, {h*128}(%[cs])')
    o.w(f'vmovapd %%zmm27, {h*128+64}(%[cs])')
    # C phase: 3 blocks of 2, straight-line (no loop: tables as immediates from %[tc])
    CT, ST = tables(13)
    for kb in range(3):
        for dk in range(2):
            o.w(f'vmovapd %%zmm24, %%zmm{26+2*dk}')
            o.w(f'vmovapd %%zmm25, %%zmm{27+2*dk}')
        for j in range(h):
            for dk in range(2):
                k = 2*kb+dk
                off = (k*h + j)*8
                bc = 30+dk
                o.w(f'vbroadcastsd {off}(%[tc]), %%zmm{bc}')
                o.w(f'vfmadd231pd %%zmm{2*j}, %%zmm{bc}, %%zmm{26+2*dk}')
                o.w(f'vfmadd231pd %%zmm{2*j+1}, %%zmm{bc}, %%zmm{27+2*dk}')
        for dk in range(2):
            k = 2*kb+dk
            o.w(f'vmovapd %%zmm{26+2*dk}, {k*128}(%[cs])')
            o.w(f'vmovapd %%zmm{27+2*dk}, {k*128+64}(%[cs])')
    # S phase setup
    if fused:
        o.w('vbroadcastsd %[c05], %%zmm0')
        o.w('vbroadcastsd %[c15], %%zmm1')
        o.w('vbroadcastsd %[c20], %%zmm2')
        o.w('vbroadcastsd %[c10], %%zmm3')
    # S blocks (KB=2), straight-line
    for kb in range(3):
        for dk in range(2):
            k = 2*kb+dk
            bc = 30+dk
            for j in range(h):
                off = (k*h + j)*8
                o.w(f'vbroadcastsd {off}(%[ts]), %%zmm{bc}')
                vr = 12+2*j; vi = 12+2*j+1
                if j == 0:
                    o.w(f'vmulpd %%zmm{bc}, %%zmm{vr}, %%zmm{26+2*dk}')
                    o.w(f'vmulpd %%zmm{bc}, %%zmm{vi}, %%zmm{27+2*dk}')
                else:
                    o.w(f'vfmadd231pd %%zmm{vr}, %%zmm{bc}, %%zmm{26+2*dk}')
                    o.w(f'vfmadd231pd %%zmm{vi}, %%zmm{bc}, %%zmm{27+2*dk}')
        # combine + store/map for the two k's
        for dk in range(2):
            k = 2*kb+dk+1  # 1-based k
            Sr = 26+2*dk; Si = 27+2*dk
            o.w(f'vmovapd {(k-1)*128}(%[cs]), %%zmm8')
            o.w(f'vmovapd {(k-1)*128+64}(%[cs]), %%zmm9')
            o.w(f'vaddpd %%zmm{Si}, %%zmm8, %%zmm10')   # Xr
            o.w(f'vsubpd %%zmm{Sr}, %%zmm9, %%zmm11')   # Xi
            o.w(f'vsubpd %%zmm{Si}, %%zmm8, %%zmm8')    # Yr
            o.w(f'vaddpd %%zmm{Sr}, %%zmm9, %%zmm9')    # Yi
            if fused:
                emit_map(o, 'zmm10', 'zmm11', k*cs, k*sp, 'cp', 'p')
                emit_map(o, 'zmm8', 'zmm9', (L-k)*cs, (L-k)*sp, 'cp', 'p')
            else:
                o.w(f'vmovapd %%zmm10, {k*sp}(%[p])')
                o.w(f'vmovapd %%zmm11, {k*sp+64}(%[p])')
                o.w(f'vmovapd %%zmm8, {(L-k)*sp}(%[p])')
                o.w(f'vmovapd %%zmm9, {(L-k)*sp+64}(%[p])')
    # dc
    o.w(f'vmovapd {h*128}(%[cs]), %%zmm10')
    o.w(f'vmovapd {h*128+64}(%[cs]), %%zmm11')
    if fused:
        emit_map(o, 'zmm10', 'zmm11', 0, 0, 'cp', 'p')
    else:
        o.w('vmovapd %%zmm10, (%[p])')
        o.w('vmovapd %%zmm11, 64(%[p])')
    args = 'double* restrict p'
    ins = '[p] "r" (p), [tc] "r" (PCT_13), [ts] "r" (PST_13), [cs] "r" (CSCR_13)'
    if fused:
        args += ', const double* restrict cp'
