def gen13_asm():
    import genprime3
    parts = [genprime3.emit_tables(13)]
    parts.append('static const double MCONST[8] ALIGN64 = { 0.5, 1.5, 2.0, 1.0, 1e-300, 0, 0, 0 };')
    parts.append('static double CSCR_13[2*7*8] ALIGN64;')
    parts.append(pencil13(13, 0, False, 'b13_y'))
    parts.append(pencil13(1, 0, False, 'b13_z'))
    parts.append(pencil13(169, 169, True, 'b13_x'))
    parts.append('''
static void step13(double* restrict G, const double* restrict C){
    for (int x = 0; x < 13; x++){
        double* base = G + (long)x*169*16;
        for (int z = 0; z < 13; z++) b13_y(base + (long)z*16);
        for (int y = 0; y < 13; y++) b13_z(base + (long)y*13*16);
    }
    for (int p = 0; p < 169; p++){
        b13_x(G + (long)p*16, C + (long)p*16);
    }
}
''')
    parts.append(genprime3.gen_run_soa(13))
    return '\n'.join(parts)
