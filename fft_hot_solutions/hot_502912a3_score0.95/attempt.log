import numpy as np
from glib import tw, hexd

def fold_tab(L):
    """for (j,k) 1..h: coefficient cos(2pi jk/L) = cosv[m-1]; sin(2pi jk/L) = sgn * sinv[m-1]
       where m = fold(jk mod L) into 1..h, sgn = +1 if jk mod L <= h else -1"""
    h = (L-1)//2
    M = {}
    for j in range(1, h+1):
        for k in range(1, h+1):
            r = (j*k) % L
            if r <= h: M[(j,k)] = (r, 1)
            else: M[(j,k)] = (L-r, -1)
    return M

def const_vals(L):
    h = (L-1)//2
    cosv = []; sinv = []
    for m in range(1, h+1):
        c, s = tw(m, L)   # cos(-2pi m/L), sin(-2pi m/L)
        cosv.append(c); sinv.append(-s)   # sin(2pi m/L)
    return cosv, sinv

class A:
    def __init__(self): self.l=[]
    def w(self,s): self.l.append(s)
    def text(self): return '\n'.join(f'        "{x}\\n\\t"' for x in self.l)

def emit_map(o, zr, zi, coff, poff, half_reg, th_reg):
    """consts: half_reg=0.5, th_reg=1.5 in regs; 2.0,1.0,tiny embedded from MCONST. temps zmm TMP0..3 via globals set before call"""
    T0,T1,T2,T3 = emit_map.T
    o.w(f'vaddpd {coff}(%[cp]), %%{zr}, %%{zr}')
    o.w(f'vaddpd {coff+64}(%[cp]), %%{zi}, %%{zi}')
    o.w(f'vbroadcastsd %[tiny], %%{T0}')
    o.w(f'vfmadd231pd %%{zi}, %%{zi}, %%{T0}')
    o.w(f'vfmadd231pd %%{zr}, %%{zr}, %%{T0}')      # r2
    o.w(f'vrsqrt14pd %%{T0}, %%{T1}')               # y0
    o.w(f'vmulpd %%{half_reg}, %%{T0}, %%{T2}')     # h
    o.w(f'vmulpd %%{T1}, %%{T1}, %%{T3}')
    o.w(f'vfnmadd213pd %%{th_reg}, %%{T2}, %%{T3}')
    o.w(f'vmulpd %%{T3}, %%{T1}, %%{T1}')           # y1
    o.w(f'vmulpd %%{T1}, %%{T1}, %%{T3}')
    o.w(f'vfnmadd213pd %%{th_reg}, %%{T2}, %%{T3}')
    o.w(f'vmulpd %%{T3}, %%{T1}, %%{T1}')           # y2
    o.w(f'vfmadd213pd %[c10]{{1to8}}, %%{T1}, %%{T0}')  # d = r2*y2 + 1
    o.w(f'vrcp14pd %%{T0}, %%{T1}')
    o.w(f'vmovapd %%{T0}, %%{T2}')
    o.w(f'vfnmadd213pd %[c20]{{1to8}}, %%{T1}, %%{T2}')
    o.w(f'vmulpd %%{T2}, %%{T1}, %%{T1}')
    o.w(f'vmovapd %%{T0}, %%{T2}')
    o.w(f'vfnmadd213pd %[c20]{{1to8}}, %%{T1}, %%{T2}')
    o.w(f'vmulpd %%{T2}, %%{T1}, %%{T1}')           # r
    o.w(f'vmulpd %%{T1}, %%{zr}, %%{zr}')
    o.w(f'vmulpd %%{T1}, %%{zi}, %%{zi}')
    o.w(f'vmovapd %%{zr}, {poff}(%[p])')
    o.w(f'vmovapd %%{zi}, {poff+64}(%[p])')

def pencil(L, SP, CS, fused, name, KBC, KBS):
    h = (L-1)//2
    sp = SP*128; cs = CS*128
    M = fold_tab(L)
    o = A()
    # ---- register plan (13): u:0-11, v->VSCR, cos:12-17, x0:18/19, Cacc:20-25(KB<=3), tmp ld:26-31
    # generic plan params:
    NU = 2*h
    U = lambda j, im: 2*(j-1) + im           # u regs 0..2h-1
    COS = lambda m: NU + (m-1)               # cos regs 2h .. 2h+h-1
    X0R = NU + h; X0I = NU + h + 1
    CA = NU + h + 2                          # C accs from here (2*KBC regs)
    # check budget
    assert CA + 2*KBC <= 30, (CA, KBC)
    # fold phase: u in regs, v stash, dc acc in CA/CA+1
    o.w('vmovapd (%[p]), %%zmm{}'.format(X0R))
    o.w('vmovapd 64(%[p]), %%zmm{}'.format(X0I))
    o.w(f'vmovapd %%zmm{X0R}, %%zmm{CA}')
    o.w(f'vmovapd %%zmm{X0I}, %%zmm{CA+1}')
    for j in range(1, h+1):
        a = j*sp; b = (L-j)*sp
        o.w(f'vmovapd {a}(%[p]), %%zmm30')
        o.w(f'vmovapd {a+64}(%[p]), %%zmm31')
        o.w(f'vmovapd {b}(%[p]), %%zmm28')
        o.w(f'vmovapd {b+64}(%[p]), %%zmm29')
        o.w(f'vaddpd %%zmm28, %%zmm30, %%zmm{U(j,0)}')
        o.w(f'vaddpd %%zmm29, %%zmm31, %%zmm{U(j,1)}')
        o.w(f'vsubpd %%zmm28, %%zmm30, %%zmm30')
        o.w(f'vsubpd %%zmm29, %%zmm31, %%zmm31')
        o.w(f'vmovapd %%zmm30, {(j-1)*128}(%[vs])')
        o.w(f'vmovapd %%zmm31, {(j-1)*128+64}(%[vs])')
        o.w(f'vaddpd %%zmm{U(j,0)}, %%zmm{CA}, %%zmm{CA}')
        o.w(f'vaddpd %%zmm{U(j,1)}, %%zmm{CA+1}, %%zmm{CA+1}')
    o.w(f'vmovapd %%zmm{CA}, {h*128}(%[cs])')
    o.w(f'vmovapd %%zmm{CA+1}, {h*128+64}(%[cs])')
    # load cos consts
    for m in range(1, h+1):
        o.w(f'vbroadcastsd {8*(m-1)}(%[cv]), %%zmm{COS(m)}')
    # C phase
    k = 1
    while k <= h:
        kb = min(KBC, h-k+1)
        for dk in range(kb):
            o.w(f'vmovapd %%zmm{X0R}, %%zmm{CA+2*dk}')
            o.w(f'vmovapd %%zmm{X0I}, %%zmm{CA+2*dk+1}')
        for j in range(1, h+1):
            for dk in range(kb):
                m, sg = M[(j, k+dk)]
                o.w(f'vfmadd231pd %%zmm{U(j,0)}, %%zmm{COS(m)}, %%zmm{CA+2*dk}')
                o.w(f'vfmadd231pd %%zmm{U(j,1)}, %%zmm{COS(m)}, %%zmm{CA+2*dk+1}')
        for dk in range(kb):
            o.w(f'vmovapd %%zmm{CA+2*dk}, {(k+dk-1)*128}(%[cs])')
            o.w(f'vmovapd %%zmm{CA+2*dk+1}, {(k+dk-1)*128+64}(%[cs])')
        k += kb
    # S phase: reload v into u's regs; sin into cos regs
    for j in range(1, h+1):
        o.w(f'vmovapd {(j-1)*128}(%[vs]), %%zmm{U(j,0)}')
        o.w(f'vmovapd {(j-1)*128+64}(%[vs]), %%zmm{U(j,1)}')
    for m in range(1, h+1):
        o.w(f'vbroadcastsd {8*(m-1)}(%[sv]), %%zmm{COS(m)}')
    if fused:
        # map consts: 0.5 -> X0R reg, 1.5 -> X0I reg (x0 no longer needed)
        o.w(f'vbroadcastsd %[c05], %%zmm{X0R}')
        o.w(f'vbroadcastsd %[c15], %%zmm{X0I}')
        emit_map.T = (f'zmm{CA+2*KBS}', f'zmm{CA+2*KBS+1}', f'zmm{CA+2*KBS+2}', f'zmm{CA+2*KBS+3}')
    k = 1
    while k <= h:
        kb = min(KBS, h-k+1)
        for j in range(1, h+1):
            for dk in range(kb):
                m, sg = M[(j, k+dk)]
                op = 'vfmadd231pd' if sg > 0 else 'vfnmadd231pd'
                if j == 1:
                    # init acc: use mul with sign: emulate with fmadd into zeroed? simpler: mul then possibly negate later... use: acc = u*s (vmulpd) and record sign handled by op for j>=2; for j==1 apply sign by swapping add/sub in combine? no -> do: acc = +/- via vmulpd then if sg<0 we need negative: use vxorpd signmask? Instead: start acc at zero via vpxorq and always fma/fnma.
                    o.w(f'vpxorq %%xmm{CA+2*dk}, %%xmm{CA+2*dk}, %%xmm{CA+2*dk}')
                    o.w(f'vpxorq %%xmm{CA+2*dk+1}, %%xmm{CA+2*dk+1}, %%xmm{CA+2*dk+1}')
                    o.w(f'{op} %%zmm{U(j,0)}, %%zmm{COS(m)}, %%zmm{CA+2*dk}')
                    o.w(f'{op} %%zmm{U(j,1)}, %%zmm{COS(m)}, %%zmm{CA+2*dk+1}')
                else:
                    o.w(f'{op} %%zmm{U(j,0)}, %%zmm{COS(m)}, %%zmm{CA+2*dk}')
                    o.w(f'{op} %%zmm{U(j,1)}, %%zmm{COS(m)}, %%zmm{CA+2*dk+1}')
        for dk in range(kb):
            kk = k+dk
            Sr = CA+2*dk; Si = CA+2*dk+1
            T0 = 30; T1 = 31
            o.w(f'vmovapd {(kk-1)*128}(%[cs]), %%zmm{T0}')     # Cr
            o.w(f'vmovapd {(kk-1)*128+64}(%[cs]), %%zmm{T1}')  # Ci
            # X = (Cr+Si, Ci-Sr), Y = (Cr-Si, Ci+Sr) -> build into 26-29 region? use 28/29 + reuse
            o.w(f'vaddpd %%zmm{Si}, %%zmm{T0}, %%zmm28')
            o.w(f'vsubpd %%zmm{Sr}, %%zmm{T1}, %%zmm29')
            o.w(f'vsubpd %%zmm{Si}, %%zmm{T0}, %%zmm{Sr}')
            o.w(f'vaddpd %%zmm{Sr if False else Sr}, %%zmm{T1}, %%zmm{Si}') # placeholder fixed below
            if fused:
                emit_map(o, 'zmm28', 'zmm29', kk*cs, kk*sp, f'zmm{X0R}', f'zmm{X0I}')
                emit_map(o, f'zmm{Sr}', f'zmm{Si}', (L-kk)*cs, (L-kk)*sp, f'zmm{X0R}', f'zmm{X0I}')
            else:
                o.w(f'vmovapd %%zmm28, {kk*sp}(%[p])')
                o.w(f'vmovapd %%zmm29, {kk*sp+64}(%[p])')
                o.w(f'vmovapd %%zmm{Sr}, {(L-kk)*sp}(%[p])')
                o.w(f'vmovapd %%zmm{Si}, {(L-kk)*sp+64}(%[p])')
