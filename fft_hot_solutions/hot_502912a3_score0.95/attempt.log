import numpy as np
from glib import Emit, tw, hexd

def table(L):
    """cos/sin tables: CT[j-1][k-1], ST[j-1][k-1] for j,k=1..h of cos(2pi jk/L), sin: -sin? define:
       W^{jk} = cos - i sin with s_{jk} = sin(2pi jk/L), X_k = x0 + sum_j u_j cos_{jk} - i sum_j v_j sin_{jk}"""
    h = (L-1)//2
    C = [[0.0]*h for _ in range(h)]
    S = [[0.0]*h for _ in range(h)]
    for j in range(1, h+1):
        for k in range(1, h+1):
            c, s = tw(j*k, L)  # cos(-2pi jk/L), sin(-2pi jk/L)
            C[j-1][k-1] = c
            S[j-1][k-1] = -s   # s_{jk} = sin(+2pi jk/L)
    return C, S

def emit_tables(L):
    C, S = table(L)
    h = (L-1)//2
    flat_c = [C[j][k] for j in range(h) for k in range(h)]
    flat_s = [S[j][k] for j in range(h) for k in range(h)]
    lines = []
    lines.append(f'static const double PCT_{L}[{h*h}] ALIGN64 = {{ ' + ', '.join(hexd(x) for x in flat_c) + ' };')
    lines.append(f'static const double PST_{L}[{h*h}] ALIGN64 = {{ ' + ', '.join(hexd(x) for x in flat_s) + ' };')
    return '\n'.join(lines)

def gen_pencil_13(fused_map):
    """L=13 fully register resident pencil: p = base pointer (doubles), S = stride in slot-pairs (compile const).
       If fused_map: add c (pointer cp, contiguous-by-k? -> use stride CS slot-pairs) and apply map, in-place store."""
    L, h = 13, 6
    e = Emit()
    # loads + folds + dc
    e.w('__m512d x0r = _mm512_load_pd(p + 0), x0i = _mm512_load_pd(p + 8);')
    e.w('__m512d dcr = x0r, dci = x0i;')
    for j in range(1, h+1):
        e.w(f'{{ __m512d ar = _mm512_load_pd(p + {j}*SP*16), ai = _mm512_load_pd(p + {j}*SP*16 + 8);')
        e.w(f'  __m512d br = _mm512_load_pd(p + {L-j}*SP*16), bi = _mm512_load_pd(p + {L-j}*SP*16 + 8);')
        e.w(f'  u{j}r = _mm512_add_pd(ar, br); u{j}i = _mm512_add_pd(ai, bi);')
        e.w(f'  v{j}r = _mm512_sub_pd(ar, br); v{j}i = _mm512_sub_pd(ai, bi);')
        e.w(f'  dcr = _mm512_add_pd(dcr, u{j}r); dci = _mm512_add_pd(dci, u{j}i); }}')
    # dc out (slot 0)
    if fused_map:
        e.w('MAPSTORE(p + 0, dcr, dci, cp + 0, cp + 8);')
    else:
        e.w('_mm512_store_pd(p + 0, dcr); _mm512_store_pd(p + 8, dci);')
    # k loop, KB=1
    for k in range(1, h+1):
        e.w(f'{{ // k={k}')
        first = True
        for j in range(1, h+1):
            cc = f'_mm512_set1_pd(PCT_13[{(j-1)*h + (k-1)}])'
            ss = f'_mm512_set1_pd(PST_13[{(j-1)*h + (k-1)}])'
            if first:
                e.w(f'  __m512d Cr = _mm512_fmadd_pd(u{j}r, {cc}, x0r);')
                e.w(f'  __m512d Ci = _mm512_fmadd_pd(u{j}i, {cc}, x0i);')
                e.w(f'  __m512d Sr = _mm512_mul_pd(v{j}r, {ss});')
                e.w(f'  __m512d Si = _mm512_mul_pd(v{j}i, {ss});')
                first = False
            else:
                e.w(f'  Cr = _mm512_fmadd_pd(u{j}r, {cc}, Cr);')
                e.w(f'  Ci = _mm512_fmadd_pd(u{j}i, {cc}, Ci);')
                e.w(f'  Sr = _mm512_fmadd_pd(v{j}r, {ss}, Sr);')
                e.w(f'  Si = _mm512_fmadd_pd(v{j}i, {ss}, Si);')
        # X_k = (Cr + Si, Ci - Sr); X_{L-k} = (Cr - Si, Ci + Sr)
        e.w(f'  __m512d Xkr = _mm512_add_pd(Cr, Si), Xki = _mm512_sub_pd(Ci, Sr);')
        e.w(f'  __m512d Ykr = _mm512_sub_pd(Cr, Si), Yki = _mm512_add_pd(Ci, Sr);')
        if fused_map:
            e.w(f'  MAPSTORE(p + {k}*SP*16, Xkr, Xki, cp + {k}*CS*16, cp + {k}*CS*16 + 8);')
            e.w(f'  MAPSTORE(p + {L-k}*SP*16, Ykr, Yki, cp + {L-k}*CS*16, cp + {L-k}*CS*16 + 8);')
        else:
            e.w(f'  _mm512_store_pd(p + {k}*SP*16, Xkr); _mm512_store_pd(p + {k}*SP*16 + 8, Xki);')
            e.w(f'  _mm512_store_pd(p + {L-k}*SP*16, Ykr); _mm512_store_pd(p + {L-k}*SP*16 + 8, Yki);')
        e.w('}')
    body = e.code(1)
    decl = '    __m512d ' + ', '.join(f'u{j}r, u{j}i, v{j}r, v{j}i' for j in range(1,h+1)) + ';'
    return decl + '\n' + body

MAP_MACRO = r'''
#define MAPSTORE(addr, zr_, zi_, car, cai) do{ \
    __m512d _zr = _mm512_add_pd(zr_, _mm512_load_pd(car)); \
    __m512d _zi = _mm512_add_pd(zi_, _mm512_load_pd(cai)); \
    __m512d _r2 = _mm512_fmadd_pd(_zr,_zr,_mm512_fmadd_pd(_zi,_zi,_mm512_set1_pd(MYTINY))); \
    __m512d _d = _mm512_add_pd(_mm512_set1_pd(1.0), _mm512_sqrt_pd(_r2)); \
    _mm512_store_pd(addr, _mm512_div_pd(_zr, _d)); \
    _mm512_store_pd((addr)+8, _mm512_div_pd(_zi, _d)); \
}while(0)
'''

def gen_13():
    L = 13; L2 = L*L; V = L2*L
    parts = [emit_tables(13), MAP_MACRO]
    # pencil functions: plain (SP param), fused (SP, CS)
    plain = gen_pencil_13(False)
    fused = gen_pencil_13(True)
    parts.append(f'''
static inline __attribute__((always_inline)) void p13_plain(double* restrict p, const long SP){{
{plain}
}}
static inline __attribute__((always_inline)) void p13_fused(double* restrict p, const double* restrict cp, const long SP, const long CS){{
{fused}
}}
static void step13(double* restrict G, const double* restrict C){{
    /* sweep A: per x-plane: Y pass then Z pass */
    for (int x = 0; x < {L}; x++){{
        double* base = G + (long)x*{L2}*16;
        for (int z = 0; z < {L}; z++) p13_plain(base + (long)z*16, {L});
        for (int y = 0; y < {L}; y++) p13_plain(base + (long)y*{L}*16, 1);
    }}
    /* sweep B: X pass + c + map */
    for (int p = 0; p < {L2}; p++){{
        p13_fused(G + (long)p*16, C + (long)p*16, {L2}, {L2});
    }}
}}
''')
    return '\n'.join(parts)

if __name__ == '__main__':
    print(gen_13())
