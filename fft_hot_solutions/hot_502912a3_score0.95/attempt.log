import sys, importlib, numpy as np
sys.path.insert(0, '/workdir')
import base
import solution
SIZES=(6,8,13,17,23,36,45,64)
TOL={6:1e-4,8:3e-6,13:1e-9,17:1e-10,23:1e-10,36:1e-10,45:1e-10,64:1e-10}
def check(W, tag):
    a = solution.transform(**W)
    b = base.transform(**W)
    assert a.shape==b.shape and a.dtype==np.complex128
    off=0; worst=[]
    for L in SIZES:
        B=W[f'B{L}']; n=B*L**3
        e1=np.linalg.norm(a[off:off+n]-b[off:off+n])/max(1e-300,np.linalg.norm(b[off:off+n])); off+=n
        em=np.linalg.norm(a[off:off+n]-b[off:off+n])/max(1e-300,np.linalg.norm(b[off:off+n])); off+=n
        ok = (e1<1e-14 or B==0) and (em<TOL[L] or B==0)
        worst.append((L,e1,em,ok))
        if not ok:
            print(f'FAIL {tag} L={L} e1={e1:.3e} em={em:.3e}')
            return False
    print(f'OK {tag}: max e1={max(w[1] for w in worst):.2e} max em={max(w[2] for w in worst):.2e}')
    return True

allok = True
# battery: odd/even m, tiny B, B%8 cases, m=1
batteries = [
  dict(seed=1, B6=1,B8=1,B13=1,B17=1,B23=1,B36=1,B45=1,B64=1, m6=1,m8=1,m13=1,m17=1,m23=1,m36=1,m45=1,m64=1),
