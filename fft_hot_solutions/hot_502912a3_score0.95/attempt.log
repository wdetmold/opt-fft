import numpy as np
from glib import Emit, tw, hexd
from genprime2 import MAP_MACRO

def emit_tables(L):
    h = (L-1)//2
    C = np.zeros((h,h)); S = np.zeros((h,h))
    for j in range(1, h+1):
        for k in range(1, h+1):
            c, s = tw(j*k, L)
            C[j-1,k-1] = c; S[j-1,k-1] = -s
    flat_c = [C[j,k] for k in range(h) for j in range(h)]
    flat_s = [S[j,k] for k in range(h) for j in range(h)]
    out = []
    out.append(f'static const double PCT_{L}[{h*h}] ALIGN64 = {{ ' + ', '.join(hexd(x) for x in flat_c) + ' };')
    out.append(f'static const double PST_{L}[{h*h}] ALIGN64 = {{ ' + ', '.join(hexd(x) for x in flat_s) + ' };')
    return '\n'.join(out)

def gen_pencil(L, fused, name, KBC, KBS):
    """Two-phase pencil with k-blocked accumulator phases.
       Phase F: load x_j, fold u (resident), v -> scratch; dc.
       Phase C: for k-blocks (size KBC): C_k = x0 + sum_j u_j * cos[j][k] -> scratch.
       Phase S: reload v (resident); for k-blocks (KBS): S_k; combine with C from scratch; store/map."""
    h = (L-1)//2
    e = Emit()
    args = 'double* restrict p, const long SP' + (', const double* restrict cp, const long CS' if fused else '')
    e.w(f'static inline __attribute__((always_inline)) void {name}({args}){{')
    e.w('    __m512d ' + ', '.join(f'u{j}r, u{j}i' for j in range(1,h+1)) + ';')
    e.w('    __m512d x0r = _mm512_load_pd(p + 0), x0i = _mm512_load_pd(p + 8);')
    e.w('    __m512d dcr = x0r, dci = x0i;')
    for j in range(1, h+1):
        e.w(f'    {{ __m512d ar = _mm512_load_pd(p + {j}*SP*16), ai = _mm512_load_pd(p + {j}*SP*16 + 8);')
        e.w(f'      __m512d br = _mm512_load_pd(p + {L-j}*SP*16), bi = _mm512_load_pd(p + {L-j}*SP*16 + 8);')
        e.w(f'      u{j}r = _mm512_add_pd(ar, br); u{j}i = _mm512_add_pd(ai, bi);')
        e.w(f'      _mm512_store_pd(VSCR + {2*(j-1)}*8, _mm512_sub_pd(ar, br));')
        e.w(f'      _mm512_store_pd(VSCR + {2*(j-1)+1}*8, _mm512_sub_pd(ai, bi));')
        e.w(f'      dcr = _mm512_add_pd(dcr, u{j}r); dci = _mm512_add_pd(dci, u{j}i); }}')
    if fused:
        e.w('    MAPSTORE(p + 0, dcr, dci, cp + 0, cp + 8);')
    else:
        e.w('    _mm512_store_pd(p + 0, dcr); _mm512_store_pd(p + 8, dci);')
    # phase C: straight-line k-blocks
    k = 1
    while k <= h:
        kb = min(KBC, h-k+1)
        e.w(f'    {{ /* C phase k={k}..{k+kb-1} */')
        for dk in range(kb):
            e.w(f'      __m512d C{dk}r = x0r, C{dk}i = x0i;')
        for j in range(1, h+1):
            for dk in range(kb):
                kk = k+dk
                cc = f'_mm512_set1_pd(PCT_{L}[{(kk-1)*h + (j-1)}])'
                e.w(f'      {{ __m512d b = {cc}; C{dk}r = _mm512_fmadd_pd(u{j}r, b, C{dk}r); C{dk}i = _mm512_fmadd_pd(u{j}i, b, C{dk}i); }}')
        for dk in range(kb):
            e.w(f'      _mm512_store_pd(CSCR + {2*(k+dk-1)}*8, C{dk}r); _mm512_store_pd(CSCR + {2*(k+dk-1)+1}*8, C{dk}i);')
        e.w('    }')
        k += kb
    # reload v
    e.w('    __m512d ' + ', '.join(f'v{j}r, v{j}i' for j in range(1,h+1)) + ';')
    for j in range(1, h+1):
        e.w(f'    v{j}r = _mm512_load_pd(VSCR + {2*(j-1)}*8); v{j}i = _mm512_load_pd(VSCR + {2*(j-1)+1}*8);')
    k = 1
    while k <= h:
        kb = min(KBS, h-k+1)
        e.w(f'    {{ /* S phase k={k}..{k+kb-1} */')
        for dk in range(kb):
            e.w(f'      __m512d S{dk}r, S{dk}i;')
        for j in range(1, h+1):
            for dk in range(kb):
                kk = k+dk
                ss = f'_mm512_set1_pd(PST_{L}[{(kk-1)*h + (j-1)}])'
                if j == 1:
                    e.w(f'      {{ __m512d b = {ss}; S{dk}r = _mm512_mul_pd(v1r, b); S{dk}i = _mm512_mul_pd(v1i, b); }}')
                else:
                    e.w(f'      {{ __m512d b = {ss}; S{dk}r = _mm512_fmadd_pd(v{j}r, b, S{dk}r); S{dk}i = _mm512_fmadd_pd(v{j}i, b, S{dk}i); }}')
        for dk in range(kb):
            kk = k+dk
            e.w(f'      {{ __m512d Cr = _mm512_load_pd(CSCR + {2*(kk-1)}*8), Ci = _mm512_load_pd(CSCR + {2*(kk-1)+1}*8);')
            e.w(f'        __m512d Xr = _mm512_add_pd(Cr, S{dk}i), Xi = _mm512_sub_pd(Ci, S{dk}r);')
            e.w(f'        __m512d Yr = _mm512_sub_pd(Cr, S{dk}i), Yi = _mm512_add_pd(Ci, S{dk}r);')
            if fused:
                e.w(f'        MAPSTORE(p + {kk}*SP*16, Xr, Xi, cp + {kk}*CS*16, cp + {kk}*CS*16 + 8);')
                e.w(f'        MAPSTORE(p + {L-kk}*SP*16, Yr, Yi, cp + {L-kk}*CS*16, cp + {L-kk}*CS*16 + 8);')
            else:
                e.w(f'        _mm512_store_pd(p + {kk}*SP*16, Xr); _mm512_store_pd(p + {kk}*SP*16 + 8, Xi);')
                e.w(f'        _mm512_store_pd(p + {L-kk}*SP*16, Yr); _mm512_store_pd(p + {L-kk}*SP*16 + 8, Yi);')
            e.w('      }')
        e.w('    }')
        k += kb
    e.w('}')
    return '\n'.join(e.lines)

def gen_prime_soa(L, KBC, KBS):
    h = (L-1)//2
    L2 = L*L; V = L2*L
    parts = [emit_tables(L), MAP_MACRO]
    parts.append(f'static double VSCR[{2*h*8}] ALIGN64;\nstatic double CSCR[{2*h*8}] ALIGN64;')
    parts.append(gen_pencil(L, False, f'p{L}_plain', KBC, KBS))
    parts.append(gen_pencil(L, True, f'p{L}_fused', KBC, KBS))
    parts.append(f'''
static void step{L}(double* restrict G, const double* restrict C){{
    for (int x = 0; x < {L}; x++){{
        double* base = G + (long)x*{L2}*16;
        for (int z = 0; z < {L}; z++) p{L}_plain(base + (long)z*16, {L});
        for (int y = 0; y < {L}; y++) p{L}_plain(base + (long)y*{L}*16, 1);
    }}
    for (int p = 0; p < {L2}; p++){{
        p{L}_fused(G + (long)p*16, {L2}, C + (long)p*16, {L2});
    }}
}}
''')
    parts.append(gen_run_soa(L))
    return '\n'.join(parts)

def gen_run_soa(L):
    V = L*L*L
    return f'''
static double* G_{L} = 0;
static double* C_{L} = 0;
void run_{L}(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    if (B < 6) {{ w00_run_{L}(x0, c, out1, outm, B, m); return; }}
    if (!G_{L}) {{ G_{L} = myk_alloc(({V}*16 + 64)*8 + 4096); C_{L} = myk_alloc(({V}*16 + 64)*8 + 4096); C_{L} += 136; }}
    double* G = G_{L}; double* C = C_{L};
    const double* src[8]; double* dst[8];
    for (long g0 = 0; g0 < B; g0 += 8) {{
        int nv = (int)(B - g0 < 8 ? B - g0 : 8);
        for (int i = 0; i < 8; i++) src[i] = x0 + (g0 + (i < nv ? i : 0))*{V}*2;
        soaconv_in_{L}(src, nv, G);
        for (int i = 0; i < 8; i++) src[i] = c + (g0 + (i < nv ? i : 0))*{V}*2;
        soaconv_in_{L}(src, nv, C);
        for (long s = 0; s < m; s++) {{
            step{L}(G, C);
            if (s == 0) {{
                for (int i = 0; i < 8; i++) dst[i] = out1 + (g0 + (i < nv ? i : 0))*{V}*2;
                soaconv_out_{L}(G, dst, nv);
            }}
        }}
        for (int i = 0; i < 8; i++) dst[i] = outm + (g0 + (i < nv ? i : 0))*{V}*2;
        soaconv_out_{L}(G, dst, nv);
    }}
}}
'''
EOF
