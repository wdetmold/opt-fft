        t0=time.perf_counter(); f(x0.ctypes.data,c.ctypes.data,one.ctypes.data,fin.ctypes.data,B,m); t1=time.perf_counter()
        best=min(best,t1-t0)
    print(f'L={L} B={B:4d} m={m}: {best/(B*m*L**3)*1e9:.3f} ns/el-step')
