# Large-scale correctness: bigger workload, longer chains, odd shapes
import sys, numpy as np
sys.path.insert(0,'/workdir')
import base, solution
SIZES=(6,8,13,17,23,36,45,64)
TOL={6:1e-4,8:3e-6,13:1e-9,17:1e-10,23:1e-10,36:1e-10,45:1e-10,64:1e-10}
W = dict(seed=31415926, B6=61,B8=37,B13=23,B17=19,B23=13,B36=7,B45=5,B64=3,
         m6=151,m8=122,m13=77,m17=63,m23=48,m36=33,m45=27,m64=19)
a = solution.transform(**W); b = base.transform(**W)
off=0; ok=True
for L in SIZES:
    B=W[f'B{L}']; n=B*L**3
    e1=np.linalg.norm(a[off:off+n]-b[off:off+n])/np.linalg.norm(b[off:off+n]); off+=n
    em=np.linalg.norm(a[off:off+n]-b[off:off+n])/np.linalg.norm(b[off:off+n]); off+=n
    flag = 'OK' if e1<1e-14 and em<TOL[L] else 'FAIL'
    ok &= (flag=='OK')
    print(f'L={L:3d} one-step {e1:.2e} m-step {em:.2e} {flag}')
print('FINAL VERIFY', 'PASS' if ok else 'FAIL')
EOF
python3 finalverify.py</antml:parameter>
</antml:invoke>
