import genprime3, glib
from genprime2 import MAP_MACRO

def gen_23():
    L = 23
    ROWP = 3      # pairs per row: 24 slots (23 + 1 pad lane)
    PLROWS = 25   # 23 rows + 1 pad row (strips need 24) + 1 alias pad
    PLP = PLROWS*ROWP  # 75 pairs per plane
    VOLP = 23*PLP
    h = 11
    parts = [genprime3.emit_tables(23), MAP_MACRO]
    parts.append(f'static double VSCR_23[{2*h*8}] ALIGN64;\nstatic double CSCR_23[{2*h*8}] ALIGN64;')
    parts.append(f'static double TSCR23[{2*24*8 + 16}] ALIGN64;')
    parts.append(genprime3.gen_pencil(23, False, 'p23_plain', 3, 3))
    parts.append(genprime3.gen_pencil(23, True, 'p23_fused', 3, 3))
    # strip transpose: 8 rows x 3 zv
    tr_in = []
    tr_out = []
    for half in (0, 8):
        for zv in range(3):
            tr_in.append(f'''
        {{ __m512d r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7;
        r0=_mm512_load_pd(base + 0*{ROWP}*16 + {zv}*16 + {half}); r1=_mm512_load_pd(base + 1*{ROWP}*16 + {zv}*16 + {half});
        r2=_mm512_load_pd(base + 2*{ROWP}*16 + {zv}*16 + {half}); r3=_mm512_load_pd(base + 3*{ROWP}*16 + {zv}*16 + {half});
        r4=_mm512_load_pd(base + 4*{ROWP}*16 + {zv}*16 + {half}); r5=_mm512_load_pd(base + 5*{ROWP}*16 + {zv}*16 + {half});
        r6=_mm512_load_pd(base + 6*{ROWP}*16 + {zv}*16 + {half}); r7=_mm512_load_pd(base + 7*{ROWP}*16 + {zv}*16 + {half});
        MTR8(r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7);
        _mm512_store_pd(TSCR23 + ({zv}*8+0)*16 + {half}, o0); _mm512_store_pd(TSCR23 + ({zv}*8+1)*16 + {half}, o1);
        _mm512_store_pd(TSCR23 + ({zv}*8+2)*16 + {half}, o2); _mm512_store_pd(TSCR23 + ({zv}*8+3)*16 + {half}, o3);
        _mm512_store_pd(TSCR23 + ({zv}*8+4)*16 + {half}, o4); _mm512_store_pd(TSCR23 + ({zv}*8+5)*16 + {half}, o5);
        _mm512_store_pd(TSCR23 + ({zv}*8+6)*16 + {half}, o6); _mm512_store_pd(TSCR23 + ({zv}*8+7)*16 + {half}, o7); }}''')
            tr_out.append(f'''
        {{ __m512d r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7;
        r0=_mm512_load_pd(TSCR23 + ({zv}*8+0)*16 + {half}); r1=_mm512_load_pd(TSCR23 + ({zv}*8+1)*16 + {half});
        r2=_mm512_load_pd(TSCR23 + ({zv}*8+2)*16 + {half}); r3=_mm512_load_pd(TSCR23 + ({zv}*8+3)*16 + {half});
        r4=_mm512_load_pd(TSCR23 + ({zv}*8+4)*16 + {half}); r5=_mm512_load_pd(TSCR23 + ({zv}*8+5)*16 + {half});
        r6=_mm512_load_pd(TSCR23 + ({zv}*8+6)*16 + {half}); r7=_mm512_load_pd(TSCR23 + ({zv}*8+7)*16 + {half});
        MTR8(r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7);
        _mm512_store_pd(base + 0*{ROWP}*16 + {zv}*16 + {half}, o0); _mm512_store_pd(base + 1*{ROWP}*16 + {zv}*16 + {half}, o1);
        _mm512_store_pd(base + 2*{ROWP}*16 + {zv}*16 + {half}, o2); _mm512_store_pd(base + 3*{ROWP}*16 + {zv}*16 + {half}, o3);
        _mm512_store_pd(base + 4*{ROWP}*16 + {zv}*16 + {half}, o4); _mm512_store_pd(base + 5*{ROWP}*16 + {zv}*16 + {half}, o5);
        _mm512_store_pd(base + 6*{ROWP}*16 + {zv}*16 + {half}, o6); _mm512_store_pd(base + 7*{ROWP}*16 + {zv}*16 + {half}, o7); }}''')
    parts.append(f'''
static void z23_strip(double* restrict base){{
    {''.join(tr_in)}
    p23_plain(TSCR23, 1);
    {''.join(tr_out)}
}}
static void step23(double* restrict G, const double* restrict Cv){{
    for (int x = 0; x < 23; x++){{
        double* base = G + (long)x*{PLP}*16;
        for (int zv = 0; zv < 3; zv++) p23_plain(base + zv*16, {ROWP});
        for (int s = 0; s < 3; s++) z23_strip(base + (long)s*8*{ROWP}*16);
    }}
    for (int q = 0; q < 69; q++){{
        p23_fused(G + (long)q*16, {PLP}, Cv + (long)q*16, {PLP});
    }}
}}
static void conv23_in(const double* restrict src, double* restrict G){{
    __m512i idr = _mm512_load_si512(DEIDX_RE), idi = _mm512_load_si512(DEIDX_IM);
    for (int x = 0; x < 23; x++){{
        for (int y = 0; y < 23; y++){{
            const double* s = src + ((long)x*529 + (long)y*23)*2;
            double* g = G + ((long)x*{PLP} + (long)y*{ROWP})*16;
            {{ __m512d A = _mm512_loadu_pd(s);      __m512d B = _mm512_loadu_pd(s + 8);
              _mm512_store_pd(g, _mm512_permutex2var_pd(A, idr, B));
              _mm512_store_pd(g + 8, _mm512_permutex2var_pd(A, idi, B)); }}
            {{ __m512d A = _mm512_loadu_pd(s + 16); __m512d B = _mm512_loadu_pd(s + 24);
              _mm512_store_pd(g + 16, _mm512_permutex2var_pd(A, idr, B));
              _mm512_store_pd(g + 24, _mm512_permutex2var_pd(A, idi, B)); }}
            {{ __m512d A = _mm512_loadu_pd(s + 32); __m512d B = _mm512_maskz_loadu_pd(0x3f, s + 40);
              _mm512_store_pd(g + 32, _mm512_maskz_permutex2var_pd(0x7f, A, idr, B));
              _mm512_store_pd(g + 40, _mm512_maskz_permutex2var_pd(0x7f, A, idi, B)); }}
        }}
    }}
}}
static void conv23_out(const double* restrict G, double* restrict dst){{
    __m512i ilo = _mm512_load_si512(INIDX_LO), ihi = _mm512_load_si512(INIDX_HI);
    for (int x = 0; x < 23; x++){{
        for (int y = 0; y < 23; y++){{
            const double* g = G + ((long)x*{PLP} + (long)y*{ROWP})*16;
            double* d = dst + ((long)x*529 + (long)y*23)*2;
            for (int zv = 0; zv < 2; zv++){{
                __m512d re = _mm512_load_pd(g + zv*16);
                __m512d im = _mm512_load_pd(g + zv*16 + 8);
                _mm512_storeu_pd(d + zv*16, _mm512_permutex2var_pd(re, ilo, im));
                _mm512_storeu_pd(d + zv*16 + 8, _mm512_permutex2var_pd(re, ihi, im));
            }}
            {{ __m512d re = _mm512_load_pd(g + 32);
