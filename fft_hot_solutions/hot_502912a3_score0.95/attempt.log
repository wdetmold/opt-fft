import sys, time, importlib, numpy as np
sys.path.insert(0, '/workdir')
import base

def run_check(modpath, W, quick=False):
    sys.path.insert(0, modpath)
    if 'solution' in sys.modules: del sys.modules['solution']
    sol = importlib.import_module('solution')
    a = sol.transform(**W)
    b = base.transform(**W)
    assert a.shape==b.shape and a.dtype==np.complex128, (a.shape, b.shape, a.dtype)
    # per-block errors
    SIZES=(6,8,13,17,23,36,45,64)
    Bs=[W[f'B{L}'] for L in SIZES]
    off=0; ok=True
    for L,B in zip(SIZES,Bs):
        n=B*L**3
        e1=np.linalg.norm(a[off:off+n]-b[off:off+n])/max(1e-300,np.linalg.norm(b[off:off+n])); off+=n
        em=np.linalg.norm(a[off:off+n]-b[off:off+n])/max(1e-300,np.linalg.norm(b[off:off+n])); off+=n
        tol={6:1e-4,8:3e-6,13:1e-9,17:1e-10,23:1e-10,36:1e-10,45:1e-10,64:1e-10}[L]
        flag = "OK" if (e1<1e-14 and em<tol) else "FAIL"
        if flag=="FAIL": ok=False
        print(f"  L={L:3d} one-step {e1:.2e} (<1e-14) m-step {em:.2e} (<{tol:g}) {flag}")
    sys.path.pop(0)
    return ok

W = dict(seed=421, B6=21, B8=19, B13=11, B17=9, B23=7, B36=5, B45=3, B64=2,
         m6=50, m8=40, m13=30, m17=25, m23=20, m36=15, m45=12, m64=10)
ok = run_check(sys.argv[1], W)
print("ALL OK" if ok else "FAILURES")
EOF
python3 check.py /tmp/cand/w00</antml:parameter>
