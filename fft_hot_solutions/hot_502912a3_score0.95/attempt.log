361's README hints the divider can take HALF the reciprocals while FMA pipes do the rest. Testing alternating div/Newton map:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/mb && cat > mbmap5.c <<'EOF'
#include <immintrin.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
static double now(){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
#define ALIGN64 __attribute__((aligned(64)))
static double Z[72*8] ALIGN64, C[72*8] ALIGN64, O[72*8] ALIGN64;
// variant: even slots use vdivpd for 1/d, odd slots use rcp14+2N
__attribute__((noinline)) void mapalt(){
    __m512d half=_mm512_set1_pd(0.5), th=_mm512_set1_pd(1.5), two=_mm512_set1_pd(2.0), one=_mm512_set1_pd(1.0), tiny=_mm512_set1_pd(1e-300);
    for (int q = 0; q < 36; q += 2){
        // pair A (divider)
        __m512d zrA = _mm512_add_pd(_mm512_load_pd(Z + 16*q), _mm512_load_pd(C + 16*q));
        __m512d ziA = _mm512_add_pd(_mm512_load_pd(Z + 16*q + 8), _mm512_load_pd(C + 16*q + 8));
        __m512d r2A = _mm512_fmadd_pd(zrA,zrA,_mm512_fmadd_pd(ziA,ziA,tiny));
        __m512d y0A = _mm512_rsqrt14_pd(r2A);
        __m512d hA = _mm512_mul_pd(r2A, half);
        __m512d wA = _mm512_fnmadd_pd(hA, _mm512_mul_pd(y0A,y0A), th);
        __m512d y1A = _mm512_mul_pd(y0A,wA);
        wA = _mm512_fnmadd_pd(hA, _mm512_mul_pd(y1A,y1A), th);
        __m512d y2A = _mm512_mul_pd(y1A,wA);
        __m512d dA = _mm512_fmadd_pd(r2A, y2A, one);
        __m512d gA = _mm512_div_pd(one, dA);
        // pair B (Newton rcp)
        __m512d zrB = _mm512_add_pd(_mm512_load_pd(Z + 16*q + 16), _mm512_load_pd(C + 16*q + 16));
        __m512d ziB = _mm512_add_pd(_mm512_load_pd(Z + 16*q + 24), _mm512_load_pd(C + 16*q + 24));
        __m512d r2B = _mm512_fmadd_pd(zrB,zrB,_mm512_fmadd_pd(ziB,ziB,tiny));
        __m512d y0B = _mm512_rsqrt14_pd(r2B);
        __m512d hB = _mm512_mul_pd(r2B, half);
        __m512d wB = _mm512_fnmadd_pd(hB, _mm512_mul_pd(y0B,y0B), th);
        __m512d y1B = _mm512_mul_pd(y0B,wB);
        wB = _mm512_fnmadd_pd(hB, _mm512_mul_pd(y1B,y1B), th);
        __m512d y2B = _mm512_mul_pd(y1B,wB);
        __m512d dB = _mm512_fmadd_pd(r2B, y2B, one);
        __m512d gB = _mm512_rcp14_pd(dB);
        gB = _mm512_mul_pd(gB, _mm512_fnmadd_pd(dB,gB,two));
        gB = _mm512_mul_pd(gB, _mm512_fnmadd_pd(dB,gB,two));
        _mm512_store_pd(O + 16*q, _mm512_mul_pd(zrA, gA));
        _mm512_store_pd(O + 16*q + 8, _mm512_mul_pd(ziA, gA));
        _mm512_store_pd(O + 16*q + 16, _mm512_mul_pd(zrB, gB));
        _mm512_store_pd(O + 16*q + 24, _mm512_mul_pd(ziB, gB));
    }
}
// variant: ALL divider for recip
__attribute__((noinline)) void mapdivr(){
    __m512d half=_mm512_set1_pd(0.5), th=_mm512_set1_pd(1.5), one=_mm512_set1_pd(1.0), tiny=_mm512_set1_pd(1e-300);
    for (int q = 0; q < 36; q++){
        __m512d zr = _mm512_add_pd(_mm512_load_pd(Z + 16*q), _mm512_load_pd(C + 16*q));
        __m512d zi = _mm512_add_pd(_mm512_load_pd(Z + 16*q + 8), _mm512_load_pd(C + 16*q + 8));
        __m512d r2 = _mm512_fmadd_pd(zr,zr,_mm512_fmadd_pd(zi,zi,tiny));
        __m512d y0 = _mm512_rsqrt14_pd(r2);
        __m512d h = _mm512_mul_pd(r2, half);
        __m512d w = _mm512_fnmadd_pd(h, _mm512_mul_pd(y0,y0), th);
        __m512d y1 = _mm512_mul_pd(y0,w);
        w = _mm512_fnmadd_pd(h, _mm512_mul_pd(y1,y1), th);
        __m512d y2 = _mm512_mul_pd(y1,w);
        __m512d d = _mm512_fmadd_pd(r2, y2, one);
        __m512d g = _mm512_div_pd(one, d);
        _mm512_store_pd(O + 16*q, _mm512_mul_pd(zr, g));
        _mm512_store_pd(O + 16*q + 8, _mm512_mul_pd(zi, g));
    }
}
int main(){
    srand(3);
    for(int i=0;i<72*8;i++){ Z[i]=(rand()%2000-1000)/300.0; C[i]=(rand()%200-100)/1000.0; }
    long R=400000;
    mapalt(); mapdivr();
    double t0=now(); for(long r=0;r<R;r++) mapalt(); double t1=now();
    printf("map alternating: %.2f cyc/pair\n",(t1-t0)/R/36*3.1e9);
    t0=now(); for(long r=0;r<R;r++) mapdivr(); t1=now();
    printf("map all-div-recip: %.2f cyc/pair\n",(t1-t0)/R/36*3.1e9);
    return 0;
}
EOF
