src = open('genprime3.py').read()
# replace gen_pencil with runtime k-block loops version
i0 = src.index('def gen_pencil(')
i1 = src.index('def gen_prime_soa(')
new_fn = '''def gen_pencil(L, fused, name, KBC, KBS):
    h = (L-1)//2
    e = Emit()
    args = 'double* restrict p, const long SP' + (', const double* restrict cp, const long CS' if fused else '')
    e.w(f'static inline __attribute__((always_inline)) void {name}({args}){{')
    e.w('    __m512d ' + ', '.join(f'u{j}r, u{j}i' for j in range(1,h+1)) + ';')
    e.w('    __m512d x0r = _mm512_load_pd(p + 0), x0i = _mm512_load_pd(p + 8);')
    e.w('    __m512d dcr = x0r, dci = x0i;')
    for j in range(1, h+1):
        e.w(f'    {{ __m512d ar = _mm512_load_pd(p + {j}*SP*16), ai = _mm512_load_pd(p + {j}*SP*16 + 8);')
        e.w(f'      __m512d br = _mm512_load_pd(p + {L-j}*SP*16), bi = _mm512_load_pd(p + {L-j}*SP*16 + 8);')
        e.w(f'      u{j}r = _mm512_add_pd(ar, br); u{j}i = _mm512_add_pd(ai, bi);')
        e.w(f'      _mm512_store_pd(VSCR_{L} + {2*(j-1)}*8, _mm512_sub_pd(ar, br));')
        e.w(f'      _mm512_store_pd(VSCR_{L} + {2*(j-1)+1}*8, _mm512_sub_pd(ai, bi));')
        e.w(f'      dcr = _mm512_add_pd(dcr, u{j}r); dci = _mm512_add_pd(dci, u{j}i); }}')
    if fused:
        e.w('    MAPSTORE(p + 0, dcr, dci, cp + 0, cp + 8);')
    else:
        e.w('    _mm512_store_pd(p + 0, dcr); _mm512_store_pd(p + 8, dci);')
    # C phase: runtime loop over k-blocks
    nbC, remC = divmod(h, KBC)
    e.w('    { const double* tc = PCT_%d; double* cs = CSCR_%d;' % (L, L))
    e.w('    #pragma GCC unroll 1')
    e.w(f'    for (int kb = 0; kb < {nbC}; kb++) {{')
    for dk in range(KBC):
        e.w(f'        __m512d C{dk}r = x0r, C{dk}i = x0i;')
    for j in range(1, h+1):
        for dk in range(KBC):
            e.w(f'        {{ __m512d b = _mm512_set1_pd(tc[{dk*h + (j-1)}]); C{dk}r = _mm512_fmadd_pd(u{j}r, b, C{dk}r); C{dk}i = _mm512_fmadd_pd(u{j}i, b, C{dk}i); }}')
    for dk in range(KBC):
        e.w(f'        _mm512_store_pd(cs + {2*dk}*8, C{dk}r); _mm512_store_pd(cs + {2*dk+1}*8, C{dk}i);')
    e.w(f'        tc += {KBC*h}; cs += {2*KBC}*8;')
    e.w('    }')
    if remC:
        for dk in range(remC):
            e.w(f'    {{ __m512d C0r = x0r, C0i = x0i;')
            for j in range(1, h+1):
                e.w(f'      {{ __m512d b = _mm512_set1_pd(tc[{dk*h + (j-1)}]); C0r = _mm512_fmadd_pd(u{j}r, b, C0r); C0i = _mm512_fmadd_pd(u{j}i, b, C0i); }}')
            e.w(f'      _mm512_store_pd(cs + {2*dk}*8, C0r); _mm512_store_pd(cs + {2*dk+1}*8, C0i); }}')
    e.w('    }')
    # reload v
    e.w('    __m512d ' + ', '.join(f'v{j}r, v{j}i' for j in range(1,h+1)) + ';')
    for j in range(1, h+1):
        e.w(f'    v{j}r = _mm512_load_pd(VSCR_{L} + {2*(j-1)}*8); v{j}i = _mm512_load_pd(VSCR_{L} + {2*(j-1)+1}*8);')
    nbS, remS = divmod(h, KBS)
    e.w('    { const double* ts = PST_%d; const double* cs = CSCR_%d;' % (L, L))
    e.w('      double* pk = p + SP*16; double* pl = p + %d*SP*16;' % (L-1))
    if fused:
        e.w('      const double* ck = cp + CS*16; const double* cl = cp + %d*CS*16;' % (L-1))
    e.w('    #pragma GCC unroll 1')
    e.w(f'    for (int kb = 0; kb < {nbS}; kb++) {{')
    for dk in range(KBS):
        e.w(f'        __m512d S{dk}r, S{dk}i;')
    for j in range(1, h+1):
        for dk in range(KBS):
            if j == 1:
                e.w(f'        {{ __m512d b = _mm512_set1_pd(ts[{dk*h}]); S{dk}r = _mm512_mul_pd(v1r, b); S{dk}i = _mm512_mul_pd(v1i, b); }}')
            else:
                e.w(f'        {{ __m512d b = _mm512_set1_pd(ts[{dk*h + (j-1)}]); S{dk}r = _mm512_fmadd_pd(v{j}r, b, S{dk}r); S{dk}i = _mm512_fmadd_pd(v{j}i, b, S{dk}i); }}')
    for dk in range(KBS):
        e.w(f'        {{ __m512d Cr = _mm512_load_pd(cs + {2*dk}*8), Ci = _mm512_load_pd(cs + {2*dk+1}*8);')
        e.w(f'          __m512d Xr = _mm512_add_pd(Cr, S{dk}i), Xi = _mm512_sub_pd(Ci, S{dk}r);')
        e.w(f'          __m512d Yr = _mm512_sub_pd(Cr, S{dk}i), Yi = _mm512_add_pd(Ci, S{dk}r);')
        if fused:
            e.w(f'          MAPSTORE(pk + {dk}*SP*16, Xr, Xi, ck + {dk}*CS*16, ck + {dk}*CS*16 + 8);')
            e.w(f'          MAPSTORE(pl - {dk}*SP*16, Yr, Yi, cl - {dk}*CS*16, cl - {dk}*CS*16 + 8);')
        else:
            e.w(f'          _mm512_store_pd(pk + {dk}*SP*16, Xr); _mm512_store_pd(pk + {dk}*SP*16 + 8, Xi);')
            e.w(f'          _mm512_store_pd(pl - {dk}*SP*16, Yr); _mm512_store_pd(pl - {dk}*SP*16 + 8, Yi);')
        e.w('        }')
    e.w(f'        ts += {KBS*h}; cs += {2*KBS}*8; pk += {KBS}*SP*16; pl -= {KBS}*SP*16;')
    if fused:
        e.w(f'        ck += {KBS}*CS*16; cl -= {KBS}*CS*16;')
    e.w('    }')
    if remS:
        for dk in range(remS):
            e.w(f'    {{ __m512d S0r, S0i;')
            for j in range(1, h+1):
                if j == 1:
                    e.w(f'      {{ __m512d b = _mm512_set1_pd(ts[{dk*h}]); S0r = _mm512_mul_pd(v1r, b); S0i = _mm512_mul_pd(v1i, b); }}')
                else:
                    e.w(f'      {{ __m512d b = _mm512_set1_pd(ts[{dk*h + (j-1)}]); S0r = _mm512_fmadd_pd(v{j}r, b, S0r); S0i = _mm512_fmadd_pd(v{j}i, b, S0i); }}')
            e.w(f'      {{ __m512d Cr = _mm512_load_pd(cs + {2*dk}*8), Ci = _mm512_load_pd(cs + {2*dk+1}*8);')
            e.w(f'        __m512d Xr = _mm512_add_pd(Cr, S0i), Xi = _mm512_sub_pd(Ci, S0r);')
            e.w(f'        __m512d Yr = _mm512_sub_pd(Cr, S0i), Yi = _mm512_add_pd(Ci, S0r);')
            if fused:
                e.w(f'        MAPSTORE(pk + {dk}*SP*16, Xr, Xi, ck + {dk}*CS*16, ck + {dk}*CS*16 + 8);')
                e.w(f'        MAPSTORE(pl - {dk}*SP*16, Yr, Yi, cl - {dk}*CS*16, cl - {dk}*CS*16 + 8);')
            else:
                e.w(f'        _mm512_store_pd(pk + {dk}*SP*16, Xr); _mm512_store_pd(pk + {dk}*SP*16 + 8, Xi);')
                e.w(f'        _mm512_store_pd(pl - {dk}*SP*16, Yr); _mm512_store_pd(pl - {dk}*SP*16 + 8, Yi);')
            e.w('      } }')
    e.w('    }')
    e.w('}')
    return '\\n'.join(e.lines)

'''
src = src[:i0] + new_fn + src[i1:]
open('genprime3.py','w').write(src)
print('rewritten')
