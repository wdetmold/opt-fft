import sys, os, time, ctypes
import numpy as np
os.sched_setaffinity(0,{0})
lib = ctypes.CDLL(sys.argv[1])
L = int(sys.argv[2])
cfgs = eval(sys.argv[3]) if len(sys.argv)>3 else {13:[(102,200),(48,200)],17:[(61,150),(48,150)],23:[(31,120),(24,120)],36:[(12,80),(24,30)],45:[(8,60),(16,20)],64:[(4,40),(8,20)],6:[(520,400)],8:[(293,300)]}[L]
