import numpy as np
def chain(L, B, m, backend):
    rng_x = np.random.default_rng(7 + L)
    x = (rng_x.standard_normal((B,L,L,L)) + 1j*rng_x.standard_normal((B,L,L,L)))
    rng_c = np.random.default_rng(1000+L)
    c = 0.1*(rng_c.standard_normal((B,L,L,L)) + 1j*rng_c.standard_normal((B,L,L,L)))
    errs=[]
    if backend=='np':
        f = lambda a: np.fft.fftn(a,axes=(1,2,3))
    else:
        # matrix dft in double
        j=np.arange(L); W=np.exp(-2j*np.pi*np.outer(j,j)/L)
        def f(a):
            y=np.einsum('bxyz,kx->bkyz',a,W); y=np.einsum('bkyz,ly->bklz',y,W); return np.einsum('bklz,mz->bklm',y,W)
    for k in range(m):
        z=f(x)+c; x=z/(1+np.abs(z))
    return x
for L,m in ((6,240),(8,160),(13,80),(17,60),(23,60),(36,40),(64,30)):
    B=2
    a=chain(L,B,m,'np'); b=chain(L,B,m,'mat')
    e=np.linalg.norm(a-b)/np.linalg.norm(a)
    print(f"L={L} m={m} relerr={e:.2e}")
EOF
python3 divg.py</antml:parameter>
</antml:invoke>
</antml:function_calls>
