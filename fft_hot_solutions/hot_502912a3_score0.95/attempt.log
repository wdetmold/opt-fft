#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <immintrin.h>
#include <time.h>
static inline double now(){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
int main(){
    // streaming read+write at various footprints
    for (long MB=0; MB<7; MB++){
        long sz = (long[]){ 32*1024, 256*1024, 1024*1024, 4*1024*1024, 8*1024*1024, 16*1024*1024, 48*1024*1024 }[MB];
        long n = sz/8;
        double* a = aligned_alloc(64, sz);
        double* b = aligned_alloc(64, sz);
        double* c = aligned_alloc(64, sz);
        memset(a, 1, sz); memset(b, 1, sz); memset(c, 1, sz);
        long reps = 3 + 600*1024*1024/sz;
        __m512d k=_mm512_set1_pd(0.5);
        double t0=now();
        for(long r=0;r<reps;r++){
            for(long i=0;i<n;i+=8){
                __m512d va=_mm512_load_pd(a+i), vc=_mm512_load_pd(c+i);
                _mm512_store_pd(b+i, _mm512_fmadd_pd(va,k,vc));
            }
            double* t=a; a=b; b=t;
        }
        double t1=now();
        double bytes = (double)reps*n*8*3;
        printf("footprint %5ld KB (x3 arrays): %.2f GB/s (r2+w1)\n", sz/1024, bytes/(t1-t0)/1e9);
        free(a);free(b);free(c);
    }
    return 0;
}
