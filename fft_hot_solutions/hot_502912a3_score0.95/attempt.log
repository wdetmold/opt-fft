    o.w(f'vmovapd {h*128}(%[cs]), %%zmm28')
    o.w(f'vmovapd {h*128+64}(%[cs]), %%zmm29')
    if fused:
        emit_map(o, 'zmm28', 'zmm29', 0, 0, f'zmm{X0R}', f'zmm{X0I}')
    else:
        o.w('vmovapd %%zmm28, (%[p])')
        o.w('vmovapd %%zmm29, 64(%[p])')
    args = 'double* restrict p'
    ins = f'[p] "r" (p), [cv] "r" (PCV_{L}), [sv] "r" (PSV_{L}), [vs] "r" (VSCR_{L}), [cs] "r" (CSCR_{L})'
    if fused:
        args += ', const double* restrict cp'
        ins += ', [cp] "r" (cp), [c05] "m" (MCONST[0]), [c15] "m" (MCONST[1]), [c20] "m" (MCONST[2]), [c10] "m" (MCONST[3]), [tiny] "m" (MCONST[4])'
    return f'''
static void {name}({args}){{
    __asm__ volatile(
{o.text()}
        :
        : {ins}
        : "memory",
          {', '.join(f'"zmm{i}"' for i in range(32))}
    );
}}
'''
