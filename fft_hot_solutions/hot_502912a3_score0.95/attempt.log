import sys, numpy as np
sys.path.insert(0,'/workdir')
import base, solution
SIZES=(6,8,13,17,23,36,45,64)
TOL={6:1e-4,8:3e-6,13:1e-9,17:1e-10,23:1e-10,36:1e-10,45:1e-10,64:1e-10}
rng = np.random.default_rng(20260824)
fails = 0
for trial in range(14):
    W = {'seed': int(rng.integers(0, 2**31))}
    for L in SIZES:
        W[f'B{L}'] = int(rng.integers(1, {6:40,8:30,13:20,17:14,23:10,36:7,45:5,64:4}[L]+1))
        W[f'm{L}'] = int(rng.integers(1, 30))
    a = solution.transform(**W); b = base.transform(**W)
    off=0; worst1=0; worstm=0; bad=[]
    for L in SIZES:
        B=W[f'B{L}']; n=B*L**3
        e1=np.linalg.norm(a[off:off+n]-b[off:off+n])/np.linalg.norm(b[off:off+n]); off+=n
        em=np.linalg.norm(a[off:off+n]-b[off:off+n])/np.linalg.norm(b[off:off+n]); off+=n
        worst1=max(worst1,e1)
        if not (e1<1e-14 and em<TOL[L]): bad.append(L)
    if bad:
        fails += 1
        print('FAIL trial', trial, bad, {k:W[k] for k in W if k!='seed'})
    else:
        print(f'trial {trial}: OK (worst one-step {worst1:.2e})')
print('FUZZ', 'PASS' if fails==0 else f'{fails} FAILURES')
EOF
