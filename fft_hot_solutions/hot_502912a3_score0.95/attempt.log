def conv_soa(L):
    """convert 8 volumes (complex interleaved, possibly fewer with zero pad) to
    paired-split SoA: G[2*q*8 .. ] : slot q re lanes, then im lanes.
    src: array of 8 pointers (each to volume start as double*), may repeat/null -> zero
    Uses 8x8 transposes over doubles."""
    V = L*L*L
    ND = 2*V  # doubles per volume
    return f'''
static void soaconv_in_{L}(const double* const* src, int nv, double* G){{
    /* G has {ND} vector slots of 8 doubles */
    __m512d zero = _mm512_setzero_pd();
    for (long d = 0; d < {ND}; d += 8) {{
        __m512d r0,r1,r2,r3,r4,r5,r6,r7;
        r0 = nv>0 ? _mm512_loadu_pd(src[0]+d) : zero;
        r1 = nv>1 ? _mm512_loadu_pd(src[1]+d) : zero;
        r2 = nv>2 ? _mm512_loadu_pd(src[2]+d) : zero;
        r3 = nv>3 ? _mm512_loadu_pd(src[3]+d) : zero;
        r4 = nv>4 ? _mm512_loadu_pd(src[4]+d) : zero;
        r5 = nv>5 ? _mm512_loadu_pd(src[5]+d) : zero;
        r6 = nv>6 ? _mm512_loadu_pd(src[6]+d) : zero;
        r7 = nv>7 ? _mm512_loadu_pd(src[7]+d) : zero;
        __m512d o0,o1,o2,o3,o4,o5,o6,o7;
        MTR8(r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7);
        double* g = G + d*8;
        _mm512_store_pd(g+0,o0); _mm512_store_pd(g+8,o1);
        _mm512_store_pd(g+16,o2); _mm512_store_pd(g+24,o3);
        _mm512_store_pd(g+32,o4); _mm512_store_pd(g+40,o5);
        _mm512_store_pd(g+48,o6); _mm512_store_pd(g+56,o7);
    }}
}}
static void soaconv_out_{L}(const double* G, double* const* dst, int nv){{
    for (long d = 0; d < {ND}; d += 8) {{
        const double* g = G + d*8;
        __m512d r0=_mm512_load_pd(g+0), r1=_mm512_load_pd(g+8);
        __m512d r2=_mm512_load_pd(g+16), r3=_mm512_load_pd(g+24);
        __m512d r4=_mm512_load_pd(g+32), r5=_mm512_load_pd(g+40);
        __m512d r6=_mm512_load_pd(g+48), r7=_mm512_load_pd(g+56);
        __m512d o0,o1,o2,o3,o4,o5,o6,o7;
        MTR8(r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7);
        if(nv>0) _mm512_storeu_pd(dst[0]+d, o0);
        if(nv>1) _mm512_storeu_pd(dst[1]+d, o1);
        if(nv>2) _mm512_storeu_pd(dst[2]+d, o2);
        if(nv>3) _mm512_storeu_pd(dst[3]+d, o3);
        if(nv>4) _mm512_storeu_pd(dst[4]+d, o4);
        if(nv>5) _mm512_storeu_pd(dst[5]+d, o5);
        if(nv>6) _mm512_storeu_pd(dst[6]+d, o6);
        if(nv>7) _mm512_storeu_pd(dst[7]+d, o7);
    }}
}}
'''
