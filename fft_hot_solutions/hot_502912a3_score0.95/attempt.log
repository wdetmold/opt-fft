import numpy as np
from glib import tw, hexd

class Asm:
    def __init__(self):
        self.lines = []
        self.label = 0
    def w(self, s):
        self.lines.append(s)
    def text(self):
        return '\n'.join(f'        "{l}\\n\\t"' for l in self.lines)

def emit_prime_pencil_asm(L, SP, CS, fused, name, KBC=2, KBS=1, layout='soa'):
    """Emit a C function containing one big inline-asm pencil.
       p (rdi-class input), cp for fused. SP/CS compile-time strides (in slot-pairs).
       Register plan (phase C): zmm0..2h-1 = u pairs; zmm24,25 = x0; zmm26..29 acc (KBC=2);
       zmm30,31 bcast temps. v stashed to VSCR. Phase S: zmm0..2h-1 = v; acc zmm26,27; map consts zmm20..23; temps zmm28..31.
    """
    h = (L-1)//2
    A = Asm()
    PB = 128  # bytes per slot-pair
    sp = SP*PB; cs = CS*PB
    # --- fold phase: load x_j / x_{L-j}, u in regs, v to VSCR, dc accumulate ---
    # x0 -> zmm24/25; dc acc zmm26/27
    A.w(f'vmovapd (%[p]), %%zmm24')
    A.w(f'vmovapd 64(%[p]), %%zmm25')
    A.w(f'vmovapd %%zmm24, %%zmm26')
    A.w(f'vmovapd %%zmm25, %%zmm27')
    for j in range(1, h+1):
        a = j*sp; b = (L-j)*sp
        ur, ui = 2*(j-1), 2*(j-1)+1
        A.w(f'vmovapd {a}(%[p]), %%zmm30')          # ar
        A.w(f'vmovapd {a+64}(%[p]), %%zmm31')       # ai
        A.w(f'vmovapd {b}(%[p]), %%zmm28')          # br
        A.w(f'vmovapd {b+64}(%[p]), %%zmm29')       # bi
        A.w(f'vaddpd %%zmm28, %%zmm30, %%zmm{ur}')  # u_r
        A.w(f'vaddpd %%zmm29, %%zmm31, %%zmm{ui}')  # u_i
        A.w(f'vsubpd %%zmm28, %%zmm30, %%zmm30')    # v_r
        A.w(f'vsubpd %%zmm29, %%zmm31, %%zmm31')    # v_i
        A.w(f'vmovapd %%zmm30, {128*(j-1)}(%[vs])')
        A.w(f'vmovapd %%zmm31, {128*(j-1)+64}(%[vs])')
        A.w(f'vaddpd %%zmm{ur}, %%zmm26, %%zmm26')
        A.w(f'vaddpd %%zmm{ui}, %%zmm27, %%zmm27')
    # dc: store to p[0] (plain) or keep in CSCR slot h (fused handles dc via map later in S phase... simpler: store plain now; fused maps dc at end of S phase reading from CSCR)
    A.w(f'vmovapd %%zmm26, {2*h*128}(%[cs])')   # stash dc at CSCR slot h (after k slots)
    A.w(f'vmovapd %%zmm27, {2*h*128+64}(%[cs])')
    # --- phase C: k blocks of KBC; tables k-major [k][j] doubles ---
    # use GP reg for k loop: %[tc] advances; acc zmm26..(26+2*KBC-1)
    nb, rem = divmod(h, KBC)
    assert rem == 0 or KBC == 2 and rem == 1 or True
    A.w(f'movq ${nb}, %[cnt]')
    A.w(f'leaq (%[cs]), %[csp]')
    A.w('1:')
    for dk in range(KBC):
        A.w(f'vmovapd %%zmm24, %%zmm{26+2*dk}')
        A.w(f'vmovapd %%zmm25, %%zmm{27+2*dk}')
    for j in range(0, h):
        for dk in range(KBC):
            off = (dk*h + j)*8
            A.w(f'vbroadcastsd {off}(%[tc]), %%zmm30')
            A.w(f'vfmadd231pd %%zmm{2*j}, %%zmm30, %%zmm{26+2*dk}')
            A.w(f'vfmadd231pd %%zmm{2*j+1}, %%zmm30, %%zmm{27+2*dk}')
    for dk in range(KBC):
        A.w(f'vmovapd %%zmm{26+2*dk}, {dk*128}(%[csp])')
        A.w(f'vmovapd %%zmm{27+2*dk}, {dk*128+64}(%[csp])')
    A.w(f'addq ${KBC*h*8}, %[tc]')
    A.w(f'addq ${KBC*128}, %[csp]')
    A.w('decq %[cnt]')
    A.w('jnz 1b')
    if rem:
        # tail k's with KBC.. emit single blocks
        for t in range(rem):
            A.w(f'vmovapd %%zmm24, %%zmm26')
            A.w(f'vmovapd %%zmm25, %%zmm27')
            for j in range(0, h):
                off = (t*h + j)*8
                A.w(f'vbroadcastsd {off}(%[tc]), %%zmm30')
                A.w(f'vfmadd231pd %%zmm{2*j}, %%zmm30, %%zmm26')
                A.w(f'vfmadd231pd %%zmm{2*j+1}, %%zmm30, %%zmm27')
            A.w(f'vmovapd %%zmm26, {t*128}(%[csp])')
            A.w(f'vmovapd %%zmm27, {t*128+64}(%[csp])')
    # --- reload v ---
    for j in range(1, h+1):
        A.w(f'vmovapd {128*(j-1)}(%[vs]), %%zmm{2*(j-1)}')
        A.w(f'vmovapd {128*(j-1)+64}(%[vs]), %%zmm{2*(j-1)+1}')
    # --- phase S + combine + store/map ---
    # consts for map: zmm20=0.5, zmm21=1.5, zmm22=2.0, zmm23=1.0 (+ tiny via mem)
    if fused:
        A.w('vbroadcastsd %[c05], %%zmm20')
        A.w('vbroadcastsd %[c15], %%zmm21')
        A.w('vbroadcastsd %[c20], %%zmm22')
        A.w('vbroadcastsd %[c10], %%zmm23')
    # k loop KBS=1: S acc zmm26/27; pointers pk/pl, ck/cl move
    A.w(f'movq ${h}, %[cnt]')
    A.w(f'leaq {sp}(%[p]), %[pk]')
    A.w(f'leaq {(L-1)*sp}(%[p]), %[pl]')
    A.w(f'leaq (%[cs]), %[csp]')
    if fused:
        A.w(f'leaq {cs}(%[cp]), %[ck]')
        A.w(f'leaq {(L-1)*cs}(%[cp]), %[cl]')
    A.w('2:')
    for j in range(0, h):
        off = j*8
        A.w(f'vbroadcastsd {off}(%[ts]), %%zmm30')
        if j == 0:
            A.w(f'vmulpd %%zmm30, %%zmm0, %%zmm26')
            A.w(f'vmulpd %%zmm30, %%zmm1, %%zmm27')
        else:
            A.w(f'vfmadd231pd %%zmm{2*j}, %%zmm30, %%zmm26')
            A.w(f'vfmadd231pd %%zmm{2*j+1}, %%zmm30, %%zmm27')
    # combine: C at (%[csp]): Xr = Cr + Si, Xi = Ci - Sr; Yr = Cr - Si, Yi = Ci + Sr
    A.w('vmovapd (%[csp]), %%zmm28')    # Cr
    A.w('vmovapd 64(%[csp]), %%zmm29')  # Ci
    A.w('vaddpd %%zmm27, %%zmm28, %%zmm30')  # Xr
    A.w('vsubpd %%zmm26, %%zmm29, %%zmm31')  # Xi
    A.w('vsubpd %%zmm27, %%zmm28, %%zmm28')  # Yr
    A.w('vaddpd %%zmm26, %%zmm29, %%zmm29')  # Yi
    if not fused:
        A.w('vmovapd %%zmm30, (%[pk])')
        A.w('vmovapd %%zmm31, 64(%[pk])')
        A.w('vmovapd %%zmm28, (%[pl])')
        A.w('vmovapd %%zmm29, 64(%[pl])')
    else:
        # map X (in zmm30/31) with c at (%[ck]); uses zmm24..27 as temps? x0 (24/25) still needed for next k!? NO: phase S doesn't need x0. zmm24/25 free now.
        emit_map_asm(A, 'zmm30', 'zmm31', 'ck', 'pk')
        emit_map_asm(A, 'zmm28', 'zmm29', 'cl', 'pl')
    A.w(f'addq ${sp}, %[pk]')
    A.w(f'subq ${sp}, %[pl]')
    A.w(f'addq ${h*8}, %[ts]')
    A.w('addq $128, %[csp]')
    if fused:
        A.w(f'addq ${cs}, %[ck]')
        A.w(f'subq ${cs}, %[cl]')
    A.w('decq %[cnt]')
    A.w('jnz 2b')
    # dc output: from CSCR slot h
    A.w(f'vmovapd {2*h*128}(%[cs]), %%zmm30')
    A.w(f'vmovapd {2*h*128+64}(%[cs]), %%zmm31')
    if not fused:
        A.w('vmovapd %%zmm30, (%[p])')
        A.w('vmovapd %%zmm31, 64(%[p])')
    else:
        A.w('leaq (%[p]), %[pk]')
        A.w('leaq (%[cp]), %[ck]')
        emit_map_asm(A, 'zmm30', 'zmm31', 'ck', 'pk')
    # build C function
    args = 'double* restrict p, const double* restrict tc0, const double* restrict ts0'
    if fused:
        args += ', const double* restrict cp'
    body = A.text()
    outs = []
    code = f'''
static void {name}({args}){{
    const double* tc = tc0; const double* ts = ts0;
    double* csp; double* pk; double* pl; long cnt;
    {'const double* ck; const double* cl;' if fused else ''}
    __asm__ volatile(
{body}
        : [tc] "+r" (tc), [ts] "+r" (ts), [cnt] "=&r" (cnt), [csp] "=&r" (csp),
          [pk] "=&r" (pk), [pl] "=&r" (pl){', [ck] "=&r" (ck), [cl] "=&r" (cl)' if fused else ''}
        : [p] "r" (p), [vs] "r" (VSCR_{L}), [cs] "r" (CSCR_{L}){', [cp] "r" (cp), [c05] "m" (MCONST[0]), [c15] "m" (MCONST[1]), [c20] "m" (MCONST[2]), [c10] "m" (MCONST[3]), [tiny] "m" (MCONST[4])' if fused else ''}
        : "memory", "cc",
          {', '.join(f'"zmm{i}"' for i in range(32))}
    );
}}
'''
    return code

def emit_map_asm(A, zr, zi, cptr, outptr):
    """map on pair in regs zr/zi: z += c; r2; rsqrt Newton x2; s; d; rcp Newton x2; store.
       temps: zmm24,25 (h, y), zmm26?? careful: zmm26/27 hold S accumulators... they are consumed already at combine -> free.
       Use temps zmm24,25,26,27 (free in S phase after combine). Constants zmm20=0.5,21=1.5,22=2.0,23=1.0"""
    A.w(f'vaddpd (%[{cptr}]), %%{zr}, %%{zr}')
    A.w(f'vaddpd 64(%[{cptr}]), %%{zi}, %%{zi}')
    A.w(f'vbroadcastsd %[tiny], %%zmm24')
    A.w(f'vfmadd231pd %%{zi}, %%{zi}, %%zmm24')     # zi*zi + tiny
    A.w(f'vfmadd231pd %%{zr}, %%{zr}, %%zmm24')     # r2
    A.w(f'vrsqrt14pd %%zmm24, %%zmm25')             # y0
    A.w(f'vmulpd %%zmm20, %%zmm24, %%zmm26')        # h = 0.5 r2
    A.w(f'vmulpd %%zmm25, %%zmm25, %%zmm27')        # y0^2
    A.w(f'vmovapd %%zmm21, %%zmm28')
    A.w(f'vfnmadd231pd %%zmm26, %%zmm27, %%zmm28')  # w = 1.5 - h*y0^2
    A.w(f'vmulpd %%zmm28, %%zmm25, %%zmm25')        # y1
    A.w(f'vmulpd %%zmm25, %%zmm25, %%zmm27')
    A.w(f'vmovapd %%zmm21, %%zmm28')
    A.w(f'vfnmadd231pd %%zmm26, %%zmm27, %%zmm28')
    A.w(f'vmulpd %%zmm28, %%zmm25, %%zmm25')        # y2
    A.w(f'vmulpd %%zmm25, %%zmm24, %%zmm24')        # s = r2*y2
    A.w(f'vaddpd %%zmm23, %%zmm24, %%zmm24')        # d = 1+s
    A.w(f'vrcp14pd %%zmm24, %%zmm25')               # r0
    A.w(f'vmovapd %%zmm22, %%zmm28')
    A.w(f'vfnmadd231pd %%zmm24, %%zmm25, %%zmm28')  # 2 - d*r0
    A.w(f'vmulpd %%zmm28, %%zmm25, %%zmm25')
    A.w(f'vmovapd %%zmm22, %%zmm28')
    A.w(f'vfnmadd231pd %%zmm24, %%zmm25, %%zmm28')
    A.w(f'vmulpd %%zmm28, %%zmm25, %%zmm25')        # r = 1/d
    A.w(f'vmulpd %%zmm25, %%{zr}, %%{zr}')
    A.w(f'vmulpd %%zmm25, %%{zi}, %%{zi}')
    A.w(f'vmovapd %%{zr}, (%[{outptr}])')
    A.w(f'vmovapd %%{zi}, 64(%[{outptr}])')
