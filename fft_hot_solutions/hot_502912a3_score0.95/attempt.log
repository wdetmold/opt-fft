def emit_pfa_kernel(N, N1, N2, dftA, dftB, name, fused):
    """kernel on pairs: p + idx*SP*16 (+8 for im). fused: consumption-order cp (advances by pair per output)."""
    nmap, kmap = build_pfa(N1, N2, dftA, dftB)
    lines = []
    args = 'double* restrict p, const long SP' + (', const double* restrict cp' if fused else '')
    lines.append(f'static inline __attribute__((always_inline)) void {name}({args}){{')
    # stage A
    for n2 in range(N2):
        ir = IR()
        xv = []
        for n1 in range(N1):
            n = nmap[n1*N2+n2]
            lines.append(f'    __m512d a{n1}r_{n2} = _mm512_load_pd(p + {n}*SP*16);')
            lines.append(f'    __m512d a{n1}i_{n2} = _mm512_load_pd(p + {n}*SP*16 + 8);')
            xv.append((f'a{n1}r_{n2}', f'a{n1}i_{n2}'))
        out = dftA(ir, xv)
        for l in ir.render():
            lines.append('    ' + l)
        for q1, (orr, oii) in enumerate(out):
            lines.append(f'    _mm512_store_pd(KSCR + {2*(q1*N2+n2)}*8, {orr});')
            lines.append(f'    _mm512_store_pd(KSCR + {2*(q1*N2+n2)+1}*8, {oii});')
    # stage B
    for q1 in range(N1):
        ir = IR()
        xv = []
        for n2 in range(N2):
            lines.append(f'    __m512d b{n2}r_{q1} = _mm512_load_pd(KSCR + {2*(q1*N2+n2)}*8);')
            lines.append(f'    __m512d b{n2}i_{q1} = _mm512_load_pd(KSCR + {2*(q1*N2+n2)+1}*8);')
            xv.append((f'b{n2}r_{q1}', f'b{n2}i_{q1}'))
        out = dftB(ir, xv)
        for l in ir.render():
            lines.append('    ' + l)
        for m, (orr, oii) in enumerate(out):
            k = kmap[q1*N2+m]
            if fused:
                lines.append(f'    MAPSTORE2(p + {k}*SP*16, p + {k}*SP*16 + 8, {orr}, {oii}, cp + {2*(q1*N2+m)}*8, cp + {2*(q1*N2+m)+1}*8);')
            else:
                lines.append(f'    _mm512_store_pd(p + {k}*SP*16, {orr});')
                lines.append(f'    _mm512_store_pd(p + {k}*SP*16 + 8, {oii});')
    lines.append('}')
    return '\n'.join(lines), kmap

