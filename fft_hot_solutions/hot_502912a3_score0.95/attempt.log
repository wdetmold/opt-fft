tot=0
for L in SIZES:
    B,m = cfg[L]
    rng=np.random.default_rng(5)
    x0=(rng.standard_normal((B,L,L,L))+1j*rng.standard_normal((B,L,L,L)))
    c=0.1*(rng.standard_normal((B,L,L,L))+1j*rng.standard_normal((B,L,L,L)))
    x0=np.ascontiguousarray(x0); c=np.ascontiguousarray(c)
    one=np.empty(B*L**3,dtype=np.complex128); fin=np.empty(B*L**3,dtype=np.complex128)
