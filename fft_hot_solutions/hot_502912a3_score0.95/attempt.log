                m = re.match(r'\s+[0-9a-f]+:\s+([a-z0-9.]+)', b)
                if m: ops[m.group(1)] = ops.get(m.group(1),0)+1
            n = sum(ops.values())
            print(f'loop at {target} size {n}: ', dict(sorted(ops.items(), key=lambda kv:-kv[1])[:10]))
    except StopIteration: pass
