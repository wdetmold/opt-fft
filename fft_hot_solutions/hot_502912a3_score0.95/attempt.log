#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <immintrin.h>
#include <time.h>
static inline double now(){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
double buf[8*1024] __attribute__((aligned(64)));
#define REP 2000000L
int main(){
    for(int i=0;i<8*1024;i++) buf[i]=1e-3+i*1e-9;
    // 1: FMA with memory operand (64B)
    {
        __m512d a0=_mm512_set1_pd(1.0),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
        __m512d b=_mm512_set1_pd(0.5);
        double t0=now();
        for(long r=0;r<REP;r++){
            const double* p=buf + (r&7)*64;
            a0=_mm512_fmadd_pd(_mm512_load_pd(p+0),b,a0); a1=_mm512_fmadd_pd(_mm512_load_pd(p+8),b,a1);
            a2=_mm512_fmadd_pd(_mm512_load_pd(p+16),b,a2); a3=_mm512_fmadd_pd(_mm512_load_pd(p+24),b,a3);
            a4=_mm512_fmadd_pd(_mm512_load_pd(p+32),b,a4); a5=_mm512_fmadd_pd(_mm512_load_pd(p+40),b,a5);
            a6=_mm512_fmadd_pd(_mm512_load_pd(p+48),b,a6); a7=_mm512_fmadd_pd(_mm512_load_pd(p+56),b,a7);
        }
        double t1=now();
        printf("mem-FMA (L1): %.3f G/s\n", REP*8.0/(t1-t0)/1e9);
        volatile double s=((double*)&a0)[0]+((double*)&a1)[0]+((double*)&a2)[0]+((double*)&a3)[0]+((double*)&a4)[0]+((double*)&a5)[0]+((double*)&a6)[0]+((double*)&a7)[0];(void)s;
    }
    // 2: 2 loads + 1 FMA per "element op" (load-heavy)
    {
        __m512d a0=_mm512_set1_pd(1.0),a1=a0,a2=a0,a3=a0;
        double t0=now();
        for(long r=0;r<REP;r++){
            const double* p=buf + (r&7)*64;
            a0=_mm512_fmadd_pd(_mm512_load_pd(p+0),_mm512_load_pd(p+8),a0);
            a1=_mm512_fmadd_pd(_mm512_load_pd(p+16),_mm512_load_pd(p+24),a1);
            a2=_mm512_fmadd_pd(_mm512_load_pd(p+32),_mm512_load_pd(p+40),a2);
            a3=_mm512_fmadd_pd(_mm512_load_pd(p+48),_mm512_load_pd(p+56),a3);
        }
        double t1=now();
        printf("2load+FMA: %.3f G FMA/s (%.2f Gload/s)\n", REP*4.0/(t1-t0)/1e9, REP*8.0/(t1-t0)/1e9);
        volatile double s=((double*)&a0)[0]+((double*)&a1)[0]+((double*)&a2)[0]+((double*)&a3)[0];(void)s;
    }
    // 3: pure loads
    {
        __m512d a0=_mm512_setzero_pd(),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
