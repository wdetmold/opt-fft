        r6=_mm512_load_pd(TSCR36 + (zv*8+6)*16 + 8); r7=_mm512_load_pd(TSCR36 + (zv*8+7)*16 + 8);
        MTR8(r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7);
        _mm512_store_pd(base + 0*{ROWP}*16 + zv*16 + 8, o0); _mm512_store_pd(base + 1*{ROWP}*16 + zv*16 + 8, o1);
        _mm512_store_pd(base + 2*{ROWP}*16 + zv*16 + 8, o2); _mm512_store_pd(base + 3*{ROWP}*16 + zv*16 + 8, o3);
        _mm512_store_pd(base + 4*{ROWP}*16 + zv*16 + 8, o4); _mm512_store_pd(base + 5*{ROWP}*16 + zv*16 + 8, o5);
        _mm512_store_pd(base + 6*{ROWP}*16 + zv*16 + 8, o6); _mm512_store_pd(base + 7*{ROWP}*16 + zv*16 + 8, o7);
    }}
}}
static void step36(double* restrict G, const double* restrict Cc){{
    for (int x = 0; x < 36; x++){{
        double* base = G + (long)x*{PLP}*16;
        for (int zv = 0; zv < 5; zv++) k36_plain(base + zv*16, {ROWP});
        for (int s = 0; s < 5; s++) z36_strip(base + (long)s*8*{ROWP}*16);
    }}
    for (int q = 0; q < 180; q++){{
        k36_fused(G + (long)q*16, {PLP}, Cc + (long)q*36*16);
    }}
}}
''')
    # conversions
    parts.append(f'''
static const long long DEIDX_RE[8] = {{0,2,4,6,8,10,12,14}};
static const long long DEIDX_IM[8] = {{1,3,5,7,9,11,13,15}};
static const long long INIDX_LO[8] = {{0,8,1,9,2,10,3,11}};
static const long long INIDX_HI[8] = {{4,12,5,13,6,14,7,15}};
static void conv36_in(const double* restrict src, double* restrict G){{
    /* src: canonical volume complex interleaved; G zeroed padded layout */
    __m512i idr = _mm512_load_si512(DEIDX_RE), idi = _mm512_load_si512(DEIDX_IM);
    for (int x = 0; x < 36; x++){{
        for (int y = 0; y < 36; y++){{
            const double* s = src + ((long)x*1296 + (long)y*36)*2;
            double* g = G + ((long)x*{PLP} + (long)y*{ROWP})*16;
            for (int zv = 0; zv < 4; zv++){{
                __m512d A = _mm512_loadu_pd(s + zv*16);
                __m512d B = _mm512_loadu_pd(s + zv*16 + 8);
                _mm512_store_pd(g + zv*16, _mm512_permutex2var_pd(A, idr, B));
                _mm512_store_pd(g + zv*16 + 8, _mm512_permutex2var_pd(A, idi, B));
            }}
            {{ /* tail: z=32..35 */
                __m512d A = _mm512_loadu_pd(s + 64);
                __m512d zero = _mm512_setzero_pd();
                _mm512_store_pd(g + 64, _mm512_maskz_permutex2var_pd(0x0f, A, idr, zero));
                _mm512_store_pd(g + 64 + 8, _mm512_maskz_permutex2var_pd(0x0f, A, idi, zero));
            }}
        }}
    }}
}}
static void conv36_out(const double* restrict G, double* restrict dst){{
    __m512i ilo = _mm512_load_si512(INIDX_LO), ihi = _mm512_load_si512(INIDX_HI);
    for (int x = 0; x < 36; x++){{
        for (int y = 0; y < 36; y++){{
            const double* g = G + ((long)x*{PLP} + (long)y*{ROWP})*16;
            double* d = dst + ((long)x*1296 + (long)y*36)*2;
            for (int zv = 0; zv < 4; zv++){{
                __m512d re = _mm512_load_pd(g + zv*16);
                __m512d im = _mm512_load_pd(g + zv*16 + 8);
                _mm512_storeu_pd(d + zv*16, _mm512_permutex2var_pd(re, ilo, im));
                _mm512_storeu_pd(d + zv*16 + 8, _mm512_permutex2var_pd(re, ihi, im));
            }}
            {{
                __m512d re = _mm512_load_pd(g + 64);
                __m512d im = _mm512_load_pd(g + 64 + 8);
                _mm512_storeu_pd(d + 64, _mm512_permutex2var_pd(re, ilo, im));
            }}
        }}
    }}
}}
static double* G36_ = 0; static double* C36_ = 0; static double* CT36_ = 0;
void run_36(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    if (!G36_) {{ G36_ = myk_alloc({VOLP}*16*8 + 8192); C36_ = myk_alloc(180L*36*16*8 + 8192); CT36_ = myk_alloc({VOLP}*16*8 + 8192); C36_ += 136; }}
    for (long b = 0; b < B; b++){{
        conv36_in(x0 + b*46656*2, G36_);
        /* c: convert then reorder to consumption order */
        conv36_in(c + b*46656*2, CT36_);
        for (int y = 0; y < 36; y++) for (int zv = 0; zv < 5; zv++){{
            double* dstc = C36_ + ((long)(y*5+zv)*36)*16;
            const double* srcc = CT36_ + ((long)y*{ROWP} + zv)*16;
            for (int j = 0; j < 36; j++){{
                __m512d re = _mm512_load_pd(srcc + (long)KMAP_36[j]*{PLP}*16);
                __m512d im = _mm512_load_pd(srcc + (long)KMAP_36[j]*{PLP}*16 + 8);
                _mm512_store_pd(dstc + j*16, re);
                _mm512_store_pd(dstc + j*16 + 8, im);
            }}
        }}
        for (long s = 0; s < m; s++){{
            step36(G36_, C36_);
            if (s == 0) conv36_out(G36_, out1 + b*46656*2);
        }}
        conv36_out(G36_, outm + b*46656*2);
    }}
}}
''')
    return '\n'.join(parts)
