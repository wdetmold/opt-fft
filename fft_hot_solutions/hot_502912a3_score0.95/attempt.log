for B,m in cfgs:
    rng=np.random.default_rng(5)
    x0=np.ascontiguousarray(rng.standard_normal((B,L,L,L))+1j*rng.standard_normal((B,L,L,L)))
    c=np.ascontiguousarray(0.1*(rng.standard_normal((B,L,L,L))+1j*rng.standard_normal((B,L,L,L))))
    one=np.empty(B*L**3,dtype=np.complex128); fin=np.empty(B*L**3,dtype=np.complex128)
    f(x0.ctypes.data,c.ctypes.data,one.ctypes.data,fin.ctypes.data,B,m)
    best=1e9
