#include <immintrin.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#define ALIGN64 __attribute__((aligned(64)))
static double now(){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
static double KSCR[2*36*8] ALIGN64;
#include "k36_extract.h"
static double* BUF;
int main(){
    BUF = aligned_alloc(64, 36L*205*16*8 + 4096);
    memset(BUF, 0, 36L*205*16*8 + 4096);
    for(long i=0;i<36L*205*16;i++) BUF[i] = (i%97)/50.0-1;
    long R;
    double t0,t1;
    // (a) single pencil, stride 5, L1-hot
    R=300000;
    for(long r=0;r<5;r++) k36_plain(BUF, 5);
    t0=now(); for(long r=0;r<R;r++) k36_plain(BUF, 5); t1=now();
    printf("(a) single pencil SP=5 hot: %.3f ns/el %.0f cyc/grp\n", (t1-t0)/R/288*1e9, (t1-t0)/R*3.1e9);
    // (b) one plane: 5 pencils
    R=80000;
    t0=now(); for(long r=0;r<R;r++){ for(int zv=0;zv<5;zv++) k36_plain(BUF + zv*16, 5); } t1=now();
    printf("(b) plane 5 pencils hot: %.3f ns/el %.0f cyc/grp\n", (t1-t0)/R/(288*5)*1e9, (t1-t0)/R/5*3.1e9);
    // (c) full volume sweep (36 planes x 5)
    R=2500;
    t0=now(); for(long r=0;r<R;r++){ for(int x=0;x<36;x++){ double* base = BUF + (long)x*205*16; for(int zv=0;zv<5;zv++) k36_plain(base + zv*16, 5); } } t1=now();
    printf("(c) volume Y sweep: %.3f ns/el %.0f cyc/grp\n", (t1-t0)/R/46656.0*1e9, (t1-t0)/R/180*3.1e9);
    // (d) volume X sweep (SP=205)
    t0=now(); for(long r=0;r<R;r++){ for(int q=0;q<180;q++) k36_plain(BUF + (long)q*16, 205); } t1=now();
    printf("(d) volume X sweep: %.3f ns/el %.0f cyc/grp\n", (t1-t0)/R/46656.0*1e9, (t1-t0)/R/180*3.1e9);
    return 0;
}
EOF
