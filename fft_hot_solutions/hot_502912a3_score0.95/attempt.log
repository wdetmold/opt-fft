  dict(seed=5, B6=33,B8=21,B13=11,B17=13,B23=10,B36=5,B45=4,B64=2, m6=40,m8=30,m13=20,m17=15,m23=12,m36=10,m45=8,m64=6),
  dict(seed=987654321, B6=6,B8=6,B13=6,B17=6,B23=6,B36=2,B45=2,B64=1, m6=101,m8=81,m13=51,m17=41,m23=31,m36=21,m45=15,m64=11),
]
