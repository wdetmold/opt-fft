static inline double now(){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
#define REP 4000000L
// simulate map: per "group": r2=fma,mul; sqrt; add; 2 div; + K FMAs of FFT work
__attribute__((noinline)) double t_map_mix(int K){
    __m512d zr=_mm512_set1_pd(1.37), zi=_mm512_set1_pd(-0.7), one=_mm512_set1_pd(1.0);
    __m512d b=_mm512_set1_pd(0.9999),c=_mm512_set1_pd(1e-18);
    __m512d a0=one,a1=one,a2=one,a3=one,a4=one,a5=one,a6=one,a7=one, accr=one, acci=one;
    double t0=now();
    for(long r=0;r<REP;r++){
        __m512d r2=_mm512_fmadd_pd(zr,zr,_mm512_mul_pd(zi,zi));
        __m512d d=_mm512_add_pd(one,_mm512_sqrt_pd(r2));
        accr=_mm512_add_pd(accr,_mm512_div_pd(zr,d));
        acci=_mm512_add_pd(acci,_mm512_div_pd(zi,d));
        for(int k=0;k<K/8;k++){
            a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c); a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
            a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
        }
    }
    double t1=now();
    volatile double s=((double*)&accr)[0]+((double*)&acci)[0]+((double*)&a0)[0]+((double*)&a1)[0]+((double*)&a2)[0]+((double*)&a3)[0]+((double*)&a4)[0]+((double*)&a5)[0]+((double*)&a6)[0]+((double*)&a7)[0];(void)s;
    return (t1-t0)/REP*1e9;
}
