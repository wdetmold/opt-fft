Scratch through L2 costs more than it saves — reverting. Let me measure the per-volume conversion overheads (matters if hidden m is small):

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/eng && python3 - <<'EOF'
import os, ctypes, numpy as np, time
try: os.sched_setaffinity(0,{0})
except Exception: pass
lib=ctypes.CDLL('/tmp/w/sol/implementation.so')
for L in (64,45,36,23,17,13,8,6):
    f=getattr(lib,f'run_{L}')
    f.argtypes=[ctypes.c_void_p]*4+[ctypes.c_long]*2
    B=4
    rng=np.random.default_rng(1)
    x0=rng.standard_normal((B,2*L**3)); c=0.1*rng.standard_normal((B,2*L**3))
    o1=np.empty(B*L**3*2); om=np.empty(B*L**3*2)
    def t(m, reps=5):
        f(x0.ctypes.data,c.ctypes.data,o1.ctypes.data,om.ctypes.data,B,m)
        best=1e9
        for _ in range(reps):
            t0=time.perf_counter(); f(x0.ctypes.data,c.ctypes.data,o1.ctypes.data,om.ctypes.data,B,m); t1=time.perf_counter()
            best=min(best,t1-t0)
        return best
    t1_,t21=t(1),t(21)
    pervol=(t1_ - (t21-t1_)/20*1)/B*1000  # rough: t(1) has conv+1 step
    perstep=(t21-t1_)/20/B*1000
    print(f"L={L}: t(m=1)={t1_*1000:.2f}ms t(m=21)={t21*1000:.2f}ms -> per-step/vol {perstep:.3f}ms, fixed/vol ~{pervol:.3f}ms (={pervol/perstep:.1f} steps)")
