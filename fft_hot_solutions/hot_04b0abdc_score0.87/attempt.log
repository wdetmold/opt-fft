import sys, numpy as np, importlib.util, time

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path + '/solution.py' if not path.endswith('.py') else path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

SIZES=(6,8,13,17,23,36,45,64)
def check(out, ref, Bs):
    # blocks: per L: one-step block then m-step block
    tols={6:1e-4,8:3e-6,13:1e-9,17:1e-10,23:1e-10,36:1e-10,45:1e-10,64:1e-10}
    off=0; ok=True
    for L in SIZES:
        n=Bs[L]*L**3
        for which, tol in (('one',1e-14),('m',tols[L])):
            a=out[off:off+n]; b=ref[off:off+n]
            e=np.linalg.norm(a-b)/max(np.linalg.norm(b),1e-300)
            stat = 'OK ' if e < tol else 'FAIL'
            if e >= tol: ok=False
            print(f"L={L} {which}: rel={e:.3e} tol={tol:.0e} {stat}")
            off+=n
    return ok

if __name__=='__main__':
    target=sys.argv[1]
    params=tuple(int(x) for x in sys.argv[2].split(','))
    base=load('/workdir/base.py','base')
    mod=load(target,'target')
    t0=time.perf_counter(); out=mod.transform(*params); t1=time.perf_counter()
    t2=time.perf_counter(); ref=base.transform(*params); t3=time.perf_counter()
    Bs=dict(zip(SIZES,params[1:9]))
    ok=check(out,ref,Bs)
    print(f"target {t1-t0:.3f}s base {t3-t2:.3f}s speedup {(t3-t2)/(t1-t0):.1f}x  ALL {'OK' if ok else 'FAIL'}")
EOF
