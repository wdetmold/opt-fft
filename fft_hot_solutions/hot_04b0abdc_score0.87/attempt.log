import os, ctypes, numpy as np, time, sys
try: os.sched_setaffinity(0,{0})
except Exception: pass
import importlib.util
spec=importlib.util.spec_from_file_location('mkl','/tmp/w/mklref.py'); mkl=importlib.util.module_from_spec(spec); spec.loader.exec_module(mkl)
_lib=ctypes.CDLL('/tmp/w/00291a90/implementation.so')
SIZES=(6,8,13,17,23,36,45,64)
for L in SIZES:
    f=getattr(_lib,f'run_{L}')
    f.argtypes=[ctypes.c_void_p]*4+[ctypes.c_long]*2
    f.restype=None

def eng(L,B,m,x0,c):
    one=np.empty(B*L**3,complex); fin=np.empty(B*L**3,complex)
    f=getattr(_lib,f'run_{L}')
    x0c=np.ascontiguousarray(x0.ravel()); cc=np.ascontiguousarray(c.ravel())
    f(x0c.ctypes.data,cc.ctypes.data,one.ctypes.data,fin.ctypes.data,B,m)
    return fin

tols={6:1e-4,8:3e-6,13:1e-9,17:1e-10,23:1e-10,36:1e-10,45:1e-10,64:1e-10}
mls={6:[1000,3000,10000,20000,30000],8:[300,1000,3000,6000,10000],13:[300,600,1000,2000],17:[200,400,800],23:[150,300,600],36:[100,200,400],45:[100,200,400],64:[60,120,240,400]}
for L in SIZES:
    B=2
    rng_x=np.random.default_rng(7+L)
    x0=(rng_x.standard_normal((B,L,L,L))+1j*rng_x.standard_normal((B,L,L,L)))
    rng_c=np.random.default_rng(1000+L)
    c=0.1*(rng_c.standard_normal((B,L,L,L))+1j*rng_c.standard_normal((B,L,L,L)))
    line=f"L={L} tol={tols[L]:.0e}: "
    for m in mls[L]:
        a=eng(L,B,m,x0,c)
        _,b=mkl.run(L,B,m,x0,c)
        e=np.linalg.norm(a-b.ravel())/np.linalg.norm(b)
        line+=f"m={m}:{e:.1e}  "
    print(line, flush=True)
