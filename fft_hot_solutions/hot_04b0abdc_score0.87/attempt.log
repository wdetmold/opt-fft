__attribute__((noinline)) double f8_sh1(){ HEAD __m512i idx=_mm512_set_epi64(3,7,2,6,1,5,0,4); __m512d s0=_mm512_set1_pd(1.0);
    for(long i=0;i<N/8;i++){
        s0=_mm512_permutexvar_pd(idx,s0);
        a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c); a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
        a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c); }
    a0=_mm512_add_pd(a0,s0); TAIL("f8_sh1",8,1) }
__attribute__((noinline)) double f8_sh2(){ HEAD __m512i idx=_mm512_set_epi64(3,7,2,6,1,5,0,4); __m512d s0=_mm512_set1_pd(1.0),s1=s0;
    for(long i=0;i<N/8;i++){
        s0=_mm512_permutexvar_pd(idx,s0); s1=_mm512_permutexvar_pd(idx,s1);
        a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c); a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
        a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c); }
    a0=_mm512_add_pd(a0,s0); a1=_mm512_add_pd(a1,s1); TAIL("f8_sh2",8,2) }
__attribute__((noinline)) double f8_bc1(){ HEAD
    for(long i=0;i<N/8;i++){ const double* p=BUF+((i*64)&1023);
        a0=_mm512_fmadd_pd(_mm512_set1_pd(p[0]),b,a0);
        a1=_mm512_fmadd_pd(a1,b,c); a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
        a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c); }
    TAIL("f8_bc1",8,1) }
__attribute__((noinline)) double f8_bcop2(){ HEAD  // embedded broadcast memory operand
    for(long i=0;i<N/8;i++){ const double* p=BUF+((i*64)&1023);
        __asm__("vfmadd231pd %2%{1to8%}, %3, %0":"+v"(a0):"0"(a0),"m"(p[0]),"v"(b));
        __asm__("vfmadd231pd %2%{1to8%}, %3, %0":"+v"(a1):"0"(a1),"m"(p[1]),"v"(b));
        a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c); a4=_mm512_fmadd_pd(a4,b,c);
        a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c); }
    TAIL("f8_bcop2",8,2) }
int main(){ memset(BUF,1,sizeof BUF);
    for(int r=0;r<2;r++){ f8_l2(); f8_l4(); f8_l8(); f8_l2_s1(); f8_sh1(); f8_sh2(); f8_bc1(); f8_bcop2(); }
    return 0; }
