for b in blocks:
    out.append(b)
out.append('#include "prime_rr.h"\n')
for b in blocks:
    b2 = b.replace('#include "prime_impl_p1.h"', '#include "prime_impl_p2.h"')
    pp = re.search(r'#define PP (\d+)', b2).group(1)
    b2 = b2.replace('#define SUF(x) x##_%s\n'%pp,
        '#define SUF(x) x##_%s\n#define CPDFT cp_dft_rr%s\n#define CPDFTM cp_dft_map_rr%s\n'%(pp,pp,pp))
    b2 = b2.replace('#undef SUF', '#undef SUF\n#undef CPDFT\n#undef CPDFTM')
    out.append(b2)
# add init calls for rr tables into each SUF(init): part2 contains SUF(init)... check
