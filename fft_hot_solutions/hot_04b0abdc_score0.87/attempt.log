src = open('/tmp/w/00291a90/implementation.c').read()
# add tsc instrumentation around SB_64 / PB_64 calls
hook = '''
static unsigned long long TCNT[8];
static inline unsigned long long _rdt(void){ unsigned a,d,c; __asm__ volatile("rdtscp":"=a"(a),"=d"(d),"=c"(c)); return ((unsigned long long)d<<32)|a; }
void get_tcnt(unsigned long long* o){ for(int i=0;i<8;i++){o[i]=TCNT[i]; TCNT[i]=0;} }
'''
import re
i = src.index('void run_64(')
src = src[:i] + hook + src[i:]
# wrap calls inside run_64 only
j = src.index('void run_64(')
k = src.index('void run_36(') if 'void run_36(' in src[j:] else len(src)
seg = src[j:]
# find end of function run_64: next 'void run_' after it
m = re.search(r'\nvoid run_', seg[10:])
end = j + 10 + m.start() if m else len(src)
body = src[j:end]
body = body.replace('SB_64(', '{unsigned long long _t0=_rdt(); SB_64(').replace('PB_64(', '{unsigned long long _t0=_rdt(); PB_64(')
# now close the braces: need to add after the ');' ... simpler: regex each call statement
import re as r2
body2 = r2.sub(r'\{unsigned long long _t0=_rdt\(\); (SB_64\([^;]*\);)', r'{unsigned long long _t0=_rdt(); \1 TCNT[0]+=_rdt()-_t0; TCNT[1]++;}', body)
body2 = r2.sub(r'\{unsigned long long _t0=_rdt\(\); (PB_64\([^;]*\);)', r'{unsigned long long _t0=_rdt(); \1 TCNT[2]+=_rdt()-_t0; TCNT[3]++;}', body2)
src = src[:j] + body2 + src[end:]
open('impl_instr.c','w').write(src)
print('ok')
EOF
