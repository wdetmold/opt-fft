<antml:function_calls>
<antml:invoke name="str_replace_based_edit_tool">
<antml:parameter name="command">create</antml:parameter>
<antml:parameter name="path">/tmp/w/eng/prime_impl.h</antml:parameter>
<antml:parameter name="file_text">// template: requires PP (prime), HH ((PP-1)/2), KB (k block), NSLOT, YP, RS, PS, SUF
// natural-order storage; direct symmetric DFT columns.
static double* SUF(X);
static double* SUF(CS);     // slab c: [i][yb] blocks of CBS (position-major [p][16])
static double* SUF(CP);     // pencil c: [y][v] blocks of CBS
static double SUF(FA)[HH*16] ALIGN64;   // folded a_j (re,im)
static double SUF(FB)[HH*16] ALIGN64;   // folded b_j
static double SUF(ZS)[NSLOT*8*16 + 8] ALIGN64;
static double SUF(TAB)[HH][HH][2] ALIGN64;  // [j-1][k-1] = cos,sin(2pi jk/p)

#define NYB (YP/8)
#define CBS (PP*16+16)

static void SUF(init_tabs)(void){
    for(int j=1;j<=HH;j++) for(int k=1;k<=HH;k++){
        long double ang = 2.0L*3.14159265358979323846264338327950288L*((long)j*k % PP)/(long double)PP;
        SUF(TAB)[j-1][k-1][0] = (double)cosl(ang);
        SUF(TAB)[j-1][k-1][1] = (double)sinl(ang);
    }
}

// fold phase: read positions, write FA/FB, and write X0 accum to FA[HH-?]..
// store x0 and DC sum in SUF(FA) tail? keep in separate statics:
static double SUF(DC)[4*8] ALIGN64;  // x0r,x0i, sumr, sumi

__attribute__((noinline))
static void SUF(fold)(const double* src, long st){
    __m512d sr = _mm512_load_pd(src), si = _mm512_load_pd(src+8);
    _mm512_store_pd(SUF(DC), sr); _mm512_store_pd(SUF(DC)+8, si);
    for(int j=1;j<=HH;j++){
        __m512d ur=_mm512_load_pd(src + (long)j*st), ui=_mm512_load_pd(src + (long)j*st + 8);
        __m512d vr=_mm512_load_pd(src + (long)(PP-j)*st), vi=_mm512_load_pd(src + (long)(PP-j)*st + 8);
        __m512d ar=_mm512_add_pd(ur,vr), ai=_mm512_add_pd(ui,vi);
        __m512d br=_mm512_sub_pd(ur,vr), bi=_mm512_sub_pd(ui,vi);
        _mm512_store_pd(SUF(FA)+(j-1)*16, ar); _mm512_store_pd(SUF(FA)+(j-1)*16+8, ai);
        _mm512_store_pd(SUF(FB)+(j-1)*16, br); _mm512_store_pd(SUF(FB)+(j-1)*16+8, bi);
        sr=_mm512_add_pd(sr,ar); si=_mm512_add_pd(si,ai);
    }
    _mm512_store_pd(SUF(DC)+16, sr); _mm512_store_pd(SUF(DC)+24, si);
}

// k-phase for k in [k0, k0+nk): accumulate and write outputs (plain) to dst
#define KPH_DECL __m512d C0r,C0i,S0r,S0i,C1r,C1i,S1r,S1i,C2r,C2i,S2r,S2i,C3r,C3i,S3r,S3i;
#define KPH_INIT(x0r,x0i) \
    C0r=x0r; C0i=x0i; S0r=_mm512_setzero_pd(); S0i=S0r; \
    C1r=x0r; C1i=x0i; S1r=S0r; S1i=S0r; \
    C2r=x0r; C2i=x0i; S2r=S0r; S2i=S0r; \
    C3r=x0r; C3i=x0i; S3r=S0r; S3i=S0r;
#define KACC(KI, j, k) do{ \
    __m512d cc=_mm512_set1_pd(SUF(TAB)[j-1][k-1][0]); \
    __m512d ss=_mm512_set1_pd(SUF(TAB)[j-1][k-1][1]); \
    C##KI##r=_mm512_fmadd_pd(cc, ar, C##KI##r); \
    C##KI##i=_mm512_fmadd_pd(cc, ai, C##KI##i); \
    S##KI##r=_mm512_fmadd_pd(ss, br, S##KI##r); \
    S##KI##i=_mm512_fmadd_pd(ss, bi, S##KI##i); \
}while(0)
// output pair k: X[k] = (Cr - Si, Ci + Sr), X[p-k] = (Cr + Si, Ci - Sr)
// [forward DFT: X[k] = x0 + sum a_j cos(2pi jk/p) - i... derive:
//  w^{jk} = cos - i sin (ang=2pi jk/p). X[k] = sum_j x_j w^{jk}
//  = x0 + sum_{j=1..h} [x_j w^{jk} + x_{p-j} w^{-jk}]
//  = x0 + sum a_j cos(jk) - i (x_j - x_{p-j}) i ... careful:
//  x_j w^{jk} + x_{p-j} conj(w^{jk}) = a_j cos(jk) - i b_j sin(jk)
//  so X[k] = (x0 + sum a cos) - i (sum b sin) = C - i S
//  => X[k]r = Cr + Si_?  : -i*(Sr + i Si) = Si - i Sr ; X[k] = (Cr + Si, Ci - Sr)
//  X[p-k]: sin flips: (Cr - Si, Ci + Sr) ]
#define KOUT(KI, k, dst, st) do{ \
    _mm512_store_pd((dst)+(long)(k)*(st),      _mm512_add_pd(C##KI##r, S##KI##i)); \
    _mm512_store_pd((dst)+(long)(k)*(st)+8,    _mm512_sub_pd(C##KI##i, S##KI##r)); \
    _mm512_store_pd((dst)+(long)(PP-(k))*(st),   _mm512_sub_pd(C##KI##r, S##KI##i)); \
    _mm512_store_pd((dst)+(long)(PP-(k))*(st)+8, _mm512_add_pd(C##KI##i, S##KI##r)); \
}while(0)
#define KOUTM(KI, k, dst, st, c) do{ \
    __m512d zr1=_mm512_add_pd(_mm512_add_pd(C##KI##r, S##KI##i), _mm512_load_pd((c)+(long)(k)*16)); \
    __m512d zi1=_mm512_add_pd(_mm512_sub_pd(C##KI##i, S##KI##r), _mm512_load_pd((c)+(long)(k)*16+8)); \
    __m512d zr2=_mm512_add_pd(_mm512_sub_pd(C##KI##r, S##KI##i), _mm512_load_pd((c)+(long)(PP-(k))*16)); \
    __m512d zi2=_mm512_add_pd(_mm512_add_pd(C##KI##i, S##KI##r), _mm512_load_pd((c)+(long)(PP-(k))*16+8)); \
    MAP2(zr1,zi1); MAP2(zr2,zi2); \
    _mm512_store_pd((dst)+(long)(k)*(st),      zr1); \
    _mm512_store_pd((dst)+(long)(k)*(st)+8,    zi1); \
    _mm512_store_pd((dst)+(long)(PP-(k))*(st),   zr2); \
    _mm512_store_pd((dst)+(long)(PP-(k))*(st)+8, zi2); \
}while(0)

// plain DFT column in place (positions 0..PP-1 at stride st)
__attribute__((noinline))
static void SUF(cp_dft)(double* p_, long st){
    SUF(fold)(p_, st);
    __m512d x0r=_mm512_load_pd(SUF(DC)), x0i=_mm512_load_pd(SUF(DC)+8);
    for(int k0=1; k0<=HH; k0+=KB){
        KPH_DECL
        KPH_INIT(x0r, x0i)
        for(int j=1;j<=HH;j++){
            __m512d ar=_mm512_load_pd(SUF(FA)+(j-1)*16), ai=_mm512_load_pd(SUF(FA)+(j-1)*16+8);
            __m512d br=_mm512_load_pd(SUF(FB)+(j-1)*16), bi=_mm512_load_pd(SUF(FB)+(j-1)*16+8);
            KACC(0, j, (k0));
            if(k0+1<=HH) KACC(1, j, (k0+1));
            if(k0+2<=HH) KACC(2, j, (k0+2));
            if(KB>3 && k0+3<=HH) KACC(3, j, (k0+3));
        }
        KOUT(0, k0, p_, st);
        if(k0+1<=HH) KOUT(1, k0+1, p_, st);
        if(k0+2<=HH) KOUT(2, k0+2, p_, st);
        if(KB>3 && k0+3<=HH) KOUT(3, k0+3, p_, st);
    }
    _mm512_store_pd(p_, _mm512_load_pd(SUF(DC)+16));
    _mm512_store_pd(p_+8, _mm512_load_pd(SUF(DC)+24));
}
// DFT column + (c,map) at outputs
__attribute__((noinline))
static void SUF(cp_dft_map)(double* p_, long st, const double* c){
    SUF(fold)(p_, st);
    __m512d x0r=_mm512_load_pd(SUF(DC)), x0i=_mm512_load_pd(SUF(DC)+8);
    for(int k0=1; k0<=HH; k0+=KB){
        KPH_DECL
        KPH_INIT(x0r, x0i)
        for(int j=1;j<=HH;j++){
            __m512d ar=_mm512_load_pd(SUF(FA)+(j-1)*16), ai=_mm512_load_pd(SUF(FA)+(j-1)*16+8);
            __m512d br=_mm512_load_pd(SUF(FB)+(j-1)*16), bi=_mm512_load_pd(SUF(FB)+(j-1)*16+8);
            KACC(0, j, (k0));
            if(k0+1<=HH) KACC(1, j, (k0+1));
            if(k0+2<=HH) KACC(2, j, (k0+2));
            if(KB>3 && k0+3<=HH) KACC(3, j, (k0+3));
        }
        KOUTM(0, k0, p_, st, c);
        if(k0+1<=HH) KOUTM(1, k0+1, p_, st, c);
        if(k0+2<=HH) KOUTM(2, k0+2, p_, st, c);
        if(KB>3 && k0+3<=HH) KOUTM(3, k0+3, p_, st, c);
    }
    { __m512d zr=_mm512_add_pd(_mm512_load_pd(SUF(DC)+16), _mm512_load_pd(c));
      __m512d zi=_mm512_add_pd(_mm512_load_pd(SUF(DC)+24), _mm512_load_pd(c+8));
      MAP2(zr,zi);
      _mm512_store_pd(p_, zr); _mm512_store_pd(p_+8, zi); }
}

// trin / trout (NSLOT tiles)
__attribute__((noinline))
static void SUF(trin)(const double* rb){
    for(int v=0; v<NSLOT; v++){
        __m512d a0,a1,a2,a3,a4,a5,a6,a7,b0,b1,b2,b3,b4,b5,b6,b7;
        a0=_mm512_load_pd(rb+0*RS+v*16); b0=_mm512_load_pd(rb+0*RS+v*16+8);
        a1=_mm512_load_pd(rb+1*RS+v*16); b1=_mm512_load_pd(rb+1*RS+v*16+8);
        a2=_mm512_load_pd(rb+2*RS+v*16); b2=_mm512_load_pd(rb+2*RS+v*16+8);
        a3=_mm512_load_pd(rb+3*RS+v*16); b3=_mm512_load_pd(rb+3*RS+v*16+8);
        a4=_mm512_load_pd(rb+4*RS+v*16); b4=_mm512_load_pd(rb+4*RS+v*16+8);
        a5=_mm512_load_pd(rb+5*RS+v*16); b5=_mm512_load_pd(rb+5*RS+v*16+8);
        a6=_mm512_load_pd(rb+6*RS+v*16); b6=_mm512_load_pd(rb+6*RS+v*16+8);
        a7=_mm512_load_pd(rb+7*RS+v*16); b7=_mm512_load_pd(rb+7*RS+v*16+8);
        TR8(a0,a1,a2,a3,a4,a5,a6,a7);
        TR8(b0,b1,b2,b3,b4,b5,b6,b7);
        double* z = SUF(ZS) + v*8*16;
        _mm512_store_pd(z+0*16, a0); _mm512_store_pd(z+0*16+8, b0);
        _mm512_store_pd(z+1*16, a1); _mm512_store_pd(z+1*16+8, b1);
        _mm512_store_pd(z+2*16, a2); _mm512_store_pd(z+2*16+8, b2);
        _mm512_store_pd(z+3*16, a3); _mm512_store_pd(z+3*16+8, b3);
        _mm512_store_pd(z+4*16, a4); _mm512_store_pd(z+4*16+8, b4);
        _mm512_store_pd(z+5*16, a5); _mm512_store_pd(z+5*16+8, b5);
        _mm512_store_pd(z+6*16, a6); _mm512_store_pd(z+6*16+8, b6);
        _mm512_store_pd(z+7*16, a7); _mm512_store_pd(z+7*16+8, b7);
    }
}
__attribute__((noinline))
static void SUF(trout)(double* rb){
    for(int v=0; v<NSLOT; v++){
        const double* z = SUF(ZS) + v*8*16;
        __m512d a0,a1,a2,a3,a4,a5,a6,a7,b0,b1,b2,b3,b4,b5,b6,b7;
        a0=_mm512_load_pd(z+0*16); b0=_mm512_load_pd(z+0*16+8);
        a1=_mm512_load_pd(z+1*16); b1=_mm512_load_pd(z+1*16+8);
        a2=_mm512_load_pd(z+2*16); b2=_mm512_load_pd(z+2*16+8);
        a3=_mm512_load_pd(z+3*16); b3=_mm512_load_pd(z+3*16+8);
        a4=_mm512_load_pd(z+4*16); b4=_mm512_load_pd(z+4*16+8);
        a5=_mm512_load_pd(z+5*16); b5=_mm512_load_pd(z+5*16+8);
        a6=_mm512_load_pd(z+6*16); b6=_mm512_load_pd(z+6*16+8);
        a7=_mm512_load_pd(z+7*16); b7=_mm512_load_pd(z+7*16+8);
        TR8(a0,a1,a2,a3,a4,a5,a6,a7);
        TR8(b0,b1,b2,b3,b4,b5,b6,b7);
        _mm512_store_pd(rb+0*RS+v*16, a0); _mm512_store_pd(rb+0*RS+v*16+8, b0);
        _mm512_store_pd(rb+1*RS+v*16, a1); _mm512_store_pd(rb+1*RS+v*16+8, b1);
        _mm512_store_pd(rb+2*RS+v*16, a2); _mm512_store_pd(rb+2*RS+v*16+8, b2);
        _mm512_store_pd(rb+3*RS+v*16, a3); _mm512_store_pd(rb+3*RS+v*16+8, b3);
        _mm512_store_pd(rb+4*RS+v*16, a4); _mm512_store_pd(rb+4*RS+v*16+8, b4);
        _mm512_store_pd(rb+5*RS+v*16, a5); _mm512_store_pd(rb+5*RS+v*16+8, b5);
        _mm512_store_pd(rb+6*RS+v*16, a6); _mm512_store_pd(rb+6*RS+v*16+8, b6);
        _mm512_store_pd(rb+7*RS+v*16, a7); _mm512_store_pd(rb+7*RS+v*16+8, b7);
    }
}

// SB modes: 0 = FyFz plain; 1 = steady; 2 = final
static void SUF(SB)(int mode){
    for(int i=0;i<PP;i++){
        double* pl = SUF(X) + (long)i*PS;
        for(int v=0; v<NSLOT; v++){ SUF(cp_dft)(pl + v*16, RS); }
        for(int yb=0; yb<NYB; yb++){
            double* rb = pl + (long)yb*8*RS;
            SUF(trin)(rb);
            if(mode==0){ SUF(cp_dft)(SUF(ZS), 16); }
            else if(mode==2){ SUF(cp_dft_map)(SUF(ZS), 16, SUF(CS) + ((long)i*NYB+yb)*CBS); }
            else {
                SUF(cp_dft_map)(SUF(ZS), 16, SUF(CS) + ((long)i*NYB+yb)*CBS);
                SUF(cp_dft)(SUF(ZS), 16);
            }
            SUF(trout)(rb);
        }
        if(mode==1){
            for(int v=0; v<NSLOT; v++){ SUF(cp_dft)(pl + v*16, RS); }
        }
    }
}
// PB modes: 0 = Fx plain; 1 = Fx,+c,map; 2 = steady
static void SUF(PB)(int mode){
    for(int y=0;y<PP;y++){
        for(int v=0;v<NSLOT;v++){
            double* p = SUF(X) + (long)y*RS + v*16;
            if(mode==0){ SUF(cp_dft)(p, PS); }
            else if(mode==1){ SUF(cp_dft_map)(p, PS, SUF(CP) + ((long)y*NSLOT+v)*CBS); }
            else {
                SUF(cp_dft_map)(p, PS, SUF(CP) + ((long)y*NSLOT+v)*CBS);
                SUF(cp_dft)(p, PS);
            }
        }
    }
}

static void SUF(convin)(const double* in, double* X){
    for(int ip=0;ip<PP;ip++)
        for(int yp=0;yp<PP;yp++){
            const double* s = in + 2*(((long)ip*PP+yp)*PP);
            double* d = X + (long)ip*PS + (long)yp*RS;
            for(int zp=0;zp<PP;zp++){
                d[(zp/8)*16 + (zp%8)]     = s[2*zp];
                d[(zp/8)*16 + 8 + (zp%8)] = s[2*zp+1];
            }
        }
}
static void SUF(convout)(const double* X, double* out){
    for(int ip=0;ip<PP;ip++)
        for(int yp=0;yp<PP;yp++){
            double* s = out + 2*(((long)ip*PP+yp)*PP);
            const double* d = X + (long)ip*PS + (long)yp*RS;
            for(int zp=0;zp<PP;zp++){
                s[2*zp]   = d[(zp/8)*16 + (zp%8)];
                s[2*zp+1] = d[(zp/8)*16 + 8 + (zp%8)];
            }
        }
}
static void SUF(build_cs)(const double* c, double* CS){
    for(int i=0;i<PP;i++)
        for(int yb=0;yb<NYB;yb++){
            double* blk = CS + ((long)i*NYB+yb)*CBS;
            for(int q=0;q<PP;q++)
                for(int l=0;l<8;l++){
                    int yy=8*yb+l;
                    if(yy<PP){
                        const double* s = c + 2*(((long)i*PP+yy)*PP+q);
                        blk[q*16+l]=s[0]; blk[q*16+8+l]=s[1];
                    } else { blk[q*16+l]=0.0; blk[q*16+8+l]=0.0; }
                }
        }
}
static void SUF(build_cp)(const double* c, double* CP){
    for(int y=0;y<PP;y++)
        for(int v=0;v<NSLOT;v++){
            double* blk = CP + ((long)y*NSLOT+v)*CBS;
            for(int q=0;q<PP;q++)
                for(int l=0;l<8;l++){
                    int zz=8*v+l;
                    if(zz<PP){
                        const double* s = c + 2*(((long)q*PP+y)*PP+zz);
                        blk[q*16+l]=s[0]; blk[q*16+8+l]=s[1];
                    } else { blk[q*16+l]=0.0; blk[q*16+8+l]=0.0; }
                }
        }
}

static void SUF(init)(void){
    if(SUF(X)) return;
    SUF(init_tabs)();
    SUF(X)  = alloc_big2((long)PP*PS*8);
    SUF(CS) = alloc_big2((long)PP*NYB*CBS*8);
    SUF(CP) = alloc_big2((long)PP*NSLOT*CBS*8);
}

#define L3SZ ((long)PP*PP*PP)
void SUF(run)(const double* x0, const double* c, double* out1, double* outm, long B, long m){
    SUF(init)();
    if(m<1) m=1;
    for(long b=0;b<B;b++){
        SUF(convin)(x0 + b*2*L3SZ, SUF(X));
        SUF(build_cs)(c + b*2*L3SZ, SUF(CS));
        SUF(build_cp)(c + b*2*L3SZ, SUF(CP));
        SUF(SB)(0);
        SUF(PB)(1);
        SUF(convout)(SUF(X), out1 + b*2*L3SZ);
        if(m==1){ memcpy(outm + b*2*L3SZ, out1 + b*2*L3SZ, L3SZ*16); continue; }
        SUF(PB)(0);
        for(long t=2;t<=m;t++){
            if((t&1)==0){ SUF(SB)(t==m ? 2 : 1); }
            else        { SUF(PB)(t==m ? 1 : 2); }
        }
        SUF(convout)(SUF(X), outm + b*2*L3SZ);
    }
}
#undef NYB
#undef CBS
#undef L3SZ
#undef KPH_DECL
#undef KPH_INIT
#undef KACC
#undef KOUT
#undef KOUTM
