import ctypes, numpy as np, os, time
try: os.sched_setaffinity(0,{0})
except Exception: pass
lib2=ctypes.CDLL('/tmp/w/eng/primes2.so')
libc=ctypes.CDLL('/tmp/w/eng/combined.so')   # prior-engine routing
for L,m in ((13,3000),(17,1200),(23,800)):
    for B in (4,8):
        row=f"L={L} B={B}:"
        for tag,lib in (('rr',lib2),('prior',libc)):
            f=getattr(lib,f'run_{L}')
            f.argtypes=[ctypes.c_void_p]*4+[ctypes.c_long]*2
            rng=np.random.default_rng(1)
            x0=rng.standard_normal((B,2*L**3)); c=0.1*rng.standard_normal((B,2*L**3))
            o1=np.empty(B*L**3*2); om=np.empty(B*L**3*2)
            f(x0.ctypes.data,c.ctypes.data,o1.ctypes.data,om.ctypes.data,B,3)
            best=1e9
            for _ in range(3):
                t0=time.perf_counter(); f(x0.ctypes.data,c.ctypes.data,o1.ctypes.data,om.ctypes.data,B,m); t1=time.perf_counter()
                best=min(best,t1-t0)
            row+=f"  {tag} {best/(B*L**3*m)*1e9:.3f}"
        print(row+" ns/pt-step", flush=True)
