#include <immintrin.h>
#include <stdio.h>
static inline unsigned long long rdt(void){ unsigned a,d,c; __asm__ volatile("rdtscp":"=a"(a),"=d"(d),"=c"(c)); return ((unsigned long long)d<<32)|a; }
#define N 10000000L
#define MK(name, op) __attribute__((noinline)) double name(void){ \
    __m512d a0=_mm512_set1_pd(1.3),a1=_mm512_set1_pd(2.1),a2=_mm512_set1_pd(0.7),a3=_mm512_set1_pd(3.3); \
