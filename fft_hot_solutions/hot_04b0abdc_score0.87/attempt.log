    __m512d one=_mm512_set1_pd(1.0); \
    unsigned long long t=rdt(); \
    for(long i=0;i<N/8;i++){ \
        a0=op(_mm512_add_pd(a0,one)); a1=op(_mm512_add_pd(a1,one)); \
        a2=op(_mm512_add_pd(a2,one)); a3=op(_mm512_add_pd(a3,one)); \
        a4=op(_mm512_add_pd(a4,one)); a5=op(_mm512_add_pd(a5,one)); \
        a6=op(_mm512_add_pd(a6,one)); a7=op(_mm512_add_pd(a7,one)); } \
    double el=(double)(rdt()-t)/N; \
    printf("%-14s: %5.2f tsc/op (8 chains; incl 1 add)\n", #name, el); \
    return _mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3))); }
