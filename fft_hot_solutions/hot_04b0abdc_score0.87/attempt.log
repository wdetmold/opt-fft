One more SB-64 idea: interleave the next block's independent S1 *inside* the fused loop body (fills map stalls within OOO lookahead). Test in harness first:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/eng && python3 - <<'EOF'
s=open('stall.c').read()
add='''
static double SCRA2X[64*16] ALIGN64;
static double PLANE2[64*144] ALIGN64;
// fused stage iteration + next-block s1 tile in the same loop body
__attribute__((noinline)) static void fullpair(void){
    const __m512d S=_mm512_set1_pd(S8C);
    for(int k1=0;k1<8;k1++){
        const double* p=SCRA+k1*128; const double* cc=CBLK+k1*128; double* q=SCRB+k1*16;
        LOADX DODFT ADDC DOMAPS DFT2ND if(k1){TW7(k1,zr,zi);} STZ
        // next-block zcol_s1 tile v=k1 (independent)
        {
            const double* p2 = PLANE2 + k1*16;
            DECL16(ar,ai)
            LOAD16(p2, 144, ar, ai)
            TR8(ar0,ar1,ar2,ar3,ar4,ar5,ar6,ar7);
            TR8(ai0,ai1,ai2,ai3,ai4,ai5,ai6,ai7);
            DECL16(br,bi)
            DFT8(S, ar0,ai0,ar1,ai1,ar2,ai2,ar3,ai3,ar4,ai4,ar5,ai5,ar6,ai6,ar7,ai7,
                    br0,bi0,br1,bi1,br2,bi2,br3,bi3,br4,bi4,br5,bi5,br6,bi6,br7,bi7);
            if(k1){ TW7(k1, br, bi); }
            double* q2 = SCRA2X + k1*16;
            _mm512_store_pd(q2+0*128, br0); _mm512_store_pd(q2+0*128+8, bi0);
            _mm512_store_pd(q2+1*128, br1); _mm512_store_pd(q2+1*128+8, bi1);
            _mm512_store_pd(q2+2*128, br2); _mm512_store_pd(q2+2*128+8, bi2);
            _mm512_store_pd(q2+3*128, br3); _mm512_store_pd(q2+3*128+8, bi3);
            _mm512_store_pd(q2+4*128, br4); _mm512_store_pd(q2+4*128+8, bi4);
            _mm512_store_pd(q2+5*128, br5); _mm512_store_pd(q2+5*128+8, bi5);
            _mm512_store_pd(q2+6*128, br6); _mm512_store_pd(q2+6*128+8, bi6);
            _mm512_store_pd(q2+7*128, br7); _mm512_store_pd(q2+7*128+8, bi7);
        }
    }
}
// reference: zs1 alone
__attribute__((noinline)) static void zs1only(void){
    const __m512d S=_mm512_set1_pd(S8C);
    for(int k1=0;k1<8;k1++){
        const double* p2 = PLANE2 + k1*16;
        DECL16(ar,ai)
        LOAD16(p2, 144, ar, ai)
        TR8(ar0,ar1,ar2,ar3,ar4,ar5,ar6,ar7);
        TR8(ai0,ai1,ai2,ai3,ai4,ai5,ai6,ai7);
        DECL16(br,bi)
        DFT8(S, ar0,ai0,ar1,ai1,ar2,ai2,ar3,ai3,ar4,ai4,ar5,ai5,ar6,ai6,ar7,ai7,
                br0,bi0,br1,bi1,br2,bi2,br3,bi3,br4,bi4,br5,bi5,br6,bi6,br7,bi7);
        if(k1){ TW7(k1, br, bi); }
        double* q2 = SCRA2X + k1*16;
        _mm512_store_pd(q2+0*128, br0); _mm512_store_pd(q2+0*128+8, bi0);
        _mm512_store_pd(q2+1*128, br1); _mm512_store_pd(q2+1*128+8, bi1);
        _mm512_store_pd(q2+2*128, br2); _mm512_store_pd(q2+2*128+8, bi2);
        _mm512_store_pd(q2+3*128, br3); _mm512_store_pd(q2+3*128+8, bi3);
        _mm512_store_pd(q2+4*128, br4); _mm512_store_pd(q2+4*128+8, bi4);
