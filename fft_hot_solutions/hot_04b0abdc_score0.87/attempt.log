src=src.replace('#define CPDFT cp_dft_rr23','#define CPDFT cp_dft_rr23\n#define INITRR init_rr23')
src=src.replace('#undef CPDFT','#undef CPDFT\n#undef INITRR')
open('primes2.c','w').write(src)
print('ok')
