Large-B verified. Now one more real optimization with the remaining budget: the prime k-phase with **register-resident constants** (only h distinct cos/sin values per prime — compile-time (j,k)→register mapping, reg-reg FMAs instead of broadcast-fed ones — the technique the notes credit for the prime wins). Writing a generator:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">mkdir -p /tmp/w/pg && cat > /tmp/w/pg/genprime.py <<'EOF'
#!/usr/bin/env python3
# emit register-resident-constant k-phase prime DFT codelets for p in {13,17,23}
import sys

def emit(p, KBLK, split):
    h = (p-1)//2
    L = []
    A = L.append
    name = f"rr{p}"
    # constant table: CT[t-1] = cos(2pi t/p), ST[t-1] = sin(2pi t/p), t=1..h  (via long double in C init)
    A(f"static double CT_{p}[{h}][8] ALIGN64, ST_{p}[{h}][8] ALIGN64;")
    A(f"static void init_{name}(void){{")
    A(f"    for(int t=1;t<={h};t++){{ long double a=2.0L*3.14159265358979323846264338327950288L*t/{p}.0L;")
    A(f"        for(int l=0;l<8;l++){{ CT_{p}[t-1][l]=(double)cosl(a); ST_{p}[t-1][l]=(double)sinl(a); }} }}")
    A(f"}}")
    # index/sign map: for j,k: t=(j*k)%p ; if t>h: t=p-t, sgn=-1 else sgn=+1  (cos even: reg ct[t]; sin: sgn*st[t])
    def jk(j,k):
        t=(j*k)%p
        if t>h: return (p-t, -1)
        return (t, 1)
    # k blocks
    kblocks=[]
    k=1
    while k<=h:
        kblocks.append(list(range(k, min(k+KBLK, h+1))))
        k+=KBLK
    for variant in ('plain','map'):
        fname = f"cp_dft_{name}" if variant=='plain' else f"cp_dft_map_{name}"
        args = "double* p_, long st" + (", const double* c" if variant=='map' else "")
        A(f"__attribute__((noinline)) static void {fname}({args}){{")
        A(f"    fold_{p}(p_, st);")
        A(f"    __m512d x0r=_mm512_load_pd(DC_{p}), x0i=_mm512_load_pd(DC_{p}+8);")
        if not split:
            # preload all h cos + h sin consts
            for t in range(1,h+1):
                A(f"    const __m512d ct{t}=_mm512_load_pd(CT_{p}[{t-1}]);")
            for t in range(1,h+1):
                A(f"    const __m512d st{t}=_mm512_load_pd(ST_{p}[{t-1}]);")
            for blk in kblocks:
                # init accumulators
                for k_ in blk:
