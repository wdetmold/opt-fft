// aligned block with controlled low-12 offsets:
static struct { double A[64*16]; double padA[256]; double C[64*16]; double padC[64]; double B2[64*16]; } ALIGN64 SCX;
// layout: A at 0 mod 4096 (8KB), padA=2KB -> C at (8192+2048)%4096 = 2048 mod 4096, padC=512B -> B2 at 2048+8192+512 = 2560 mod 4096
__attribute__((noinline)) static void sA(void){
    const __m512d S=_mm512_set1_pd(S8C);
    for(int k1=0;k1<8;k1++){
        const double* p=SCX.A+k1*128; const double* cc=CBLK+k1*128; double* q2=SCX.C+k1*128;
        LOADX DODFT ADDC
        _mm512_store_pd(q2+0, yr0); _mm512_store_pd(q2+8, yi0);
        _mm512_store_pd(q2+16, yr1); _mm512_store_pd(q2+24, yi1);
        _mm512_store_pd(q2+32, yr2); _mm512_store_pd(q2+40, yi2);
        _mm512_store_pd(q2+48, yr3); _mm512_store_pd(q2+56, yi3);
        _mm512_store_pd(q2+64, yr4); _mm512_store_pd(q2+72, yi4);
        _mm512_store_pd(q2+80, yr5); _mm512_store_pd(q2+88, yi5);
        _mm512_store_pd(q2+96, yr6); _mm512_store_pd(q2+104, yi6);
        _mm512_store_pd(q2+112, yr7); _mm512_store_pd(q2+120, yi7);
    }
}
__attribute__((noinline)) static void sB(void){
    const __m512d S=_mm512_set1_pd(S8C);
    for(int k1=0;k1<8;k1++){
        const double* p=SCX.C+k1*128; double* q=SCX.B2+k1*16;
        LOADX
        __m512d yr0=xr0,yi0=xi0,yr1=xr1,yi1=xi1,yr2=xr2,yi2=xi2,yr3=xr3,yi3=xi3,
                yr4=xr4,yi4=xi4,yr5=xr5,yi5=xi5,yr6=xr6,yi6=xi6,yr7=xr7,yi7=xi7;
        DOMAPS DFT2ND if(k1){TW7(k1,zr,zi);} STZ
    }
}
__attribute__((noinline)) static void splitX(void){ sA(); sB(); }
__attribute__((noinline)) static void fullX(void){
    const __m512d S=_mm512_set1_pd(S8C);
    for(int k1=0;k1<8;k1++){
        const double* p=SCX.A+k1*128; const double* cc=CBLK+k1*128; double* q=SCX.B2+k1*16;
        LOADX DODFT ADDC DOMAPS DFT2ND if(k1){TW7(k1,zr,zi);} STZ
    }
}
'''
i=s.index('int main(){')
