The load test used a 512KB buffer (L2). Let me redo with L1-resident data and test co-issue of FMA with loads:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cat > /tmp/w/mb/mb2.c <<'EOF'
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <immintrin.h>
#include <time.h>
static inline uint64_t rdtscp(){ unsigned a,d,c; __asm__ volatile("rdtscp":"=a"(a),"=d"(d),"=c"(c)); return ((uint64_t)d<<32)|a; }
static double BUF[512] __attribute__((aligned(64)));   // 4KB, L1
#define N 100000000L
// r FMA per 1 load from L1
#define MK(FN, NF) \
__attribute__((noinline)) double FN(){ \
    __m512d a0=_mm512_set1_pd(1e-18),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0; \
    __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-18); \
    uint64_t c0=rdtscp(); \
    for(long i=0;i<N/8;i++){ \
        const double* p=BUF + ((i*64)&511); \
        a0=_mm512_fmadd_pd(_mm512_load_pd(p),b,a0); \
        a1=_mm512_fmadd_pd(a1,b,c); a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c); \
        if(NF>4){ a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);} \
    } \
    uint64_t c1=rdtscp(); \
    double s=_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)))+_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7))); \
    double fml=(NF)*(double)(N/8), vu=fml+(double)(N/8); \
    printf(#FN ": %.3f fma/tsc  %.3f vuops/tsc (sink %g)\n", fml/(c1-c0), vu/(c1-c0), s); \
    return s; }
MK(fma4_ld1, 4)
MK(fma8_ld1, 8)
// 2 loads 2 fma
__attribute__((noinline)) double fma2_ld2(){
    __m512d a0=_mm512_set1_pd(1e-18),a1=a0,a2=a0,a3=a0;
    __m512d b=_mm512_set1_pd(0.9999999);
    uint64_t c0=rdtscp();
    for(long i=0;i<N/8;i++){
        const double* p=BUF + ((i*64)&511);
        a0=_mm512_fmadd_pd(_mm512_load_pd(p),b,a0);
        a1=_mm512_fmadd_pd(_mm512_load_pd(p+8),b,a1);
        a2=_mm512_fmadd_pd(_mm512_load_pd(p+16),b,a2);
        a3=_mm512_fmadd_pd(_mm512_load_pd(p+24),b,a3);
    }
    uint64_t c1=rdtscp();
    double s=_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)));
    printf("fma4_ld4: %.3f fma/tsc %.3f vuops/tsc (sink %g)\n", (double)(N/2)/(c1-c0), (double)N/(c1-c0), s);
    return s;
}
// ymm version: 8 fma ymm + 1 load
__attribute__((noinline)) double yfma8_ld1(){
    __m256d a0=_mm256_set1_pd(1e-18),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m256d b=_mm256_set1_pd(0.9999999), c=_mm256_set1_pd(1e-18);
    uint64_t c0=rdtscp();
    for(long i=0;i<N/8;i++){
        const double* p=BUF + ((i*64)&511);
        a0=_mm256_fmadd_pd(_mm256_load_pd(p),b,a0);
        a1=_mm256_fmadd_pd(a1,b,c); a2=_mm256_fmadd_pd(a2,b,c); a3=_mm256_fmadd_pd(a3,b,c);
        a4=_mm256_fmadd_pd(a4,b,c); a5=_mm256_fmadd_pd(a5,b,c); a6=_mm256_fmadd_pd(a6,b,c); a7=_mm256_fmadd_pd(a7,b,c);
    }
    uint64_t c1=rdtscp();
    double s=_mm256_cvtsd_f64(_mm256_add_pd(_mm256_add_pd(a0,a1),_mm256_add_pd(a2,a3)))+_mm256_cvtsd_f64(_mm256_add_pd(_mm256_add_pd(a4,a5),_mm256_add_pd(a6,a7)));
    printf("yfma8_ld1: %.3f fma/tsc %.3f vuops/tsc (sink %g)\n", (double)N/(c1-c0), (double)(N+N/8)/(c1-c0), s);
    return s;
}
// fma + store mix 4:1
__attribute__((noinline)) double fma8_st1(){
    __m512d a0=_mm512_set1_pd(1e-18),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-18);
    uint64_t c0=rdtscp();
    for(long i=0;i<N/8;i++){
