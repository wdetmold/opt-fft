Prior notes endorse "stage-interleaved map pipelines" — a 1-stage software pipeline with memory staging so the map latency of iteration k hides under the second DFT of k−1. Build it in the harness:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/eng && python3 - <<'EOF'
s=open('stall.c').read()
add='''
static struct { double pad0[64]; double D[64*16]; } ALIGN64 SCD;  // staging, offset 512B
// software-pipelined fused stage: iter k does [DFT2+TW+ST for k-1] + [DFT1+c+map -> SCD for k]
__attribute__((noinline)) static void fullpipe(void){
    const __m512d S=_mm512_set1_pd(S8C);
    for(int k1=0;k1<9;k1++){
        if(k1<8){
            const double* p=SCRA+k1*128; const double* cc=CBLK+k1*128;
            LOADX DODFT ADDC DOMAPS
            double* qd=SCD.D+k1*128;
            _mm512_store_pd(qd+0, yr0); _mm512_store_pd(qd+8, yi0);
            _mm512_store_pd(qd+16, yr1); _mm512_store_pd(qd+24, yi1);
            _mm512_store_pd(qd+32, yr2); _mm512_store_pd(qd+40, yi2);
            _mm512_store_pd(qd+48, yr3); _mm512_store_pd(qd+56, yi3);
            _mm512_store_pd(qd+64, yr4); _mm512_store_pd(qd+72, yi4);
            _mm512_store_pd(qd+80, yr5); _mm512_store_pd(qd+88, yi5);
            _mm512_store_pd(qd+96, yr6); _mm512_store_pd(qd+104, yi6);
            _mm512_store_pd(qd+112, yr7); _mm512_store_pd(qd+120, yi7);
        }
        if(k1>0){
            int k0=k1-1;
            const double* p=SCD.D+k0*128; double* q=SCRB+k0*16;
            LOADX
            __m512d yr0=xr0,yi0=xi0,yr1=xr1,yi1=xi1,yr2=xr2,yi2=xi2,yr3=xr3,yi3=xi3,
                    yr4=xr4,yi4=xi4,yr5=xr5,yi5=xi5,yr6=xr6,yi6=xi6,yr7=xr7,yi7=xi7;
            DFT2ND if(k0){TW7(k0,zr,zi);} STZ
        }
    }
}
'''
i=s.index('int main(){')
s=s[:i]+add+s[i:]
s=s.replace('MB(full) MB(full6) MB(maponly) MB(maponly6)','MB(full) MB(fullpipe) MB(full) MB(fullpipe)')
open('stall.c','w').write(s)
EOF
