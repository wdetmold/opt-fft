import ctypes, numpy as np
lib=ctypes.CDLL('/tmp/w/eng/pfa.so')
L=45
getattr(lib,f't_tr_{L}').argtypes=[ctypes.c_void_p]*2
rng=np.random.default_rng(5)
x=(rng.standard_normal((L,L,L))+1j*rng.standard_normal((L,L,L)))
xc=np.ascontiguousarray(x.ravel()); out=np.empty(L**3,complex)
getattr(lib,f't_tr_{L}')(xc.ctypes.data,out.ctypes.data)
print("trin/trout roundtrip:", np.abs(out-xc).max())
# also test a 1D DFT with PFA order in numpy to verify my OPOS math
N1,N2,LL=5,9,45
VAL=[(N2*n1+N1*n2)%LL for n2 in range(N2) for n1 in range(N1)]
v=rng.standard_normal(LL)+1j*rng.standard_normal(LL)
# state: position q holds value VAL[q]
st=np.array([v[VAL[q]] for q in range(LL)])
# S1: for each n2: DFT5 of positions n2*5+n1
A=np.zeros((N1,N2),complex)
for n2 in range(N2):
    grp=st[n2*N1:(n2+1)*N1]
    A[:,n2]=np.fft.fft(grp)
# S2: for each k1: DFT9 over n2
out1=np.zeros(LL,complex)
n1inv=[a for a in range(N2) if (a*N1)%N2==1][0]
n2inv=[a for a in range(N1) if (a*N2)%N1==1][0]
for k1 in range(N1):
    Y=np.fft.fft(A[k1,:])
    for k2 in range(N2):
        q=((n1inv*k2)%N2)*N1 + (n2inv*k1)%N1
        out1[q]=Y[k2]
ref=np.fft.fft(v)
chk=np.array([ref[VAL[q]] for q in range(LL)])
print("PFA math check:", np.abs(out1-chk).max())
