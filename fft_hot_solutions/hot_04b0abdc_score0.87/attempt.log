# restructure: do all three p1 includes, then prime_rr.h, then three p2 includes.
import re
blocks = re.findall(r'(#define PP \d+.*?#undef SUF\n)', s, re.S)
assert len(blocks)==3
header = s[:s.index('#define PP 13')]
