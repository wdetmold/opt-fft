    x0=(rng.standard_normal((B,L,L,L))+1j*rng.standard_normal((B,L,L,L)))
    c=0.1*(np.random.default_rng(999+L).standard_normal((B,L,L,L))+1j*np.random.default_rng(77+L).standard_normal((B,L,L,L)))
    xc=np.ascontiguousarray(x0.ravel()); cc=np.ascontiguousarray(c.ravel())
    o1=np.empty(B*L**3,complex); om=np.empty(B*L**3,complex)
    f(xc.ctypes.data,cc.ctypes.data,o1.ctypes.data,om.ctypes.data,B,m)
    x=x0.copy(); one=None
    for k in range(m):
        z=np.fft.fftn(x,axes=(1,2,3))+c
        x=z/(1+np.abs(z))
        if k==0: one=x.copy()
    print(f"L={L} one: {np.linalg.norm(o1-one.ravel())/np.linalg.norm(one):.2e}  m: {np.linalg.norm(om-x.ravel())/np.linalg.norm(x):.2e}")
EOF
