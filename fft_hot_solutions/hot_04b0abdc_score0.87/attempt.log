    x0=rng.standard_normal((B,2*L**3)); c=0.1*rng.standard_normal((B,2*L**3))
    o1=np.empty(B*L**3*2); om=np.empty(B*L**3*2)
    lib.run_64(x0.ctypes.data,c.ctypes.data,o1.ctypes.data,om.ctypes.data,B,3)
    best=1e9
    for _ in range(3):
        t0=time.perf_counter(); lib.run_64(x0.ctypes.data,c.ctypes.data,o1.ctypes.data,om.ctypes.data,B,m); t1=time.perf_counter()
        best=min(best,t1-t0)
    print(f"{so.split('/')[-1]}: {best:.4f} s  {best/(B*L**3*m)*1e9:.3f} ns/pt-step")
EOF</antml:parameter>
