<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/eng && objdump -d combined.so --no-show-raw-insn > comb.dis && python3 - <<'EOF'
import re
dis=open('comb.dis').read()
funcs=re.findall(r'<(MY_[a-z0-9_.]+|col_s1[a-z0-9_.]*|zcol[a-z0-9_.]*|cp_[a-z0-9_.]*)>:\n(.*?)(?=\n[0-9a-f]+ <|\Z)', dis, re.S)
from collections import Counter
seen=set()
for name, body in funcs:
    if name in seen: continue
    seen.add(name)
    lines=body.strip().split('\n')
    ops=Counter()
    spill_st=0; spill_ld=0
    for ln in lines:
        m2=re.search(r'\t([a-z0-9.]+)\s*(.*)',ln)
        if not m2: continue
        op,args=m2.groups()
        ops[op]+=1
        if op.startswith('vmov') and 'rsp' in args:
            if args.strip().endswith(('%zmm'+args.split('%zmm')[-1] if '%zmm' in args else '')): pass
            if re.search(r'%zmm\d+,\s*[^,]*rsp', args): spill_st+=1
            elif re.search(r'rsp[^,]*,\s*%zmm', args): spill_ld+=1
    n=len(lines)
    if n<20: continue
    print(f"{name:28s} insns={n:5d} spill_st={spill_st:3d} spill_ld={spill_ld:3d}")
EOF</antml:parameter>
</antml:invoke>
</antml:function_calls>
