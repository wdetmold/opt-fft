Key insight: Fy walks the plane 8× at stride 1152B (latency-exposed misses). Restructure to row-sequential order with 8 column scratches:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/eng && cp e64_nopf.c e64v5.c && python3 - <<'EOF'
s=open('e64v5.c').read()
add='''
static double SCRA8[8][1040] ALIGN64;   /* per-v column scratch, 8KB + 128B stagger */
// whole-plane Fy stage 1: row-sequential (g outer, v inner)
__attribute__((noinline))
static void fy8_s1(const double* pl){
    const __m512d S=_mm512_set1_pd(S8C);
    for(int g=0; g<8; g++){
        const double* rb = pl + (long)g*8*RS64;
        for(int v=0; v<8; v++){
            const double* p = rb + v*16;
            DECL16(xr,xi)
            LOAD16(p, RS64, xr, xi)
            DECL16(yr,yi)
            DFT8(S, xr0,xi0,xr1,xi1,xr2,xi2,xr3,xi3,xr4,xi4,xr5,xi5,xr6,xi6,xr7,xi7,
                    yr0,yi0,yr1,yi1,yr2,yi2,yr3,yi3,yr4,yi4,yr5,yi5,yr6,yi6,yr7,yi7);
            if(g){ TW7(g, yr, yi); }
            double* q = SCRA8[v] + g*16;
            _mm512_store_pd(q+0*128, yr0); _mm512_store_pd(q+0*128+8, yi0);
            _mm512_store_pd(q+1*128, yr1); _mm512_store_pd(q+1*128+8, yi1);
            _mm512_store_pd(q+2*128, yr2); _mm512_store_pd(q+2*128+8, yi2);
            _mm512_store_pd(q+3*128, yr3); _mm512_store_pd(q+3*128+8, yi3);
            _mm512_store_pd(q+4*128, yr4); _mm512_store_pd(q+4*128+8, yi4);
            _mm512_store_pd(q+5*128, yr5); _mm512_store_pd(q+5*128+8, yi5);
            _mm512_store_pd(q+6*128, yr6); _mm512_store_pd(q+6*128+8, yi6);
            _mm512_store_pd(q+7*128, yr7); _mm512_store_pd(q+7*128+8, yi7);
        }
    }
}
// whole-plane Fy stage 2: k1 outer, v inner (row-sequential writes)
__attribute__((noinline))
static void fy8_s2(double* pl){
    const __m512d S=_mm512_set1_pd(S8C);
    for(int k1=0; k1<8; k1++){
        double* rb = pl + (long)k1*8*RS64;
        for(int v=0; v<8; v++){
            const double* p = SCRA8[v] + k1*128;
            DECL16(xr,xi)
            LOAD16(p, 16, xr, xi)
            DECL16(yr,yi)
            DFT8(S, xr0,xi0,xr1,xi1,xr2,xi2,xr3,xi3,xr4,xi4,xr5,xi5,xr6,xi6,xr7,xi7,
                    yr0,yi0,yr1,yi1,yr2,yi2,yr3,yi3,yr4,yi4,yr5,yi5,yr6,yi6,yr7,yi7);
            double* q = rb + v*16;
            STORE16(q, RS64, yr, yi)
        }
    }
}
'''
