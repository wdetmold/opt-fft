import numpy as np
# measure divergence growth rate between pocketfft fp64 and matrix-DFT fp64
for L, tol in ((6,1e-4),(8,3e-6),(13,1e-9),(17,1e-10),(23,1e-10),(36,1e-10),(45,1e-10),(64,1e-10)):
    rng_x = np.random.default_rng(42 + L)
    B = 2
    x = (rng_x.standard_normal((B, L, L, L)) + 1j*rng_x.standard_normal((B, L, L, L)))
    rng_c = np.random.default_rng(1000 + L)
    c = 0.1*(rng_c.standard_normal((B, L, L, L)) + 1j*rng_c.standard_normal((B, L, L, L)))
    # matrix DFT in fp64
    j = np.arange(L); kj = np.outer(j,j) % L
    ang = -2*np.pi*kj/L
    W = np.cos(ang) + 1j*np.sin(ang)
    xa = x.copy(); xb = x.copy()
    errs = []
    for k in range(1, 401):
        za = np.fft.fftn(xa, axes=(1,2,3)) + c
        xa = za/(1+np.abs(za))
        yb = np.einsum('bxyz,kx->bkyz', xb, W)
        yb = np.einsum('bkyz,ly->bklz', yb, W)
        zb = np.einsum('bklz,mz->bklm', yb, W) + c
        xb = zb/(1+np.abs(zb))
        e = np.linalg.norm(xa-xb)/np.linalg.norm(xa)
        errs.append(e)
        if e > tol/300 and k > 2:
            print(f"L={L}: err reaches tol/300={tol/300:.1e} at m={k} (err={e:.2e})")
            break
    else:
        print(f"L={L}: after 400 steps err={errs[-1]:.2e} (tol/300={tol/300:.1e})")
EOF
