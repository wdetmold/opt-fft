#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <immintrin.h>
static inline uint64_t rdtscp(){ unsigned a,d,c; __asm__ volatile("rdtscp":"=a"(a),"=d"(d),"=c"(c)); return ((uint64_t)d<<32)|a; }
static double BUF[1024] __attribute__((aligned(64)));
#define N 100000000L
#define HEAD __m512d a0=_mm512_set1_pd(1e-18),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0; \
    __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-18); uint64_t c0=rdtscp();
#define TAIL(NAME,NFMA,NOTH) uint64_t c1=rdtscp(); \
    double s=_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)))+_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7))); \
    printf("%-14s: %.3f fma/tsc  %.3f vuops/tsc (%g)\n", NAME, (double)(NFMA)*(N/8)/(c1-c0), (double)((NFMA)+(NOTH))*(N/8)/(c1-c0), s); return s;
__attribute__((noinline)) double f8_l2(){ HEAD
    for(long i=0;i<N/8;i++){ const double* p=BUF+((i*64)&1023);
        a0=_mm512_fmadd_pd(_mm512_load_pd(p),b,a0); a1=_mm512_fmadd_pd(_mm512_load_pd(p+8),b,a1);
        a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c); a4=_mm512_fmadd_pd(a4,b,c);
        a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c); }
    TAIL("f8_l2",8,2) }
__attribute__((noinline)) double f8_l4(){ HEAD
    for(long i=0;i<N/8;i++){ const double* p=BUF+((i*64)&1023);
        a0=_mm512_fmadd_pd(_mm512_load_pd(p),b,a0); a1=_mm512_fmadd_pd(_mm512_load_pd(p+8),b,a1);
        a2=_mm512_fmadd_pd(_mm512_load_pd(p+16),b,a2); a3=_mm512_fmadd_pd(_mm512_load_pd(p+24),b,a3);
        a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c); }
    TAIL("f8_l4",8,4) }
__attribute__((noinline)) double f8_l8(){ HEAD
    for(long i=0;i<N/8;i++){ const double* p=BUF+((i*64)&1023);
        a0=_mm512_fmadd_pd(_mm512_load_pd(p),b,a0); a1=_mm512_fmadd_pd(_mm512_load_pd(p+8),b,a1);
        a2=_mm512_fmadd_pd(_mm512_load_pd(p+16),b,a2); a3=_mm512_fmadd_pd(_mm512_load_pd(p+24),b,a3);
        a4=_mm512_fmadd_pd(_mm512_load_pd(p+32),b,a4); a5=_mm512_fmadd_pd(_mm512_load_pd(p+40),b,a5);
        a6=_mm512_fmadd_pd(_mm512_load_pd(p+48),b,a6); a7=_mm512_fmadd_pd(_mm512_load_pd(p+56),b,a7); }
    TAIL("f8_l8",8,8) }
__attribute__((noinline)) double f8_l2_s1(){ HEAD
    for(long i=0;i<N/8;i++){ const double* p=BUF+((i*64)&1023); double* q=BUF+512+((i*8)&255);
        a0=_mm512_fmadd_pd(_mm512_load_pd(p),b,a0); a1=_mm512_fmadd_pd(_mm512_load_pd(p+8),b,a1);
        _mm512_store_pd(q, a2);
        a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c); a4=_mm512_fmadd_pd(a4,b,c);
        a5=_mm512_fmadd_pd(a5,b,c); a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c); }
