Baseline W3 = 2.27s; L=64 is 48% of it. Let me measure the memory hierarchy bandwidth to know whether L=64 is bandwidth- or issue-bound:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cat > /tmp/w/mb/bw.c <<'EOF'
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <stdlib.h>
#include <immintrin.h>
#include <time.h>
static inline double now(){ struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); return t.tv_sec + 1e-9*t.tv_nsec; }
double bench_read(double* buf, long n, int reps){
    __m512d s0=_mm512_setzero_pd(), s1=s0, s2=s0, s3=s0;
    double t0=now();
    for(int r=0;r<reps;r++)
        for(long i=0;i<n;i+=32){
            s0=_mm512_add_pd(s0,_mm512_load_pd(buf+i));
            s1=_mm512_add_pd(s1,_mm512_load_pd(buf+i+8));
            s2=_mm512_add_pd(s2,_mm512_load_pd(buf+i+16));
            s3=_mm512_add_pd(s3,_mm512_load_pd(buf+i+24));
        }
    double t1=now();
    volatile double sink=_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(s0,s1),_mm512_add_pd(s2,s3)));
    (void)sink;
    return n*8.0*reps/(t1-t0)/1e9;
}
double bench_write(double* buf, long n, int reps){
    __m512d v=_mm512_set1_pd(1.5);
    double t0=now();
    for(int r=0;r<reps;r++)
        for(long i=0;i<n;i+=32){
            _mm512_store_pd(buf+i,v); _mm512_store_pd(buf+i+8,v);
            _mm512_store_pd(buf+i+16,v); _mm512_store_pd(buf+i+24,v);
        }
    double t1=now();
    return n*8.0*reps/(t1-t0)/1e9;
}
double bench_rw(double* a, double* b, long n, int reps){ // read a, write b
    double t0=now();
    for(int r=0;r<reps;r++)
        for(long i=0;i<n;i+=32){
            _mm512_store_pd(b+i,_mm512_load_pd(a+i)); _mm512_store_pd(b+i+8,_mm512_load_pd(a+i+8));
            _mm512_store_pd(b+i+16,_mm512_load_pd(a+i+16)); _mm512_store_pd(b+i+24,_mm512_load_pd(a+i+24));
        }
    double t1=now();
    return 2*n*8.0*reps/(t1-t0)/1e9;
}
int main(int argc, char** argv){
    for(long kb=256; kb<=131072; kb*=2){
        long n=kb*1024/8;
        double* a=aligned_alloc(64, n*8+64);
        double* b=aligned_alloc(64, n*8+64);
        memset(a,1,n*8); memset(b,1,n*8);
        int reps = (int)(400LL*1024*1024/(n*8))+1;
        double r=bench_read(a,n,reps), w=bench_write(b,n,reps), rw=bench_rw(a,b,n,reps);
        printf("%7ld KB: read %6.1f GB/s  write %6.1f GB/s  copy(rw) %6.1f GB/s\n", kb, r, w, rw);
        free(a); free(b);
    }
    return 0;
}
EOF
