Let me verify the machine model with my own microbenchmarks before building on the prior findings:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">mkdir -p /tmp/w/mb && cat > /tmp/w/mb/mb.c <<'EOF'
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <immintrin.h>
#include <time.h>
static inline uint64_t rdtscp(){ unsigned a,d,c; __asm__ volatile("rdtscp":"=a"(a),"=d"(d),"=c"(c)); return ((uint64_t)d<<32)|a; }
static inline double now(){ struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); return t.tv_sec + 1e-9*t.tv_nsec; }
#define N 100000000L
// pure reg-reg FMA, 8 accumulators
__attribute__((noinline)) double fma_rate(){
    __m512d a0=_mm512_set1_pd(1.0000001),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-18);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<N/8;i++){
        a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c);
        a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
        a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
        a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double s=_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)))+_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    printf("fma reg-reg: %.3f fma/tsc-cyc  %.3f Gfma/s  wall %.3f (sink %g)\n", (double)N/(c1-c0), N/(t1-t0)/1e9, t1-t0, s);
    return s;
}
static double BUF[8192*16] __attribute__((aligned(64)));
__attribute__((noinline)) double load_fma_rate(){ // 1 load per FMA
    __m512d a0=_mm512_set1_pd(1e-18),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d b=_mm512_set1_pd(0.9999999);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<N/64;i++){
        const double* p=BUF + (i&1023)*64;
        a0=_mm512_fmadd_pd(_mm512_load_pd(p+0),b,a0); a1=_mm512_fmadd_pd(_mm512_load_pd(p+8),b,a1);
        a2=_mm512_fmadd_pd(_mm512_load_pd(p+16),b,a2); a3=_mm512_fmadd_pd(_mm512_load_pd(p+24),b,a3);
        a4=_mm512_fmadd_pd(_mm512_load_pd(p+32),b,a4); a5=_mm512_fmadd_pd(_mm512_load_pd(p+40),b,a5);
        a6=_mm512_fmadd_pd(_mm512_load_pd(p+48),b,a6); a7=_mm512_fmadd_pd(_mm512_load_pd(p+56),b,a7);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double s=_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)))+_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    printf("fma 1:1 load: %.3f fma/tsc-cyc  wall %.3f (sink %g)\n", (double)(N/8)/(c1-c0), t1-t0, s);
    return s;
}
__attribute__((noinline)) double shuf_fma_rate(){ // 1 shuffle per 1 FMA
    __m512d a0=_mm512_set1_pd(1.0000001),a1=a0,a2=a0,a3=a0;
    __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-18);
    __m512i idx=_mm512_set_epi64(3,7,2,6,1,5,0,4);
    __m512d s0=_mm512_set1_pd(1.0),s1=s0,s2=s0,s3=s0;
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<N/8;i++){
        a0=_mm512_fmadd_pd(a0,b,c); s0=_mm512_permutexvar_pd(idx,s0);
        a1=_mm512_fmadd_pd(a1,b,c); s1=_mm512_permutexvar_pd(idx,s1);
        a2=_mm512_fmadd_pd(a2,b,c); s2=_mm512_permutexvar_pd(idx,s2);
        a3=_mm512_fmadd_pd(a3,b,c); s3=_mm512_permutexvar_pd(idx,s3);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double s=_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)))+_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(s0,s1),_mm512_add_pd(s2,s3)));
    printf("fma+shuf 1:1: %.3f (fma+shuf)/tsc-cyc wall %.3f (sink %g)\n", (double)(2*(N/8)*4)/(c1-c0)/4, t1-t0, s);
    return s;
}
__attribute__((noinline)) double store_rate(){
    __m512d b=_mm512_set1_pd(0.9999999);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<N/64;i++){
        double* p=BUF + (i&1023)*64;
        _mm512_store_pd(p+0,b);_mm512_store_pd(p+8,b);_mm512_store_pd(p+16,b);_mm512_store_pd(p+24,b);
        _mm512_store_pd(p+32,b);_mm512_store_pd(p+40,b);_mm512_store_pd(p+48,b);_mm512_store_pd(p+56,b);
    }
    uint64_t c1=rdtscp(); double t1=now();
    printf("store zmm L1: %.3f st/tsc-cyc wall %.3f\n", (double)(N/8)/(c1-c0), t1-t0);
    return BUF[5];
}
int main(){
    memset(BUF, 1, sizeof BUF);
    for(int r=0;r<3;r++){ fma_rate(); load_fma_rate(); shuf_fma_rate(); store_rate(); }
    return 0;
}
EOF
