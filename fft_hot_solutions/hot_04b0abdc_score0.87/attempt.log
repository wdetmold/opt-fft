# LOCAL BENCHMARK ONLY - NOT part of solution. MKL DFTI reference mimicking held-out SOTA.
import os, ctypes, numpy as np, time
os.environ['MKL_NUM_THREADS']='1'
os.environ['OMP_NUM_THREADS']='1'
_lib = ctypes.CDLL('/work/mkl_runtime/lib/libmkl_rt.so.3', mode=ctypes.RTLD_GLOBAL)
# set sequential
_lib.MKL_Set_Threading_Layer.restype=ctypes.c_int
_lib.MKL_Set_Threading_Layer(ctypes.c_int(1))  # MKL_THREADING_SEQUENTIAL=1
DFTI_DOUBLE=36; DFTI_COMPLEX=32
# config params
DFTI_NUMBER_OF_TRANSFORMS=7; DFTI_INPUT_DISTANCE=14; DFTI_PLACEMENT=11; DFTI_INPLACE=43
class H(ctypes.Structure): pass
HP=ctypes.POINTER(H)
_lib.DftiCreateDescriptor.restype=ctypes.c_long
_lib.DftiCreateDescriptor.argtypes=[ctypes.POINTER(HP),ctypes.c_int,ctypes.c_int,ctypes.c_long,ctypes.c_long*3]
def plan(L,B):
    h=HP()
    dims=(ctypes.c_long*3)(L,L,L)
    st=_lib.DftiCreateDescriptor(ctypes.byref(h),DFTI_DOUBLE,DFTI_COMPLEX,3,dims)
    assert st==0, st
    _lib.DftiSetValue(h,ctypes.c_int(DFTI_NUMBER_OF_TRANSFORMS),ctypes.c_long(B))
    _lib.DftiSetValue(h,ctypes.c_int(DFTI_INPUT_DISTANCE),ctypes.c_long(L**3))
    st=_lib.DftiCommitDescriptor(h)
    assert st==0, st
    return h
def run(L,B,m,x0,c):
    h=plan(L,B)
    x=np.ascontiguousarray(x0).copy()
    one=None
    for k in range(m):
        st=_lib.DftiComputeForward(h,ctypes.c_void_p(x.ctypes.data))
        assert st==0
        z=x+c
        x=z/(1.0+np.abs(z))
        if k==0: one=x.copy()
    _lib.DftiFreeDescriptor(ctypes.byref(h))
    return one,x

SIZES=(6,8,13,17,23,36,45,64)
def transform(seed,*args):
    Bs=dict(zip(SIZES,args[0:8])); ms=dict(zip(SIZES,args[8:16]))
    outs=[]
    for L in SIZES:
        B=Bs[L]
        rng_x=np.random.default_rng(seed+L)
        x0=(rng_x.standard_normal((B,L,L,L))+1j*rng_x.standard_normal((B,L,L,L)))
        rng_c=np.random.default_rng(1000+L)
        c=0.1*(rng_c.standard_normal((B,L,L,L))+1j*rng_c.standard_normal((B,L,L,L)))
        one,final=run(L,B,ms[L],x0,c)
        outs+=[one.ravel(),final.ravel()]
    return np.concatenate(outs)
EOF
