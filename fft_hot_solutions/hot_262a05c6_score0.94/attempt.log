#include <stdio.h>
#include <stdint.h>
#include <time.h>
#include <immintrin.h>
static inline uint64_t rdtscp(void){ unsigned a; return __rdtscp(&a); }
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
__attribute__((noinline)) long intchain(long iters){
    long a=0;
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        asm volatile("addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n":"+r"(a));
    }
    uint64_t c1=rdtscp(); double t1=now();
    double n=iters*8.0;
    printf("int add chain: %.4f ns/add -> clock %.3f GHz ; tsc/add %.4f -> clock %.3f GHz(from tsc2.6)\n",
        (t1-t0)*1e9/n, n/((t1-t0)*1e9), (double)(c1-c0)/n, 2.6*n/(double)(c1-c0));
    return a;
}
// ymm FMA throughput, 10 accumulators
__attribute__((noinline)) double thr_ymm(long iters){
    __m256d a[10]; for(int i=0;i<10;i++) a[i]=_mm256_set1_pd(1.0+i*1e-7);
    __m256d b=_mm256_set1_pd(0.99999999), c=_mm256_set1_pd(1e-12);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        for(int k=0;k<10;k++) a[k]=_mm256_fmadd_pd(a[k],b,c);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double n=iters*10.0;
    printf("10-acc ymm FMA: %.3f fma/ns  %.3f fma/tsc\n", n/((t1-t0)*1e9), n/(double)(c1-c0));
    __m256d s=a[0]; for(int i=1;i<10;i++) s=_mm256_add_pd(s,a[i]);
    double tmp[4]; _mm256_storeu_pd(tmp,s); return tmp[0]+tmp[1]+tmp[2]+tmp[3];
}
__attribute__((noinline)) double thr_zmm10(long iters){
    __m512d a[10]; for(int i=0;i<10;i++) a[i]=_mm512_set1_pd(1.0+i*1e-7);
    __m512d b=_mm512_set1_pd(0.99999999), c=_mm512_set1_pd(1e-12);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        for(int k=0;k<10;k++) a[k]=_mm512_fmadd_pd(a[k],b,c);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double n=iters*10.0;
    printf("10-acc zmm FMA: %.3f fma/ns  %.3f fma/tsc\n", n/((t1-t0)*1e9), n/(double)(c1-c0));
    __m512d s=a[0]; for(int i=1;i<10;i++) s=_mm512_add_pd(s,a[i]);
    return _mm512_reduce_add_pd(s);
}
int main(){
    long N=30000000; double x=0; long y=0;
    for(int r=0;r<3;r++){
        y+=intchain(N);
        x+=thr_ymm(N/2);
        x+=thr_zmm10(N/2);
        printf("---\n");
    }
    printf("sink %g %ld\n", x, y);
}
EOF
