                A(f"    _mm512_store_pd({dst}+{(p-k)*dstride}, yr); _mm512_store_pd({dst}+{(p-k)*dstride}+8, yi);")
            A("    }")
        A("    }")
        A("}")
        return "\\n".join(L)'''
assert marker in src
src = src.replace(marker, blocked)
