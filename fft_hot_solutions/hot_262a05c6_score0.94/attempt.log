static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
static double buf[1<<13] __attribute__((aligned(64)));
static double obuf[1<<13] __attribute__((aligned(64)));

#define RUN(name, FMAS, LOADS, STORES, BODY) \
__attribute__((noinline)) double name(long iters){ \
    __m512d a0=_mm512_set1_pd(1.0),a1=_mm512_set1_pd(1.01),a2=_mm512_set1_pd(1.02),a3=_mm512_set1_pd(1.03); \
    __m512d a4=_mm512_set1_pd(1.04),a5=_mm512_set1_pd(1.05),a6=_mm512_set1_pd(1.06),a7=_mm512_set1_pd(1.07); \
    __m512d b=_mm512_set1_pd(0.99999999), c=_mm512_set1_pd(1e-12); \
    double t0=now(); \
    for(long i=0;i<iters;i++){ \
        const double* p=buf+((i*64)&4095); double* q=obuf+((i*64)&4095); (void)p; (void)q; \
        BODY \
    } \
    double t1=now(); \
    double f=iters*(double)(FMAS), l=iters*(double)(LOADS), s=iters*(double)(STORES); \
    double u=f+l+s; double secs=t1-t0; \
    printf("%-14s: %.2f fma/ns %.2f uops/ns | at2.6GHz: %.2f fma/cyc %.2f uops/cyc\n", #name, f/secs/1e9, u/secs/1e9, f/secs/2.6e9, u/secs/2.6e9); \
    __m512d ss=_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)); \
    ss=_mm512_add_pd(ss,_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7))); \
    return _mm512_reduce_add_pd(ss); \
}

// 2 FMA per load
RUN(f2_l1, 8, 4, 0, {
    __m512d l0=_mm512_load_pd(p), l1=_mm512_load_pd(p+8), l2=_mm512_load_pd(p+16), l3=_mm512_load_pd(p+24);
    a0=_mm512_fmadd_pd(a0,b,l0); a1=_mm512_fmadd_pd(a1,b,l1);
    a2=_mm512_fmadd_pd(a2,b,l2); a3=_mm512_fmadd_pd(a3,b,l3);
    a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
    a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
})
// 4 FMA per load
RUN(f4_l1, 8, 2, 0, {
    __m512d l0=_mm512_load_pd(p), l1=_mm512_load_pd(p+8);
    a0=_mm512_fmadd_pd(a0,b,l0); a1=_mm512_fmadd_pd(a1,b,l1);
    a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
    a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
    a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
})
// 2 FMA : 1 load : 1 store
RUN(f2_l1_s1, 8, 4, 4, {
    __m512d l0=_mm512_load_pd(p), l1=_mm512_load_pd(p+8), l2=_mm512_load_pd(p+16), l3=_mm512_load_pd(p+24);
    a0=_mm512_fmadd_pd(a0,b,l0); a1=_mm512_fmadd_pd(a1,b,l1);
