#include <stdio.h>
#include <stdint.h>
#include <time.h>
#include <immintrin.h>
static inline uint64_t rdtscp(void){ unsigned a; return __rdtscp(&a); }
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }

// serial FMA latency chain -> anchor clock (ICX FMA latency = 4 cyc)
__attribute__((noinline)) double lat_chain(long iters){
    __m512d a=_mm512_set1_pd(1.0), b=_mm512_set1_pd(0.99999999), c=_mm512_set1_pd(1e-12);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        a=_mm512_fmadd_pd(a,b,c); a=_mm512_fmadd_pd(a,b,c);
        a=_mm512_fmadd_pd(a,b,c); a=_mm512_fmadd_pd(a,b,c);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double n=iters*4.0;
    double ns_per = (t1-t0)*1e9/n, tsc_per=(double)(c1-c0)/n;
    printf("serial FMA: %.3f ns per FMA, %.3f tsc per FMA -> if lat=4cyc, clock=%.3f GHz, tsc ratio=%.3f\n",
      ns_per, tsc_per, 4.0/ns_per, 4.0/tsc_per);
    return _mm512_reduce_add_pd(a);
}

// 8 indep accumulators pure FMA -> throughput in cycles (using anchored clock)
__attribute__((noinline)) double thr(long iters){
    __m512d a[8]; for(int i=0;i<8;i++) a[i]=_mm512_set1_pd(1.0+i*1e-7);
    __m512d b=_mm512_set1_pd(0.99999999), c=_mm512_set1_pd(1e-12);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        a[0]=_mm512_fmadd_pd(a[0],b,c); a[1]=_mm512_fmadd_pd(a[1],b,c);
        a[2]=_mm512_fmadd_pd(a[2],b,c); a[3]=_mm512_fmadd_pd(a[3],b,c);
        a[4]=_mm512_fmadd_pd(a[4],b,c); a[5]=_mm512_fmadd_pd(a[5],b,c);
        a[6]=_mm512_fmadd_pd(a[6],b,c); a[7]=_mm512_fmadd_pd(a[7],b,c);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double n=iters*8.0;
    printf("8-acc FMA: %.3f fma/ns, %.3f fma/tsc\n", n/((t1-t0)*1e9), n/(double)(c1-c0));
    __m512d s=a[0]; for(int i=1;i<8;i++) s=_mm512_add_pd(s,a[i]);
    return _mm512_reduce_add_pd(s);
}

static double buf[1<<13] __attribute__((aligned(64)));
// load throughput: pure 512b loads
__attribute__((noinline)) double ldthr(long iters){
    __m512d s0=_mm512_setzero_pd(), s1=_mm512_setzero_pd(),s2=_mm512_setzero_pd(),s3=_mm512_setzero_pd();
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        const double* p=buf+((i*64)&4095);
        s0=_mm512_add_pd(s0,_mm512_load_pd(p));   s1=_mm512_add_pd(s1,_mm512_load_pd(p+8));
        s2=_mm512_add_pd(s2,_mm512_load_pd(p+16));s3=_mm512_add_pd(s3,_mm512_load_pd(p+24));
        s0=_mm512_add_pd(s0,_mm512_load_pd(p+32));s1=_mm512_add_pd(s1,_mm512_load_pd(p+40));
        s2=_mm512_add_pd(s2,_mm512_load_pd(p+48));s3=_mm512_add_pd(s3,_mm512_load_pd(p+56));
    }
    uint64_t c1=rdtscp(); double t1=now();
    double n=iters*8.0;
    printf("512b load+add: %.3f ld/ns %.3f ld/tsc\n", n/((t1-t0)*1e9), n/(double)(c1-c0));
    return _mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(s0,s1),_mm512_add_pd(s2,s3)));
}
// store throughput 512b
__attribute__((noinline)) double stthr(long iters){
    __m512d v=_mm512_set1_pd(1.5);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        double* p=buf+((i*64)&4095);
        _mm512_store_pd(p,v); _mm512_store_pd(p+8,v);
        _mm512_store_pd(p+16,v); _mm512_store_pd(p+24,v);
        _mm512_store_pd(p+32,v); _mm512_store_pd(p+40,v);
        _mm512_store_pd(p+48,v); _mm512_store_pd(p+56,v);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double n=iters*8.0;
    printf("512b store: %.3f st/ns %.3f st/tsc\n", n/((t1-t0)*1e9), n/(double)(c1-c0));
    return buf[1];
}
// balanced kernel mimicking an FFT stage: 2 FMA : 1 load : 0.5 store
__attribute__((noinline)) double mixfft(long iters){
    __m512d a[6]; for(int i=0;i<6;i++) a[i]=_mm512_set1_pd(1.0+i*1e-7);
    __m512d b=_mm512_set1_pd(0.99999999);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        const double* p=buf+((i*64)&4095);
        double* q=buf+4096+((i*32)&2047);
        __m512d l0=_mm512_load_pd(p), l1=_mm512_load_pd(p+8), l2=_mm512_load_pd(p+16);
        a[0]=_mm512_fmadd_pd(a[0],b,l0); a[1]=_mm512_fmadd_pd(a[1],b,l1);
        a[2]=_mm512_fmadd_pd(a[2],b,l2); a[3]=_mm512_fmadd_pd(a[3],b,l0);
        a[4]=_mm512_fmadd_pd(a[4],b,l1); a[5]=_mm512_fmadd_pd(a[5],b,l2);
        _mm512_store_pd(q,a[0]);
        a[0]=_mm512_fmadd_pd(a[0],b,l0); a[1]=_mm512_fmadd_pd(a[1],b,l1);
        a[2]=_mm512_fmadd_pd(a[2],b,l2); a[3]=_mm512_fmadd_pd(a[3],b,l0);
        a[4]=_mm512_fmadd_pd(a[4],b,l1); a[5]=_mm512_fmadd_pd(a[5],b,l2);
        _mm512_store_pd(q+8,a[1]);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double fn=iters*12.0, un=iters*17.0;
    printf("mix 12f/3l/2s: %.3f fma/ns %.3f uops/ns %.3f uops/tsc\n", fn/((t1-t0)*1e9), un/((t1-t0)*1e9), un/(double)(c1-c0));
    __m512d s=a[0]; for(int i=1;i<6;i++) s=_mm512_add_pd(s,a[i]);
    return _mm512_reduce_add_pd(s);
}
int main(){
    double x=0; long N=30000000;
    for(int r=0;r<3;r++){
        x+=lat_chain(N/4); x+=thr(N/4); x+=ldthr(N/4); x+=stthr(N/4); x+=mixfft(N/4);
        printf("---\n");
    }
    printf("sink %g\n", x);
}
