<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/v8 && python3 - <<'EOF'
src = open('genbdrv.py').read()
# parameterize strides: add row-pad for 64 and plane-stride pad for all
src = src.replace('''def gen_size(L):
    ZB = (L+7)//8
    RW = ZB*16
    NR = 8*ZB           # padded rows per plane
    PL = NR*RW          # plane doubles
    VOL = L*PL''','''def gen_size(L):
    ZB = (L+7)//8
    RW = ZB*16 + (8 if L==64 else 0)   # row stride pad to break 4K aliasing in column sweeps
    NR = 8*ZB           # padded rows per plane
    PL = NR*RW + 8      # plane stride (pad: breaks 4K aliasing across planes)
    VOL = L*PL''')
open('genbdrv.py','w').write(src)
EOF
