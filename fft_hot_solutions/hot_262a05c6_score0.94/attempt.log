<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /workdir && python3 - <<'EOF'
src = open('solution.py').read()
old = '''_VOL = {L: L*L*L for L in _SIZES}

def _run(L, B, m, x0, c):'''
new = '''_VOL = {L: L*L*L for L in _SIZES}

def _padbuf(key, n):
    a = _pool.get(key)
    if a is None or a.shape[0] < n:
        a = np.zeros(max(n, 1), dtype=np.complex128)
        _pool[key] = a
    return a

def _run_padded8(L, rem, m, x0v, cv, onev, finalv, goff, fn):
    # process rem (<8) trailing volumes as one zero-padded 8-group via fn
    V = _VOL[L]
    xin = _padbuf((L, 'px'), 8*V); cin = _padbuf((L, 'pc'), 8*V)
    o1 = _padbuf((L, 'p1'), 8*V);  om = _padbuf((L, 'pm'), 8*V)
    xin[:rem*V] = x0v.reshape(-1)[goff//2:goff//2 + rem*V]
    xin[rem*V:8*V] = 0.0
    cin[:rem*V] = cv.reshape(-1)[goff//2:goff//2 + rem*V]
    cin[rem*V:8*V] = 0.0
    fn(xin.ctypes.data, cin.ctypes.data, o1.ctypes.data, om.ctypes.data, 8, int(m))
    onev[goff//2:goff//2 + rem*V] = o1[:rem*V]
    finalv[goff//2:goff//2 + rem*V] = om[:rem*V]

def _run(L, B, m, x0, c):'''
assert old in src
src = src.replace(old, new)
old2 = '''        elif L == 13:
            if g:
                _libV.run2_13(px, pc, p1, pm, g, m)
            if B - g:
                _libA.run_13(px + off, pc + off, p1 + off, pm + off, B - g, m)'''
new2 = '''        elif L == 13:
            if g:
                _libV.run2_13(px, pc, p1, pm, g, m)
            rem = B - g
            if rem:
                if rem >= 6:
                    _run_padded8(13, rem, m, x0, c, one, final, off, _libV.run2_13)
                else:
                    _libA.run_13(px + off, pc + off, p1 + off, pm + off, rem, m)'''
assert old2 in src
src = src.replace(old2, new2)
old3 = '''        else:
            getattr(_libA, f'run_{L}')(px, pc, p1, pm, B, m)
    return one, final'''
new3 = '''        elif L == 17:
            rem = B % 8
            if rem >= 5:
                if g:
                    _libA.run_17(px, pc, p1, pm, g, m)
                _run_padded8(17, rem, m, x0, c, one, final, off, _libA.run_17)
            else:
