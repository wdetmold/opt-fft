    res={}
    for nm,lib,sym in (('A',libA,f'run_{L}'),('d43',libM,f'run_{L}'),('v8p',libP,f'run2_{L}')):
        f=getattr(lib,sym); f(*args,B,4)
        best=9e9
        for r in range(4):
            t=time.perf_counter(); f(*args,B,m); best=min(best,time.perf_counter()-t)
        res[nm]=best/(B*m*L**3)*1e9
    print(f"L={L} B={B:3d}: " + "  ".join(f"{k}={v:.2f}" for k,v in res.items()) + f" -> {min(res,key=res.get)}")
