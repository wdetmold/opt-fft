#include <stdio.h>
#include <time.h>
#include <immintrin.h>
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
static double ibuf[4096] __attribute__((aligned(64)));
__attribute__((noinline)) double mix_div_fma(long iters, int K, int ndiv){
    __m512d a[8]; for(int i=0;i<8;i++) a[i]=_mm512_set1_pd(1.0+i*1e-7);
    __m512d b=_mm512_set1_pd(0.99999999), c=_mm512_set1_pd(1e-12), one=_mm512_set1_pd(1.0);
    __m512d s0=_mm512_setzero_pd(), s1=_mm512_setzero_pd();
    double t0=now();
    for(long i=0;i<iters;i++){
        const double* p=ibuf+((i*16)&2047);
        __m512d f0=_mm512_div_pd(one,_mm512_load_pd(p));
        s0=_mm512_add_pd(f0,s0);
        if(ndiv>1){ __m512d f1=_mm512_div_pd(one,_mm512_load_pd(p+8)); s1=_mm512_add_pd(f1,s1); }
        for(int k=0;k<8;k++) a[k]=_mm512_fmadd_pd(a[k],b,c);
        if(K>8) for(int k=0;k<8;k++) a[k]=_mm512_fmadd_pd(a[k],b,c);
        if(K>16) for(int k=0;k<8;k++) a[k]=_mm512_fmadd_pd(a[k],b,c);
        if(K>24) for(int k=0;k<8;k++) a[k]=_mm512_fmadd_pd(a[k],b,c);
    }
    double cyc=(now()-t0)*2.6e9/iters;
    printf("%d div + %2d fma: %5.1f cyc/group (fma floor %4.1f) extra=%.1f\n", ndiv, K, cyc, K/2.0, cyc-K/2.0);
    __m512d s=a[0]; for(int i=1;i<8;i++) s=_mm512_add_pd(s,a[i]);
    return _mm512_reduce_add_pd(s)+_mm512_reduce_add_pd(s0)+_mm512_reduce_add_pd(s1);
}
int main(){
    for(int i=0;i<4096;i++) ibuf[i]=1.0+0.37*((i*37)%113)/113.0;
    double s=0; long N=8000000;
    for(int r=0;r<2;r++){
        s+=mix_div_fma(N,8,1); s+=mix_div_fma(N,16,1); s+=mix_div_fma(N/2,24,1); s+=mix_div_fma(N/2,32,1);
        s+=mix_div_fma(N/2,16,2); s+=mix_div_fma(N/2,32,2);
        printf("---\n");
    }
    printf("sink %g\n",s);
}
