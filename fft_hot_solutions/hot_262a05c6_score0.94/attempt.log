static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
__attribute__((noinline)) double readbw(double* a, long n, long reps){
    __m512d s0=_mm512_setzero_pd(), s1=_mm512_setzero_pd(), s2=_mm512_setzero_pd(), s3=_mm512_setzero_pd();
    double t0=now();
    for(long r=0;r<reps;r++)
        for(long i=0;i<n;i+=32){
            s0=_mm512_add_pd(s0,_mm512_load_pd(a+i));
            s1=_mm512_add_pd(s1,_mm512_load_pd(a+i+8));
            s2=_mm512_add_pd(s2,_mm512_load_pd(a+i+16));
            s3=_mm512_add_pd(s3,_mm512_load_pd(a+i+24));
        }
    double t1=now();
    double gb = (double)n*8*reps/1e9;
    printf("  read %6.1f GB/s", gb/(t1-t0));
    return _mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(s0,s1),_mm512_add_pd(s2,s3)));
}
__attribute__((noinline)) double writebw(double* a, long n, long reps){
    __m512d v=_mm512_set1_pd(1.5);
    double t0=now();
    for(long r=0;r<reps;r++)
        for(long i=0;i<n;i+=32){
            _mm512_store_pd(a+i,v); _mm512_store_pd(a+i+8,v);
            _mm512_store_pd(a+i+16,v); _mm512_store_pd(a+i+24,v);
        }
    double t1=now();
    double gb = (double)n*8*reps/1e9;
    printf("  write %6.1f GB/s", gb/(t1-t0));
    return a[3];
}
__attribute__((noinline)) double copybw(double* a, double* b, long n, long reps){
    double t0=now();
    for(long r=0;r<reps;r++)
        for(long i=0;i<n;i+=32){
            _mm512_store_pd(b+i,_mm512_load_pd(a+i)); _mm512_store_pd(b+i+8,_mm512_load_pd(a+i+8));
            _mm512_store_pd(b+i+16,_mm512_load_pd(a+i+16)); _mm512_store_pd(b+i+24,_mm512_load_pd(a+i+24));
        }
    double t1=now();
    double gb = (double)n*8*reps*2/1e9;
    printf("  copy(r+w) %6.1f GB/s\n", gb/(t1-t0));
    return b[3];
}
int main(){
    for (long kb=32; kb<=65536*2; kb*=2){
        long n = kb*1024/8;
        double* a = aligned_alloc(64, n*8+64);
        double* b = aligned_alloc(64, n*8+64);
        memset(a,1,n*8); memset(b,2,n*8);
        long reps = 400l*1024*1024/(kb*1024)+1;
        printf("%7ld KB:", kb);
        double s=readbw(a,n,reps)+writebw(a,n,reps)+copybw(a,b,n,reps/2+1);
        free(a); free(b);
        if(s==12345) printf("x");
    }
}
