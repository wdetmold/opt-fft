        args=(x0.ctypes.data,c.ctypes.data,one.ctypes.data,fin.ctypes.data)
        res={}
        fa=getattr(libA, f'run_{L}')
        fa(*args, B, 4)
        res['A']=t_of(lambda: fa(*args,B,mm))
        if L in (36,45,64):
            fv=getattr(libV, f'run_{L}_g'); fv(*args,B,4)
            res['v8']=t_of(lambda: fv(*args,B,mm))
        if L in (13,17,23) and B%8==0:
            fp=getattr(libP, f'run2_{L}'); fp(*args,B,4)
            res['v8p']=t_of(lambda: fp(*args,B,mm))
        if L==64:
            lib3.run64(B,4,*args)
            res['3f30']=t_of(lambda: lib3.run64(B,mm,*args))
        line=" ".join(f"{k}={v/(B*mm*L**3)*1e9:.2f}ns" for k,v in res.items())
        print(f"L={L} B={B} m={mm}: {line} -> {min(res,key=res.get)}")
