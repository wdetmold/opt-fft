#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <immintrin.h>
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
// read+write with prefetch distance PD lines ahead
__attribute__((noinline)) double rw_pf(double* a, double* b, long n, long reps, long pd){
    double t0=now();
    for(long r=0;r<reps;r++)
        for(long i=0;i<n;i+=16){
            if(pd) { _mm_prefetch((char*)(a+i)+pd*64, _MM_HINT_T0); _mm_prefetch((char*)(b+i)+pd*64, _MM_HINT_T0); }
            __m512d x0=_mm512_load_pd(a+i), x1=_mm512_load_pd(a+i+8);
            x0=_mm512_fmadd_pd(x0,x0,x1);
            _mm512_store_pd(b+i,x0); _mm512_store_pd(b+i+8,x1);
        }
    double t1=now();
    double gb=(double)n*8*reps*2/1e9;
    printf("  pf=%2ld: %6.1f GB/s (r+w)\n", pd, gb/(t1-t0));
    return b[5];
}
// pure read with prefetch
__attribute__((noinline)) double r_pf(double* a, long n, long reps, long pd){
    __m512d s0=_mm512_setzero_pd(),s1=_mm512_setzero_pd();
    double t0=now();
    for(long r=0;r<reps;r++)
        for(long i=0;i<n;i+=16){
            if(pd) _mm_prefetch((char*)(a+i)+pd*64, _MM_HINT_T0);
            s0=_mm512_add_pd(s0,_mm512_load_pd(a+i)); s1=_mm512_add_pd(s1,_mm512_load_pd(a+i+8));
        }
    double t1=now();
    double gb=(double)n*8*reps/1e9;
    printf("  rd pf=%2ld: %6.1f GB/s\n", pd, gb/(t1-t0));
    return _mm512_reduce_add_pd(_mm512_add_pd(s0,s1));
}
int main(){
    long mb = 4;
    long n = mb*1024*1024/8;
    double* a = aligned_alloc(64, n*8); double* b = aligned_alloc(64, n*8);
    memset(a,1,n*8); memset(b,2,n*8);
    long reps = 100;
    printf("4MB buffers (L3):\n");
    double s=0;
    for(int t=0;t<2;t++){
      s+=r_pf(a,n,reps,0); s+=r_pf(a,n,reps,8); s+=r_pf(a,n,reps,16); s+=r_pf(a,n,reps,32);
      s+=rw_pf(a,b,n,reps,0); s+=rw_pf(a,b,n,reps,8); s+=rw_pf(a,b,n,reps,16); s+=rw_pf(a,b,n,reps,32);
    }
    printf("sink %g\n", s);
}
