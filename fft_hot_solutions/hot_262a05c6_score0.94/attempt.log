#include "v8prime2.c"
static double pbuf[24*48] __attribute__((aligned(64)));
static double vbuf[23*1160] __attribute__((aligned(64)));
static double cbuf[23*1160] __attribute__((aligned(64)));
int main(){
    for(int i=0;i<24*48;i++) pbuf[i]=0.01*((i*37)%113)-0.5;
    for(int i=0;i<23*1160;i++){ vbuf[i]=0.01*((i*53)%97)-0.3; cbuf[i]=0.001*((i*31)%89); }
    long N=500000; double t;
    for(int r=0;r<1000;r++) wz_23(pbuf);
    t=now(); for(long r=0;r<N;r++){ wz_23(pbuf); }
    printf("wz_23: %.1f cyc (~950 uops -> 365 expect)\n", (now()-t)*2.6e9/N);
    for(int r=0;r<1000;r++) wtr_23(pbuf);
    t=now(); for(long r=0;r<N;r++){ wtr_23(pbuf); }
    printf("wtr_23: %.1f cyc\n", (now()-t)*2.6e9/N);
    for(int r=0;r<1000;r++) wx_23(vbuf, cbuf);
    t=now(); for(long r=0;r<N;r++){ wx_23(vbuf, cbuf); }
    printf("wx_23: %.1f cyc\n", (now()-t)*2.6e9/N);
    return (int)pbuf[3];
}
