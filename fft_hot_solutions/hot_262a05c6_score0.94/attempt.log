// microbench: FMA throughput, load throughput, mixed issue
#include <stdio.h>
#include <stdint.h>
#include <time.h>
#include <immintrin.h>

static inline uint64_t rdtscp(void){ unsigned a; return __rdtscp(&a); }
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }

#define N 100000000L

__attribute__((noinline)) double fma_reg(long iters){
    __m512d a0=_mm512_set1_pd(1.000001),a1=_mm512_set1_pd(1.0000011),a2=_mm512_set1_pd(1.0000012),a3=_mm512_set1_pd(1.0000013);
    __m512d a4=_mm512_set1_pd(1.0000014),a5=_mm512_set1_pd(1.0000015),a6=_mm512_set1_pd(1.0000016),a7=_mm512_set1_pd(1.0000017);
    __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-9);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c);
        a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
        a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
        a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double fmas = iters*8.0;
    printf("fma_reg: %.3f fma/tsc-cyc  %.3f fma/ns  wall %.3f s\n", fmas/(c1-c0), fmas/((t1-t0)*1e9), t1-t0);
    __m512d s=_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3));
    s=_mm512_add_pd(s,_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    return _mm512_reduce_add_pd(s);
}

static double buf[8192] __attribute__((aligned(64)));

__attribute__((noinline)) double fma_mem(long iters){
    __m512d a0=_mm512_set1_pd(1e-9),a1=_mm512_set1_pd(1.1e-9),a2=_mm512_set1_pd(1.2e-9),a3=_mm512_set1_pd(1.3e-9);
    __m512d a4=_mm512_set1_pd(1e-9),a5=_mm512_set1_pd(1.1e-9),a6=_mm512_set1_pd(1.2e-9),a7=_mm512_set1_pd(1.3e-9);
    __m512d b=_mm512_set1_pd(0.9999999);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        const double* p=buf + ((i&7)<<6);
        a0=_mm512_fmadd_pd(_mm512_load_pd(p),b,a0); a1=_mm512_fmadd_pd(_mm512_load_pd(p+8),b,a1);
        a2=_mm512_fmadd_pd(_mm512_load_pd(p+16),b,a2); a3=_mm512_fmadd_pd(_mm512_load_pd(p+24),b,a3);
        a4=_mm512_fmadd_pd(_mm512_load_pd(p+32),b,a4); a5=_mm512_fmadd_pd(_mm512_load_pd(p+40),b,a5);
        a6=_mm512_fmadd_pd(_mm512_load_pd(p+48),b,a6); a7=_mm512_fmadd_pd(_mm512_load_pd(p+56),b,a7);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double fmas=iters*8.0;
    printf("fma_memop: %.3f fma/tsc  %.3f fma/ns\n", fmas/(c1-c0), fmas/((t1-t0)*1e9));
    __m512d s=_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3));
    s=_mm512_add_pd(s,_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    return _mm512_reduce_add_pd(s);
}

__attribute__((noinline)) double fma_bcast(long iters){
    __m512d a0=_mm512_set1_pd(1e-9),a1=_mm512_set1_pd(1.1e-9),a2=_mm512_set1_pd(1.2e-9),a3=_mm512_set1_pd(1.3e-9);
    __m512d a4=_mm512_set1_pd(1e-9),a5=_mm512_set1_pd(1.1e-9),a6=_mm512_set1_pd(1.2e-9),a7=_mm512_set1_pd(1.3e-9);
    __m512d b=_mm512_set1_pd(0.9999999);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        const double* p=buf + ((i&7)<<6);
        a0=_mm512_fmadd_pd(_mm512_set1_pd(p[0]),b,a0); a1=_mm512_fmadd_pd(_mm512_set1_pd(p[1]),b,a1);
        a2=_mm512_fmadd_pd(_mm512_set1_pd(p[2]),b,a2); a3=_mm512_fmadd_pd(_mm512_set1_pd(p[3]),b,a3);
        a4=_mm512_fmadd_pd(_mm512_set1_pd(p[4]),b,a4); a5=_mm512_fmadd_pd(_mm512_set1_pd(p[5]),b,a5);
        a6=_mm512_fmadd_pd(_mm512_set1_pd(p[6]),b,a6); a7=_mm512_fmadd_pd(_mm512_set1_pd(p[7]),b,a7);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double fmas=iters*8.0;
    printf("fma_bcast: %.3f fma/tsc  %.3f fma/ns\n", fmas/(c1-c0), fmas/((t1-t0)*1e9));
    __m512d s=_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3));
    s=_mm512_add_pd(s,_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    return _mm512_reduce_add_pd(s);
}

// mixed: 2 FMA + 1 load per "group" -> can we get 3 uops/cyc? or capped at ~2.1?
__attribute__((noinline)) double mix21(long iters){
    __m512d a0=_mm512_set1_pd(1e-9),a1=_mm512_set1_pd(1.1e-9),a2=_mm512_set1_pd(1.2e-9),a3=_mm512_set1_pd(1.3e-9);
    __m512d a4=_mm512_set1_pd(1e-9),a5=_mm512_set1_pd(1.1e-9);
    __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-9);
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        const double* p=buf + ((i&7)<<6);
        __m512d l0=_mm512_load_pd(p), l1=_mm512_load_pd(p+8), l2=_mm512_load_pd(p+16);
        a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c);
        a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
        a4=_mm512_fmadd_pd(a4,b,l0); a5=_mm512_fmadd_pd(a5,b,l1);
        a0=_mm512_fmadd_pd(a0,b,l2);
    }
    uint64_t c1=rdtscp(); double t1=now();
    double fmas=iters*7.0, uops=iters*10.0;
    printf("mix 7fma+3ld: %.3f fma/tsc  %.3f uops/tsc  %.3f uops/ns\n", fmas/(c1-c0), uops/(c1-c0), uops/((t1-t0)*1e9));
    __m512d s=_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3));
    s=_mm512_add_pd(s,_mm512_add_pd(a4,a5));
    return _mm512_reduce_add_pd(s);
}

int main(){
    // pin handled by taskset
    double x=0;
    for(int r=0;r<3;r++){
        x+=fma_reg(N/8);
        x+=fma_mem(N/8);
        x+=fma_bcast(N/8);
        x+=mix21(N/8);
        printf("---\n");
    }
    printf("sink %g\n",x);
    return 0;
}
EOF
gcc -O3 -march=native mb1.c -o mb1 && taskset -c 0 ./mb1</antml:parameter>
</antml:invoke>
