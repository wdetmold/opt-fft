libs = {}
def get(sofile, sym, abi):
    if sofile not in libs:
        libs[sofile] = ctypes.CDLL(sofile)
        if 'impl_3f30' in sofile:
            libs[sofile].init_tables()
    f = getattr(libs[sofile], sym)
    if abi=='C':
        f.argtypes=[ctypes.c_longlong]*2+[ctypes.c_void_p]*4
    else:
        f.argtypes=[ctypes.c_void_p]*4+[ctypes.c_long]*2
