Key design question: can the hardware divider (vsqrtpd+vdivpd) be fully hidden behind FMA streams? Let me measure.

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/mb && cat > mbdiv.c <<'EOF'
#include <stdio.h>
#include <stdint.h>
#include <time.h>
#include <immintrin.h>
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
// pure vsqrtpd zmm throughput
__attribute__((noinline)) double sqrt_thr(long iters){
    __m512d a0=_mm512_set1_pd(1.3), a1=_mm512_set1_pd(2.4), a2=_mm512_set1_pd(3.1), a3=_mm512_set1_pd(0.7);
    __m512d s0=_mm512_setzero_pd(),s1=_mm512_setzero_pd(),s2=_mm512_setzero_pd(),s3=_mm512_setzero_pd();
    double t0=now();
    for(long i=0;i<iters;i++){
        s0=_mm512_add_pd(s0,_mm512_sqrt_pd(a0)); s1=_mm512_add_pd(s1,_mm512_sqrt_pd(a1));
        s2=_mm512_add_pd(s2,_mm512_sqrt_pd(a2)); s3=_mm512_add_pd(s3,_mm512_sqrt_pd(a3));
    }
    double t1=now();
    printf("vsqrtpd zmm: %.2f ns/op (%.1f cyc @2.6)\n", (t1-t0)*1e9/(iters*4), (t1-t0)*2.6e9/(iters*4));
    return _mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(s0,s1),_mm512_add_pd(s2,s3)));
}
__attribute__((noinline)) double div_thr(long iters){
    __m512d a0=_mm512_set1_pd(1.3), a1=_mm512_set1_pd(2.4), a2=_mm512_set1_pd(3.1), a3=_mm512_set1_pd(0.7);
    __m512d one=_mm512_set1_pd(1.0);
    __m512d s0=_mm512_setzero_pd(),s1=_mm512_setzero_pd(),s2=_mm512_setzero_pd(),s3=_mm512_setzero_pd();
    double t0=now();
    for(long i=0;i<iters;i++){
        s0=_mm512_add_pd(s0,_mm512_div_pd(one,a0)); s1=_mm512_add_pd(s1,_mm512_div_pd(one,a1));
        s2=_mm512_add_pd(s2,_mm512_div_pd(one,a2)); s3=_mm512_add_pd(s3,_mm512_div_pd(one,a3));
    }
    double t1=now();
    printf("vdivpd zmm: %.2f ns/op (%.1f cyc @2.6)\n", (t1-t0)*1e9/(iters*4), (t1-t0)*2.6e9/(iters*4));
    return _mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(s0,s1),_mm512_add_pd(s2,s3)));
}
// sqrt + div + FMA stream: does the divider hide behind FMAs?
// per "group": 1 sqrt + 1 div + K fma
__attribute__((noinline)) double mix_div_fma(long iters, int K){
    __m512d a[8]; for(int i=0;i<8;i++) a[i]=_mm512_set1_pd(1.0+i*1e-7);
    __m512d b=_mm512_set1_pd(0.99999999), c=_mm512_set1_pd(1e-12), one=_mm512_set1_pd(1.0);
    __m512d q0=_mm512_set1_pd(1.7), s0=_mm512_setzero_pd();
    double t0=now();
    for(long i=0;i<iters;i++){
        __m512d w=_mm512_sqrt_pd(q0);
        __m512d f=_mm512_div_pd(one,_mm512_add_pd(one,w));
        s0=_mm512_fmadd_pd(f,b,s0);
        for(int k=0;k<8;k++) a[k]=_mm512_fmadd_pd(a[k],b,c);
        if(K>8){ for(int k=0;k<8;k++) a[k]=_mm512_fmadd_pd(a[k],b,c); }
        if(K>16){ for(int k=0;k<8;k++) a[k]=_mm512_fmadd_pd(a[k],b,c); }
        if(K>24){ for(int k=0;k<8;k++) a[k]=_mm512_fmadd_pd(a[k],b,c); }
    }
    double t1=now();
    double cyc=(t1-t0)*2.6e9/iters;
    printf("1 sqrt + 1 div + %2d fma: %.1f cyc/group  (fma-only floor %.1f) overhead=%.1f cyc\n", K, cyc, K/2.0, cyc-K/2.0);
    __m512d s=a[0]; for(int i=1;i<8;i++) s=_mm512_add_pd(s,a[i]);
    return _mm512_reduce_add_pd(s)+_mm512_reduce_add_pd(s0);
}
int main(){
    double s=0; long N=10000000;
    for(int r=0;r<2;r++){
        s+=sqrt_thr(N); s+=div_thr(N);
        s+=mix_div_fma(N,8); s+=mix_div_fma(N/2,16); s+=mix_div_fma(N/2,24); s+=mix_div_fma(N/3,32);
        printf("---\n");
    }
    printf("sink %g\n",s);
}
EOF
