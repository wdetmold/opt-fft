    args=(x0.ctypes.data,c.ctypes.data,one.ctypes.data,fin.ctypes.data)
    fe=getattr(lib, f'frun_{L}'); fa=getattr(libA, f'run_{L}')
    fe(*args,B8,5); fa(*args,B8,5)
    be=ba=9e9
    for r in range(4):
        t=time.perf_counter(); fe(*args,B8,m); be=min(be,time.perf_counter()-t)
        t=time.perf_counter(); fa(*args,B8,m); ba=min(ba,time.perf_counter()-t)
    print(f"L={L} B={B8}: mine={be/(B8*m*L**3)*1e9:.3f}ns  A={ba/(B8*m*L**3)*1e9:.3f}ns -> {'MINE' if be<ba else 'A'}")
EOF</antml:parameter>
