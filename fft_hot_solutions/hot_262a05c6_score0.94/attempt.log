    double t; long N;
    // pass1 z-cols per a-plane
    N=2000;
    t=now();
    for(long r=0;r<N;r++){
        double* P = V;
        qz64_st(P);
        long i=0;
        for(; i+2<=63; i+=2){ qz64_ab(P+i*1024,P+(i+1)*1024); qz64_ba(P+(i+1)*1024,P+(i+2)*1024); }
        qz64_ab(P+62*1024,P+63*1024); qz64_fb(P+63*1024);
    }
    printf("z-cols/plane: %.0f cyc (64 cols; /col=%.0f)\n", (now()-t)*2.6e9/N, (now()-t)*2.6e9/N/64);
    t=now();
    for(long r=0;r<N;r++){
        double* P = V;
        qy64_st(P);
        long i=0;
        for(; i+2<=63; i+=2){ qy64_ab(P+i*16,P+(i+1)*16); qy64_ba(P+(i+1)*16,P+(i+2)*16); }
        qy64_ab(P+62*16,P+63*16); qy64_fb(P+63*16);
    }
    printf("y-cols/plane: %.0f cyc (/col=%.0f)\n", (now()-t)*2.6e9/N, (now()-t)*2.6e9/N/64);
    N=20000;
    t=now();
    for(long r=0;r<N;r++){
        for(int e=0;e<16;e++) ex64(V + e*16, C + e*16);
    }
    printf("ex64: %.0f cyc/octet (model: 136+48sh+136map+... ~400 uops -> 170)\n", (now()-t)*2.6e9/N/16);
    return (int)V[3];
}
