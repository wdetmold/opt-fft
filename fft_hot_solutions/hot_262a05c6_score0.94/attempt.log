import sys, numpy as np
sys.path.insert(0,'/workdir')
import solution, base
# per-size chain gates at various chain lengths
TOL = {6:1e-4, 8:3e-6, 13:1e-9, 17:1e-10, 23:1e-10, 36:1e-10, 45:1e-10, 64:1e-10}
_S=(6,8,13,17,23,36,45,64)
def test(ms, Bs=None):
    Bs = Bs or {L:2 for L in _S}
    args = [31] + [Bs[L] for L in _S] + [ms[L] for L in _S]
    out = solution.transform(*args)
    ref = base.transform(*args)
    # split blocks
    off=0; res={}
    for L in _S:
        n = Bs[L]*L**3
        o1 = out[off:off+n]; r1 = ref[off:off+n]; off+=n
        om = out[off:off+n]; rm = ref[off:off+n]; off+=n
        e1 = np.linalg.norm(o1-r1)/np.linalg.norm(r1)
        em = np.linalg.norm(om-rm)/np.linalg.norm(rm)
        res[L] = (e1, em, em < TOL[L])
    return res
ms = {6:200, 8:100, 13:60, 17:40, 23:30, 36:25, 45:20, 64:15}
for L,(e1,em,ok) in test(ms).items():
    print(f"L={L} m={ms[L]}: one={e1:.2e} final={em:.2e} tol={TOL[L]:.0e} {'OK' if ok else 'FAIL'}")
ms = {6:1000, 8:400, 13:150, 17:100, 23:80, 36:60, 45:50, 64:40}
for L,(e1,em,ok) in test(ms).items():
    print(f"L={L} m={ms[L]}: one={e1:.2e} final={em:.2e} tol={TOL[L]:.0e} {'OK' if ok else 'FAIL'}")
