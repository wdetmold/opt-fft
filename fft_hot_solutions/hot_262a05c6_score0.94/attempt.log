def t_of(fn, reps=3):
    best=9e9
    for r in range(reps):
        t=time.perf_counter(); fn(); best=min(best, time.perf_counter()-t)
    return best
print("=== small B regimes ===")
for L, Bs, m in ((36,(1,2,4,7),600),(45,(1,2,4,7),300),(64,(1,2,4),150),(13,(8,16),3000),(17,(8,),1200),(23,(8,),500)):
    for B in Bs:
