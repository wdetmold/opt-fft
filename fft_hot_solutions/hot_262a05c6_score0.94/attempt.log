import os, sys, ctypes, time
import numpy as np
try:
    os.sched_setaffinity(0, {0})
except Exception:
    pass
try:
    _libc = ctypes.CDLL("libc.so.6", use_errno=True)
    _libc.mallopt(ctypes.c_int(-3), ctypes.c_int(1 << 30))
    _libc.mallopt(ctypes.c_int(-1), ctypes.c_int(1 << 30))
except Exception:
    pass

_SIZES = (6, 8, 13, 17, 23, 36, 45, 64)

class Engine:
    def __init__(self, sopath):
        self.lib = ctypes.CDLL(sopath)
        for L in _SIZES:
            f = getattr(self.lib, f'run_{L}')
            f.argtypes = [ctypes.c_void_p]*4 + [ctypes.c_long]*2
            f.restype = None
        self.pool = {}
    def buf(self, key, n):
        a = self.pool.get(key)
        if a is None or a.shape[0] < n:
            a = np.empty(max(n,1), dtype=np.complex128)
            self.pool[key] = a
        return a[:n]
    def run(self, L, B, m, x0, c):
        n = B*L*L*L
        one = self.buf((L,0), n); final = self.buf((L,1), n)
        if B>0:
            x0 = np.ascontiguousarray(x0); c = np.ascontiguousarray(c)
            getattr(self.lib, f'run_{L}')(x0.ctypes.data, c.ctypes.data,
                one.ctypes.data, final.ctypes.data, int(B), int(m))
        return one, final

def gen_inputs(seed, L, B):
    rng_x = np.random.default_rng(seed + L)
    x0 = (rng_x.standard_normal((B, L, L, L)) + 1j*rng_x.standard_normal((B, L, L, L)))
    rng_c = np.random.default_rng(1000 + L)
    c = 0.1*(rng_c.standard_normal((B, L, L, L)) + 1j*rng_c.standard_normal((B, L, L, L)))
    return x0, c

def ref_run(L, B, m, x0, c):
    x = x0.copy(); one=None
    for k in range(m):
        z = np.fft.fftn(x, axes=(1,2,3)) + c
        x = z/(1.0+np.abs(z))
        if k==0: one = x.copy()
    return one.ravel(), x.ravel()

def relerr(a, b):
    d = np.linalg.norm(a-b); n = np.linalg.norm(b)
    return d/max(n,1e-300)
EOF
echo ok</antml:parameter>
</antml:invoke>
</antml:function_calls>
