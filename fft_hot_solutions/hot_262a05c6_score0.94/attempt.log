// MKL DFTI surrogate of the transform: CALIBRATION ONLY (not graded path)
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include "mkl_dfti.h"

typedef struct { double re, im; } cplx;

static DFTI_DESCRIPTOR_HANDLE handles[65][2]; // [L][0] unused; create on demand per (L)

void run_sota(int L, long B, long m, const double* x0, const double* c,
              double* one, double* final) {
    long n = B * (long)L * L * L;
    MKL_LONG sizes[3] = {L, L, L};
    DFTI_DESCRIPTOR_HANDLE h;
    DftiCreateDescriptor(&h, DFTI_DOUBLE, DFTI_COMPLEX, 3, sizes);
    DftiSetValue(h, DFTI_NUMBER_OF_TRANSFORMS, (MKL_LONG)B);
    DftiSetValue(h, DFTI_INPUT_DISTANCE, (MKL_LONG)(L*L*L));
    DftiSetValue(h, DFTI_OUTPUT_DISTANCE, (MKL_LONG)(L*L*L));
    DftiSetValue(h, DFTI_PLACEMENT, DFTI_INPLACE);
    DftiCommitDescriptor(h);
    double* x = (double*)malloc(sizeof(double)*2*n);
    memcpy(x, x0, sizeof(double)*2*n);
    for (long k = 0; k < m; ++k) {
        DftiComputeForward(h, x);
        for (long i = 0; i < n; ++i) {
            double zr = x[2*i] + c[2*i], zi = x[2*i+1] + c[2*i+1];
            double d = 1.0 + sqrt(zr*zr + zi*zi);
            x[2*i] = zr/d; x[2*i+1] = zi/d;
        }
        if (k == 0) memcpy(one, x, sizeof(double)*2*n);
    }
    memcpy(final, x, sizeof(double)*2*n);
    free(x);
    DftiFreeDescriptor(&h);
}
EOF
