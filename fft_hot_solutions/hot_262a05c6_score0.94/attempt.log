                        else:
                            A(f"    qr{k} = _mm512_mul_pd(_mm512_sub_pd(_mm512_setzero_pd(),ks{t}), di); qi{k} = _mm512_mul_pd(_mm512_sub_pd(_mm512_setzero_pd(),ks{t}), dr);")
                    else:
