#include <stdio.h>
#include <stdint.h>
#include <time.h>
#include <immintrin.h>
static inline uint64_t rdtscp(void){ unsigned a; return __rdtscp(&a); }
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
// measure core clock DURING zmm FMA pressure: integer add chain (1cyc) in parallel with zmm FMAs
__attribute__((noinline)) double clock_under_zmm(long iters){
    __m512d a[8]; for(int i=0;i<8;i++) a[i]=_mm512_set1_pd(1.0+i*1e-7);
    __m512d b=_mm512_set1_pd(0.99999999), c=_mm512_set1_pd(1e-12);
    long x=0;
    double t0=now(); uint64_t c0=rdtscp();
    for(long i=0;i<iters;i++){
        // 8 int adds (serial chain, 8 cycles) + 8 zmm FMA (independent)
        asm volatile(
          "vfmadd213pd %z2,%z1,%z3\n vfmadd213pd %z2,%z1,%z4\n vfmadd213pd %z2,%z1,%z5\n vfmadd213pd %z2,%z1,%z6\n"
          "addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n"
          "vfmadd213pd %z2,%z1,%z7\n vfmadd213pd %z2,%z1,%z8\n vfmadd213pd %z2,%z1,%z9\n vfmadd213pd %z2,%z1,%z10\n"
          "addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n"
          : "+r"(x), "+v"(b), "+v"(c), "+v"(a[0]),"+v"(a[1]),"+v"(a[2]),"+v"(a[3]),"+v"(a[4]),"+v"(a[5]),"+v"(a[6]),"+v"(a[7]));
    }
    uint64_t c1=rdtscp(); double t1=now();
    double adds=iters*8.0, fmas=iters*8.0;
    double secs=t1-t0;
    // if int chain is the critical path (8 cyc/iter) and FMAs keep up (8 per 8 cyc = 1..2/cyc ok)
    printf("under-zmm: %.3f cyc-chain GHz (adds/ns), fma/ns=%.3f, tsc ratio=%.3f\n",
        adds/secs/1e9, fmas/secs/1e9, (c1-c0)/(secs*1e9*2.6)*2.6);
    printf("   adds/tsc=%.4f -> core GHz = %.3f\n", adds/(double)(c1-c0), 2.6*adds/(double)(c1-c0));
    return x + _mm512_reduce_add_pd(a[0]);
}
int main(){ double s=0; for(int r=0;r<3;r++){ s+=clock_under_zmm(40000000);} printf("sink %g\n",s); }
EOF
