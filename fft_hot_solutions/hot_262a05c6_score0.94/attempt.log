<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/v8 && python3 - <<'EOF'
src = open('genbdrv.py').read()
# In step_: prefetch next plane's rows interleaved across pass1 work
old = '''static void step_{L}(double* restrict V, const double* restrict CP){{
    for(int x=0;x<{L};x++){{
        double* P = V + (long)x*{PL};
        COLS_{L}(P);
        ptr_{L}(P);
        COLS_{L}(P);
    }}'''
new = '''static void step_{L}(double* restrict V, const double* restrict CP){{
    for(int x=0;x<{L};x++){{
        double* P = V + (long)x*{PL};
        if(x+1 < {L}){{
            const char* np_ = (const char*)(V + (long)(x+1)*{PL});
            for(long q=0; q<{PL}*8; q += 256) _mm_prefetch(np_ + q, _MM_HINT_T0);
        }}
        COLS_{L}(P);
        ptr_{L}(P);
        COLS_{L}(P);
    }}'''
assert old in src
src = src.replace(old, new)
open('genbdrv.py','w').write(src)
print('ok')
EOF
