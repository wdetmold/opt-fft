    // whole-step timing on resident data
    N=100;
    t=now();
    for(long r=0;r<N;r++) xstep_64(V, V2, C);
    printf("xstep: %.3f ms -> %.3f ns/pt\n", (now()-t)*1e3/N, (now()-t)*1e9/N/262144);
    return (int)V[3];
}
