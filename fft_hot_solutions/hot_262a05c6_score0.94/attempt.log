old = '''        conv_in_{L}(c + off, C0_{L});
        memcpy(C1_{L}, C0_{L}, (long){VOL}*8);
        for(int x=0;x<{L};x++) ptr_{L}(C1_{L} + (long)x*{PL});
        for(int r=0;r<{L};r++)
            for(int g=0;g<{ZB};g++)
                for(int k=0;k<{L};k++){{
                    memcpy(CC0_{L} + (((long)r*{ZB}+g)*{L}+k)*16, C0_{L} + (long)k*{PL} + (long)r*{RW} + g*16, 128);
                    memcpy(CC1_{L} + (((long)r*{ZB}+g)*{L}+k)*16, C1_{L} + (long)k*{PL} + (long)r*{RW} + g*16, 128);
                }}'''
new = '''        conv_cc_{L}(c + off, CC0_{L}, CC1_{L});'''
assert old in src
src = src.replace(old, new)
# emit conv_cc: parity0 CC0[((r*ZB+g)*L+k)] = c(x=k, y=r, z=8g..8g+7) ; parity1 CC1[...] = c(x=k, y=8g..8g+7, z=r)
conv_cc = '''
static void conv_cc_{L}(const double* restrict src, double* restrict CC0, double* restrict CC1){{
    // parity 0 (used when pass2 input rows=y, lanes=z): element (x=k, y=r, z=8g+l)
    for(int r=0;r<{L};r++)
        for(int g=0;g<{ZB};g++){{
            double* d = CC0 + (((long)r*{ZB}+g)*{L})*16;
            for(int k=0;k<{L};k++){{
                const double* s = src + (((long)k*{L}+r)*{L} + 8*g)*2;
                if(8*g+8 <= {L}){{
                    __m512d a = _mm512_loadu_pd(s);
                    __m512d b = _mm512_loadu_pd(s+8);
                    _mm512_store_pd(d + (long)k*16,     _mm512_permutex2var_pd(a, IDX_RE, b));
                    _mm512_store_pd(d + (long)k*16 + 8, _mm512_permutex2var_pd(a, IDX_IM, b));
                }} else {{
                    double tre[8]={{0,0,0,0,0,0,0,0}}, tim[8]={{0,0,0,0,0,0,0,0}};
                    for(int t=0; 8*g+t<{L}; t++){{ tre[t]=s[2*t]; tim[t]=s[2*t+1]; }}
                    _mm512_store_pd(d + (long)k*16, _mm512_loadu_pd(tre));
                    _mm512_store_pd(d + (long)k*16 + 8, _mm512_loadu_pd(tim));
                }}
            }}
        }}
    // parity 1 (rows=z, lanes=y): element (x=k, y=8g+l, z=r): strided gather over y
    for(int r=0;r<{L};r++)
        for(int g=0;g<{ZB};g++){{
            double* d = CC1 + (((long)r*{ZB}+g)*{L})*16;
            for(int k=0;k<{L};k++){{
                const double* s = src + (((long)k*{L} + 8*g)*{L} + r)*2;
                double tre[8] ALIGN64 ={{0,0,0,0,0,0,0,0}}, tim[8] ALIGN64 ={{0,0,0,0,0,0,0,0}};
                int lim = {L} - 8*g; if(lim>8) lim=8;
                for(int t=0; t<lim; t++){{ tre[t]=s[(long)t*{L}*2]; tim[t]=s[(long)t*{L}*2+1]; }}
                _mm512_store_pd(d + (long)k*16, _mm512_load_pd(tre));
                _mm512_store_pd(d + (long)k*16 + 8, _mm512_load_pd(tim));
            }}
        }}
}}
'''
src = src.replace('''static double* V_{L}; static double* C0_{L}; static double* C1_{L}; static double* CC0_{L}; static double* CC1_{L};''',
conv_cc + '''static double* V_{L}; static double* C0_{L}; static double* C1_{L}; static double* CC0_{L}; static double* CC1_{L};''')
open('genbdrv.py','w').write(src)
print("ok")
EOF
