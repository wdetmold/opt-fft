sizes = [int(s) for s in sys.argv[1].split(',')] if len(sys.argv)>1 else [13,17,23,36,45,64]
REP = int(sys.argv[2]) if len(sys.argv)>2 else 5
for L in sizes:
    B,m = WL[L]
    if L in (13,17,23): B = (B//8)*8
    x0,c = gen_inputs(5,L,B)
    x0=np.ascontiguousarray(x0); c=np.ascontiguousarray(c)
    n=B*L**3
    one=np.empty(n,dtype=np.complex128); fin=np.empty(n,dtype=np.complex128)
    res = {}
    for (nm, so, sym, abi) in CAND[L]:
        f,abi = get(so,sym,abi)
        run(f,abi,L,B,max(2,m//10),x0,c,one,fin)  # warm
        best=1e9
        for r in range(REP):
            t=time.perf_counter(); run(f,abi,L,B,m,x0,c,one,fin); dt=time.perf_counter()-t
            best=min(best,dt)
        res[nm]=best
    line = f"L={L} B={B} m={m}: " + "  ".join(f"{nm}={res[nm]:.3f}s({res[nm]/(B*m*L**3)*1e9:.2f}ns)" for nm in res)
    winner = min(res, key=res.get)
    print(line + f"   -> {winner}")
