            u.raw(f"_mm512_store_pd(P + {(y2 + 8*k1)*64*16} + zz*16, {y[0]});")
            u.raw(f"_mm512_store_pd(P + {(y2 + 8*k1)*64*16} + zz*16 + 8, {y[1]});")
