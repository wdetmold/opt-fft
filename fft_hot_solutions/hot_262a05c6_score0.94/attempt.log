    a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
    a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
    _mm512_store_pd(q,a0); _mm512_store_pd(q+8,a1); _mm512_store_pd(q+16,a2); _mm512_store_pd(q+24,a3);
})
// 4:1:0.5
RUN(f8_l2_s1, 8, 2, 1, {
    __m512d l0=_mm512_load_pd(p), l1=_mm512_load_pd(p+8);
