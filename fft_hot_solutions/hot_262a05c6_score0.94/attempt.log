#include <stdio.h>
#include <stdint.h>
#include <time.h>
#include <immintrin.h>
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
static double buf[1<<14] __attribute__((aligned(64)));
// 12 independent ymm FMA accumulators, hand-unrolled
__attribute__((noinline)) double ymm12(long iters){
    __m256d a0=_mm256_set1_pd(1.0),a1=_mm256_set1_pd(1.01),a2=_mm256_set1_pd(1.02),a3=_mm256_set1_pd(1.03);
    __m256d a4=_mm256_set1_pd(1.04),a5=_mm256_set1_pd(1.05),a6=_mm256_set1_pd(1.06),a7=_mm256_set1_pd(1.07);
    __m256d a8=_mm256_set1_pd(1.08),a9=_mm256_set1_pd(1.09),aa=_mm256_set1_pd(1.10),ab=_mm256_set1_pd(1.11);
    __m256d b=_mm256_set1_pd(0.99999999), c=_mm256_set1_pd(1e-12);
    double t0=now();
    for(long i=0;i<iters;i++){
        a0=_mm256_fmadd_pd(a0,b,c); a1=_mm256_fmadd_pd(a1,b,c); a2=_mm256_fmadd_pd(a2,b,c);
        a3=_mm256_fmadd_pd(a3,b,c); a4=_mm256_fmadd_pd(a4,b,c); a5=_mm256_fmadd_pd(a5,b,c);
        a6=_mm256_fmadd_pd(a6,b,c); a7=_mm256_fmadd_pd(a7,b,c); a8=_mm256_fmadd_pd(a8,b,c);
        a9=_mm256_fmadd_pd(a9,b,c); aa=_mm256_fmadd_pd(aa,b,c); ab=_mm256_fmadd_pd(ab,b,c);
    }
    double t1=now();
    double n=iters*12.0, secs=t1-t0;
    printf("ymm12 FMA: %.3f fma/ns (%.2f/cyc @3.16)\n", n/secs/1e9, n/secs/3.16e9);
    __m256d s=_mm256_add_pd(_mm256_add_pd(_mm256_add_pd(a0,a1),_mm256_add_pd(a2,a3)),
                            _mm256_add_pd(_mm256_add_pd(a4,a5),_mm256_add_pd(a6,a7)));
    s=_mm256_add_pd(s,_mm256_add_pd(_mm256_add_pd(a8,a9),_mm256_add_pd(aa,ab)));
    double tmp[4]; _mm256_storeu_pd(tmp,s); return tmp[0]+tmp[1]+tmp[2]+tmp[3];
}
// ymm loads: 2/cyc?
__attribute__((noinline)) double ymmld(long iters){
    __m256d a0=_mm256_set1_pd(0),a1=_mm256_set1_pd(0),a2=_mm256_set1_pd(0),a3=_mm256_set1_pd(0);
    __m256d a4=_mm256_set1_pd(0),a5=_mm256_set1_pd(0),a6=_mm256_set1_pd(0),a7=_mm256_set1_pd(0);
    __m256d b=_mm256_set1_pd(0.5);
    double t0=now();
    for(long i=0;i<iters;i++){
        const double* p=buf+((i*32)&8191);
        a0=_mm256_fmadd_pd(_mm256_load_pd(p),b,a0); a1=_mm256_fmadd_pd(_mm256_load_pd(p+4),b,a1);
        a2=_mm256_fmadd_pd(_mm256_load_pd(p+8),b,a2); a3=_mm256_fmadd_pd(_mm256_load_pd(p+12),b,a3);
        a4=_mm256_fmadd_pd(_mm256_load_pd(p+16),b,a4); a5=_mm256_fmadd_pd(_mm256_load_pd(p+20),b,a5);
        a6=_mm256_fmadd_pd(_mm256_load_pd(p+24),b,a6); a7=_mm256_fmadd_pd(_mm256_load_pd(p+28),b,a7);
    }
    double t1=now();
    double n=iters*8.0, secs=t1-t0;
    printf("ymm ld+fma: %.3f ld/ns (%.2f/cyc @3.16)\n", n/secs/1e9, n/secs/3.16e9);
    __m256d s=_mm256_add_pd(_mm256_add_pd(_mm256_add_pd(a0,a1),_mm256_add_pd(a2,a3)),
                            _mm256_add_pd(_mm256_add_pd(a4,a5),_mm256_add_pd(a6,a7)));
    double tmp[4]; _mm256_storeu_pd(tmp,s); return tmp[0]+tmp[1]+tmp[2]+tmp[3];
}
// ymm stores: 2/cyc?
__attribute__((noinline)) double ymmst(long iters){
    __m256d v=_mm256_set1_pd(1.5);
    double t0=now();
    for(long i=0;i<iters;i++){
        double* q=buf+((i*32+8)&8191);
        _mm256_store_pd(q,v); _mm256_store_pd(q+4,v); _mm256_store_pd(q+8,v); _mm256_store_pd(q+12,v);
        _mm256_store_pd(q+16,v); _mm256_store_pd(q+20,v); _mm256_store_pd(q+24,v); _mm256_store_pd(q+28,v);
    }
    double t1=now();
    double n=iters*8.0, secs=t1-t0;
    printf("ymm store: %.3f st/ns (%.2f/cyc @3.16)\n", n/secs/1e9, n/secs/3.16e9);
    return buf[9];
}
// clock under ymm FMA pressure
__attribute__((noinline)) double clock_under_ymm(long iters){
    __m256d a0=_mm256_set1_pd(1.0),a1=_mm256_set1_pd(1.01),a2=_mm256_set1_pd(1.02),a3=_mm256_set1_pd(1.03);
    __m256d a4=_mm256_set1_pd(1.04),a5=_mm256_set1_pd(1.05),a6=_mm256_set1_pd(1.06),a7=_mm256_set1_pd(1.07);
    __m256d b=_mm256_set1_pd(0.99999999), c=_mm256_set1_pd(1e-12);
    long x=0;
    double t0=now();
    for(long i=0;i<iters;i++){
        asm volatile(
          "vfmadd213pd %2,%1,%3\n vfmadd213pd %2,%1,%4\n vfmadd213pd %2,%1,%5\n vfmadd213pd %2,%1,%6\n"
          "addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n"
          "vfmadd213pd %2,%1,%7\n vfmadd213pd %2,%1,%8\n vfmadd213pd %2,%1,%9\n vfmadd213pd %2,%1,%10\n"
          "addq $1,%0\n addq $1,%0\n addq $1,%0\n addq $1,%0\n"
          : "+r"(x), "+v"(b), "+v"(c), "+v"(a0),"+v"(a1),"+v"(a2),"+v"(a3),"+v"(a4),"+v"(a5),"+v"(a6),"+v"(a7));
    }
    double t1=now();
    double adds=iters*8.0, secs=t1-t0;
    printf("clock under ymm FMA: %.3f GHz\n", adds/secs/1e9);
    double tmp[4]; _mm256_storeu_pd(tmp,a0); return x + tmp[0];
}
int main(){ double s=0; long N=40000000;
  for(int r=0;r<3;r++){ s+=ymm12(N); s+=ymmld(N); s+=ymmst(N); s+=clock_under_ymm(N); printf("---\n"); }
  printf("sink %g\n", s);
}
