def top_idents(src):
    ids = set()
    for m in re.finditer(r'^(?:static\s+)?(?:inline\s+)?(?:__attribute__\(\(.*?\)\)\s*)?(?:const\s+)?(?:unsigned\s+)?(?:void|int|long|double|float|__m512d|__m512i|__m256d|uint64_t|int64_t|size_t|char|vd)\s*\**\s*([A-Za-z_][A-Za-z0-9_]*)\s*[(;\[=]', src, re.M):
