    t0 = nww(); for (long r = 0; r < reps; r++) for (int x = 0; x < 64; x++) { tp64(SR_64 + (long)x*4616); tp64(SI_64 + (long)x*4616); } t1 = nww();
    printf("tp64 x2:    %.3f us/plane (%.3f ns/pt)\n", (t1-t0)/reps/64*1e6, (t1-t0)/reps/262144*1e9);
