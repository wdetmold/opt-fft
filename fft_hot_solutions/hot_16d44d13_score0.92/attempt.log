Let me optimize the prime codelet: fuse the cos phase into the fold (saves scratch round-trip), keep SR/SI in registers through combine, and interleave map chains.

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /workdir/dev && cat > gen_prime.py << 'EOF'
"""Prime-size engines (13/17/23): batch-lane SoA-8, folded phase-split DFT.
v2: cos phase fused with fold; sin phase keeps accs in regs for combine;
map fused at combine with chains from 2 k-pairs interleaved by emission order."""
import numpy as np
from genlib import Emit, hexd, trig_tables

def kblocks_sin(p):
    h = (p - 1) // 2
    if p == 13: return [list(range(1, 7))]
    if p == 17: return [list(range(1, 9))]
    if p == 23: return [list(range(1, 7)), list(range(7, 12))]
    ks = list(range(1, h + 1))
    return [ks[i:i+6] for i in range(0, len(ks), 6)]

def kblocks_cos(p):
    # cos phase fused with fold: pool + 2KB accs + 4 data + temps <= 30
    h = (p - 1) // 2
    if p == 13: return [list(range(1, 7))]    # 6 pool + 12 acc + 2 X0acc + 4 data = 24
    if p == 17: return [list(range(1, 9))]    # 8 + 16 + 2 + 4 = 30 (tight)
    if p == 23: return [list(range(1, 7)), list(range(7, 12))]
    ks = list(range(1, h + 1))
    return [ks[i:i+6] for i in range(0, len(ks), 6)]

def emit_tables(E, p):
    cos, sin = trig_tables(p)
    h = (p - 1) // 2
    E(f'static const double PRT_{p}[{2*h}] ALIGN64 = {{')
    E('    ' + ', '.join(hexd(cos[t]) for t in range(1, h + 1)) + ',')
    E('    ' + ', '.join(hexd(sin[t]) for t in range(1, h + 1)))
    E('};')

def cidx(p, j, k):
    h = (p - 1) // 2
    r = (j * k) % p
    if r > h: r = p - r
    return r - 1, 1.0
def sidx(p, j, k):
    h = (p - 1) // 2
    r = (j * k) % p
    if r > h: return p - r - 1, -1.0
    return r - 1, 1.0

def emit_dft(E, p, stride, name, mode):
    """mode: 'plain' or 'map'."""
    h = (p - 1) // 2
    SO = stride
    cblocks = kblocks_cos(p)
    sblocks = kblocks_sin(p)
    nb_c = len(cblocks)
    if mode == 'plain':
        E(f'static void {name}(double* restrict pen){{')
    else:
        E(f'static void {name}(double* restrict pen, const double* restrict cg, double* restrict cap){{')
    E.ind += 1
    # scratch: dr/di per j (2h zmm) + spilled accs CR/CI (2h) + spilled SR/SI low blocks
    E(f'double fs[{(2*h + 2*h + 2*h)*8}] ALIGN64;')
    E('V x0r = VL(pen + 0), x0i = VL(pen + 8);')
    # ---- fold + cos phase fused (per cos block; fold runs fully in first block, others read dr/di? no:
    # fold computes sr,si,dr,di; cos blocks need sr,si per j. For nb_c>1 we must re-make sr,si:
    # store sr,si to scratch too in first block; later blocks load them.
    E('V a0r = x0r, a0i = x0i;')
    for bi, blk in enumerate(cblocks):
        E('{')
        needed = sorted(set(cidx(p, j, k)[0] for j in range(1, h+1) for k in blk))
        for t in needed:
            E(f'V P{t} = VSET1(PRT_{p}[{t}]);')
        for k in blk:
            E(f'V CR{k} = x0r, CI{k} = x0i;')
        for j in range(1, h + 1):
            if bi == 0:
                E(f'{{ V ar = VL(pen + {j*SO}), ai = VL(pen + {j*SO + 8});')
                E(f'  V br = VL(pen + {(p-j)*SO}), bi_ = VL(pen + {(p-j)*SO + 8});')
                E(f'  V sr = VADD(ar, br), si = VADD(ai, bi_);')
                E(f'  V dr = VSUB(ar, br), di = VSUB(ai, bi_);')
                E(f'  VS(fs + {(j-1)*32}, dr); VS(fs + {(j-1)*32 + 8}, di);')
                if nb_c > 1:
                    E(f'  VS(fs + {(j-1)*32 + 16}, sr); VS(fs + {(j-1)*32 + 24}, si);')
                E(f'  a0r = VADD(a0r, sr); a0i = VADD(a0i, si);')
            else:
                E(f'{{ V sr = VL(fs + {(j-1)*32 + 16}), si = VL(fs + {(j-1)*32 + 24});')
            for k in blk:
                t, sg = cidx(p, j, k)
                E(f'  CR{k} = VFMA(sr, P{t}, CR{k}); CI{k} = VFMA(si, P{t}, CI{k});')
            E('}')
        for k in blk:
            E(f'VS(fs + {(2*h + (k-1)*2)*8}, CR{k}); VS(fs + {(2*h + (k-1)*2)*8 + 8}, CI{k});')
        E('}')
    # ---- sin phase; last block keeps accs and does its combine in-regs; other blocks spill+combine later
    def out_one(idx, rexpr, iexpr, tag):
        if mode == 'plain':
            E(f'VS(pen + {idx*SO}, {rexpr}); VS(pen + {idx*SO + 8}, {iexpr});')
        else:
            E(f'V zr{tag} = VADD({rexpr}, VL(cg + {idx*SO})), zi{tag} = VADD({iexpr}, VL(cg + {idx*SO + 8}));')
            E(f'V mr{tag}, mi{tag}; MAPK(zr{tag}, zi{tag}, mr{tag}, mi{tag});')
            E(f'VS(pen + {idx*SO}, mr{tag}); VS(pen + {idx*SO + 8}, mi{tag});')
            E(f'VS(cap + {idx*SO}, mr{tag}); VS(cap + {idx*SO + 8}, mi{tag});')
    for bi, blk in enumerate(sblocks):
        E('{')
        needed = sorted(set(sidx(p, j, k)[0] for j in range(1, h+1) for k in blk))
        for t in needed:
            E(f'V Q{t} = VSET1(PRT_{p}[{h + t}]);')
        for k in blk:
            E(f'V SR{k} = VZERO(), SI{k} = VZERO();')
        for j in range(1, h + 1):
            E(f'{{ V dr = VL(fs + {(j-1)*32}), di = VL(fs + {(j-1)*32 + 8});')
            for k in blk:
                t, sg = sidx(p, j, k)
                op = 'VFMA' if sg > 0 else 'VFNMA'
                E(f'  SR{k} = {op}(dr, Q{t}, SR{k}); SI{k} = {op}(di, Q{t}, SI{k});')
            E('}')
        # combine for this block's ks (CR/CI from scratch)
        for k in blk:
            E(f'{{ V cr = VL(fs + {(2*h + (k-1)*2)*8}), ci = VL(fs + {(2*h + (k-1)*2)*8 + 8});')
            E(f'  V xr = VADD(cr, SI{k}), yr = VSUB(cr, SI{k});')
            E(f'  V xi = VSUB(ci, SR{k}), yi = VADD(ci, SR{k});')
            E.ind += 1
            out_one(k, 'xr', 'xi', f'a{k}')
            out_one(p - k, 'yr', 'yi', f'b{k}')
            E.ind -= 1
            E('}')
        E('}')
    E.ind += 0
    out_one(0, 'a0r', 'a0i', 'dc')
    E.ind -= 1
    E('}')

def emit_prime(E, p, mapk='MAP_M4'):
    h = (p - 1) // 2
    n3 = p**3
    emit_tables(E, p)
    E(f'#define MAPK {mapk}')
    emit_dft(E, p, 16, f'dz{p}_plain', 'plain')
    emit_dft(E, p, 16, f'dz{p}_map', 'map')
    emit_dft(E, p, 16*p, f'dy{p}_plain', 'plain')
    emit_dft(E, p, 16*p*p, f'dx{p}_plain', 'plain')
    emit_dft(E, p, 16*p*p, f'dx{p}_map', 'map')
    E('#undef MAPK')
    E(f'''
static double* G_{p};
static double* CG_{p};
static double* CAP_{p};
static double* DUM_{p};
static void init_{p}(void){{
    if (G_{p}) return;
    G_{p}   = (double*)alloc_arena({n3}*16*8 + 4096);
    CG_{p}  = (double*)alloc_arena({n3}*16*8 + 4096);
    CAP_{p} = (double*)alloc_arena({n3}*16*8 + 4096);
    DUM_{p} = (double*)alloc_arena({p}*16*8 + 4096);
}}
static void sweepA_{p}(double* G, const double* CG, double* cap, int pre){{
    for (int x = 0; x < {p}; x++) {{
        double* s = G + (long)x*{16*p*p};
        const double* cs = CG + (long)x*{16*p*p};
        double* caps = cap ? cap + (long)x*{16*p*p} : 0;
        for (int z = 0; z < {p}; z++) dy{p}_plain(s + z*16);
        for (int y = 0; y < {p}; y++)
            dz{p}_map(s + y*{16*p}, cs + y*{16*p}, caps ? caps + y*{16*p} : DUM_{p});
        if (pre) {{
            for (int y = 0; y < {p}; y++) dz{p}_plain(s + y*{16*p});
            for (int z = 0; z < {p}; z++) dy{p}_plain(s + z*16);
        }}
    }}
}}
static void sweepB_{p}(double* G, const double* CG, double* cap, int pre){{
    for (int yz = 0; yz < {p*p}; yz++) {{
        double* pen = G + (long)yz*16;
        dx{p}_map(pen, CG + (long)yz*16, cap ? cap + (long)yz*16 : DUM_{p});
        if (pre) dx{p}_plain(pen);
    }}
}}
static void convin_{p}(const double* src, double* dst, long Bg){{
    for (long j = 0; j < {n3}; j++)
        for (long v = 0; v < 8; v++) {{
            long vv = v < Bg ? v : (Bg ? v % Bg : 0);
            dst[j*16 + v] = src[vv*{2*n3} + 2*j];
            dst[j*16 + 8 + v] = src[vv*{2*n3} + 2*j + 1];
        }}
}}
static void convout_{p}(const double* src, double* dst, long Bg){{
    for (long j = 0; j < {n3}; j++)
        for (long v = 0; v < Bg; v++) {{
            dst[v*{2*n3} + 2*j] = src[j*16 + v];
            dst[v*{2*n3} + 2*j + 1] = src[j*16 + 8 + v];
        }}
}}
void run_{p}(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    init_{p}();
    if (m < 1) m = 1;
    for (long g = 0; g < (B + 7) / 8; g++) {{
        long Bg = B - g*8 < 8 ? B - g*8 : 8;
        const double* xg = x0 + g*8*{2*n3};
        const double* cg = c + g*8*{2*n3};
        convin_{p}(xg, G_{p}, Bg);
        convin_{p}(cg, CG_{p}, Bg);
        for (int yz = 0; yz < {p*p}; yz++) dx{p}_plain(G_{p} + (long)yz*16);
        sweepA_{p}(G_{p}, CG_{p}, CAP_{p}, m > 1);
        convout_{p}(CAP_{p}, out1 + g*8*{2*n3}, Bg);
        for (long t = 2; t <= m; t++) {{
            if ((t & 1) == 0) sweepB_{p}(G_{p}, CG_{p}, 0, t < m);
            else              sweepA_{p}(G_{p}, CG_{p}, 0, t < m);
        }}
        convout_{p}(G_{p}, outm + g*8*{2*n3}, Bg);
    }}
}}
''')

if __name__ == '__main__':
    from genlib import PRELUDE
    import sys
    mapk = sys.argv[1] if len(sys.argv) > 1 else 'MAP_M4'
    E = Emit()
    E(PRELUDE)
    for p in (13, 17, 23):
        emit_prime(E, p, mapk)
    open('prime_test.c', 'w').write(E.text())
    print('wrote prime_test.c', len(E.text()))
EOF
