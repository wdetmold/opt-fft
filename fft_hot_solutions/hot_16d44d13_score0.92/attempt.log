buf = np.full(13*13*16*2, 0.5)  # a couple slabs worth
cg = np.full(13*13*16*2, 0.01)
cap = np.zeros(13*16*2)
for name, args, pts in (
    ('bench_dy13', (buf.ctypes.data, 100000), 104),
    ('bench_dz13', (buf.ctypes.data, 100000), 104),
    ('bench_dz13m', (buf.ctypes.data, cg.ctypes.data, cap.ctypes.data, 100000), 104),
):
    f = getattr(lib, name)
    f.argtypes = [ctypes.c_void_p]*(len(args)-1) + [ctypes.c_long]
