void chainprof64(long m){
    init_64();
    double tA = 0, tB = 0; long nA = 0, nB = 0;
    for (long t = 2; t <= m; t++) {
        double t0 = nww();
        if ((t & 1) == 0) { sweepB_64(t < m); tB += nww()-t0; nB++; }
        else              { sweepA_64(t < m, 0); tA += nww()-t0; nA++; }
    }
    printf("sweepA: %.1f us avg (%.3f ns/pt/step-it-covers)  sweepB: %.1f us\n", tA/nA*1e6, tA/nA/262144*1e9, tB/nB*1e6);
    printf("per-step avg: %.3f ns/pt\n", (tA+tB)/(nA+nB)/262144*1e9);
}
void chainprof36(long m){
    init_36();
    double tA = 0, tB = 0; long nA = 0, nB = 0;
    for (long t = 2; t <= m; t++) {
        double t0 = nww();
