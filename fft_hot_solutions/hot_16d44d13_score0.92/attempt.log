"""Numpy model of the within-volume engine: validates pass structure + index maps.
Pipeline (per volume), plane (r,q); state stored natural (r=y,q=z), x = plane idx.
sweep A: per x: rowpass(y) -> T -> rowpass(z) -> +cT,map -> [rowpass(z)] -> T -> [rowpass(y)]
sweep B: per (r,qb): xpass -> +cN,map -> [xpass]
"""
import numpy as np

def dft(n):
    j = np.arange(n)
    return np.exp(-2j*np.pi*np.outer(j, j)/n)

def mapf(z):
    return z / (1 + np.abs(z))

def model_chain(L, m, x0, c, seed_full=False):
    """x0, c: (L,L,L) complex. Returns (one, final) both (L,L,L)."""
    W = dft(L)
    S = x0.copy()          # S[x][y][z]
    cN = c                 # natural
    cT = c.transpose(0, 2, 1)  # per-plane transposed (x, z, y)
    one = None
    # x-pre: DFT along x
    S = np.einsum('kx,xyz->kyz', W, S)
    t = 1
    while t <= m:
        # sweep A (completes odd step t)
        pre = t < m
        newS = np.empty_like(S)
        for x in range(L):
            P = S[x]                       # (y, z)
            P = W @ P                      # y-DFT (rows)
            P = P.T.copy()                 # (z, y)
            P = W @ P                      # z-DFT (rows)
            P = mapf(P + cT[x])            # + c, map
            if t == 1: 
                if one is None: one = np.empty_like(S)
                one[x] = P.T
            if pre:
                P = W @ P                  # z-DFT (t+1)
            P = P.T.copy()                 # (y, z)
            if pre:
                P = W @ P                  # y-DFT (t+1)
            newS[x] = P
        S = newS
        t += 1
        if t > m: break
        # sweep B (completes even step t)
        pre = t < m
        S = np.einsum('kx,xyz->kyz', W, S)     # x-DFT
        S = mapf(S + cN)
        if pre:
            S = np.einsum('kx,xyz->kyz', W, S)
        t += 1
    return one, S

def ref_chain(L, m, x0, c):
    x = x0.copy()
    one = None
    for k in range(m):
        z = np.fft.fftn(x) + c
        x = z/(1+np.abs(z))
        if k == 0: one = x.copy()
    return one, x

for L in (6, 36):
    for m in (1, 2, 3, 5, 8):
        rng = np.random.default_rng(7)
        x0 = rng.standard_normal((L,L,L)) + 1j*rng.standard_normal((L,L,L))
        c = 0.1*(rng.standard_normal((L,L,L)) + 1j*rng.standard_normal((L,L,L)))
        o1, fin = model_chain(L, m, x0, c)
        r1, rfin = ref_chain(L, m, x0, c)
        e1 = np.linalg.norm(o1-r1)/np.linalg.norm(r1)
        em = np.linalg.norm(fin-rfin)/np.linalg.norm(rfin)
        print(f'L={L} m={m}: one {e1:.2e} final {em:.2e}', 'OK' if max(e1,em)<1e-12 else 'BAD')
