        "vaddpd %%zmm14, %%zmm15, %%zmm10\n\tvaddpd %%zmm14, %%zmm15, %%zmm11\n\t"
        "dec %0\n\tjnz 1b\n" : "+r"(iters) : "r"(buf)
        : "zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11","zmm14","zmm15","memory");
    return now() - t0;
}
// loads with 2 streams to avoid any bank thing; 16 loads/iter
static double t_load16(long iters){
