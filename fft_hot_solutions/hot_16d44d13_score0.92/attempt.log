"""Prime-size engines (13/17/23): batch-lane SoA-8, folded phase-split DFT,
one-sweep-per-step alternation, map fused into completing pass."""
import numpy as np
from genlib import Emit, hexd, trig_tables

def kblocks(p):
    h = (p - 1) // 2
    if p == 13: return [list(range(1, 7))]
    if p == 17: return [list(range(1, 9))]
    if p == 23: return [list(range(1, 7)), list(range(7, 12))]
    # generic: blocks of 6
    ks = list(range(1, h + 1))
    return [ks[i:i+6] for i in range(0, len(ks), 6)]

def emit_tables(E, p):
    cos, sin = trig_tables(p)
    h = (p - 1) // 2
    E(f'static const double PRT_{p}[{2*h}] ALIGN64 = {{')
    E('    ' + ', '.join(hexd(cos[t]) for t in range(1, h + 1)) + ',')
    E('    ' + ', '.join(hexd(sin[t]) for t in range(1, h + 1)))
    E('};')

def cidx(p, j, k):
    """cos(2pi jk/p) = sign * pool[t]: returns (t-1, sign) with t in 1..h for cos; cos is even."""
    h = (p - 1) // 2
    r = (j * k) % p
    if r == 0: return None
    if r > h: r = p - r
    return r - 1, 1.0   # cos(2pi (p-r)/p) = cos(2pi r/p): always +
def sidx(p, j, k):
    h = (p - 1) // 2
    r = (j * k) % p
    if r == 0: return None
    if r > h: return p - r - 1, -1.0
    return r - 1, 1.0

def emit_dft(E, p, stride, name, mode):
    """mode: 'plain' or 'map'.
    plain: void name(double* pen)
    map:   void name(double* pen, const double* cg, double* cap)  (c/cap have same stride)
    pen[j*stride*8 .. ] : j-th element: re zmm at pen + j*SO, im at +8. SO = stride doubles.
    """
    h = (p - 1) // 2
    SO = stride
    if mode == 'plain':
        E(f'static void {name}(double* restrict pen){{')
    else:
        E(f'static void {name}(double* restrict pen, const double* restrict cg, double* restrict cap){{')
    E.ind += 1
    E(f'double fs[{4*h*8 + 4*2*h*8}] ALIGN64;')  # fold scratch + acc spill area
    # fold
    E('V x0r = VL(pen + 0), x0i = VL(pen + 8);')
    E('V a0r = x0r, a0i = x0i;')
    for j in range(1, h + 1):
        E(f'{{ V ar = VL(pen + {j*SO}), ai = VL(pen + {j*SO + 8});')
        E(f'  V br = VL(pen + {(p-j)*SO}), bi = VL(pen + {(p-j)*SO + 8});')
        E(f'  V sr = VADD(ar, br), dr = VSUB(ar, br), si = VADD(ai, bi), di = VSUB(ai, bi);')
        E(f'  VS(fs + {(j-1)*32}, sr); VS(fs + {(j-1)*32 + 8}, si);')
        E(f'  VS(fs + {(j-1)*32 + 16}, dr); VS(fs + {(j-1)*32 + 24}, di);')
        E(f'  a0r = VADD(a0r, sr); a0i = VADD(a0i, si); }}')
    spill = 4 * h * 8
    # cos phases then sin phases; accumulate; spill accs
    for phase, (pool_off, dat_off, accnames) in enumerate(
            ((0, 0, ('CR', 'CI')), (h, 16, ('SR', 'SI')))):
        for blk in kblocks(p):
            # load pool values needed for this block (the full pool; registers)
            needed = sorted(set((cidx if phase == 0 else sidx)(p, j, k)[0] for j in range(1, h+1) for k in blk))
            for t in needed:
                E(f'V P{t} = VSET1(PRT_{p}[{pool_off + t}]);')
            for k in blk:
                if phase == 0:
                    E(f'V {accnames[0]}{k} = x0r, {accnames[1]}{k} = x0i;')
                else:
                    E(f'V {accnames[0]}{k} = VZERO(), {accnames[1]}{k} = VZERO();')
            for j in range(1, h + 1):
                E(f'{{ V u = VL(fs + {(j-1)*32 + dat_off}), w = VL(fs + {(j-1)*32 + dat_off + 8});')
                for k in blk:
                    t, sg = (cidx if phase == 0 else sidx)(p, j, k)
                    if sg > 0:
                        E(f'  {accnames[0]}{k} = VFMA(u, P{t}, {accnames[0]}{k}); {accnames[1]}{k} = VFMA(w, P{t}, {accnames[1]}{k});')
                    else:
                        E(f'  {accnames[0]}{k} = VFNMA(u, P{t}, {accnames[0]}{k}); {accnames[1]}{k} = VFNMA(w, P{t}, {accnames[1]}{k});')
                E('}')
            for k in blk:
                E(f'VS(fs + {spill + ((phase*h) + (k-1))*16}, {accnames[0]}{k}); VS(fs + {spill + ((phase*h) + (k-1))*16 + 8}, {accnames[1]}{k});')
    # combine + optional map
    def out_one(idx, rexpr, iexpr):
        if mode == 'plain':
            E(f'VS(pen + {idx*SO}, {rexpr}); VS(pen + {idx*SO + 8}, {iexpr});')
        else:
            E(f'{{ V zr = VADD({rexpr}, VL(cg + {idx*SO})), zi = VADD({iexpr}, VL(cg + {idx*SO + 8}));')
            E('  V mr, mi; MAPK(zr, zi, mr, mi);')
            E(f'  VS(pen + {idx*SO}, mr); VS(pen + {idx*SO + 8}, mi);')
            E(f'  VS(cap + {idx*SO}, mr); VS(cap + {idx*SO + 8}, mi); }}')
    out_one(0, 'a0r', 'a0i')
    for k in range(1, h + 1):
        E(f'{{ V cr = VL(fs + {spill + (k-1)*16}), ci = VL(fs + {spill + (k-1)*16 + 8});')
        E(f'  V sr = VL(fs + {spill + (h + k - 1)*16}), si = VL(fs + {spill + (h + k - 1)*16 + 8});')
        E('  V xr = VADD(cr, si), yr = VSUB(cr, si);')
        E('  V xi = VSUB(ci, sr), yi = VADD(ci, sr);')
        E.ind += 1
        out_one(k, 'xr', 'xi')
        out_one(p - k, 'yr', 'yi')
        E.ind -= 1
        E('}')
    E.ind -= 1
    E('}')

def emit_prime(E, p, mapk='MAP_M3'):
    h = (p - 1) // 2
    emit_tables(E, p)
    E(f'#define MAPK {mapk}')
    emit_dft(E, p, 16, f'dz{p}_plain', 'plain')          # z axis: stride 16 doubles
    emit_dft(E, p, 16, f'dz{p}_map', 'map')
    emit_dft(E, p, 16*p, f'dy{p}_plain', 'plain')        # y axis
    emit_dft(E, p, 16*p*p, f'dx{p}_plain', 'plain')      # x axis
    emit_dft(E, p, 16*p*p, f'dx{p}_map', 'map')
    E('#undef MAPK')
    n3 = p**3
    E(f'''
static double* G_{p};
static double* CG_{p};
static double* CAP_{p};
static double* DUM_{p};
static void init_{p}(void){{
    if (G_{p}) return;
    G_{p}   = (double*)alloc_arena({n3}*16*8 + 4096);
    CG_{p}  = (double*)alloc_arena({n3}*16*8 + 4096);
    CAP_{p} = (double*)alloc_arena({n3}*16*8 + 4096);
    DUM_{p} = (double*)alloc_arena({p}*16*8 + 4096);
}}
/* sweep A: per x-slab: y(t), z(t)+c+map(+capture), [z(t+1), y(t+1)] */
static void sweepA_{p}(double* G, const double* CG, double* cap, int pre){{
    for (int x = 0; x < {p}; x++) {{
        double* s = G + (long)x*{16*p*p};
        const double* cs = CG + (long)x*{16*p*p};
        double* caps = cap ? cap + (long)x*{16*p*p} : 0;
        for (int z = 0; z < {p}; z++) dy{p}_plain(s + z*16);
        for (int y = 0; y < {p}; y++) {{
            double* pen = s + y*{16*p};
            dz{p}_map(pen, cs + y*{16*p}, caps ? caps + y*{16*p} : DUM_{p});
        }}
        if (pre) {{
            for (int y = 0; y < {p}; y++) dz{p}_plain(s + y*{16*p});
            for (int z = 0; z < {p}; z++) dy{p}_plain(s + z*16);
        }}
    }}
}}
/* sweep B: per (y,z) pencil: x(t)+c+map, [x(t+1)] */
static void sweepB_{p}(double* G, const double* CG, double* cap, int pre){{
    for (int yz = 0; yz < {p*p}; yz++) {{
        double* pen = G + (long)yz*16;
        dx{p}_map(pen, CG + (long)yz*16, cap ? cap + (long)yz*16 : DUM_{p});
        if (pre) dx{p}_plain(pen);
    }}
}}
static void convin_{p}(const double* src, double* dst, long Bg){{
    for (long j = 0; j < {n3}; j++)
        for (long v = 0; v < 8; v++) {{
            long vv = v < Bg ? v : (Bg ? v % Bg : 0);
            dst[j*16 + v] = src[vv*{2*n3} + 2*j];
            dst[j*16 + 8 + v] = src[vv*{2*n3} + 2*j + 1];
        }}
}}
static void convout_{p}(const double* src, double* dst, long Bg){{
    for (long j = 0; j < {n3}; j++)
        for (long v = 0; v < Bg; v++) {{
            dst[v*{2*n3} + 2*j] = src[j*16 + v];
            dst[v*{2*n3} + 2*j + 1] = src[j*16 + 8 + v];
        }}
}}
void run_{p}(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    init_{p}();
    if (m < 1) m = 1;
    for (long g = 0; g < (B + 7) / 8; g++) {{
        long Bg = B - g*8 < 8 ? B - g*8 : 8;
        const double* xg = x0 + g*8*{2*n3};
        const double* cg = c + g*8*{2*n3};
        convin_{p}(xg, G_{p}, Bg);
        convin_{p}(cg, CG_{p}, Bg);
        for (int yz = 0; yz < {p*p}; yz++) dx{p}_plain(G_{p} + (long)yz*16);  /* pre-transform x for step 1 */
        sweepA_{p}(G_{p}, CG_{p}, CAP_{p}, m > 1);
        convout_{p}(CAP_{p}, out1 + g*8*{2*n3}, Bg);
        for (long t = 2; t <= m; t++) {{
            if ((t & 1) == 0) sweepB_{p}(G_{p}, CG_{p}, 0, t < m);
            else              sweepA_{p}(G_{p}, CG_{p}, 0, t < m);
        }}
        convout_{p}(G_{p}, outm + g*8*{2*n3}, Bg);
    }}
}}
''')

if __name__ == '__main__':
    from genlib import PRELUDE
    E = Emit()
    E(PRELUDE)
    for p in (13, 17, 23):
        emit_prime(E, p)
    open('prime_test.c', 'w').write(E.text())
    print('wrote prime_test.c', len(E.text()))
EOF
