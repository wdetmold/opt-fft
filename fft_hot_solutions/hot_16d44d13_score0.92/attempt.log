#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <sched.h>
#include <stdint.h>

static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec + 1e-9*ts.tv_nsec; }
static double buf[1<<13] __attribute__((aligned(4096)));  // 64KB > L1? 8192 doubles = 64KB; use 4096 for 32KB
#define REP4(X) X X X X
#define REP16(X) REP4(REP4(X))

// latency chain: 4-cycle FMA dependency
static double lat_chain(long iters){
    double t0 = now();
    __asm__ volatile(
        "vmovapd (%1), %%zmm0\n\tvmovapd 64(%1), %%zmm1\n\tvmovapd 128(%1), %%zmm2\n"
        "1:\n\t"
        REP16("vfmadd213pd %%zmm2, %%zmm1, %%zmm0\n\t")
        "dec %0\n\tjnz 1b\n"
        : "+r"(iters) : "r"(buf) : "zmm0","zmm1","zmm2","memory");
    return (now() - t0);
}
// throughput: 16 independent FMA per iter
static double fma_tput(long iters){
    double t0 = now();
    __asm__ volatile(
        "vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n"
        "1:\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm0\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm1\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm2\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm3\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm4\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm5\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm6\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm7\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm8\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm9\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm10\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm11\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm12\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm13\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm0\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm1\n\t"
        "dec %0\n\tjnz 1b\n"
        : "+r"(iters) : "r"(buf)
        : "zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11","zmm12","zmm13","zmm14","zmm15","memory");
    return now() - t0;
}
// 8 FMA + 4 loads per iter (advancing pointer, L1-resident 16KB window)
static double mix_8f_4l(long iters){
    double t0 = now();
    __asm__ volatile(
        "vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t"
        "mov %1, %%rax\n\tlea 16384(%1), %%rcx\n"
        "1:\n\t"
        "vmovapd (%%rax), %%zmm8\n\tvmovapd 64(%%rax), %%zmm9\n\t"
        "vmovapd 128(%%rax), %%zmm10\n\tvmovapd 192(%%rax), %%zmm11\n\t"
        "vfmadd213pd %%zmm8, %%zmm15, %%zmm0\n\tvfmadd213pd %%zmm9, %%zmm15, %%zmm1\n\t"
        "vfmadd213pd %%zmm10, %%zmm15, %%zmm2\n\tvfmadd213pd %%zmm11, %%zmm15, %%zmm3\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm4\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm5\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm6\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm7\n\t"
        "add $256, %%rax\n\tcmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\t2:\n\t"
        "dec %0\n\tjnz 1b\n"
        : "+r"(iters) : "r"(buf)
        : "rax","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11","zmm14","zmm15","memory");
    return now() - t0;
}
// 2 loads per cycle test: 8 loads + 0 fma
static double pure_load(long iters){
    double t0 = now();
    __asm__ volatile(
        "mov %1, %%rax\n\tlea 16384(%1), %%rcx\n"
        "1:\n\t"
        "vmovapd (%%rax), %%zmm0\n\tvmovapd 64(%%rax), %%zmm1\n\t"
        "vmovapd 128(%%rax), %%zmm2\n\tvmovapd 192(%%rax), %%zmm3\n\t"
        "vmovapd 256(%%rax), %%zmm4\n\tvmovapd 320(%%rax), %%zmm5\n\t"
        "vmovapd 384(%%rax), %%zmm6\n\tvmovapd 448(%%rax), %%zmm7\n\t"
        "add $512, %%rax\n\tcmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\t2:\n\t"
        "dec %0\n\tjnz 1b\n"
        : "+r"(iters) : "r"(buf)
        : "rax","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","memory");
    return now() - t0;
}
// pure stores: 8 stores
static double pure_store(long iters){
    double t0 = now();
    __asm__ volatile(
        "vmovapd (%1), %%zmm0\n\t"
        "mov %1, %%rax\n\tlea 16384(%1), %%rcx\n"
        "1:\n\t"
        "vmovapd %%zmm0, (%%rax)\n\tvmovapd %%zmm0, 64(%%rax)\n\t"
        "vmovapd %%zmm0, 128(%%rax)\n\tvmovapd %%zmm0, 192(%%rax)\n\t"
        "vmovapd %%zmm0, 256(%%rax)\n\tvmovapd %%zmm0, 320(%%rax)\n\t"
        "vmovapd %%zmm0, 384(%%rax)\n\tvmovapd %%zmm0, 448(%%rax)\n\t"
        "add $512, %%rax\n\tcmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\t2:\n\t"
        "dec %0\n\tjnz 1b\n"
        : "+r"(iters) : "r"(buf)
        : "rax","rcx","zmm0","memory");
    return now() - t0;
}
// realistic: 8 FMA + 4 load + 2 store per iter  (14 vuops)
static double mix_8f_4l_2s(long iters){
    double t0 = now();
    __asm__ volatile(
        "vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t"
        "mov %1, %%rax\n\tlea 8192(%1), %%rcx\n"
        "1:\n\t"
        "vmovapd (%%rax), %%zmm8\n\tvmovapd 64(%%rax), %%zmm9\n\t"
        "vmovapd 128(%%rax), %%zmm10\n\tvmovapd 192(%%rax), %%zmm11\n\t"
        "vfmadd213pd %%zmm8, %%zmm15, %%zmm0\n\tvfmadd213pd %%zmm9, %%zmm15, %%zmm1\n\t"
        "vfmadd213pd %%zmm10, %%zmm15, %%zmm2\n\tvfmadd213pd %%zmm11, %%zmm15, %%zmm3\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm4\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm5\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm6\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm7\n\t"
        "vmovapd %%zmm4, 16384(%%rax)\n\tvmovapd %%zmm5, 16448(%%rax)\n\t"
        "add $256, %%rax\n\tcmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\t2:\n\t"
        "dec %0\n\tjnz 1b\n"
        : "+r"(iters) : "r"(buf)
        : "rax","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11","zmm14","zmm15","memory");
    return now() - t0;
}
// ymm FMA tput (16 per iter)
static double fma_tput_ymm(long iters){
    double t0 = now();
    __asm__ volatile(
        "vmovapd (%1), %%ymm14\n\tvmovapd 64(%1), %%ymm15\n"
        "1:\n\t"
        REP4("vfmadd213pd %%ymm14, %%ymm15, %%ymm0\n\tvfmadd213pd %%ymm14, %%ymm15, %%ymm1\n\tvfmadd213pd %%ymm14, %%ymm15, %%ymm2\n\tvfmadd213pd %%ymm14, %%ymm15, %%ymm3\n\t")
        "dec %0\n\tjnz 1b\n"
        : "+r"(iters) : "r"(buf)
        : "ymm0","ymm1","ymm2","ymm3","ymm14","ymm15","memory");
    return now() - t0;
}
// fma + shuffle mix (2:1): 8 FMA + 4 vpermpd
static double mix_8f_4sh(long iters){
    double t0 = now();
    __asm__ volatile(
        "vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\tvmovapd 128(%1), %%zmm13\n"
        "1:\n\t"
        "vpermpd %%zmm14, %%zmm13, %%zmm8\n\tvpermpd %%zmm15, %%zmm13, %%zmm9\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm0\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm1\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm2\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm3\n\t"
        "vpermpd %%zmm14, %%zmm13, %%zmm10\n\tvpermpd %%zmm15, %%zmm13, %%zmm11\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm4\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm5\n\t"
        "vfmadd213pd %%zmm14, %%zmm15, %%zmm6\n\tvfmadd213pd %%zmm14, %%zmm15, %%zmm7\n\t"
        "dec %0\n\tjnz 1b\n"
        : "+r"(iters) : "r"(buf)
        : "rax","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11","zmm13","zmm14","zmm15","memory");
    return now() - t0;
}

int main(void){
    cpu_set_t set; CPU_ZERO(&set); CPU_SET(0, &set); sched_setaffinity(0, sizeof(set), &set);
    for (int i = 0; i < (1<<13); i++) buf[i] = 1e-10 + i * 1e-18;
    long it = 10000000;
    lat_chain(it);
    double tl = 1e9; for (int r=0;r<5;r++){ double t=lat_chain(it); if(t<tl) tl=t; }
    double cyc = tl / (it * 16.0 * 4.0);
    printf("clock (FMA lat=4): %.3f GHz\n", 1e-9/cyc);
    uint64_t tsc0 = __builtin_ia32_rdtsc(); double w0 = now();
    while (now() - w0 < 0.2) {}
    uint64_t tsc1 = __builtin_ia32_rdtsc();
    printf("tsc: %.3f GHz\n", (tsc1-tsc0)/0.2e9);
    struct { const char* n; double (*f)(long); double ops; } T[] = {
        {"fma_tput(16F)      ", fma_tput, 16},
        {"fma_tput_ymm(16F)  ", fma_tput_ymm, 16},
        {"mix_8f_4l  (12u)   ", mix_8f_4l, 12},
        {"pure_load  (8L)    ", pure_load, 8},
        {"pure_store (8S)    ", pure_store, 8},
        {"mix_8f4l2s (14u)   ", mix_8f_4l_2s, 14},
        {"mix_8f_4sh (12u)   ", mix_8f_4sh, 12},
    };
    for (unsigned k = 0; k < sizeof(T)/sizeof(T[0]); k++) {
        T[k].f(it/10);
        double best=1e9; for(int r=0;r<5;r++){ double t=T[k].f(it/2); if(t<best)best=t; }
        double upc = T[k].ops * (it/2) * cyc / best;
        printf("%s: %6.3f uops/cyc  (%5.2f ns/iter)\n", T[k].n, upc, best/(it/2)*1e9);
    }
    return 0;
}
