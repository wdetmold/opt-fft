// MKL DFTI reference engine: iterate z = FFT3(x)+c; x = z/(1+|z|)
#include "mkl_dfti.h"
#include <math.h>
#include <string.h>
#include <stdlib.h>

typedef struct { double re, im; } cplx;

void run_mkl(int L, long B, long m, double* x, const double* c, double* one, double* final) {
    DFTI_DESCRIPTOR_HANDLE h;
    MKL_LONG dims[3] = {L, L, L};
    DftiCreateDescriptor(&h, DFTI_DOUBLE, DFTI_COMPLEX, 3, dims);
    DftiSetValue(h, DFTI_NUMBER_OF_TRANSFORMS, (MKL_LONG)B);
    DftiSetValue(h, DFTI_INPUT_DISTANCE, (MKL_LONG)(L*(long)L*L));
    DftiCommitDescriptor(&h);
    long n = B * (long)L*L*L;
    for (long k = 0; k < m; k++) {
        DftiComputeForward(h, x);
        for (long i = 0; i < n; i++) {
            double zr = x[2*i] + c[2*i], zi = x[2*i+1] + c[2*i+1];
            double d = 1.0 / (1.0 + sqrt(zr*zr + zi*zi));
            x[2*i] = zr * d; x[2*i+1] = zi * d;
        }
        if (k == 0) memcpy(one, x, n * 16);
    }
    memcpy(final, x, n * 16);
    DftiFreeDescriptor(&h);
}
EOF
