"""Shared emitter helpers for the FFT engine generator."""
import numpy as np

LD = np.longdouble

def hexd(v):
    """Emit a double as C hex literal, computed from long double."""
    d = float(v)
    return d.hex()

def trig_tables(p):
    """cos/sin(2*pi*t/p) computed in long double, t=0..p-1."""
    PI = LD('3.14159265358979323846264338327950288419716939937510582097494459')
    t = np.arange(p, dtype=LD)
    ang = 2 * PI * t / LD(p)
    return np.cos(ang), np.sin(ang)

class Emit:
    def __init__(self):
        self.lines = []
        self.ind = 0
    def __call__(self, s=''):
        for ln in s.split('\n'):
            self.lines.append('    ' * self.ind + ln)
    def text(self):
        return '\n'.join(self.lines) + '\n'

PRELUDE = r'''
#include <immintrin.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <sys/mman.h>

#define ALIGN64 __attribute__((aligned(64)))
typedef __m512d V;
#define VL(p)      _mm512_load_pd(p)
#define VLU(p)     _mm512_loadu_pd(p)
#define VS(p,v)    _mm512_store_pd(p,v)
#define VSU(p,v)   _mm512_storeu_pd(p,v)
#define VADD(a,b)  _mm512_add_pd(a,b)
#define VSUB(a,b)  _mm512_sub_pd(a,b)
#define VMUL(a,b)  _mm512_mul_pd(a,b)
#define VFMA(a,b,c)  _mm512_fmadd_pd(a,b,c)   /* a*b+c */
#define VFMS(a,b,c)  _mm512_fmsub_pd(a,b,c)   /* a*b-c */
#define VFNMA(a,b,c) _mm512_fnmadd_pd(a,b,c)  /* -a*b+c */
#define VSET1(x)   _mm512_set1_pd(x)
#define VZERO()    _mm512_setzero_pd()
#define VRSQRT(a)  _mm512_rsqrt14_pd(a)
#define VRCP(a)    _mm512_rcp14_pd(a)
#define VSQRT(a)   _mm512_sqrt_pd(a)
#define VDIV(a,b)  _mm512_div_pd(a,b)

static void* alloc_arena(size_t bytes){
    size_t sz = (bytes + (2u<<20) - 1) & ~(size_t)((2u<<20)-1);
    void* p = mmap(0, sz + (2u<<20), PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
    if (p == MAP_FAILED) { void* q = 0; if (posix_memalign(&q, 64, bytes)) return 0; memset(q, 0, bytes); return q; }
    uintptr_t a = ((uintptr_t)p + (2u<<20) - 1) & ~(uintptr_t)((2u<<20)-1);
    madvise((void*)a, sz, MADV_HUGEPAGE);
    memset((void*)a, 0, sz);
    return (void*)a;
}

/* map helpers: given zr,zi (z = fft+c already), produce zr*d, zi*d with d = 1/(1+|z|).
   M3 variant: rsqrt14+2NR for |z|, one vdivpd for the reciprocal. */
#define MAP_M3(zr, zi, or_, oi_) do { \
    V n2 = VFMA(zr, zr, VMUL(zi, zi)); \
    V s = VRSQRT(n2); \
    V u1 = VMUL(n2, s); V v1 = VMUL(u1, s); V w1 = VFNMA(v1, VSET1(0.5), VSET1(1.5)); s = VMUL(s, w1); \
    V u2 = VMUL(n2, s); V v2 = VMUL(u2, s); V w2 = VFNMA(v2, VSET1(0.5), VSET1(1.5)); s = VMUL(s, w2); \
    V t = VFMA(n2, s, VSET1(1.0)); \
    V d = VDIV(VSET1(1.0), t); \
    or_ = VMUL(zr, d); oi_ = VMUL(zi, d); \
} while(0)

/* M4 variant: all-FMA (rsqrt14+2NR, rcp14+2NR), no divider. */
#define MAP_M4(zr, zi, or_, oi_) do { \
    V n2 = VFMA(zr, zr, VMUL(zi, zi)); \
    V s = VRSQRT(n2); \
    V u1 = VMUL(n2, s); V v1 = VMUL(u1, s); V w1 = VFNMA(v1, VSET1(0.5), VSET1(1.5)); s = VMUL(s, w1); \
    V u2 = VMUL(n2, s); V v2 = VMUL(u2, s); V w2 = VFNMA(v2, VSET1(0.5), VSET1(1.5)); s = VMUL(s, w2); \
    V t = VFMA(n2, s, VSET1(1.0)); \
    V d = VRCP(t); \
    V e1 = VFNMA(t, d, VSET1(1.0)); d = VFMA(d, e1, d); \
    V e2 = VFNMA(t, d, VSET1(1.0)); d = VFMA(d, e2, d); \
    or_ = VMUL(zr, d); oi_ = VMUL(zi, d); \
} while(0)

/* M2 variant: hardware sqrt + rcp14+2NR. */
#define MAP_M2(zr, zi, or_, oi_) do { \
    V n2 = VFMA(zr, zr, VMUL(zi, zi)); \
    V t = VADD(VSQRT(n2), VSET1(1.0)); \
    V d = VRCP(t); \
    V e1 = VFNMA(t, d, VSET1(1.0)); d = VFMA(d, e1, d); \
    V e2 = VFNMA(t, d, VSET1(1.0)); d = VFMA(d, e2, d); \
    or_ = VMUL(zr, d); oi_ = VMUL(zi, d); \
} while(0)
'''
EOF
