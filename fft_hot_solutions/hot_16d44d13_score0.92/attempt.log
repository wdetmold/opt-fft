        c = 0.1 * (rng_c.standard_normal((B, L, L, L)) + 1j * rng_c.standard_normal((B, L, L, L)))
        outs += [x0.ravel(), c.ravel()]
    r = np.concatenate(outs)
    t1 = time.perf_counter()
    print('inputgen+concat', t1-t0)
