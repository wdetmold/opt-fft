import sys
sys.path.insert(0, '/workdir')
import numpy as np, importlib
import solution
rng = np.random.default_rng(7)
tol = {6:1e-4, 8:3e-6, 13:1e-9, 17:1e-10, 23:1e-10, 36:1e-10, 45:1e-10, 64:1e-10}
sizes = (6,8,13,17,23,36,45,64)
fails = 0
for trial in range(6):
    Bs = [int(rng.integers(1, 20)) for _ in sizes]
    ms = [int(rng.integers(1, 8)) for _ in sizes]
    seed = int(rng.integers(0, 100000))
    args = (seed, *Bs, *ms)
    r_me = solution.transform(*args)
    # pocketfft reference inline
    outs = []
    for L, B, m in zip(sizes, Bs, ms):
        rx = np.random.default_rng(seed + L)
        x = rx.standard_normal((B, L, L, L)) + 1j*rx.standard_normal((B, L, L, L))
        rc = np.random.default_rng(1000 + L)
        c = 0.1*(rc.standard_normal((B, L, L, L)) + 1j*rc.standard_normal((B, L, L, L)))
        one = None
        for k in range(m):
            z = np.fft.fftn(x, axes=(1,2,3)) + c
            x = z/(1+np.abs(z))
            if k == 0: one = x.copy()
        outs += [one.ravel(), x.ravel()]
    r_ref = np.concatenate(outs)
    off = 0
    for L, B, m in zip(sizes, Bs, ms):
        n = B*L**3
        for which, gate in (('one', 1e-14), ('final', tol[L])):
            a = r_me[off:off+n]; b = r_ref[off:off+n]
            e = np.linalg.norm(a-b)/np.linalg.norm(b)
            if e >= gate*0.5:
                print(f'trial {trial} L={L} B={B} m={m} {which}: {e:.2e} vs gate {gate:.0e} <-- CHECK')
                fails += 1
            off += n
    print(f'trial {trial}: Bs={Bs} ms={ms} ok')
print('fuzz done, fails:', fails)
EOF</antml:parameter>
</antml:invoke>
</antml:function_calls>
