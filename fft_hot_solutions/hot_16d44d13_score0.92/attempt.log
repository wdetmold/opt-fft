The a90 baseline: 1.17s compute on my calibrated workload vs MKL 4.3s (r≈0.28). Now the load-bearing question: the claimed ~2.1 vector-uops/cycle issue cap. Let me verify this machine's actual capabilities with careful microbenchmarks.

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">mkdir -p /tmp/micro && cd /tmp/micro && cat > ub.c << 'EOF'
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <immintrin.h>
#include <sched.h>

static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec + 1e-9*ts.tv_nsec; }

static double buf[16384] __attribute__((aligned(64)));

// FMA latency chain to calibrate clock: latency of vfmadd is 4 cycles on ICL
__attribute__((noinline)) double lat_chain(long iters){
    __m512d a = _mm512_set1_pd(1e-10), b = _mm512_set1_pd(1.0000001), c = _mm512_set1_pd(1e-12);
    double t0 = now();
    for (long i = 0; i < iters; i++) {
        a = _mm512_fmadd_pd(a, b, c);
        __asm__ volatile("" : "+x"(a));
    }
    double t1 = now();
    volatile double sink = a[0]; (void)sink;
    return (t1 - t0) / iters;   // seconds per 4-cycle chain step
}

// pure reg-reg FMA throughput, 10 accumulators
__attribute__((noinline)) double fma_tput(long iters){
    __m512d a0,a1,a2,a3,a4,a5,a6,a7,a8,a9, b, c;
    a0=a1=a2=a3=a4=a5=a6=a7=a8=a9=_mm512_set1_pd(1e-10);
    b=_mm512_set1_pd(1.0000001); c=_mm512_set1_pd(1e-12);
    double t0 = now();
    for (long i = 0; i < iters; i++) {
        a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c);
        a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
        a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
        a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
        a8=_mm512_fmadd_pd(a8,b,c); a9=_mm512_fmadd_pd(a9,b,c);
        __asm__ volatile("" : "+x"(a0),"+x"(a1),"+x"(a2),"+x"(a3),"+x"(a4),"+x"(a5),"+x"(a6),"+x"(a7),"+x"(a8),"+x"(a9));
    }
    double t1 = now();
    volatile double sink = a0[0]+a1[0]+a2[0]+a3[0]+a4[0]+a5[0]+a6[0]+a7[0]+a8[0]+a9[0]; (void)sink;
    return (t1-t0)/iters; // sec per 10 FMAs
}

// mix: per loop iter: nf FMA + nl loads + ns stores (L1-resident)
#define MIXK(NAME, BODY, COUNT) \
__attribute__((noinline)) double NAME(long iters){ \
    __m512d a0,a1,a2,a3,a4,a5,a6,a7, b, c; \
    a0=a1=a2=a3=a4=a5=a6=a7=_mm512_set1_pd(1e-10); \
    b=_mm512_set1_pd(1.0000001); c=_mm512_set1_pd(1e-12); \
    double* p = buf; \
    double t0 = now(); \
    for (long i = 0; i < iters; i++) { BODY \
        __asm__ volatile("" : "+x"(a0),"+x"(a1),"+x"(a2),"+x"(a3),"+x"(a4),"+x"(a5),"+x"(a6),"+x"(a7)); } \
    double t1 = now(); \
    volatile double sink = a0[0]+a1[0]+a2[0]+a3[0]+a4[0]+a5[0]+a6[0]+a7[0]; (void)sink; \
    return (t1-t0)/iters; }

// 8 FMA + 4 loads (2:1)
MIXK(mix_2f_1l, {
    __m512d l0 = _mm512_load_pd(p+0), l1 = _mm512_load_pd(p+64), l2 = _mm512_load_pd(p+128), l3 = _mm512_load_pd(p+192);
    a0=_mm512_fmadd_pd(a0,b,l0); a1=_mm512_fmadd_pd(a1,b,l1);
    a2=_mm512_fmadd_pd(a2,b,l2); a3=_mm512_fmadd_pd(a3,b,l3);
    a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
    a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
}, 12)

// 8 FMA + 8 loads (1:1)
MIXK(mix_1f_1l, {
    __m512d l0 = _mm512_load_pd(p+0), l1 = _mm512_load_pd(p+64), l2 = _mm512_load_pd(p+128), l3 = _mm512_load_pd(p+192);
    __m512d l4 = _mm512_load_pd(p+256), l5 = _mm512_load_pd(p+320), l6 = _mm512_load_pd(p+384), l7 = _mm512_load_pd(p+448);
    a0=_mm512_fmadd_pd(a0,b,l0); a1=_mm512_fmadd_pd(a1,b,l1);
    a2=_mm512_fmadd_pd(a2,b,l2); a3=_mm512_fmadd_pd(a3,b,l3);
    a4=_mm512_fmadd_pd(a4,b,l4); a5=_mm512_fmadd_pd(a5,b,l5);
    a6=_mm512_fmadd_pd(a6,b,l6); a7=_mm512_fmadd_pd(a7,b,l7);
}, 16)

// pure loads: 8 loads
MIXK(pure_load, {
    __m512d l0 = _mm512_load_pd(p+0), l1 = _mm512_load_pd(p+64), l2 = _mm512_load_pd(p+128), l3 = _mm512_load_pd(p+192);
    __m512d l4 = _mm512_load_pd(p+256), l5 = _mm512_load_pd(p+320), l6 = _mm512_load_pd(p+384), l7 = _mm512_load_pd(p+448);
    a0=_mm512_add_pd(l0,l1); a1=_mm512_add_pd(l2,l3); a2=_mm512_add_pd(l4,l5); a3=_mm512_add_pd(l6,l7);
}, 8)

// stores: 4 stores per iter
MIXK(pure_store, {
    _mm512_store_pd(p+512, a0); _mm512_store_pd(p+576, a1);
    _mm512_store_pd(p+640, a2); _mm512_store_pd(p+704, a3);
}, 4)

// realistic kernel mix: 8 FMA + 4 load + 2 store
MIXK(mix_8f_4l_2s, {
    __m512d l0 = _mm512_load_pd(p+0), l1 = _mm512_load_pd(p+64), l2 = _mm512_load_pd(p+128), l3 = _mm512_load_pd(p+192);
    a0=_mm512_fmadd_pd(a0,b,l0); a1=_mm512_fmadd_pd(a1,b,l1);
    a2=_mm512_fmadd_pd(a2,b,l2); a3=_mm512_fmadd_pd(a3,b,l3);
    a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
    a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
    _mm512_store_pd(p+512, a4); _mm512_store_pd(p+576, a5);
}, 14)

// broadcast-operand FMA: 8 FMA all with embedded broadcast
MIXK(bcast_fma, {
    a0=_mm512_fmadd_pd(a0,b,_mm512_set1_pd(p[0])); a1=_mm512_fmadd_pd(a1,b,_mm512_set1_pd(p[1]));
    a2=_mm512_fmadd_pd(a2,b,_mm512_set1_pd(p[2])); a3=_mm512_fmadd_pd(a3,b,_mm512_set1_pd(p[3]));
    a4=_mm512_fmadd_pd(a4,b,_mm512_set1_pd(p[4])); a5=_mm512_fmadd_pd(a5,b,_mm512_set1_pd(p[5]));
    a6=_mm512_fmadd_pd(a6,b,_mm512_set1_pd(p[6])); a7=_mm512_fmadd_pd(a7,b,_mm512_set1_pd(p[7]));
}, 8)

int main(int argc, char** argv){
    cpu_set_t set; CPU_ZERO(&set); CPU_SET(0, &set); sched_setaffinity(0, sizeof(set), &set);
    memset(buf, 1, sizeof(buf)); for (int i=0;i<16384;i++) buf[i]=1e-10+i*1e-18;
    long it = 20000000;
    lat_chain(it/10);
    double t_lat = lat_chain(it);           // 4 cycles per iter
    double cyc = t_lat / 4.0;               // sec per cycle
    printf("clock: %.3f GHz (assuming FMA latency 4)\n", 1e-9/cyc);
    struct { const char* name; double (*fn)(long); double nops; const char* what; } tests[] = {
        {"fma_tput   ", fma_tput,    10, "FMA/cyc"},
        {"mix_2f_1l  ", mix_2f_1l,   12, "vuops/cyc (8F+4L)"},
        {"mix_1f_1l  ", mix_1f_1l,   16, "vuops/cyc (8F+8L)"},
        {"pure_load  ", pure_load,   8,  "loads .. (8L+4A)/cyc"},
        {"pure_store ", pure_store,  4,  "stores/cyc"},
        {"mix_8f4l2s ", mix_8f_4l_2s,14, "vuops/cyc (8F+4L+2S)"},
        {"bcast_fma  ", bcast_fma,   8,  "bcastFMA/cyc"},
    };
    for (unsigned k = 0; k < sizeof(tests)/sizeof(tests[0]); k++) {
        tests[k].fn(it/10);
        double best = 1e9;
        for (int r = 0; r < 5; r++) { double t = tests[k].fn(it/4); if (t < best) best = t; }
        printf("%s: %6.3f %s\n", tests[k].name, tests[k].nops * cyc / best, tests[k].what);
    }
    return 0;
}
EOF
