import re
a90 = open('/tmp/w/a90/dev_generators_final/implementation.c').read()  # on-host regenerated
f30 = open('/tmp/w/d43/impl_3f30.c').read()

def top_idents(src):
    ids = set()
    # crude: function defs & file-scope vars: "static ... name(" and "double* name;" etc
    for m in re.finditer(r'^(?:static\s+)?(?:inline\s+)?(?:__attribute__\(\(.*?\)\)\s*)?(?:const\s+)?(?:unsigned\s+)?(?:void|int|long|double|float|__m512d|__m512i|__m256d|uint64_t|int64_t|size_t|char)\s*\**\s*([A-Za-z_][A-Za-z0-9_]*)\s*[(;\[=]', src, re.M):
        ids.add(m.group(1))
    for m in re.finditer(r'^#define\s+([A-Za-z_][A-Za-z0-9_]*)', src, re.M):
        ids.add(m.group(1))
    return ids

ia, ib = top_idents(a90), top_idents(f30)
coll = sorted(ia & ib)
print('collisions:', coll)
print('f30 identifiers:', len(ib))
EOF</antml:parameter>
