Now implementing the fused "zmega" pass: transpose-in + z-DFT + c/map + z-DFT(t+1) + transpose-out, all in one plane visit through L1 tiles — replacing four separate plane passes.

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /workdir/dev && cat >> gen_vol.py << 'PYEOF'

def emit_zmega(E, L, variant):
    """zmega{L}_{variant}(pr, pi, cr, ci [, kr, ki]) : per-plane fused pass:
    for each y-slab (8 y in lanes): T-in -> DFT_z(t) -> +c,map(,cap) -> [DFT_z(t+1)] -> T-out.
    variant: 'pre' (with second DFT) | 'fin' (no second DFT) | 'cappre'/'capfin' (with capture).
    c/cap given as TRANSPOSED planes (rows=z, cols=y)."""
    cfg = CFG[L]; pitch = cfg['pitch']; nqb = cfg['nqb']
    cap = variant.startswith('cap')
    pre = variant.endswith('pre')
    name = f'zm{L}_{variant}'
    args = 'double* restrict pr, double* restrict pi, const double* restrict cr, const double* restrict ci'
    if cap: args += ', double* restrict kr, double* restrict ki'
    E(f'static void {name}({args}){{')
    E.ind += 1
    E(f'static double TT[{pitch}*16] ALIGN64 = {{[0 ... {pitch*16-1}] = 0.5}};')
    E(f'static double TM2[{pitch}*16] ALIGN64 = {{[0 ... {pitch*16-1}] = 0.5}};')
    E(f'static double TM3[{pitch}*16] ALIGN64 = {{[0 ... {pitch*16-1}] = 0.5}};')
    E(f'double TMP[{L}*16] ALIGN64;')
    E(f'for (long bi = 0; bi < {nqb}; bi++) {{')
    E.ind += 1
    E(f'double* bp_r = pr + bi*8; double* bp_i = pi + bi*8;')
    # T-in: for each z-block cb: TR8 of (rows=y-slab bi... rows are y: block rows = bi*8..; cols = cb*8..)
    # careful: the slab is y in LANES: block = plane rows bi*8..bi*8+7, cols cb*8..+7 -> TR8 -> z-major
    E(f'for (long cb = 0; cb < {nqb}; cb++) {{')
    E.ind += 1
    for comp, (src, toff) in enumerate((('pr', 0), ('pi', 8))):
        E(f'{{ double* b = {src} + bi*{8*pitch} + cb*8;')
        E(f'  LDB8(b, {pitch}, a0,a1,a2,a3,a4,a5,a6,a7)')
        E('  V o0,o1,o2,o3,o4,o5,o6,o7;')
        E('  TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);')
        for k in range(8):
            E(f'  VS(TT + (cb*8 + {k})*16 + {toff}, o{k});')
        E('}')
    E.ind -= 1
    E('}')
    # DFT_z(t) on TT -> map -> TM3 (mapped); using emit_body_twostage
    addr_tt = lambda j: (f'TT + {j*16}', f'TT + {j*16 + 8}')
    addr_tm3 = lambda k: (f'TM3 + {k*16}', f'TM3 + {k*16 + 8}')
    addr_c = lambda k: (f'cr + {k}*{pitch} + bi*8', f'ci + {k}*{pitch} + bi*8')
    # map variant writes to TM3; emit manually to add capture store
    cfg2 = CFG[L]
    n1, n2, mode = cfg2['n1'], cfg2['n2'], cfg2['mode']
    inm, outm = dft_factor_maps(L, n1, n2, mode)
    consts = {}
    sub = Emit(); sub.ind = E.ind
    ctx = Ctx(sub, 'z')
    for g in range(n2):
        sub('{')
        xs = []
        for t1 in range(n1):
            j = inm[t1][g]
            cx = ctx.new()
            ctx.dekl(cx, f'VL(TT + {j*16})', f'VL(TT + {j*16+8})')
            xs.append(cx)
        o = [None]*n1
        emit_stage_dft(ctx, n1, xs, o, consts)
        if mode == 'ct':
            o = [emit_tw(ctx, o[k1], L, g*k1, consts) for k1 in range(n1)]
        for t1 in range(n1):
            sub(f'VS(TMP + {(t1*n2 + g)*16}, {o[t1].r}); VS(TMP + {(t1*n2 + g)*16 + 8}, {o[t1].i});')
        sub('}')
    for u1 in range(n1):
        sub('{')
        xs = []
        for t2 in range(n2):
            cx = ctx.new()
