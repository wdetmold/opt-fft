# sanity: check numpy fftn chain against it
def run(x0, c, one, fin, B, m):
    L = round((len(x0)/B)**(1/3))
    x = x0.reshape(B, L, L, L).copy()
    cc = c.reshape(B, L, L, L)
    for k in range(m):
        z = np.fft.fftn(x, axes=(1,2,3)) + cc
        x = z/(1+np.abs(z))
        if k == 0: one[:] = x.ravel()
    fin[:] = x.ravel()
