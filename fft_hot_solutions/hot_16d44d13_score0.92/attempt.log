import re
src = open('/workdir/implementation.c').read()
# Extract the full k64 function text
i = src.index('void k64(vd *restrict xr')
# find matching close: k64 ends right before "#define GEN_WRAPPERS"
j = src.index('#define GEN_WRAPPERS', i)
k64txt = src[i:j]
# Build k64_mp: phase 1 = k64 with map forced on, storing to tile T2 (natural order);
# phase 2 = k64 plain reading T2 (stride 1), writing xr/xi.
p1 = k64txt
p1 = p1.replace('void k64(vd *restrict xr, vd *restrict xi, ptrdiff_t s,\n         const vd *restrict cr, const vd *restrict ci, const int domap) {',
                'static void k64_mp(vd *restrict xr, vd *restrict xi, ptrdiff_t s,\n         const vd *restrict cr, const vd *restrict ci) {\n    vd t2r[64], t2i[64];')
# phase-1 stores: KSTORE(xr[pN], xi[pN], rN, iN, cr[pN], ci[pN], domap) -> mapped into t2 slots (k1 + 8*k2)
def repl_store(m):
    pvar, r, i2, _, _2 = m.groups()
    return f'{{ vd _r = ({r}) + cr[{pvar}], _i = ({i2}) + ci[{pvar}]; mapv(&_r, &_i); t2r[{pvar}/s] = _r; t2i[{pvar}/s] = _i; }}'
# KSTORE(xr[p0], xi[p0], r0, i0, cr[p0], ci[p0], domap);
p1 = re.sub(r'KSTORE\(xr\[(p\d)\], xi\[\1\], (r\d), (i\d), cr\[\1\], ci\[\1\], domap\);',
            lambda m: f'{{ vd _r = {m.group(2)} + cr[{m.group(1)}], _i = {m.group(3)} + ci[{m.group(1)}]; mapv(&_r, &_i); t2r[{m.group(1)}/s] = _r; t2i[{m.group(1)}/s] = _i; }}',
            p1)
assert 'KSTORE' not in p1, 'unreplaced stores'
# append phase 2: plain k64 body on t2 (stride 1), writing xr/xi with stride s
phase2 = '''
    /* phase 2: DFT of the mapped values (next step's z-pass), t2 -> slab */
    for (int b = 0; b < 8; b++) {
        vd r0 = t2r[b],    i0 = t2i[b];
        vd r1 = t2r[8+b],  i1 = t2i[8+b];
        vd r2 = t2r[16+b], i2 = t2i[16+b];
        vd r3 = t2r[24+b], i3 = t2i[24+b];
        vd r4 = t2r[32+b], i4 = t2i[32+b];
        vd r5 = t2r[40+b], i5 = t2i[40+b];
        vd r6 = t2r[48+b], i6 = t2i[48+b];
        vd r7 = t2r[56+b], i7 = t2i[56+b];
        bf8(&r0,&i0,&r1,&i1,&r2,&i2,&r3,&i3,&r4,&i4,&r5,&i5,&r6,&i6,&r7,&i7);
        t2r[b] = r0; t2i[b] = i0;
        if (b == 0) {
            t2r[8]=r1; t2i[8]=i1;   t2r[16]=r2; t2i[16]=i2;
            t2r[24]=r3; t2i[24]=i3; t2r[32]=r4; t2i[32]=i4;
            t2r[40]=r5; t2i[40]=i5; t2r[48]=r6; t2i[48]=i6;
            t2r[56]=r7; t2i[56]=i7;
        } else {
            t2r[8+b]  = r1*TW64R[b][1] - i1*TW64I[b][1];  t2i[8+b]  = r1*TW64I[b][1] + i1*TW64R[b][1];
            t2r[16+b] = r2*TW64R[b][2] - i2*TW64I[b][2];  t2i[16+b] = r2*TW64I[b][2] + i2*TW64R[b][2];
            t2r[24+b] = r3*TW64R[b][3] - i3*TW64I[b][3];  t2i[24+b] = r3*TW64I[b][3] + i3*TW64R[b][3];
            t2r[32+b] = r4*TW64R[b][4] - i4*TW64I[b][4];  t2i[32+b] = r4*TW64I[b][4] + i4*TW64R[b][4];
