#include <stdio.h>
#include <time.h>
static double nwp(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec + 1e-9*ts.tv_nsec; }
void prof64alt(long m){
    if (!f30_inited_) { init_tables(); f30_inited_ = 1; }
    double tA=0, tXp=0, tY=0, tZ=0, tM=0; long nA=0, nX=0;
    for (long t = 2; t <= m; t++) {
        double t0 = nwp();
        if ((t & 1) == 0) { sweepX64_mappre(XP_, CP_); tXp += nwp()-t0; nX++; }
        else              { sweepA64(XP_, CP_, 1); tA += nwp()-t0; nA++; }
    }
    // sub-profiles of sweepA64 parts
    double t0 = nwp();
    for (int r = 0; r < 8; r++) for (int a = 0; a < 8; a++) { vd* slab = XP_ + 2*(ptrdiff_t)a*SA64; for (int z = 0; z < 64; z++) k64_p(slab + 2*z, slab + 2*z + 1, 2*RY64); }
    tY = (nwp()-t0)/8;
    t0 = nwp();
    for (int r = 0; r < 8; r++) for (int a = 0; a < 8; a++) { vd* slab = XP_ + 2*(ptrdiff_t)a*SA64; for (int y = 0; y < 64; y++) k64_p(slab + 2*(ptrdiff_t)y*RY64, slab + 2*(ptrdiff_t)y*RY64 + 1, 2); }
    tZ = (nwp()-t0)/8;
    t0 = nwp();
    for (int r = 0; r < 8; r++) for (int a = 0; a < 8; a++) { vd* slab = XP_ + 2*(ptrdiff_t)a*SA64; const vd* cs = CP_ + 2*(ptrdiff_t)a*SA64; for (int y = 0; y < 64; y++) k64_m(slab + 2*(ptrdiff_t)y*RY64, slab + 2*(ptrdiff_t)y*RY64 + 1, 2, cs + 2*(ptrdiff_t)y*RY64, cs + 2*(ptrdiff_t)y*RY64 + 1); }
    tM = (nwp()-t0)/8;
    printf("sweepA64: %.0f us (Y-pass %.0f us, Z-pass %.0f us, Zmap-pass %.0f us)\n", tA/nA*1e6, tY*1e6, tZ*1e6, tM*1e6);
    printf("sweepX64_mappre: %.0f us\n", tXp/nX*1e6);
}
EOF
