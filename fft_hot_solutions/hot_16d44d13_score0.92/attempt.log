#define FMM(n,off) "vfmadd231pd " #off "(%%rax), %%zmm15, %%zmm" #n "\n\t"
#define LOOP(body) \
    __asm__ volatile("vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t" \
        "mov %1, %%rax\n\tlea 65536(%1), %%rbx\n\tmov $8192, %%rcx\n" "1:\n\t" \
        body \
        "add $512, %%rax\n\tand %%rcx, %%rax\n\tadd %1, %%rax\n\t... " \
        : : : ); 
// simpler: fixed address loop (stays in L1, no advance) but ensure loads not hoisted: asm has memory clobber and rax changes? keep advancing within 32KB
static double run(long iters, const char* name, int nf, int nl, int ns, int mode){
    double t0 = 0, best = 1e9;
    for (int rep = 0; rep < 7; rep++) {
        long n = iters;
        t0 = now();
        switch (mode) {
        case 0: // nf=8 FMA + nl zmm loads + ns stores
        __asm__ volatile("vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t"
            "mov %1, %%rax\n\tlea 32768(%1), %%rbx\n\tlea 65536(%1), %%rcx\n"
            "1:\n\t"
            LD(8,0) LD(9,64) LD(10,128) LD(11,192) LD(12,256) LD(13,320)
            FM(0) FM(1) FM(2) FM(3) FM(4) FM(5) FM(6) FM(7)
            ST(0,0) ST(1,64) ST(2,128) ST(3,192)
            "add $384, %%rax\n\tadd $256, %%rbx\n\t"
            "cmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\tlea 32768(%1), %%rbx\n\t2:\n\t"
            "dec %0\n\tjnz 1b\n" : "+r"(n) : "r"(buf)
            : "rax","rbx","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11","zmm12","zmm13","zmm14","zmm15","memory");
            break;
        case 1: // 8 FMA + 2 zmm loads + 1 store
        __asm__ volatile("vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t"
            "mov %1, %%rax\n\tlea 32768(%1), %%rbx\n\tlea 65536(%1), %%rcx\n"
            "1:\n\t"
            LD(8,0) LD(9,64)
            FM(0) FM(1) FM(2) FM(3) FM(4) FM(5) FM(6) FM(7)
            ST(0,0)
            "add $128, %%rax\n\tadd $64, %%rbx\n\t"
            "cmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\tlea 32768(%1), %%rbx\n\t2:\n\t"
            "dec %0\n\tjnz 1b\n" : "+r"(n) : "r"(buf)
            : "rax","rbx","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm14","zmm15","memory");
            break;
        case 2: // 8 FMA with embedded broadcast memory operands (bcast from L1)
        __asm__ volatile("vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t"
            "mov %1, %%rax\n\tlea 65536(%1), %%rcx\n"
            "1:\n\t"
            FMB(0,0) FMB(1,8) FMB(2,16) FMB(3,24) FMB(4,32) FMB(5,40) FMB(6,48) FMB(7,56)
            "add $64, %%rax\n\t"
            "cmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\t2:\n\t"
            "dec %0\n\tjnz 1b\n" : "+r"(n) : "r"(buf)
            : "rax","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm14","zmm15","memory");
            break;
        case 3: // 8 FMA with full 64B memory operands
        __asm__ volatile("vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t"
            "mov %1, %%rax\n\tlea 65536(%1), %%rcx\n"
            "1:\n\t"
            FMM(0,0) FMM(1,64) FMM(2,128) FMM(3,192) FMM(4,256) FMM(5,320) FMM(6,384) FMM(7,448)
            "add $512, %%rax\n\t"
            "cmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\t2:\n\t"
            "dec %0\n\tjnz 1b\n" : "+r"(n) : "r"(buf)
            : "rax","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm14","zmm15","memory");
            break;
        case 4: // 8 FMA + 4 ymm loads + 2 ymm stores
        __asm__ volatile("vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t"
            "mov %1, %%rax\n\tlea 32768(%1), %%rbx\n\tlea 65536(%1), %%rcx\n"
            "1:\n\t"
            LDY(8,0) LDY(9,32) LDY(10,64) LDY(11,96)
            FM(0) FM(1) FM(2) FM(3) FM(4) FM(5) FM(6) FM(7)
            "vmovapd %%ymm0, (%%rbx)\n\tvmovapd %%ymm1, 32(%%rbx)\n\t"
            "add $128, %%rax\n\tadd $64, %%rbx\n\t"
            "cmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\tlea 32768(%1), %%rbx\n\t2:\n\t"
            "dec %0\n\tjnz 1b\n" : "+r"(n) : "r"(buf)
            : "rax","rbx","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11","zmm14","zmm15","memory");
            break;
        case 5: // 12 FMA + 6 zmm loads + 3 zmm stores (2:1:0.5 scaled)
        __asm__ volatile("vmovapd (%1), %%zmm14\n\tvmovapd 64(%1), %%zmm15\n\t"
            "mov %1, %%rax\n\tlea 32768(%1), %%rbx\n\tlea 65536(%1), %%rcx\n"
            "1:\n\t"
            LD(8,0) LD(9,64) LD(10,128)
            FM(0) FM(1) FM(2) FM(3) FM(4) FM(5)
            ST(0,0)
            LD(11,192) LD(12,256) LD(13,320)
            FM(6) FM(7) FM(0) FM(1) FM(2) FM(3)
            ST(1,64) ST(2,128)
            "add $384, %%rax\n\tadd $192, %%rbx\n\t"
            "cmp %%rcx, %%rax\n\tjb 2f\n\tmov %1, %%rax\n\tlea 32768(%1), %%rbx\n\t2:\n\t"
            "dec %0\n\tjnz 1b\n" : "+r"(n) : "r"(buf)
            : "rax","rbx","rcx","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11","zmm12","zmm13","zmm14","zmm15","memory");
            break;
        }
        double t = now() - t0;
        if (t < best) best = t;
    }
    double ns = best / iters * 1e9;
    printf("%-28s: %7.3f ns/iter  F=%4.2f/ns L=%4.2f/ns S=%4.2f/ns  tot=%4.2f vu/ns\n",
        name, ns, nf/ns, nl/ns, ns>0?ns*0:0 + ns ? (double)0 : 0, (nf+nl+ns)/ns);
    return best;
}
int main(void){
    cpu_set_t set; CPU_ZERO(&set); CPU_SET(0, &set); sched_setaffinity(0, sizeof(set), &set);
    for (int i = 0; i < (1<<14); i++) buf[i] = 1e-10 + i * 1e-18;
    long it = 6000000;
    run(it, "8F+6L+4S zmm", 8, 6, 4, 0);
    run(it, "8F+2L+1S zmm", 8, 2, 1, 1);
    run(it, "8F bcast-mem", 8, 8, 0, 2);
    run(it, "8F full-mem", 8, 8, 0, 3);
    run(it, "8F+4Ly+2Sy ymm ld/st", 8, 4, 2, 4);
    run(it, "12F+6L+3S zmm", 12, 6, 3, 5);
    return 0;
}
EOF
