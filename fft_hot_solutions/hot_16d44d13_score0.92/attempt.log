Best prior engines all sit at 3-4.5 ns/pt. My cost model suggests ~1.4-1.7 ns/pt is achievable. Before committing to a design, let me prototype the critical kernel — a batched radix-8×8 DFT-64 pass (lanes = 8 pencils, pure vertical) — and validate the throughput model.

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">mkdir -p /tmp/proto && cd /tmp/proto && cat > p64.c << 'EOF'
// Prototype: DFT-64 along "rows" for 8 pencils in lanes (pure vertical SIMD).
// Data: xre[j][lane], xim[j][lane], j=0..63 (j-major, 8 lanes) in L1/L2 scratch.
// Algorithm: CT 64 = 8x8: stage A: DFT8 over j1 (j = 8*j1 + j0), twiddle, stage B: DFT8 over j0.
// Here: straight-line with registers: process one j0 at a time? Need all 64...
// Two-sweep through L1 scratch: stage A reads j at stride 8 (8 regs), writes back; stage B reads stride 1.
#define _GNU_SOURCE
#include <immintrin.h>
#include <stdio.h>
#include <time.h>
#include <sched.h>
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec + 1e-9*ts.tv_nsec; }

#define LD(p) _mm512_load_pd(p)
#define ST(p,v) _mm512_store_pd(p,v)

static double W[64*2*8] __attribute__((aligned(64)));    // twiddle per (k1,j0): re/im broadcast lanes
static double X[64*2*8+8] __attribute__((aligned(64)));  // one tile: 64 j x (re,im) x 8 lanes
static double Y[64*2*8+8] __attribute__((aligned(64)));

// complex DFT8 macro on 8 register pairs (vertical), unnormalized forward
// in: r0..r7 / i0..i7 ; uses s = 1/sqrt(2)
#define DFT8(r0,r1,r2,r3,r4,r5,r6,r7,i0,i1,i2,i3,i4,i5,i6,i7, SQ) do { \
    __m512d t0r,t0i,t1r,t1i,t2r,t2i,t3r,t3i,u0r,u0i,u1r,u1i,u2r,u2i,u3r,u3i; \
    t0r=_mm512_add_pd(r0,r4); t0i=_mm512_add_pd(i0,i4); \
    t1r=_mm512_sub_pd(r0,r4); t1i=_mm512_sub_pd(i0,i4); \
    t2r=_mm512_add_pd(r2,r6); t2i=_mm512_add_pd(i2,i6); \
    t3r=_mm512_sub_pd(r2,r6); t3i=_mm512_sub_pd(i2,i6); \
    u0r=_mm512_add_pd(r1,r5); u0i=_mm512_add_pd(i1,i5); \
    u1r=_mm512_sub_pd(r1,r5); u1i=_mm512_sub_pd(i1,i5); \
    u2r=_mm512_add_pd(r3,r7); u2i=_mm512_add_pd(i3,i7); \
    u3r=_mm512_sub_pd(r3,r7); u3i=_mm512_sub_pd(i3,i7); \
    __m512d a0r=_mm512_add_pd(t0r,t2r), a0i=_mm512_add_pd(t0i,t2i); \
    __m512d a2r=_mm512_sub_pd(t0r,t2r), a2i=_mm512_sub_pd(t0i,t2i); \
    __m512d a1r=_mm512_add_pd(u0r,u2r), a1i=_mm512_add_pd(u0i,u2i); \
    __m512d a3r=_mm512_sub_pd(u0r,u2r), a3i=_mm512_sub_pd(u0i,u2i); \
    r0=_mm512_add_pd(a0r,a1r); i0=_mm512_add_pd(a0i,a1i); \
    r4=_mm512_sub_pd(a0r,a1r); i4=_mm512_sub_pd(a0i,a1i); \
    r2=_mm512_add_pd(a2r,a3i); i2=_mm512_sub_pd(a2i,a3r); \
    r6=_mm512_sub_pd(a2r,a3i); i6=_mm512_add_pd(a2i,a3r); \
    __m512d b1r=_mm512_mul_pd(SQ,_mm512_add_pd(u1r,u1i)); \
    __m512d b1i=_mm512_mul_pd(SQ,_mm512_sub_pd(u1i,u1r)); \
    __m512d b3r=_mm512_mul_pd(SQ,_mm512_sub_pd(u3i,u3r)); \
    __m512d b3i=_mm512_mul_pd(SQ,_mm512_add_pd(u3r,u3i)); b3i=_mm512_sub_pd(_mm512_setzero_pd(),b3i); \
    __m512d c1r=_mm512_add_pd(t1r,t3i), c1i=_mm512_sub_pd(t1i,t3r); \
    __m512d c3r=_mm512_sub_pd(t1r,t3i), c3i=_mm512_add_pd(t1i,t3r); \
    r1=_mm512_add_pd(c1r,b1r); i1=_mm512_add_pd(c1i,b1i); \
    r5=_mm512_sub_pd(c1r,b1r); i5=_mm512_sub_pd(c1i,b1i); \
    r3=_mm512_add_pd(c3r,b3r); i3=_mm512_add_pd(c3i,b3i); \
    r7=_mm512_sub_pd(c3r,b3r); i7=_mm512_sub_pd(c3i,b3i); \
} while(0)

__attribute__((noinline)) void dft64_tile(double* X_, const double* W_) {
    const __m512d SQ = _mm512_set1_pd(0.70710678118654752440);
    // stage A: j0 fixed, DFT8 over j1: elements at X[(8*j1+j0)*16 + {0,8}]
    for (int j0 = 0; j0 < 8; j0++) {
        double* p = X_ + j0*16;
        __m512d r0=LD(p+0*128),r1=LD(p+1*128),r2=LD(p+2*128),r3=LD(p+3*128),r4=LD(p+4*128),r5=LD(p+5*128),r6=LD(p+6*128),r7=LD(p+7*128);
        __m512d i0=LD(p+0*128+8),i1=LD(p+1*128+8),i2=LD(p+2*128+8),i3=LD(p+3*128+8),i4=LD(p+4*128+8),i5=LD(p+5*128+8),i6=LD(p+6*128+8),i7=LD(p+7*128+8);
        DFT8(r0,r1,r2,r3,r4,r5,r6,r7,i0,i1,i2,i3,i4,i5,i6,i7,SQ);
        // twiddle: k1 = output index of stage A; multiply by w64^(k1*j0)
        const double* w = W_ + j0*128;   // per (j0,k1): re at w[k1*16], im at w[k1*16+8]
        #define TW(rr,ii,k1) do{ if(k1){ __m512d wr=LD(w+(k1)*16), wi=LD(w+(k1)*16+8); \
            __m512d nr=_mm512_fnmadd_pd(ii,wi,_mm512_mul_pd(rr,wr)); \
            ii=_mm512_fmadd_pd(rr,wi,_mm512_mul_pd(ii,wr)); rr=nr; } }while(0)
        TW(r1,i1,1); TW(r2,i2,2); TW(r3,i3,3); TW(r4,i4,4); TW(r5,i5,5); TW(r6,i6,6); TW(r7,i7,7);
        ST(p+0*128,r0); ST(p+1*128,r1); ST(p+2*128,r2); ST(p+3*128,r3); ST(p+4*128,r4); ST(p+5*128,r5); ST(p+6*128,r6); ST(p+7*128,r7);
        ST(p+0*128+8,i0); ST(p+1*128+8,i1); ST(p+2*128+8,i2); ST(p+3*128+8,i3); ST(p+4*128+8,i4); ST(p+5*128+8,i5); ST(p+6*128+8,i6); ST(p+7*128+8,i7);
    }
    // stage B: k1 fixed (block of 8 consecutive j0), DFT8 over j0: elements X[(8*k1+j0)*16]
    for (int k1 = 0; k1 < 8; k1++) {
        double* p = X_ + k1*128;
        __m512d r0=LD(p+0),r1=LD(p+16),r2=LD(p+32),r3=LD(p+48),r4=LD(p+64),r5=LD(p+80),r6=LD(p+96),r7=LD(p+112);
        __m512d i0=LD(p+8),i1=LD(p+24),i2=LD(p+40),i3=LD(p+56),i4=LD(p+72),i5=LD(p+88),i6=LD(p+104),i7=LD(p+120);
        DFT8(r0,r1,r2,r3,r4,r5,r6,r7,i0,i1,i2,i3,i4,i5,i6,i7,SQ);
        ST(p+0,r0); ST(p+16,r1); ST(p+32,r2); ST(p+48,r3); ST(p+64,r4); ST(p+80,r5); ST(p+96,r6); ST(p+112,r7);
        ST(p+8,i0); ST(p+24,i1); ST(p+40,i2); ST(p+56,i3); ST(p+72,i4); ST(p+88,i5); ST(p+104,i6); ST(p+120,i7);
    }
}
int main(void){
    cpu_set_t set; CPU_ZERO(&set); CPU_SET(0, &set); sched_setaffinity(0, sizeof(set), &set);
    for (int i = 0; i < 64*16; i++) { X[i] = 0.001*i; W[i] = 0.5 + 1e-6*i; }
    long it = 2000000;
    dft64_tile(X, W);
    double best=1e9;
    for (int r = 0; r < 7; r++) {
        double t0=now();
        for (long k = 0; k < it/8; k++) dft64_tile(X, W);
        double t=(now()-t0)/(it/8); if (t<best) best=t;
    }
    printf("dft64 tile (512 pts): %.2f ns = %.4f ns/pt per pass\n", best*1e9, best*1e9/512);
    return 0;
}
EOF
