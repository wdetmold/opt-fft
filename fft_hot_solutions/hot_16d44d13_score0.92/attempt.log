<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/bench && taskset -c 0 python3 - << 'EOF'
import sys
sys.path.insert(0, '/workdir')
import numpy as np
import solution
rng = np.random.default_rng(31337)
tol = {6:1e-4, 8:3e-6, 13:1e-9, 17:1e-10, 23:1e-10, 36:1e-10, 45:1e-10, 64:1e-10}
sizes = (6,8,13,17,23,36,45,64)
worst = {}
for trial in range(4):
    Bs = [int(rng.integers(1, 12)) for _ in sizes]
    ms = [int(rng.integers(20, 400)), int(rng.integers(20, 300)), int(rng.integers(20, 200)),
          int(rng.integers(10, 150)), int(rng.integers(10, 120)), int(rng.integers(5, 100)),
          int(rng.integers(5, 80)), int(rng.integers(5, 60))]
    seed = int(rng.integers(0, 10**6))
    args = (seed, *Bs, *ms)
    r_me = solution.transform(*args)
    outs = []
    for L, B, m in zip(sizes, Bs, ms):
        rx = np.random.default_rng(seed + L)
        x = rx.standard_normal((B, L, L, L)) + 1j*rx.standard_normal((B, L, L, L))
        rc = np.random.default_rng(1000 + L)
        c = 0.1*(rc.standard_normal((B, L, L, L)) + 1j*rc.standard_normal((B, L, L, L)))
        one = None
        for k in range(m):
            z = np.fft.fftn(x, axes=(1,2,3)) + c
            x = z/(1+np.abs(z))
            if k == 0: one = x.copy()
        outs += [one.ravel(), x.ravel()]
    r_ref = np.concatenate(outs)
    off = 0
    for L, B, m in zip(sizes, Bs, ms):
        n = B*L**3
        for which, gate in (('one', 1e-14), ('final', tol[L])):
            a = r_me[off:off+n]; b = r_ref[off:off+n]
            e = np.linalg.norm(a-b)/np.linalg.norm(b)
            frac = e/gate
            key = (L, which)
            worst[key] = max(worst.get(key, 0), frac)
            assert e < gate, (trial, L, B, m, which, e)
            off += n
    print(f'trial {trial}: Bs={Bs} ms={ms} PASS')
print('worst gate-fraction used:', {k: round(v, 4) for k, v in sorted(worst.items()) if v == max(worst.values())})
print('ALL DEEP FUZZ TRIALS PASS')
EOF</antml:parameter>
</antml:invoke>
</antml:function_calls>
