#include <stdio.h>
#include <time.h>
static double nwq(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec + 1e-9*ts.tv_nsec; }
void prof45(long m){
    double tS = 0, tP = 0; long nS = 0, nP = 0;
    for (long t = 2; t <= m; t++) {
        double t0 = nwq();
        if ((t & 1) == 0) { SB_45(XB_45, CZT_45, CZP_45, 2); tS += nwq()-t0; nS++; }
        else              { PB_45(XB_45, CPB_45, CPP_45, 2, 0); tP += nwq()-t0; nP++; }
    }
    printf("SB_45: %.1f us   PB_45: %.1f us  (per step avg %.3f ns/pt)\n", tS/nS*1e6, tP/nP*1e6, (tS+tP)/(nS+nP)/91125*1e9);
}
void prof36(long m){
    double tS = 0, tP = 0; long nS = 0, nP = 0;
    for (long t = 2; t <= m; t++) {
        double t0 = nwq();
        if ((t & 1) == 0) { SB_36(XB_36, CZT_36, CZP_36, 2); tS += nwq()-t0; nS++; }
        else              { PB_36(XB_36, CPB_36, CPP_36, 2, 0); tP += nwq()-t0; nP++; }
    }
    printf("SB_36: %.1f us   PB_36: %.1f us  (per step avg %.3f ns/pt)\n", tS/nS*1e6, tP/nP*1e6, (tS+tP)/(nS+nP)/46656*1e9);
}
EOF
