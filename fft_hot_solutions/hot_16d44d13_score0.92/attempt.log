import sys, os, ctypes, time
import numpy as np
sys.path.insert(0, '/workdir/dev')
import ref
os.sched_setaffinity(0, {0})

def make_runner(libpath, L):
    lib = ctypes.CDLL(libpath)
    f = getattr(lib, f'run_{L}')
    f.argtypes = [ctypes.c_void_p]*4 + [ctypes.c_long]*2
    def run(x0, c, one, fin, B, m):
        f(x0.ctypes.data, c.ctypes.data, one.ctypes.data, fin.ctypes.data, B, m)
    return run

def bench(libpath, L, B, m, reps=3):
    run = make_runner(libpath, L)
    x0, c = ref.make_inputs(L, B)
    n = B * L**3
    one = np.empty(n, np.complex128); fin = np.empty(n, np.complex128)
    run(x0, c, one, fin, B, min(m, 20))
    best = 1e9
    for r in range(reps):
        t0 = time.perf_counter(); run(x0, c, one, fin, B, m); t1 = time.perf_counter()
        best = min(best, t1-t0)
    print(f'{libpath} L={L} B={B} m={m}: {best:.4f}s = {best/(B*m*L**3)*1e9:.3f} ns/pt')
    return best

if __name__ == '__main__':
    lib = sys.argv[1]; L = int(sys.argv[2])
    mode = sys.argv[3] if len(sys.argv) > 3 else 'check'
    if mode == 'check':
        run = make_runner(lib, L)
        for B, m in ((1,1),(2,1),(3,2),(8,5),(9,3),(2,40)):
            ref.check(L, B, m, run)
    else:
        B = int(sys.argv[4]); m = int(sys.argv[5])
        bench(lib, L, B, m)
