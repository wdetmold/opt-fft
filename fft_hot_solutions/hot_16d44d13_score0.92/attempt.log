import sys, os; sys.path.insert(0, '/tmp/bench'); os.sched_setaffinity(0,{0})
import numpy as np, time
import mkl_sol
for L, B, m in ((6,24,4000),(8,16,3000),(13,8,1500),(17,3,1000),(23,2,600),(36,1,600),(45,1,300),(64,1,150)):
    rng = np.random.default_rng(1)
    x0 = rng.standard_normal((B, L, L, L)) + 1j*rng.standard_normal((B, L, L, L))
    c = 0.1*(rng.standard_normal((B, L, L, L)) + 1j*rng.standard_normal((B, L, L, L)))
    n = B*L**3
    one = np.empty(n, np.complex128); fin = np.empty(n, np.complex128)
    x = x0.copy()
    mkl_sol._lib.run_mkl(L, B, 10, x.ctypes.data, c.ctypes.data, one.ctypes.data, fin.ctypes.data)
    x = x0.copy(); t0=time.perf_counter()
    mkl_sol._lib.run_mkl(L, B, m, x.ctypes.data, c.ctypes.data, one.ctypes.data, fin.ctypes.data)
    t1=time.perf_counter()
    xb = x0.copy()
    for k in range(3):
        z = np.fft.fftn(xb, axes=(1,2,3)) + c; xb = z/(1.0+np.abs(z))
    mnp = max(3, m//8)
    t2=time.perf_counter()
    for k in range(mnp):
        z = np.fft.fftn(xb, axes=(1,2,3)) + c; xb = z/(1.0+np.abs(z))
    t3=time.perf_counter()
    per_mkl=(t1-t0)/(B*m); per_np=(t3-t2)/(B*mnp)
    print(f'L={L:2d} B={B:3d} mkl={per_mkl*1e6:9.2f}us/vstep np={per_np*1e6:9.2f} ratio={per_np/per_mkl:5.2f}')
