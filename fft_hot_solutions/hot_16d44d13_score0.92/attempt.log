TR8_MACRO = r'''
#define TR8(r0,r1,r2,r3,r4,r5,r6,r7,o0,o1,o2,o3,o4,o5,o6,o7) do{ \
    __m512d _t0=_mm512_unpacklo_pd(r0,r1), _t1=_mm512_unpackhi_pd(r0,r1); \
    __m512d _t2=_mm512_unpacklo_pd(r2,r3), _t3=_mm512_unpackhi_pd(r2,r3); \
    __m512d _t4=_mm512_unpacklo_pd(r4,r5), _t5=_mm512_unpackhi_pd(r4,r5); \
    __m512d _t6=_mm512_unpacklo_pd(r6,r7), _t7=_mm512_unpackhi_pd(r6,r7); \
    __m512d _u0=_mm512_shuffle_f64x2(_t0,_t2,0x44), _u1=_mm512_shuffle_f64x2(_t4,_t6,0x44); \
    __m512d _u2=_mm512_shuffle_f64x2(_t0,_t2,0xee), _u3=_mm512_shuffle_f64x2(_t4,_t6,0xee); \
    __m512d _u4=_mm512_shuffle_f64x2(_t1,_t3,0x44), _u5=_mm512_shuffle_f64x2(_t5,_t7,0x44); \
    __m512d _u6=_mm512_shuffle_f64x2(_t1,_t3,0xee), _u7=_mm512_shuffle_f64x2(_t5,_t7,0xee); \
    o0=_mm512_shuffle_f64x2(_u0,_u1,0x88); o2=_mm512_shuffle_f64x2(_u0,_u1,0xdd); \
    o4=_mm512_shuffle_f64x2(_u2,_u3,0x88); o6=_mm512_shuffle_f64x2(_u2,_u3,0xdd); \
    o1=_mm512_shuffle_f64x2(_u4,_u5,0x88); o3=_mm512_shuffle_f64x2(_u4,_u5,0xdd); \
    o5=_mm512_shuffle_f64x2(_u6,_u7,0x88); o7=_mm512_shuffle_f64x2(_u6,_u7,0xdd); \
}while(0)
#define LDB8(p, P, v0,v1,v2,v3,v4,v5,v6,v7) \
    V v0=VL(p), v1=VL((p)+(P)), v2=VL((p)+2*(P)), v3=VL((p)+3*(P)), v4=VL((p)+4*(P)), v5=VL((p)+5*(P)), v6=VL((p)+6*(P)), v7=VL((p)+7*(P));
#define STB8(p, P, v0,v1,v2,v3,v4,v5,v6,v7) \
    VS(p, v0); VS((p)+(P), v1); VS((p)+2*(P), v2); VS((p)+3*(P), v3); VS((p)+4*(P), v4); VS((p)+5*(P), v5); VS((p)+6*(P), v6); VS((p)+7*(P), v7);
'''

def emit_transpose(E, L):
    cfg = CFG[L]; pitch = cfg['pitch']
    nb = (pitch // 8) if L != 64 else 8   # block-grid size over the square region
    E(f'static void tp{L}(double* restrict p){{')
    E.ind += 1
    E(f'for (int bi = 0; bi < {nb}; bi++) {{')
    E.ind += 1
    E(f'{{ double* d = p + (long)bi*{8*pitch} + bi*8;')
    E(f'  LDB8(d, {pitch}, a0,a1,a2,a3,a4,a5,a6,a7)')
    E('  V o0,o1,o2,o3,o4,o5,o6,o7;')
    E('  TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);')
    E(f'  STB8(d, {pitch}, o0,o1,o2,o3,o4,o5,o6,o7) }}')
    E(f'for (int bj = bi + 1; bj < {nb}; bj++) {{')
    E.ind += 1
    E(f'double* d1 = p + (long)bi*{8*pitch} + bj*8;')
    E(f'double* d2 = p + (long)bj*{8*pitch} + bi*8;')
    E(f'LDB8(d1, {pitch}, a0,a1,a2,a3,a4,a5,a6,a7)')
    E(f'LDB8(d2, {pitch}, b0,b1,b2,b3,b4,b5,b6,b7)')
    E('V o0,o1,o2,o3,o4,o5,o6,o7;')
    E('TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);')
    E(f'STB8(d2, {pitch}, o0,o1,o2,o3,o4,o5,o6,o7)')
    E('TR8(b0,b1,b2,b3,b4,b5,b6,b7,o0,o1,o2,o3,o4,o5,o6,o7);')
    E(f'STB8(d1, {pitch}, o0,o1,o2,o3,o4,o5,o6,o7)')
    E.ind -= 1
    E('}')
    E.ind -= 1
    E('}')
    E.ind -= 1
    E('}')

def emit_engine(E, L, mapk='MAP_M3'):
    cfg = CFG[L]; pitch = cfg['pitch']; ps = PS(L); nqb = cfg['nqb']
    n3 = L**3
    E(f'#define MAPK {mapk}')
    emit_rowpass(E, L, 'plain')
    emit_rowpass(E, L, 'map')
    emit_xpass(E, L, 'plain')
    emit_xpass(E, L, 'mappre')
    emit_xpass(E, L, 'mapfin')
    E('#undef MAPK')
    emit_transpose(E, L)
    E(f'''
static double *SR_{L}, *SI_{L}, *CNR_{L}, *CNI_{L}, *CTR_{L}, *CTI_{L}, *KR_{L}, *KI_{L}, *DPR_{L}, *DPI_{L};
static void init_{L}(void){{
    if (SR_{L}) return;
    SR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    SI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CNR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CNI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CTR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CTI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    KR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    KI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    DPR_{L} = (double*)alloc_arena({ps}*8 + 4096);
    DPI_{L} = (double*)alloc_arena({ps}*8 + 4096);
    for (long i = 0; i < {L}*{ps}; i++) {{ SR_{L}[i] = 1.0; SI_{L}[i] = 1.0; }}
}}
/* sweep A: completes odd step; cap != 0 -> capture mapped state (transposed layout) */
static void sweepA_{L}(int pre, int cap){{
    for (int x = 0; x < {L}; x++) {{
        double* pr = SR_{L} + (long)x*{ps};
        double* pi = SI_{L} + (long)x*{ps};
        const double* cr = CTR_{L} + (long)x*{ps};
        const double* ci = CTI_{L} + (long)x*{ps};
        double* kr = cap ? KR_{L} + (long)x*{ps} : DPR_{L};
        double* ki = cap ? KI_{L} + (long)x*{ps} : DPI_{L};
        rp{L}_plain(pr, pi);
        tp{L}(pr); tp{L}(pi);
        rp{L}_map(pr, pi, cr, ci, kr, ki);
        if (pre) rp{L}_plain(pr, pi);
        tp{L}(pr); tp{L}(pi);
        if (pre) rp{L}_plain(pr, pi);
    }}
}}
static void sweepB_{L}(int pre){{
    for (int r = 0; r < {L}; r++) {{
        for (int qb = 0; qb < {nqb}; qb++) {{
            long off = (long)r*{pitch} + qb*8;
            if (pre) xp{L}_mappre(SR_{L} + off, SI_{L} + off, CNR_{L} + off, CNI_{L} + off);
            else     xp{L}_mapfin(SR_{L} + off, SI_{L} + off, CNR_{L} + off, CNI_{L} + off);
        }}
    }}
}}
static void convin_{L}(const double* v, double* dr, double* di, int transpose){{
    for (long x = 0; x < {L}; x++)
        for (long y = 0; y < {L}; y++)
            for (long z = 0; z < {L}; z++) {{
                long src = ((x*{L} + y)*{L} + z)*2;
                long dst = x*{ps} + (transpose ? z*{pitch} + y : y*{pitch} + z);
                dr[dst] = v[src]; di[dst] = v[src + 1];
            }}
}}
static void convout_{L}(const double* dr, const double* di, double* v, int transpose){{
    for (long x = 0; x < {L}; x++)
        for (long y = 0; y < {L}; y++)
            for (long z = 0; z < {L}; z++) {{
                long dst = ((x*{L} + y)*{L} + z)*2;
                long src = x*{ps} + (transpose ? z*{pitch} + y : y*{pitch} + z);
                v[dst] = dr[src]; v[dst + 1] = di[src];
            }}
}}
void run_{L}(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    init_{L}();
    if (m < 1) m = 1;
    for (long b = 0; b < B; b++) {{
        convin_{L}(x0 + b*{2*n3}, SR_{L}, SI_{L}, 0);
        convin_{L}(c + b*{2*n3}, CNR_{L}, CNI_{L}, 0);
        convin_{L}(c + b*{2*n3}, CTR_{L}, CTI_{L}, 1);
        for (int r = 0; r < {L}; r++)
            for (int qb = 0; qb < {nqb}; qb++)
                xp{L}_plain(SR_{L} + (long)r*{pitch} + qb*8, SI_{L} + (long)r*{pitch} + qb*8);
        sweepA_{L}(m > 1, 1);
        convout_{L}(KR_{L}, KI_{L}, out1 + b*{2*n3}, 1);
        for (long t = 2; t <= m; t++) {{
            if ((t & 1) == 0) sweepB_{L}(t < m);
            else              sweepA_{L}(t < m, 0);
        }}
        convout_{L}(SR_{L}, SI_{L}, outm + b*{2*n3}, 0);
    }}
}}
''')

def build(ls=(36, 45, 64), mapk='MAP_M3', out='vol_test.c'):
    from genlib import PRELUDE
    E = Emit()
    E(PRELUDE)
    E(TR8_MACRO)
    for L in ls:
        emit_engine(E, L, mapk)
    open(out, 'w').write(E.text())
    print('wrote', out, len(E.text()))
