            F8 "dec %0\n\tjnz 1b\n" : "+r"(iters) : "r"(buf)
            : "zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm14","zmm15","memory");
    }
