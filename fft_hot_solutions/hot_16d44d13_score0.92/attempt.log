import sys, os, time, importlib.util
import numpy as np

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

WORKLOADS = {
 'W1': (1234, 32,16,6,2,2,1,1,1, 10000,8000,4000,2500,1300,1000,600,350),
 'W2': (777,  12,8,4,3,2,2,1,1,  6000,5000,3000,1500,1000,700,500,300),
 'W3': (555,  64,32,12,4,3,2,2,1, 12000,9000,4500,2500,1500,1200,700,450),
}
def main():
    solpath = sys.argv[1]
    wname = sys.argv[2] if len(sys.argv) > 2 else 'W1'
    reps = int(sys.argv[3]) if len(sys.argv) > 3 else 3
    args = WORKLOADS[wname]
    mod = load(solpath, 'sol')
    walls = []
    out = None
    for r in range(reps):
        t0 = time.perf_counter()
        out = mod.transform(*args)
        t1 = time.perf_counter()
        walls.append(t1-t0)
    print(f'{os.path.basename(os.path.dirname(solpath))}/{os.path.basename(solpath)} {wname}: walls={[f"{w:.4f}" for w in walls]} best={min(walls):.4f}')
    print('checksum', complex(out.sum()), float(np.abs(out).sum()))
main()
