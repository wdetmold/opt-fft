Key insight: tiles alone run at model speed; the fused map causes spills, and multi-instantiation thrashes L1i. New architecture: plain-only tiles + separate compact software-pipelined map loop; per-sweep hot code fits the cache.

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /workdir/dev && cat > gen_vol3.py << 'EOF'
"""v3 within-volume engines (36/45/64): plain tiles (per stride combo) + separate map loop."""
import numpy as np
from genlib import Emit, hexd
from gen_vol import (CFG, PS, dft_factor_maps, emit_stage_dft, gather_consts_decl,
                     Ctx, TR8_MACRO, emit_tw)

def emit_tile(E, L, name, ss, ds):
    """tile DFT-L: src element j at (sr + j*ss, si + j*ss); dst at (dr + k*ds, di + k*ds).
    ss/ds are compile-time strides (doubles)."""
    cfg = CFG[L]
    n1, n2, mode = cfg['n1'], cfg['n2'], cfg['mode']
    inm, outm = dft_factor_maps(L, n1, n2, mode)
    E(f'static void __attribute__((noinline)) {name}(const double* restrict sr, const double* restrict si, double* restrict dr_, double* restrict di_){{')
    E.ind += 1
    E(f'double TMP[{L*16}] ALIGN64;')
    consts = {}
    sub = Emit(); sub.ind = E.ind
    ctx = Ctx(sub, 't')
    for g in range(n2):
        sub('{')
        xs = []
        for t1 in range(n1):
            j = inm[t1][g]
            c = ctx.new()
            ctx.dekl(c, f'VL(sr + {j*ss})', f'VL(si + {j*ss})')
            xs.append(c)
        o = [None]*n1
        emit_stage_dft(ctx, n1, xs, o, consts)
        if mode == 'ct':
            o = [emit_tw(ctx, o[k1], L, g*k1, consts) for k1 in range(n1)]
        for t1 in range(n1):
            sub(f'VS(TMP + {(t1*n2 + g)*16}, {o[t1].r}); VS(TMP + {(t1*n2 + g)*16 + 8}, {o[t1].i});')
        sub('}')
    for u1 in range(n1):
        sub('{')
        xs = []
        for t2 in range(n2):
            c = ctx.new()
            ctx.dekl(c, f'VL(TMP + {(u1*n2 + t2)*16})', f'VL(TMP + {(u1*n2 + t2)*16 + 8})')
            xs.append(c)
        o = [None]*n2
        emit_stage_dft(ctx, n2, xs, o, consts)
        for u2 in range(n2):
            k = outm[u1][u2]
            sub(f'VS(dr_ + {k*ds}, {o[u2].r}); VS(di_ + {k*ds}, {o[u2].i});')
        sub('}')
    E('{')
    for ln in gather_consts_decl(consts):
        E(ln)
    E(sub.text().rstrip('\n'))
    E('}')
    E.ind -= 1
    E('}')

MAPLOOP = r'''
/* software-pipelined map loop: n elements; src/dst/c/cap strided. */
static void __attribute__((noinline)) maploop(const double* sr, const double* si, long ss,
        double* dr_, double* di_, long ds,
        const double* cr, const double* ci, long cs, long n){
    const V half = VSET1(0.5), c15 = VSET1(1.5), one = VSET1(1.0);
    for (long j = 0; j < n; j++) {
        V zr = VADD(VL(sr), VL(cr)), zi = VADD(VL(si), VL(ci));
        V n2 = VFMA(zr, zr, VMUL(zi, zi));
        V s = VRSQRT(n2);
        V u1 = VMUL(n2, s); V v1 = VMUL(u1, s); V w1 = VFNMA(v1, half, c15); s = VMUL(s, w1);
        V u2 = VMUL(n2, s); V v2 = VMUL(u2, s); V w2 = VFNMA(v2, half, c15); s = VMUL(s, w2);
        V t = VFMA(n2, s, one);
        V d = VDIV(one, t);
        VS(dr_, VMUL(zr, d)); VS(di_, VMUL(zi, d));
        sr += ss; si += ss; cr += cs; ci += cs; dr_ += ds; di_ += ds;
    }
}
static void __attribute__((noinline)) maploopcap(const double* sr, const double* si, long ss,
        double* dr_, double* di_, long ds,
        const double* cr, const double* ci, long cs,
        double* kr, double* ki, long ks, long n){
    const V half = VSET1(0.5), c15 = VSET1(1.5), one = VSET1(1.0);
    for (long j = 0; j < n; j++) {
        V zr = VADD(VL(sr), VL(cr)), zi = VADD(VL(si), VL(ci));
        V n2 = VFMA(zr, zr, VMUL(zi, zi));
        V s = VRSQRT(n2);
        V u1 = VMUL(n2, s); V v1 = VMUL(u1, s); V w1 = VFNMA(v1, half, c15); s = VMUL(s, w1);
        V u2 = VMUL(n2, s); V v2 = VMUL(u2, s); V w2 = VFNMA(v2, half, c15); s = VMUL(s, w2);
        V t = VFMA(n2, s, one);
        V d = VDIV(one, t);
        V mr = VMUL(zr, d), mi = VMUL(zi, d);
        VS(dr_, mr); VS(di_, mi);
        VS(kr, mr); VS(ki, mi);
        sr += ss; si += ss; cr += cs; ci += cs; dr_ += ds; di_ += ds; kr += ks; ki += ks;
    }
}
'''

def emit_engine(E, L):
    cfg = CFG[L]; pitch = cfg['pitch']; ps = PS(L); nqb = cfg['nqb']
    n3 = L**3
    emit_tile(E, L, f'tP_{L}', pitch, pitch)      # rp
    emit_tile(E, L, f'tT_{L}', 16, 16)            # zm inner
    emit_tile(E, L, f'tXin_{L}', ps, 16)          # xp gather
    emit_tile(E, L, f'tXout_{L}', 16, ps)         # xp scatter
    E(f'''
static double *SR_{L}, *SI_{L}, *CNR_{L}, *CNI_{L}, *CTR_{L}, *CTI_{L}, *KR_{L}, *KI_{L};
static double ZTT_{L}[{pitch}*16] ALIGN64;
static double ZM2_{L}[{pitch}*16] ALIGN64;
static double ZM3_{L}[{pitch}*16] ALIGN64;
static double XT3_{L}[{L}*16] ALIGN64;
static double XT4_{L}[{L}*16] ALIGN64;
static void init_{L}(void){{
    if (SR_{L}) return;
    SR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    SI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CNR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CNI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CTR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CTI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    KR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    KI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    for (long i = 0; i < {L}*{ps}; i++) {{ SR_{L}[i] = 1.0; SI_{L}[i] = 1.0; }}
    for (long i = 0; i < {pitch}*16; i++) {{ ZTT_{L}[i] = 0.5; ZM2_{L}[i] = 0.5; ZM3_{L}[i] = 0.5; }}
    for (long i = 0; i < {L}*16; i++) {{ XT3_{L}[i] = 0.5; XT4_{L}[i] = 0.5; }}
}}
static void rp_{L}(double* pr, double* pi){{
    for (long qb = 0; qb < {nqb}; qb++)
        tP_{L}(pr + qb*8, pi + qb*8, pr + qb*8, pi + qb*8);
}}
static void tin_{L}(const double* pr, const double* pi, long bi){{
    for (long cb = 0; cb < {nqb}; cb++) {{
        {{ const double* b = pr + bi*{8*pitch} + cb*8;
          LDB8(b, {pitch}, a0,a1,a2,a3,a4,a5,a6,a7)
          V o0,o1,o2,o3,o4,o5,o6,o7;
          TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);
          STB8(ZTT_{L} + cb*128, 16, o0,o1,o2,o3,o4,o5,o6,o7) }}
        {{ const double* b = pi + bi*{8*pitch} + cb*8;
          LDB8(b, {pitch}, a0,a1,a2,a3,a4,a5,a6,a7)
          V o0,o1,o2,o3,o4,o5,o6,o7;
          TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);
          STB8(ZTT_{L} + cb*128 + 8, 16, o0,o1,o2,o3,o4,o5,o6,o7) }}
    }}
}}
static void tout_{L}(double* pr, double* pi, long bi, const double* srcT){{
    for (long cb = 0; cb < {nqb}; cb++) {{
        {{ LDB8(srcT + cb*128, 16, a0,a1,a2,a3,a4,a5,a6,a7)
          V o0,o1,o2,o3,o4,o5,o6,o7;
          TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);
          double* b = pr + bi*{8*pitch} + cb*8;
          STB8(b, {pitch}, o0,o1,o2,o3,o4,o5,o6,o7) }}
        {{ LDB8(srcT + cb*128 + 8, 16, a0,a1,a2,a3,a4,a5,a6,a7)
          V o0,o1,o2,o3,o4,o5,o6,o7;
          TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);
          double* b = pi + bi*{8*pitch} + cb*8;
          STB8(b, {pitch}, o0,o1,o2,o3,o4,o5,o6,o7) }}
    }}
}}
static void sweepA_{L}(int pre, int cap){{
    for (int x = 0; x < {L}; x++) {{
        double* pr = SR_{L} + (long)x*{ps};
        double* pi = SI_{L} + (long)x*{ps};
        const double* cr = CTR_{L} + (long)x*{ps};
        const double* ci = CTI_{L} + (long)x*{ps};
        rp_{L}(pr, pi);
        for (long bi = 0; bi < {nqb}; bi++) {{
            tin_{L}(pr, pi, bi);
            tT_{L}(ZTT_{L}, ZTT_{L}+8, ZM3_{L}, ZM3_{L}+8);
            if (cap) maploopcap(ZM3_{L}, ZM3_{L}+8, 16, ZM3_{L}, ZM3_{L}+8, 16,
                        cr + bi*8, ci + bi*8, {pitch},
                        KR_{L} + (long)x*{ps} + bi*8, KI_{L} + (long)x*{ps} + bi*8, {pitch}, {L});
            else maploop(ZM3_{L}, ZM3_{L}+8, 16, ZM3_{L}, ZM3_{L}+8, 16, cr + bi*8, ci + bi*8, {pitch}, {L});
            const double* srcT = ZM3_{L};
            if (pre) {{ tT_{L}(ZM3_{L}, ZM3_{L}+8, ZM2_{L}, ZM2_{L}+8); srcT = ZM2_{L}; }}
            tout_{L}(pr, pi, bi, srcT);
        }}
        if (pre) rp_{L}(pr, pi);
    }}
}}
static void sweepB_{L}(int pre){{
    for (int r = 0; r < {L}; r++) {{
        for (int qb = 0; qb < {nqb}; qb++) {{
            long off = (long)r*{pitch} + qb*8;
            tXin_{L}(SR_{L} + off, SI_{L} + off, XT3_{L}, XT3_{L}+8);
            maploop(XT3_{L}, XT3_{L}+8, 16, XT3_{L}, XT3_{L}+8, 16, CNR_{L} + off, CNI_{L} + off, {ps}, {L});
            if (pre) {{
                tXout_{L}(XT3_{L}, XT3_{L}+8, SR_{L} + off, SI_{L} + off);
            }} else {{
                for (long j = 0; j < {L}; j++) {{
                    VS(SR_{L} + off + j*{ps}, VL(XT3_{L} + j*16));
                    VS(SI_{L} + off + j*{ps}, VL(XT3_{L} + j*16 + 8));
                }}
            }}
        }}
    }}
}}
static void convin_{L}(const double* v, double* dr, double* di, int transpose){{
    for (long x = 0; x < {L}; x++)
        for (long y = 0; y < {L}; y++)
            for (long z = 0; z < {L}; z++) {{
                long src = ((x*{L} + y)*{L} + z)*2;
                long dst = x*{ps} + (transpose ? z*{pitch} + y : y*{pitch} + z);
                dr[dst] = v[src]; di[dst] = v[src + 1];
            }}
}}
static void convout_{L}(const double* dr, const double* di, double* v, int transpose){{
    for (long x = 0; x < {L}; x++)
        for (long y = 0; y < {L}; y++)
            for (long z = 0; z < {L}; z++) {{
                long dst = ((x*{L} + y)*{L} + z)*2;
                long src = x*{ps} + (transpose ? z*{pitch} + y : y*{pitch} + z);
                v[dst] = dr[src]; v[dst + 1] = di[src];
            }}
}}
void run_{L}(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    init_{L}();
    if (m < 1) m = 1;
    for (long b = 0; b < B; b++) {{
        convin_{L}(x0 + b*{2*n3}, SR_{L}, SI_{L}, 0);
        convin_{L}(c + b*{2*n3}, CNR_{L}, CNI_{L}, 0);
        convin_{L}(c + b*{2*n3}, CTR_{L}, CTI_{L}, 1);
        for (int r = 0; r < {L}; r++)
            for (int qb = 0; qb < {nqb}; qb++) {{
                long off = (long)r*{pitch} + qb*8;
                tXin_{L}(SR_{L} + off, SI_{L} + off, XT4_{L}, XT4_{L}+8);
                for (long j = 0; j < {L}; j++) {{
                    VS(SR_{L} + off + j*{ps}, VL(XT4_{L} + j*16));
                    VS(SI_{L} + off + j*{ps}, VL(XT4_{L} + j*16 + 8));
                }}
            }}
        sweepA_{L}(m > 1, 1);
        convout_{L}(KR_{L}, KI_{L}, out1 + b*{2*n3}, 1);
        for (long t = 2; t <= m; t++) {{
            if ((t & 1) == 0) sweepB_{L}(t < m);
            else              sweepA_{L}(t < m, 0);
        }}
        convout_{L}(SR_{L}, SI_{L}, outm + b*{2*n3}, 0);
    }}
}}
''')

def build(ls=(36, 45, 64), out='vol3_test.c'):
    from genlib import PRELUDE
    E = Emit()
    E(PRELUDE)
    E(TR8_MACRO)
    E(MAPLOOP)
    for L in ls:
        emit_engine(E, L)
    open(out, 'w').write(E.text())
    print('wrote', out, len(E.text()))

if __name__ == '__main__':
    build()
