<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/micro && cat > bw.c << 'EOF'
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <sched.h>
#include <immintrin.h>
static double now(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec + 1e-9*ts.tv_nsec; }
int main(void){
    cpu_set_t set; CPU_ZERO(&set); CPU_SET(0, &set); sched_setaffinity(0, sizeof(set), &set);
    for (long sz = 1<<17; sz <= (1<<25); sz <<= 2) {   // 128KB .. 32MB
        double* a = aligned_alloc(64, sz);
        double* b = aligned_alloc(64, sz);
        memset(a, 1, sz); memset(b, 2, sz);
        long n = sz/8;
        // read BW
        double best_r = 1e9, best_c = 1e9, best_rw = 1e9;
        for (int rep = 0; rep < 7; rep++) {
            double t0 = now();
            __m512d s0 = _mm512_setzero_pd(), s1 = s0, s2 = s0, s3 = s0;
            for (long i = 0; i < n; i += 32) {
                s0=_mm512_add_pd(s0, _mm512_load_pd(a+i)); s1=_mm512_add_pd(s1, _mm512_load_pd(a+i+8));
                s2=_mm512_add_pd(s2, _mm512_load_pd(a+i+16)); s3=_mm512_add_pd(s3, _mm512_load_pd(a+i+24));
            }
            volatile double sink = s0[0]+s1[1]+s2[2]+s3[3]; (void)sink;
            double t = now()-t0; if (t < best_r) best_r = t;
            // copy a->b
            t0 = now();
            for (long i = 0; i < n; i += 32) {
                _mm512_store_pd(b+i, _mm512_load_pd(a+i)); _mm512_store_pd(b+i+8, _mm512_load_pd(a+i+8));
                _mm512_store_pd(b+i+16, _mm512_load_pd(a+i+16)); _mm512_store_pd(b+i+24, _mm512_load_pd(a+i+24));
            }
            t = now()-t0; if (t < best_c) best_c = t;
            // read-modify-write in place
            t0 = now();
            __m512d k = _mm512_set1_pd(1.000001);
            for (long i = 0; i < n; i += 32) {
                _mm512_store_pd(a+i, _mm512_mul_pd(k,_mm512_load_pd(a+i))); _mm512_store_pd(a+i+8, _mm512_mul_pd(k,_mm512_load_pd(a+i+8)));
                _mm512_store_pd(a+i+16, _mm512_mul_pd(k,_mm512_load_pd(a+i+16))); _mm512_store_pd(a+i+24, _mm512_mul_pd(k,_mm512_load_pd(a+i+24)));
            }
            t = now()-t0; if (t < best_rw) best_rw = t;
        }
        printf("%6ld KB: read %6.1f GB/s  copy %6.1f GB/s (r+w)  rmw %6.1f GB/s (r+w)\n",
            sz>>10, sz/best_r/1e9, 2.0*sz/best_c/1e9, 2.0*sz/best_rw/1e9);
        free(a); free(b);
    }
    return 0;
}
EOF
