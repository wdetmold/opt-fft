New insight: sweepA's first sub-pass walks 8448B strides (prefetch-hostile, latency-exposed). Reorder so the sequential-stride Z-pass pulls the slab first, and fuse the map into the Y-pass:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /workdir/dev && python3 - << 'EOF'
src = open('/workdir/implementation.c').read()
old = '''/* sweep A: per a-slab: Y(t); Z(t)+c+map; [Z(t+1); Y(t+1)] */
static void sweepA64(vd *restrict X, const vd *restrict C, int pre) {
    for (int a = 0; a < 8; a++) {
        vd *slab = X + 2*(ptrdiff_t)a*SA64;
        const vd *cslab = C + 2*(ptrdiff_t)a*SA64;
        for (int z = 0; z < 64; z++) k64_p(slab + 2*z, slab + 2*z + 1, 2*RY64);
        for (int y = 0; y < 64; y++) {
            vd *p = slab + 2*(ptrdiff_t)y*RY64;
            const vd *cp = cslab + 2*(ptrdiff_t)y*RY64;
            k64_m(p, p + 1, 2, cp, cp + 1);
        }
        if (pre) {
            for (int y = 0; y < 64; y++) k64_p(slab + 2*(ptrdiff_t)y*RY64, slab + 2*(ptrdiff_t)y*RY64 + 1, 2);
            for (int z = 0; z < 64; z++) k64_p(slab + 2*z, slab + 2*z + 1, 2*RY64);
        }
    }
}'''
new = '''/* sweep A: per a-slab: Z(t) [stride-128, prefetch-friendly first touch];
   Y(t)+c+map; [Y(t+1); Z(t+1)] */
static void sweepA64(vd *restrict X, const vd *restrict C, int pre) {
    for (int a = 0; a < 8; a++) {
        vd *slab = X + 2*(ptrdiff_t)a*SA64;
        const vd *cslab = C + 2*(ptrdiff_t)a*SA64;
        for (int y = 0; y < 64; y++) k64_p(slab + 2*(ptrdiff_t)y*RY64, slab + 2*(ptrdiff_t)y*RY64 + 1, 2);
        for (int z = 0; z < 64; z++) {
            vd *p = slab + 2*z;
            const vd *cp = cslab + 2*z;
            k64_m(p, p + 1, 2*RY64, cp, cp + 1);
        }
        if (pre) {
            for (int z = 0; z < 64; z++) k64_p(slab + 2*z, slab + 2*z + 1, 2*RY64);
            for (int y = 0; y < 64; y++) k64_p(slab + 2*(ptrdiff_t)y*RY64, slab + 2*(ptrdiff_t)y*RY64 + 1, 2);
        }
    }
}'''
assert old in src
src = src.replace(old, new)
# NOTE: in new order, the first sub-pass is along z? wait: k64_p(slab+2y*RY, stride 2) IS the Z-pass
# (pencil along z for fixed y, elements stride 2 slots = contiguous). The stride-128 pass is Z. Good:
# we start with Z (contiguous), then Y+map (strided), then pre: Z then Y.
# Hmm: 'for y... stride 2' = Z-pass (contiguous) -- correct first. Then 'for z... stride 2*RY64' = Y-pass + map.
open('/workdir/implementation.c','w').write(src)
print('patched')
EOF
