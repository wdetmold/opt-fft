Correct but slower — the giant straight-line codelets blow L1i (32KB). Refactor: one shared pair of stride-parameterized tile-DFT functions per size, used by ALL passes (rp/xp/zm) — small resident code.

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /workdir/dev && cat > gen_vol2.py << 'EOF'
"""v2 within-volume engines: shared stride-parametrized tile-DFT codelets per L.
tile_plain_L(src, ss, dst, ds): two-stage DFT-L; element j at src + j*ss (doubles), re/im at +0/+8.
tile_map_L(..., cr, ci, cs): fused +c and map on outputs.
tile_mapcap_L: also stores mapped to cap (kr, ki, stride cs).
All other machinery (T-in/out, sweeps, drivers) built on these.
"""
import numpy as np
from genlib import Emit, hexd
from gen_vol import (CFG, PS, dft_factor_maps, emit_stage_dft, gather_consts_decl,
                     Ctx, Cplx, TR8_MACRO)

def emit_tile(E, L, variant):
    cfg = CFG[L]
    n1, n2, mode = cfg['n1'], cfg['n2'], cfg['mode']
    inm, outm = dft_factor_maps(L, n1, n2, mode)
    name = f'tile_{variant}_{L}'
    args = 'const double* restrict src, long ss, double* restrict dst, long ds'
    if variant != 'plain':
        args += ', const double* restrict cr, const double* restrict ci, long cs'
    if variant == 'mapcap':
        args += ', double* restrict kr, double* restrict ki'
    E(f'static void __attribute__((noinline)) {name}({args}){{')
    E.ind += 1
    E(f'double TMP[{L*16}] ALIGN64;')
    consts = {}
    sub = Emit(); sub.ind = E.ind
    ctx = Ctx(sub, 't')
    for g in range(n2):
        sub('{')
        xs = []
        for t1 in range(n1):
            j = inm[t1][g]
            c = ctx.new()
            ctx.dekl(c, f'VL(src + {j}*ss)', f'VL(src + {j}*ss + 8)')
            xs.append(c)
        o = [None]*n1
        emit_stage_dft(ctx, n1, xs, o, consts)
        if mode == 'ct':
            from gen_vol import emit_tw
            o = [emit_tw(ctx, o[k1], L, g*k1, consts) for k1 in range(n1)]
        for t1 in range(n1):
            sub(f'VS(TMP + {(t1*n2 + g)*16}, {o[t1].r}); VS(TMP + {(t1*n2 + g)*16 + 8}, {o[t1].i});')
        sub('}')
    for u1 in range(n1):
        sub('{')
        xs = []
        for t2 in range(n2):
            c = ctx.new()
            ctx.dekl(c, f'VL(TMP + {(u1*n2 + t2)*16})', f'VL(TMP + {(u1*n2 + t2)*16 + 8})')
            xs.append(c)
        o = [None]*n2
        emit_stage_dft(ctx, n2, xs, o, consts)
        for u2 in range(n2):
            k = outm[u1][u2]
            if variant == 'plain':
                sub(f'VS(dst + {k}*ds, {o[u2].r}); VS(dst + {k}*ds + 8, {o[u2].i});')
            else:
                sub(f'{{ V zr = VADD({o[u2].r}, VL(cr + {k}*cs)), zi = VADD({o[u2].i}, VL(ci + {k}*cs));')
                sub('  V mr, mi; MAPK(zr, zi, mr, mi);')
                sub(f'  VS(dst + {k}*ds, mr); VS(dst + {k}*ds + 8, mi);')
                if variant == 'mapcap':
                    sub(f'  VS(kr + {k}*cs, mr); VS(ki + {k}*cs, mi);')
                sub('}')
        sub('}')
    E('{')
    for ln in gather_consts_decl(consts):
        E(ln)
    E(sub.text().rstrip('\n'))
    E('}')
    E.ind -= 1
    E('}')

def emit_engine(E, L, mapk='MAP_M3'):
    cfg = CFG[L]; pitch = cfg['pitch']; ps = PS(L); nqb = cfg['nqb']
    n3 = L**3
    E(f'#define MAPK {mapk}')
    for v in ('plain', 'map', 'mapcap'):
        emit_tile(E, L, v)
    E('#undef MAPK')
    E(f'''
static double *SR_{L}, *SI_{L}, *CNR_{L}, *CNI_{L}, *CTR_{L}, *CTI_{L}, *KR_{L}, *KI_{L};
static double ZTT_{L}[{pitch}*16] ALIGN64;
static double ZM2_{L}[{pitch}*16] ALIGN64;
static double ZM3_{L}[{pitch}*16] ALIGN64;
static double XT3_{L}[{L}*16] ALIGN64;
static void init_{L}(void){{
    if (SR_{L}) return;
    SR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    SI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CNR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CNI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CTR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    CTI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    KR_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    KI_{L} = (double*)alloc_arena({L}*{ps}*8 + 4096);
    for (long i = 0; i < {L}*{ps}; i++) {{ SR_{L}[i] = 1.0; SI_{L}[i] = 1.0; }}
    for (long i = 0; i < {pitch}*16; i++) {{ ZTT_{L}[i] = 0.5; ZM2_{L}[i] = 0.5; ZM3_{L}[i] = 0.5; }}
}}
/* rp: row DFTs (along r) for a full plane, in place */
static void rp_{L}(double* pr, double* pi){{
    for (long qb = 0; qb < {nqb}; qb++)
        tile_plain_{L}(pr + qb*8, {pitch}, pr + qb*8, {pitch});
}}
static void sweepA_{L}(int pre, int cap){{
    for (int x = 0; x < {L}; x++) {{
        double* pr = SR_{L} + (long)x*{ps};
        double* pi = SI_{L} + (long)x*{ps};
        const double* cr = CTR_{L} + (long)x*{ps};
        const double* ci = CTI_{L} + (long)x*{ps};
        rp_{L}(pr, pi);
        for (long bi = 0; bi < {nqb}; bi++) {{
            /* T-in: y-slab bi -> ZTT (z-major, lanes=y) */
            for (long cb = 0; cb < {nqb}; cb++) {{
                {{ double* b = pr + bi*{8*pitch} + cb*8;
                  LDB8(b, {pitch}, a0,a1,a2,a3,a4,a5,a6,a7)
                  V o0,o1,o2,o3,o4,o5,o6,o7;
                  TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);
                  STB8(ZTT_{L} + cb*128, 16, o0,o1,o2,o3,o4,o5,o6,o7) }}
                {{ double* b = pi + bi*{8*pitch} + cb*8;
                  LDB8(b, {pitch}, a0,a1,a2,a3,a4,a5,a6,a7)
                  V o0,o1,o2,o3,o4,o5,o6,o7;
                  TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);
                  STB8(ZTT_{L} + cb*128 + 8, 16, o0,o1,o2,o3,o4,o5,o6,o7) }}
            }}
            if (cap) tile_mapcap_{L}(ZTT_{L}, 16, ZM3_{L}, 16, cr + bi*8, ci + bi*8, {pitch}, KR_{L} + (long)x*{ps} + bi*8, KI_{L} + (long)x*{ps} + bi*8);
            else     tile_map_{L}(ZTT_{L}, 16, ZM3_{L}, 16, cr + bi*8, ci + bi*8, {pitch});
            double* srcT = ZM3_{L};
            if (pre) {{ tile_plain_{L}(ZM3_{L}, 16, ZM2_{L}, 16); srcT = ZM2_{L}; }}
            /* T-out */
            for (long cb = 0; cb < {nqb}; cb++) {{
                {{ LDB8(srcT + cb*128, 16, a0,a1,a2,a3,a4,a5,a6,a7)
                  V o0,o1,o2,o3,o4,o5,o6,o7;
                  TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);
                  double* b = pr + bi*{8*pitch} + cb*8;
                  STB8(b, {pitch}, o0,o1,o2,o3,o4,o5,o6,o7) }}
                {{ LDB8(srcT + cb*128 + 8, 16, a0,a1,a2,a3,a4,a5,a6,a7)
                  V o0,o1,o2,o3,o4,o5,o6,o7;
                  TR8(a0,a1,a2,a3,a4,a5,a6,a7,o0,o1,o2,o3,o4,o5,o6,o7);
                  double* b = pi + bi*{8*pitch} + cb*8;
                  STB8(b, {pitch}, o0,o1,o2,o3,o4,o5,o6,o7) }}
            }}
        }}
        if (pre) rp_{L}(pr, pi);
    }}
}}
static void sweepB_{L}(int pre){{
    for (int r = 0; r < {L}; r++) {{
        for (int qb = 0; qb < {nqb}; qb++) {{
            long off = (long)r*{pitch} + qb*8;
            if (pre) {{
                tile_map_{L}(SR_{L} + off, {ps}, XT3_{L}, 16, CNR_{L} + off, CNI_{L} + off, {ps});
                tile_plain_{L}(XT3_{L}, 16, SR_{L} + off, {ps});
            }} else {{
                tile_map_{L}(SR_{L} + off, {ps}, SR_{L} + off, {ps}, CNR_{L} + off, CNI_{L} + off, {ps});
            }}
        }}
    }}
}}
static void convin_{L}(const double* v, double* dr, double* di, int transpose){{
    for (long x = 0; x < {L}; x++)
        for (long y = 0; y < {L}; y++)
            for (long z = 0; z < {L}; z++) {{
                long src = ((x*{L} + y)*{L} + z)*2;
                long dst = x*{ps} + (transpose ? z*{pitch} + y : y*{pitch} + z);
                dr[dst] = v[src]; di[dst] = v[src + 1];
            }}
}}
static void convout_{L}(const double* dr, const double* di, double* v, int transpose){{
    for (long x = 0; x < {L}; x++)
        for (long y = 0; y < {L}; y++)
            for (long z = 0; z < {L}; z++) {{
                long dst = ((x*{L} + y)*{L} + z)*2;
                long src = x*{ps} + (transpose ? z*{pitch} + y : y*{pitch} + z);
                v[dst] = dr[src]; v[dst + 1] = di[src];
            }}
}}
void run_{L}(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    init_{L}();
    if (m < 1) m = 1;
    for (long b = 0; b < B; b++) {{
        convin_{L}(x0 + b*{2*n3}, SR_{L}, SI_{L}, 0);
        convin_{L}(c + b*{2*n3}, CNR_{L}, CNI_{L}, 0);
        convin_{L}(c + b*{2*n3}, CTR_{L}, CTI_{L}, 1);
        for (int r = 0; r < {L}; r++)
            for (int qb = 0; qb < {nqb}; qb++) {{
                long off = (long)r*{pitch} + qb*8;
                tile_plain_{L}(SR_{L} + off, {ps}, SR_{L} + off, {ps});
            }}
        sweepA_{L}(m > 1, 1);
        convout_{L}(KR_{L}, KI_{L}, out1 + b*{2*n3}, 1);
        for (long t = 2; t <= m; t++) {{
            if ((t & 1) == 0) sweepB_{L}(t < m);
            else              sweepA_{L}(t < m, 0);
        }}
        convout_{L}(SR_{L}, SI_{L}, outm + b*{2*n3}, 0);
    }}
}}
''')

def build(ls=(36, 45, 64), mapk='MAP_M3', out='vol2_test.c'):
    from genlib import PRELUDE
    E = Emit()
    E(PRELUDE)
    E(TR8_MACRO)
    for L in ls:
        emit_engine(E, L, mapk)
    open(out, 'w').write(E.text())
    print('wrote', out, len(E.text()))

if __name__ == '__main__':
    build()
