Maps verified. Now the full emission code for the volume engines.

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /workdir/dev && cat >> gen_vol.py << 'PYEOF'

# ---------------------------------------------------------------------------
CFG = {
    36: dict(n1=4, n2=9, mode='pfa', pitch=40, nqb=5),
    45: dict(n1=5, n2=9, mode='pfa', pitch=48, nqb=6),
    64: dict(n1=8, n2=8, mode='ct',  pitch=72, nqb=8),
}
def PS(L):
    c = CFG[L]
    return c['pitch'] * (c['pitch'] if L != 64 else 64) + 8

def emit_stage_dft(ctx, n, xs, out, consts):
    if n == 4: emit_dft4(ctx, xs, out)
    elif n == 5: emit_dft5(ctx, xs, out, consts)
    elif n == 8: emit_dft8(ctx, xs, out, consts)
    elif n == 9: emit_dft9(ctx, xs, out, consts)
    else: raise ValueError(n)

def gather_consts_decl(consts):
    lines = []
    for (kind, n, t), name in sorted(consts.items(), key=lambda kv: kv[1]):
        val = wre(n, t) if kind == 'c' else wim(n, t)
        lines.append(f'const V {name} = VSET1({hexd(val)});')
    return lines

def emit_body_twostage(E, L, addr_in, addr_out, addr_c, variant, tag):
    """Emits straight-line two-stage DFT-L.
    addr_in(j) -> (expr_re, expr_im) C pointer exprs for element j input
    addr_out(k) -> pointer exprs for output element k
    addr_c(k) -> c pointer exprs (for map variants)
    variant: 'plain' | 'map' (map + capture via CAPR/CAPI exprs given by addr_cap) """
    cfg = CFG[L]
    n1, n2, mode = cfg['n1'], cfg['n2'], cfg['mode']
    inm, outm = dft_factor_maps(L, n1, n2, mode)
    consts = {}
    sub = Emit(); sub.ind = E.ind
    ctx = Ctx(sub, tag)
    # stage A
    for g in range(n2):
        sub('{')
        xs = []
        for t1 in range(n1):
            j = inm[t1][g]
            c = ctx.new()
            pr, pi = addr_in(j)
            ctx.dekl(c, f'VL({pr})', f'VL({pi})')
            xs.append(c)
        o = [None]*n1
        emit_stage_dft(ctx, n1, xs, o, consts)
        if mode == 'ct':
            o = [emit_tw(ctx, o[k1], L, g*k1, consts) for k1 in range(n1)]
        for t1 in range(n1):
            sub(f'VS(TMP + {(t1*n2 + g)*16}, {o[t1].r}); VS(TMP + {(t1*n2 + g)*16 + 8}, {o[t1].i});')
        sub('}')
    # stage B
    for u1 in range(n1):
        sub('{')
        xs = []
        for t2 in range(n2):
            c = ctx.new()
            ctx.dekl(c, f'VL(TMP + {(u1*n2 + t2)*16})', f'VL(TMP + {(u1*n2 + t2)*16 + 8})')
            xs.append(c)
        o = [None]*n2
        emit_stage_dft(ctx, n2, xs, o, consts)
        for u2 in range(n2):
            k = outm[u1][u2]
            pr, po = addr_out(k)
            if variant == 'plain':
                sub(f'VS({pr}, {o[u2].r}); VS({po}, {o[u2].i});')
            else:
                cr, ci = addr_c(k)
                sub(f'{{ V zr = VADD({o[u2].r}, VL({cr})), zi = VADD({o[u2].i}, VL({ci}));')
                sub('  V mr, mi; MAPK(zr, zi, mr, mi);')
                sub(f'  VS({pr}, mr); VS({po}, mi); }}')
        sub('}')
    for ln in gather_consts_decl(consts):
        E(ln)
    E(sub.text().rstrip('\n'))

def emit_rowpass(E, L, variant):
    """rp{L}_{variant}(pr, pi[, cr, ci, capr, capi]) : in-place row DFTs for all qb.
    map variant stores mapped to plane AND to cap plane."""
    cfg = CFG[L]; pitch = cfg['pitch']; nqb = cfg['nqb']
    name = f'rp{L}_{variant}'
    if variant == 'plain':
        E(f'static void {name}(double* restrict pr, double* restrict pi){{')
    else:
        E(f'static void {name}(double* restrict pr, double* restrict pi, const double* restrict cr, const double* restrict ci, double* restrict capr, double* restrict capi){{')
    E.ind += 1
    E(f'double TMP[{L*16}] ALIGN64;')
    E(f'for (long qb = 0; qb < {nqb}; qb++) {{')
    E.ind += 1
    E('double* br = pr + qb*8; double* bi = pi + qb*8;')
    if variant != 'plain':
        E('const double* bcr = cr + qb*8; const double* bci = ci + qb*8;')
        E('double* bkr = capr + qb*8; double* bki = capi + qb*8;')
    addr_in = lambda j: (f'br + {j*pitch}', f'bi + {j*pitch}')
    if variant == 'plain':
        emit_body_twostage(E, L, addr_in, addr_in, None, 'plain', 'a')
    else:
        # map variant: write to plane and capture
        cfg2 = CFG[L]
        n1, n2, mode = cfg2['n1'], cfg2['n2'], cfg2['mode']
        inm, outm = dft_factor_maps(L, n1, n2, mode)
        consts = {}
        sub = Emit(); sub.ind = E.ind
        ctx = Ctx(sub, 'a')
        for g in range(n2):
            sub('{')
            xs = []
            for t1 in range(n1):
                j = inm[t1][g]
                c = ctx.new()
                ctx.dekl(c, f'VL(br + {j*pitch})', f'VL(bi + {j*pitch})')
                xs.append(c)
            o = [None]*n1
            emit_stage_dft(ctx, n1, xs, o, consts)
            if mode == 'ct':
                o = [emit_tw(ctx, o[k1], L, g*k1, consts) for k1 in range(n1)]
            for t1 in range(n1):
                sub(f'VS(TMP + {(t1*n2 + g)*16}, {o[t1].r}); VS(TMP + {(t1*n2 + g)*16 + 8}, {o[t1].i});')
            sub('}')
        for u1 in range(n1):
            sub('{')
            xs = []
            for t2 in range(n2):
                c = ctx.new()
                ctx.dekl(c, f'VL(TMP + {(u1*n2 + t2)*16})', f'VL(TMP + {(u1*n2 + t2)*16 + 8})')
                xs.append(c)
            o = [None]*n2
            emit_stage_dft(ctx, n2, xs, o, consts)
            for u2 in range(n2):
                k = outm[u1][u2]
                sub(f'{{ V zr = VADD({o[u2].r}, VL(bcr + {k*pitch})), zi = VADD({o[u2].i}, VL(bci + {k*pitch}));')
                sub('  V mr, mi; MAPK(zr, zi, mr, mi);')
                sub(f'  VS(br + {k*pitch}, mr); VS(bi + {k*pitch}, mi);')
                sub(f'  VS(bkr + {k*pitch}, mr); VS(bki + {k*pitch}, mi); }}')
            sub('}')
        for ln in gather_consts_decl(consts):
            E(ln)
        E(sub.text().rstrip('\n'))
    E.ind -= 1
    E('}')
    E.ind -= 1
    E('}')

def emit_xpass(E, L, variant):
    """xp{L}_{variant}(base_r, base_i, off[, cr, ci]) : one pencil-group along x at plane-offset off.
    variants: plain | mappre | mapfin"""
    cfg = CFG[L]; ps = PS(L)
    name = f'xp{L}_{variant}'
    if variant == 'plain':
        E(f'static void {name}(double* restrict xr, double* restrict xi){{')
    else:
        E(f'static void {name}(double* restrict xr, double* restrict xi, const double* restrict cr, const double* restrict ci){{')
    E.ind += 1
    E(f'double TMP[{L*16}] ALIGN64;')
    addr_in = lambda j: (f'xr + {j*ps}', f'xi + {j*ps}')
    addr_c = (lambda k: (f'cr + {k*ps}', f'ci + {k*ps}')) if variant != 'plain' else None
    if variant == 'plain':
        emit_body_twostage(E, L, addr_in, addr_in, None, 'plain', 'b')
    elif variant == 'mapfin':
        emit_body_twostage(E, L, addr_in, addr_in, addr_c, 'map', 'b')
    else:  # mappre: map into TMP2 (natural slot k), then second DFT from TMP2 to planes
        E(f'double TMP2[{L*16}] ALIGN64;')
        addr_out_t2 = lambda k: (f'TMP2 + {k*16}', f'TMP2 + {k*16 + 8}')
        emit_body_twostage(E, L, addr_in, addr_out_t2, addr_c, 'map', 'b')
        addr_in2 = lambda j: (f'TMP2 + {j*16}', f'TMP2 + {j*16 + 8}')
        emit_body_twostage(E, L, addr_in2, addr_in, None, 'plain', 'c')
    E.ind -= 1
    E('}')
