void prof64(long reps){
    init_64();
    double t0, t1;
    t0 = nww(); for (long r = 0; r < reps; r++) for (int x = 0; x < 64; x++) rp64_plain(SR_64 + (long)x*4616, SI_64 + (long)x*4616); t1 = nww();
