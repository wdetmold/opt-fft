import sys; sys.path.insert(0, '/tmp/bench'); sys.path.insert(0, '/workdir')
import numpy as np, time, ctypes, os
import mkl_sol
_SIZES = (6, 8, 13, 17, 23, 36, 45, 64)
# per-size: time per (volume*step) for MKL and numpy base
for L in _SIZES:
    B = max(2, int(2e5 / L**3))
    m = max(3, int(3e6/ (B*L**3)))
    rng = np.random.default_rng(1)
    x0 = rng.standard_normal((B, L, L, L)) + 1j*rng.standard_normal((B, L, L, L))
    c = 0.1*(rng.standard_normal((B, L, L, L)) + 1j*rng.standard_normal((B, L, L, L)))
    n = B*L**3
    one = np.empty(n, np.complex128); fin = np.empty(n, np.complex128)
    x = x0.copy()
    t0=time.perf_counter()
    mkl_sol._lib.run_mkl(L, B, m, x.ctypes.data, c.ctypes.data, one.ctypes.data, fin.ctypes.data)
    t1=time.perf_counter()
    # numpy base
    xb = x0.copy()
    t2=time.perf_counter()
    for k in range(m):
        z = np.fft.fftn(xb, axes=(1,2,3)) + c
        xb = z/(1.0+np.abs(z))
    t3=time.perf_counter()
    per_mkl = (t1-t0)/(B*m)
    per_np  = (t3-t2)/(B*m)
    print(f'L={L:2d} B={B:5d} m={m:3d}  mkl/vol-step={per_mkl*1e6:9.2f}us  np={per_np*1e6:9.2f}us  ratio={per_np/per_mkl:5.2f}  mkl ns/point={per_mkl/L**3*1e9:7.2f}')
"</antml:parameter>
</antml:invoke>
