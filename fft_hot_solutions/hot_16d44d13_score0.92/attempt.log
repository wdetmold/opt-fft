"""Within-volume engines for L=36,45,64.
Plane (r,q) padded to pitch; lanes = 8 consecutive q. State natural (r=y,q=z), per-x planes.
sweep A per x: rp(y) T rp(z) map [rp(z) T rp(y)] ; sweep B per (r,qb): xp map [xp].
rp/xp are two-stage factorized DFTs through an L1 tile; PFA for 36/45, CT for 64.
"""
import numpy as np
from genlib import Emit, hexd

LD = np.longdouble
PI = LD('3.14159265358979323846264338327950288419716939937510582097494459')

def wre(n, t):  # cos(-2pi t/n)
    return np.cos(2*PI*LD(t % n)/LD(n))
def wim(n, t):  # sin(-2pi t/n)
    return -np.sin(2*PI*LD(t % n)/LD(n))

class Cplx:
    """symbolic complex register pair (names)."""
    __slots__ = ('r', 'i')
    def __init__(self, r, i): self.r, self.i = r, i

class Ctx:
    def __init__(self, E, tag):
        self.E = E; self.n = 0; self.tag = tag
    def new(self):
        self.n += 1
        return Cplx(f'{self.tag}r{self.n}', f'{self.tag}i{self.n}')
    def dekl(self, c, rexpr, iexpr):
        self.E(f'V {c.r} = {rexpr}, {c.i} = {iexpr};')

def emit_dft2(ctx, x, out):
    E = ctx.E
    a, b = x; A, B = ctx.new(), ctx.new()
    ctx.dekl(A, f'VADD({a.r}, {b.r})', f'VADD({a.i}, {b.i})')
    ctx.dekl(B, f'VSUB({a.r}, {b.r})', f'VSUB({a.i}, {b.i})')
    out[0], out[1] = A, B

def emit_dft3(ctx, x, out, w=None):
    """w: optional extra twiddle exponents... (not used)"""
    E = ctx.E
    x0, x1, x2 = x
    t, d, m, X0 = ctx.new(), ctx.new(), ctx.new(), ctx.new()
    ctx.dekl(t, f'VADD({x1.r}, {x2.r})', f'VADD({x1.i}, {x2.i})')
    ctx.dekl(d, f'VSUB({x1.r}, {x2.r})', f'VSUB({x1.i}, {x2.i})')
    ctx.dekl(X0, f'VADD({x0.r}, {t.r})', f'VADD({x0.i}, {t.i})')
    ctx.dekl(m, f'VFNMA({t.r}, VHALF, {x0.r})', f'VFNMA({t.i}, VHALF, {x0.i})')
    u = ctx.new()
    ctx.dekl(u, f'VMUL({d.i}, VS32)', f'VMUL({d.r}, VS32)')   # s*(di), s*(dr); s = sin(2pi/3)
    X1, X2 = ctx.new(), ctx.new()
    # X1 = m + (s*di, -s*dr) ; X2 = m - (s*di, -s*dr)   [forward, w = e^{-2pi i/3}]
    ctx.dekl(X1, f'VADD({m.r}, {u.r})', f'VSUB({m.i}, {u.i})')
    ctx.dekl(X2, f'VSUB({m.r}, {u.r})', f'VADD({m.i}, {u.i})')
    out[0], out[1], out[2] = X0, X1, X2

def emit_dft4(ctx, x, out):
    x0, x1, x2, x3 = x
    t0, t1, t2, t3 = ctx.new(), ctx.new(), ctx.new(), ctx.new()
    ctx.dekl(t0, f'VADD({x0.r}, {x2.r})', f'VADD({x0.i}, {x2.i})')
    ctx.dekl(t1, f'VSUB({x0.r}, {x2.r})', f'VSUB({x0.i}, {x2.i})')
    ctx.dekl(t2, f'VADD({x1.r}, {x3.r})', f'VADD({x1.i}, {x3.i})')
    ctx.dekl(t3, f'VSUB({x1.r}, {x3.r})', f'VSUB({x1.i}, {x3.i})')
    X0, X1, X2, X3 = ctx.new(), ctx.new(), ctx.new(), ctx.new()
    ctx.dekl(X0, f'VADD({t0.r}, {t2.r})', f'VADD({t0.i}, {t2.i})')
    ctx.dekl(X2, f'VSUB({t0.r}, {t2.r})', f'VSUB({t0.i}, {t2.i})')
    ctx.dekl(X1, f'VADD({t1.r}, {t3.i})', f'VSUB({t1.i}, {t3.r})')   # t1 + (-i) t3
    ctx.dekl(X3, f'VSUB({t1.r}, {t3.i})', f'VADD({t1.i}, {t3.r})')
    out[0], out[1], out[2], out[3] = X0, X1, X2, X3

def emit_tw(ctx, x, n, t, consts):
    """multiply x by w_n^t (forward, negative exponent); consts: dict name->expr pool collector"""
    t = t % n
    if t == 0: return x
    if 4*t % n == 0:
        # powers of -i
        q = (4*t)//n  # 1: -i, 2: -1, 3: i
        y = ctx.new()
        if q == 1: ctx.dekl(y, x.i, f'VSUB(VZERO(), {x.r})')
        elif q == 2: ctx.dekl(y, f'VSUB(VZERO(), {x.r})', f'VSUB(VZERO(), {x.i})')
        else: ctx.dekl(y, f'VSUB(VZERO(), {x.i})', x.r)
        return y
    cr = consts.setdefault(('c', n, t), f'TWC_{n}_{t}')
    ci = consts.setdefault(('s', n, t), f'TWS_{n}_{t}')
    y = ctx.new()
    # y = x * (cr + i ci):  yr = xr*cr - xi*ci; yi = xr*ci + xi*cr
    ctx.dekl(y, f'VFNMA({x.i}, {ci}, VMUL({x.r}, {cr}))',
                f'VFMA({x.r}, {ci}, VMUL({x.i}, {cr}))')
    return y

def emit_dft9(ctx, x, out, consts):
    """CT 3x3: j = 3*j1 + j0; X[k1 + 3*k2] = DFT3_{j0}( w9^{j0 k1} DFT3_{j1}(x[3 j1 + j0]) )"""
    y = {}
    for j0 in range(3):
        sub = [x[3*j1 + j0] for j1 in range(3)]
        o = [None]*3
        emit_dft3(ctx, sub, o)
        for k1 in range(3):
            y[(j0, k1)] = emit_tw(ctx, o[k1], 9, j0*k1, consts)
    for k1 in range(3):
        sub = [y[(j0, k1)] for j0 in range(3)]
        o = [None]*3
        emit_dft3(ctx, sub, o)
        for k2 in range(3):
            out[k1 + 3*k2] = o[k2]

def emit_dft5(ctx, x, out, consts):
    """folded direct DFT5."""
    c1 = consts.setdefault(('c', 5, 1), 'TWC_5_1'); s1 = consts.setdefault(('s', 5, 1), 'TWS_5_1')
    c2 = consts.setdefault(('c', 5, 2), 'TWC_5_2'); s2 = consts.setdefault(('s', 5, 2), 'TWS_5_2')
    x0, x1, x2, x3, x4 = x
    sa, da, sb, db = ctx.new(), ctx.new(), ctx.new(), ctx.new()
    ctx.dekl(sa, f'VADD({x1.r}, {x4.r})', f'VADD({x1.i}, {x4.i})')
    ctx.dekl(da, f'VSUB({x1.r}, {x4.r})', f'VSUB({x1.i}, {x4.i})')
    ctx.dekl(sb, f'VADD({x2.r}, {x3.r})', f'VADD({x2.i}, {x3.i})')
    ctx.dekl(db, f'VSUB({x2.r}, {x3.r})', f'VSUB({x2.i}, {x3.i})')
    X0 = ctx.new()
    ctx.dekl(X0, f'VADD({x0.r}, VADD({sa.r}, {sb.r}))', f'VADD({x0.i}, VADD({sa.i}, {sb.i}))')
    # CR_k = x0 + c_k*sa + c_2k*sb ; SR_k = s_k*da + s_2k*db  (note WC_5_t = cos(2pi t/5), WS = -sin)
    A1, A2 = ctx.new(), ctx.new()
    ctx.dekl(A1, f'VFMA({sb.r}, {c2}, VFMA({sa.r}, {c1}, {x0.r}))', f'VFMA({sb.i}, {c2}, VFMA({sa.i}, {c1}, {x0.i}))')
    ctx.dekl(A2, f'VFMA({sb.r}, {c1}, VFMA({sa.r}, {c2}, {x0.r}))', f'VFMA({sb.i}, {c1}, VFMA({sa.i}, {c2}, {x0.i}))')
    B1, B2 = ctx.new(), ctx.new()
    # W_5^{jk} im part = WS (= -sin(2pi jk/5)); X_k += i-part: for re: -(WS_k*da_i + WS_2k*db_i) ... derive:
    # X_k = sum x_j (c - i s), s = sin(2pi jk/5): Xk.re = x0r + sum c*srj + s*dij ; Xk.im = x0i + c*sij - s*drj
    # with WS = -s: Xk.re = CR + (-WS1*dai - WS2*dbi)... use S_k = s1*da + s2*db computed with POSITIVE sin = -WS
    # B1 = s_1*da + s_2*db, B2 = s_2*da - s_1*db   (k=2: s(2*1)=s2? careful: k=2: j=1: sin(4pi/5)=s2; j=2: sin(8pi/5) = -s1)
    ctx.dekl(B1, f'VFMA({db.r}, {s2}, VMUL({da.r}, {s1}))', f'VFMA({db.i}, {s2}, VMUL({da.i}, {s1}))')
    ctx.dekl(B2, f'VFNMA({db.r}, {s1}, VMUL({da.r}, {s2}))', f'VFNMA({db.i}, {s1}, VMUL({da.i}, {s2}))')
    X1, X2, X3, X4 = ctx.new(), ctx.new(), ctx.new(), ctx.new()
    ctx.dekl(X1, f'VADD({A1.r}, {B1.i})', f'VSUB({A1.i}, {B1.r})')
    ctx.dekl(X4, f'VSUB({A1.r}, {B1.i})', f'VADD({A1.i}, {B1.r})')
    ctx.dekl(X2, f'VADD({A2.r}, {B2.i})', f'VSUB({A2.i}, {B2.r})')
    ctx.dekl(X3, f'VSUB({A2.r}, {B2.i})', f'VADD({A2.i}, {B2.r})')
    out[0], out[1], out[2], out[3], out[4] = X0, X1, X2, X3, X4

def emit_dft8(ctx, x, out, consts):
    """CT 8 = 2x4-ish split-radix-lite: use radix-2 DIT structure (52 slots)."""
    # stage: pairs (j, j+4) DFT2
    t = [None]*8
    for j in range(4):
        a, b = ctx.new(), ctx.new()
        ctx.dekl(a, f'VADD({x[j].r}, {x[j+4].r})', f'VADD({x[j].i}, {x[j+4].i})')
        ctx.dekl(b, f'VSUB({x[j].r}, {x[j+4].r})', f'VSUB({x[j].i}, {x[j+4].i})')
        t[j], t[j+4] = a, b
    # even part: DFT4 of t[0..3] -> X0 X2 X4 X6
    o4 = [None]*4
    emit_dft4(ctx, t[:4], o4)
    # odd part: u_j = t[4+j] * w8^j, then DFT4 -> X1 X3 X5 X7
    u = [emit_tw(ctx, t[4+j], 8, j, consts) for j in range(4)]
    o4b = [None]*4
    emit_dft4(ctx, u, o4b)
    for k in range(4):
        out[2*k] = o4[k]
        out[2*k+1] = o4b[k]

def dft_factor_maps(n, n1, n2, mode):
    """Returns (in_map, out_map) index maps for two-stage DFT.
    mode 'pfa': stage A = n2 DFTn1's, stage B = n1 DFTn2's.
      in_map[t1][t2] = input index j; out_map[u1][u2] = output index k.
    mode 'ct': j = n2*j1 + j0 (stage A over j1 f=n1), twiddle w_n^{j0 k1}, stage B over j0 (g=n2),
      k = k1 + n1*k2."""
    if mode == 'pfa':
        assert np.gcd(n1, n2) == 1
        inm = [[(t1*n2 + t2*n1) % n for t2 in range(n2)] for t1 in range(n1)]
        i1 = pow(n2, -1, n1); i2 = pow(n1, -1, n2)
        outm = [[(u1*n2*i1 + u2*n1*i2) % n for u2 in range(n2)] for u1 in range(n1)]
        return inm, outm
    else:
        inm = [[n2*j1 + j0 for j0 in range(n2)] for j1 in range(n1)]
        outm = [[(k1 + n1*k2) for k2 in range(n2)] for k1 in range(n1)]
        return inm, outm

def verify_maps():
    # numeric verification of both factorizations as used in emission
    def dftm(n):
        j = np.arange(n); return np.exp(-2j*np.pi*np.outer(j,j)/n)
    for (n, n1, n2, mode) in ((36,4,9,'pfa'), (45,5,9,'pfa'), (64,8,8,'ct')):
        x = np.random.default_rng(0).standard_normal(n) + 1j*np.random.default_rng(1).standard_normal(n)
        X = dftm(n) @ x
        inm, outm = dft_factor_maps(n, n1, n2, mode)
        if mode == 'pfa':
            y = np.zeros((n1, n2), complex)
            for t2 in range(n2):
                col = np.array([x[inm[t1][t2]] for t1 in range(n1)])
                y[:, t2] = dftm(n1) @ col
            out = np.zeros(n, complex)
            for u1 in range(n1):
                row = dftm(n2) @ y[u1]
                for u2 in range(n2):
                    out[outm[u1][u2]] = row[u2]
        else:
            y = np.zeros((n1, n2), complex)   # y[k1][j0]
            for j0 in range(n2):
                col = np.array([x[n2*j1 + j0] for j1 in range(n1)])
                f = dftm(n1) @ col
                for k1 in range(n1):
                    y[k1, j0] = f[k1] * np.exp(-2j*np.pi*j0*k1/n)
            out = np.zeros(n, complex)
            for k1 in range(n1):
                row = dftm(n2) @ y[k1]
                for k2 in range(n2):
                    out[k1 + n1*k2] = row[k2]
        err = np.linalg.norm(out - X)/np.linalg.norm(X)
        print(n, mode, f'{err:.2e}', 'OK' if err < 1e-12 else 'BAD')

if __name__ == '__main__':
    verify_maps()
EOF
