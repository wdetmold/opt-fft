import numpy as np
L = 13; h = 6
rng = np.random.default_rng(0)
x = rng.standard_normal(L) + 1j*rng.standard_normal(L)
ref = np.fft.fft(x)
# my scheme
PI = np.pi
X = np.zeros(L, complex)
x0 = x[0]
dc = x0
A = {}; Bb = {}
for k in range(1, h+1):
    A[k] = x0; Bb[k] = 0
for j in range(1, h+1):
    u = x[j] + x[L-j]
    v = x[j] - x[L-j]
    dc += u
    for k in range(1, h+1):
        C = np.cos(2*PI*((j*k)%L)/L); S = np.sin(2*PI*((j*k)%L)/L)
        # A_k accumulates C*u (complex both parts); B_k: brr = S*v_im ; bri = S*v_re
        A[k] = A[k] + C*u
        Bb[k] = Bb[k] + S*v     # keep complex; brr = S*v.imag? see combine
X[0] = dc
for k in range(1, h+1):
    ar, ai = A[k].real, A[k].imag
    brr, bri = Bb[k].imag, Bb[k].real   # brr = sum S*v_im ; bri = sum S*v_re
    X[k] = (ar + brr) + 1j*(ai - bri)
    X[L-k] = (ar - brr) + 1j*(ai + bri)
print('sim err:', np.abs(X-ref).max())
