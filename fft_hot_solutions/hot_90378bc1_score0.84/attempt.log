base = importlib.util.module_from_spec(spec2); spec2.loader.exec_module(base)
MIXES = {
 'small-heavy': [42, 128,96,48,32,16,4,2,1, 2000,1000,400,250,150,40,25,15],
 'big-heavy':   [43, 16,12,8,6,4,16,12,8,   100,80,50,40,30,30,20,15],
