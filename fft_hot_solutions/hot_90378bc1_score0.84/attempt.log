    one = np.zeros(B*N**3, complex); fin = np.zeros(B*N**3, complex)
    getattr(lib, f'run_{N}')(x0.ctypes.data, c.ctypes.data, one.ctypes.data, fin.ctypes.data, B, m)
    r1, rm = ref_steps(x0, c, m)
