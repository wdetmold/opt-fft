c = 0.1*(rng.standard_normal((B,36,36,36)) + 1j*rng.standard_normal((B,36,36,36)))
one = np.zeros(B*36**3, complex); fin = np.zeros(B*36**3, complex)
f(x0.ctypes.data, c.ctypes.data, one.ctypes.data, fin.ctypes.data, B, m)
x = x0.copy()
for k in range(m):
    z = np.fft.fftn(x, axes=(1,2,3)) + c
    x = z/(1+np.abs(z))
print('fin err', np.linalg.norm(fin-x.ravel())/np.linalg.norm(x))
EOF
