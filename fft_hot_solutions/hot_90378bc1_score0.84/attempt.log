import sys, time, importlib.util, os
import numpy as np
sys.dont_write_bytecode = True

SIZES=(6,8,13,17,23,36,45,64)
GATES={6:1e-4, 8:3e-6, 13:1e-9, 17:1e-10, 23:1e-10, 36:1e-10, 45:1e-10, 64:1e-10}

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

def run(mod, args, reps=1):
    ts=[]
    out=None
    for _ in range(reps):
        t0=time.perf_counter(); out = mod.transform(*args); t1=time.perf_counter()
        ts.append(t1-t0)
    return out, ts

def check(out, ref, Bs):
    off=0; ok=True
    for L in SIZES:
        n=Bs[L]*L**3
        for tag,gate in (('one',1e-14),('fin',GATES[L])):
            x=ref[off:off+n]; y=out[off:off+n]
            e=np.linalg.norm(x-y)/max(np.linalg.norm(x),1e-300)
            flag = 'OK ' if e<gate else 'FAIL'
            if e>=gate: ok=False
            print(f'  L={L:2d} {tag}: rel={e:.2e} gate={gate:.0e} {flag}')
            off+=n
    return ok

if __name__=='__main__':
    solpath = sys.argv[1]
    W = sys.argv[2] if len(sys.argv)>2 else 'W1'
    reps = int(sys.argv[3]) if len(sys.argv)>3 else 3
    if W=='W1':
        A=dict(seed=1234,B6=64,B8=48,B13=24,B17=16,B23=12,B36=8,B45=6,B64=4,
               m6=600,m8=400,m13=200,m17=150,m23=100,m36=60,m45=40,m64=30)
    elif W=='Wsmall':
        A=dict(seed=77,B6=3,B8=2,B13=1,B17=2,B23=1,B36=1,B45=1,B64=1,
               m6=5,m8=4,m13=3,m17=2,m23=2,m36=2,m45=2,m64=1)
    elif W=='Wodd':
        A=dict(seed=9,B6=7,B8=9,B13=11,B17=9,B23=9,B36=9,B45=9,B64=3,
               m6=50,m8=40,m13=30,m17=20,m23=15,m36=10,m45=8,m64=6)
    args=[A['seed']]+[A[f'B{L}'] for L in SIZES]+[A[f'm{L}'] for L in SIZES]
    Bs={L:A[f'B{L}'] for L in SIZES}
    reffile=f'/tmp/h/ref_{W}.npy'
    if not os.path.exists(reffile):
        base=load('/workdir/base.py','base')
        ref,_=run(base,args)
        np.save(reffile,ref)
    ref=np.load(reffile)
    sol=load(solpath,'sol')
    out,ts=run(sol,args,reps)
    print('times:', ' '.join(f'{t:.3f}' for t in ts))
    ok = check(out,ref,Bs)
    print('PASS' if ok else 'FAIL')
