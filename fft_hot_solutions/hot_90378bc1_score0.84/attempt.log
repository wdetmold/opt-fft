                vr, vi = nvr, nvi
            pb(f'_mm512_store_pd(SCR64_re+({k}*8+base)*8, {vr});')
            pb(f'_mm512_store_pd(SCR64_im+({k}*8+base)*8, {vi});')
        pb('}')
        pb('}')
        rpass(64, 1, True)"""
assert old3 in src
src = src.replace(old3, new3)
