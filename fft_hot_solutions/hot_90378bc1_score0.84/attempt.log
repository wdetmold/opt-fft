    ore = np.zeros((N,8)); oim = np.zeros((N,8))
    f(re.ctypes.data, im.ctypes.data, ore.ctypes.data, oim.ctypes.data)
    ref = np.fft.fft(x, axis=0)
    err = np.abs(ore+1j*oim - ref).max()/np.abs(ref).max()
    print(f'N={N}: rel err {err:.2e}')
