base = importlib.util.module_from_spec(spec2); spec2.loader.exec_module(base)
SIZES=(6,8,13,17,23,36,45,64)
GATES={6:1e-4, 8:3e-6, 13:1e-9, 17:1e-10, 23:1e-10, 36:1e-10, 45:1e-10, 64:1e-10}
# long chains, odd Bs
A=dict(seed=31337,B6=17,B8=11,B13=9,B17=7,B23=17,B36=3,B45=2,B64=1,
       m6=3000,m8=1200,m13=500,m17=350,m23=250,m36=150,m45=100,m64=60)
args=[A['seed']]+[A[f'B{L}'] for L in SIZES]+[A[f'm{L}'] for L in SIZES]
