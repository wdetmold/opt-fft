# add BCASTV to genlib and use it in gen_p
src = open('genlib.py').read()
if 'BCASTV_DEF' not in src:
    src += '''

BCASTV_DEF = """
static inline __m512d bcastv(const double* p){
  __m512d v;
  __asm__ volatile("vbroadcastsd %1, %0" : "=v"(v) : "m"(*p));
  return v;
}
"""
'''
open('genlib.py','w').write(src)
src = open('gen_p.py').read()
src = src.replace("cv = T(pe, f'_mm512_set1_pd(w[{pos}])')","cv = T(pe, f'bcastv(w+{pos})')")
src = src.replace("sv = T(pe, f'_mm512_set1_pd(w[{pos}+1])')","sv = T(pe, f'bcastv(w+{pos}+1)')")
src = src.replace("src = PRELUDE + '#include <math.h>\\n#include <x86intrin.h>\\n'",
                  "from genlib import BCASTV_DEF\n    src = PRELUDE + '#include <math.h>\\n#include <x86intrin.h>\\n' + BCASTV_DEF")
open('gen_p.py','w').write(src)
print('ok')
EOF
