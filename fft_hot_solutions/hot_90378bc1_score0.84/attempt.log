# Strong-ish MKL DFTI reference with the same interface shape, for ratio estimation only (dev env).
import ctypes, numpy as np, os, time, sys
os.sched_setaffinity(0,{0})
lib = ctypes.CDLL('/work/mkl_runtime/lib/libmkl_rt.so.3', mode=ctypes.RTLD_GLOBAL)
lib.MKL_Set_Threading_Layer(ctypes.c_int(1))
LONG=ctypes.c_long
DFTI_DOUBLE=36; DFTI_COMPLEX=32; DFTI_NUMBER_OF_TRANSFORMS=7; DFTI_INPUT_DISTANCE=14
SIZES=(6,8,13,17,23,36,45,64)
WL = {
 'W1': dict(seed=1234,B6=64,B8=48,B13=24,B17=16,B23=12,B36=8,B45=6,B64=4,
            m6=600,m8=400,m13=200,m17=150,m23=100,m36=60,m45=40,m64=30),
 'W2': dict(seed=777,B6=96,B8=64,B13=32,B17=24,B23=16,B36=12,B45=8,B64=6,
            m6=400,m8=300,m13=160,m17=120,m23=80,m36=50,m45=35,m64=25),
}[sys.argv[1]]
def transform(seed, *a):
    Bs=dict(zip(SIZES,a[:8])); ms=dict(zip(SIZES,a[8:]))
    outs=[]
    for L in SIZES:
        B,m = Bs[L], ms[L]
        h=ctypes.c_void_p(); dims=(LONG*3)(L,L,L)
        lib.DftiCreateDescriptor(ctypes.byref(h), ctypes.c_int(DFTI_DOUBLE), ctypes.c_int(DFTI_COMPLEX), LONG(3), dims)
        lib.DftiSetValue(h, ctypes.c_int(DFTI_NUMBER_OF_TRANSFORMS), LONG(B))
        lib.DftiSetValue(h, ctypes.c_int(DFTI_INPUT_DISTANCE), LONG(L**3))
        lib.DftiCommitDescriptor(h)
        rng_x = np.random.default_rng(seed + L)
        x = rng_x.standard_normal((B,L,L,L)) + 1j*rng_x.standard_normal((B,L,L,L))
        rng_c = np.random.default_rng(1000 + L)
        c = 0.1*(rng_c.standard_normal((B,L,L,L)) + 1j*rng_c.standard_normal((B,L,L,L)))
        one=None
        for k in range(m):
            lib.DftiComputeForward(h, ctypes.c_void_p(x.ctypes.data))
            x += c
            np.abs(x, out=(ab:=np.empty_like(x, dtype=np.float64)) if False else None)
            ab = np.abs(x)
            ab += 1.0
            x /= ab
            if k==0: one = x.copy()
        outs += [one.ravel(), x.ravel()]
        lib.DftiFreeDescriptor(ctypes.byref(h))
    return np.concatenate(outs)
args=[WL['seed']]+[WL[f'B{L}'] for L in SIZES]+[WL[f'm{L}'] for L in SIZES]
ts=[]
for i in range(3):
    t0=time.perf_counter(); out=transform(*args); t1=time.perf_counter()
    ts.append(t1-t0)
print(f'MKL-ref {sys.argv[1]}: walls={" ".join(f"{t:.3f}" for t in ts)} best={min(ts):.3f}')
EOF
taskset -c 0 python3 mklref2.py W1; taskset -c 0 python3 mklref2.py W2</antml:parameter>
</antml:invoke>
