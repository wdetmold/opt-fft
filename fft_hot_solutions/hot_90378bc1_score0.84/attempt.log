<antml:parameter name="command">cd /tmp/g && python3 - <<'EOF'
src = open('gen_64c.py').read()  # start from prefetch-only variant (no NT stores)

# Refactor: parameterized sweep emitter. Replace the phaseB section wholesale.
start = src.index("# ---------------- phase B ----------------")
end = src.index("# ---------------- driver ----------------")
newB = '''# ---------------- phase B (plain + fused) ----------------
def emit_sweep(fused):
    CB = Consts()
    pb = Emitter()
    nm = 'fused' if fused else 'plain'
    pb(f"""
static void phaseB_{nm}_64(const double* re, const double* im, double* ore, double* oim,
                      const double* cre, const double* cim){{
%CONSTS%
  for(int rc=0;rc<64;rc++){{
    const double* pr = re + (size_t)rc*8*{LP};
    const double* pi = im + (size_t)rc*8*{LP};
    int l2 = rc & 7, l1 = rc >> 3;
    (void)l2; (void)l1;
    // transpose-in fused with l3-axis DFT8
    for(int ub=0;ub<64;ub++){{
      _mm_prefetch((const char*)(pr+(ub&7)*{LP}+ub*8+512), _MM_HINT_T0);
      _mm_prefetch((const char*)(pi+(ub&7)*{LP}+ub*8+512), _MM_HINT_T0);""")
    xv = []
    for arr in ('re','im'):
        sp = 'pr' if arr=='re' else 'pi'
        tin = [T(pb, f'_mm512_loadu_pd({sp}+{r}*{LP}+ub*8)') for r in range(8)]
        outv = [f'q{arr}{j}' for j in range(8)]
        for o in outv: pb(f'__m512d {o};')
        emit_transpose8(pb, tin, outv)
    for j in range(8):
        xv.append((f'qre{j}', f'qim{j}'))
    X = dft8(pb, CB, xv)
    for k in range(8):
        pb(f'_mm512_store_pd(SCR64_re+(ub*8+{k})*8, {X[k][0]});')
        pb(f'_mm512_store_pd(SCR64_im+(ub*8+{k})*8, {X[k][1]});')
    pb('}')
    # l2 pass: stride 8
    pb(f'for(int l1x=0;l1x<8;l1x++)for(int l3x=0;l3x<8;l3x++){{ int base=l1x*64+l3x;')
    x2=[]
    for j in range(8):
        r = T(pb, f'_mm512_load_pd(SCR64_re+({j}*8+base)*8)')
        i = T(pb, f'_mm512_load_pd(SCR64_im+({j}*8+base)*8)')
        x2.append((r,i))
    X2 = dft8(pb, CB, x2)
    for k in range(8):
        pb(f'_mm512_store_pd(SCR64_re+({k}*8+base)*8, {X2[k][0]});')
        pb(f'_mm512_store_pd(SCR64_im+({k}*8+base)*8, {X2[k][1]});')
    pb('}')
    # l1 pass (stride 64) + c + map -> scratch (fused) or direct store (plain)
    pb(f'for(int o=0;o<64;o++){{ int base=o; ')
    x3=[]
    for j in range(8):
        r = T(pb, f'_mm512_load_pd(SCR64_re+({j}*64+base)*8)')
        i = T(pb, f'_mm512_load_pd(SCR64_im+({j}*64+base)*8)')
        x3.append((r,i))
    X3 = dft8(pb, CB, x3)
    subs=[]
    for k in range(8):
        bu = Emitter()
        zr = T(bu, f'_mm512_add_pd({X3[k][0]}, _mm512_load_pd(cre + (size_t)({k}*64+base)*{LP} + rc*8))')
        zi = T(bu, f'_mm512_add_pd({X3[k][1]}, _mm512_load_pd(cim + (size_t)({k}*64+base)*{LP} + rc*8))')
        bu(f'__m512d fr{k}, fi{k};')
        emit_map(bu, CB, zr, zi, f'fr{k}', f'fi{k}')
        if fused:
            bu(f'_mm512_store_pd(SCR64_re+({k}*64+base)*8, fr{k});')
            bu(f'_mm512_store_pd(SCR64_im+({k}*64+base)*8, fi{k});')
        else:
            bu(f'_mm512_store_pd(ore + (size_t)({k}*64+base)*{LP} + rc*8, fr{k});')
            bu(f'_mm512_store_pd(oim + (size_t)({k}*64+base)*{LP} + rc*8, fi{k});')
        subs.append(bu.out().split(chr(10)))
    mx = max(len(s) for s in subs)
    for row in range(mx):
        for s in subs:
            if row < len(s): pb(s[row])
    pb('}')
    if fused:
        # next step's phase A on scratch: r3 (stride 1) + tw3, r2 (stride 8) + tw(l2'=rc&7), r1 (stride 64) + tw(l1'=rc>>3)
        def rpass(stride, twsel, store_out):
            pref = {1:'ra', 8:'rb', 64:'rx'}[stride]
            if stride == 1:
                pb(f'for(int o=0;o<64;o++){{ int base=o*8;')
            elif stride == 8:
                pb(f'for(int r1x=0;r1x<8;r1x++)for(int r3x=0;r3x<8;r3x++){{ int base=r1x*64+r3x;')
            else:
                pb(f'for(int o=0;o<64;o++){{ int base=o;')
            xr=[]
            for j in range(8):
                r = T(pb, f'_mm512_load_pd(SCR64_re+({j}*{stride}+base)*8)')
                i = T(pb, f'_mm512_load_pd(SCR64_im+({j}*{stride}+base)*8)')
                xr.append((r,i))
            XR = dft8(pb, CB, xr)
            for k in range(8):
                vr, vi = XR[k]
                if k > 0:
                    if twsel == 3:
                        wr = T(pb, f'_mm512_load_pd(TW3_re+{k}*8)')
                        wi = T(pb, f'_mm512_load_pd(TW3_im+{k}*8)')
                    else:
                        d = 'l2' if twsel == 2 else 'l1'
                        wr = T(pb, f'bcastv(&TW12_re[{d}*8+{k}])')
                        wi = T(pb, f'bcastv(&TW12_im[{d}*8+{k}])')
                    rr = MUL(pb, wr, vr); ri = MUL(pb, wr, vi)
                    nvr = FNMA(pb, wi, vi, rr); nvi = FMA(pb, wi, vr, ri)
                    vr, vi = nvr, nvi
                if store_out:
                    pb(f'_mm512_store_pd(ore + (size_t)({k}*{stride}+base)*{LP} + rc*8, {vr});')
                    pb(f'_mm512_store_pd(oim + (size_t)({k}*{stride}+base)*{LP} + rc*8, {vi});')
                else:
                    pb(f'_mm512_store_pd(SCR64_re+({k}*{stride}+base)*8, {vr});')
                    pb(f'_mm512_store_pd(SCR64_im+({k}*{stride}+base)*8, {vi});')
            pb('}')
        rpass(1, 3, False)
        rpass(8, 2, False)
        rpass(64, 1, True)
    pb('}')
    pb('}')
    return pb.out().replace('%CONSTS%', CB.loads())

em(emit_sweep(False))
em(emit_sweep(True))
