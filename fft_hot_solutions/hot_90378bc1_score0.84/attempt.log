 'uniformB8':   [45, 8,8,8,8,8,8,8,8,       300,200,120,90,60,40,30,20],
}
for nm, args in MIXES.items():
    ts=[]
    for i in range(3):
        t0=time.perf_counter(); out = sol.transform(*args); t1=time.perf_counter(); ts.append(t1-t0)
    t0=time.perf_counter(); ref = base.transform(*args); t1=time.perf_counter(); tb=t1-t0
    # correctness quick
    ok = np.linalg.norm(out-ref)/np.linalg.norm(ref) < 1e-4
    print(f'{nm:13s}: sol best {min(ts):.3f}s  base {tb:.2f}s  speedup {tb/min(ts):5.1f}x  sane={ok}')
EOF
taskset -c 0 python3 mixes.py</antml:parameter>
