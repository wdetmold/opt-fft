#include <immintrin.h>
#include <stdio.h>
#include <stdint.h>
static inline uint64_t rdtscp(void){unsigned a,d,c;__asm__ volatile("rdtscp":"=a"(a),"=d"(d),"=c"(c));return ((uint64_t)d<<32)|a;}
static double buf[1<<14] __attribute__((aligned(64)));
#define REP 2000000
// latency chain: 8 dependent FMAs per iter -> 32 cycles/iter (FMA lat 4)
__attribute__((noinline)) uint64_t lat_chain(void){
  uint64_t t0=rdtscp();
  __asm__ volatile(
    "vmovapd %[b], %%zmm0\n\t"
    "vmovapd %[b], %%zmm1\n\t"
    "mov %[rep], %%rcx\n\t"
    "1:\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "dec %%rcx\n\t"
    "jnz 1b\n\t"
    :: [b]"m"(buf[0]), [rep]"i"(REP) : "rcx","zmm0","zmm1","memory");
  return rdtscp()-t0;
}
// throughput: 16 independent FMAs per iter
__attribute__((noinline)) uint64_t tp_fma(void){
  uint64_t t0=rdtscp();
  __asm__ volatile(
    "vmovapd %[b], %%zmm1\n\t"
    "mov %[rep], %%rcx\n\t"
