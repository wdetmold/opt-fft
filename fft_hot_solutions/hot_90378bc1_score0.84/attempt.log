    "vfmadd231pd %%zmm1,%%zmm1,%%zmm2\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm3\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm4\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm5\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm6\n\t"
