L=64 is memory-bound as feared. Let me calibrate the machine's actual L3/DRAM bandwidth and test NT stores:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/mb && cat > bw.c <<'EOF'
#include <immintrin.h>
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <sys/mman.h>
#include <time.h>
static inline uint64_t now_ns(void){struct timespec ts;clock_gettime(CLOCK_MONOTONIC,&ts);return ts.tv_sec*1000000000ull+ts.tv_nsec;}
double* alloc_mb(size_t mb){
  void* p = mmap(0, mb<<20, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
  madvise(p, mb<<20, MADV_HUGEPAGE); memset(p, 1, mb<<20); return (double*)p;
}
int main(){
  size_t MB = 16;       // ~ working set 16MB (L3-resident-ish, > L2)
  size_t n = (MB<<20)/8;
  double* a = alloc_mb(MB); double* b = alloc_mb(MB);
  volatile double sink;
  for(int rep=0;rep<3;rep++){
    // read
    uint64_t t0=now_ns(); __m512d s=_mm512_setzero_pd();
    for(size_t i=0;i<n;i+=8) s=_mm512_add_pd(s,_mm512_load_pd(a+i));
    uint64_t t1=now_ns(); sink=((double*)&s)[0];
    double rbw = (double)(MB<<20)/(t1-t0);
    // write
    t0=now_ns();
    for(size_t i=0;i<n;i+=8) _mm512_store_pd(b+i,s);
    t1=now_ns();
    double wbw = (double)(MB<<20)/(t1-t0);
    // NT write
    t0=now_ns();
    for(size_t i=0;i<n;i+=8) _mm512_stream_pd(b+i,s);
    _mm_sfence();
    t1=now_ns();
    double ntbw = (double)(MB<<20)/(t1-t0);
    // copy a->b
    t0=now_ns();
    for(size_t i=0;i<n;i+=8) _mm512_store_pd(b+i,_mm512_load_pd(a+i));
    t1=now_ns();
    double cbw = (double)(2*(MB<<20))/(t1-t0);
    // NT copy
    t0=now_ns();
    for(size_t i=0;i<n;i+=8) _mm512_stream_pd(b+i,_mm512_load_pd(a+i));
    _mm_sfence();
    t1=now_ns();
    double ncbw = (double)(2*(MB<<20))/(t1-t0);
    printf("read %.1f GB/s | write %.1f | NTwrite %.1f | copy %.1f | NTcopy %.1f\n", rbw,wbw,ntbw,cbw,ncbw);
  }
  return 0;
}
EOF
