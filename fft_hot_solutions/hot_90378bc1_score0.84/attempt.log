os.sched_setaffinity(0,{0})
lib = ctypes.CDLL('/work/mkl_runtime/lib/libmkl_rt.so.3', mode=ctypes.RTLD_GLOBAL)
lib.MKL_Set_Threading_Layer(ctypes.c_int(1))
LONG=ctypes.c_long
DftiCreateDescriptor=lib.DftiCreateDescriptor
DftiSetValue=lib.DftiSetValue
DftiCommitDescriptor=lib.DftiCommitDescriptor
DftiComputeForward=lib.DftiComputeForward
DFTI_DOUBLE=36; DFTI_COMPLEX=32
DFTI_NUMBER_OF_TRANSFORMS=7; DFTI_INPUT_DISTANCE=14; DFTI_PLACEMENT=11; DFTI_INPLACE=43; DFTI_NOT_INPLACE=44
ARGS = dict(B6=64, B8=48, B13=24, B17=16, B23=12, B36=8, B45=6, B64=4,
    m6=600, m8=400, m13=200, m17=150, m23=100, m36=60, m45=40, m64=30)
tot=0
for L in (6,8,13,17,23,36,45,64):
    B=ARGS[f'B{L}']; m=ARGS[f'm{L}']
    h=ctypes.c_void_p()
    dims=(LONG*3)(L,L,L)
    st=DftiCreateDescriptor(ctypes.byref(h), ctypes.c_int(DFTI_DOUBLE), ctypes.c_int(DFTI_COMPLEX), LONG(3), dims)
    assert st==0, st
    DftiSetValue(h, ctypes.c_int(DFTI_NUMBER_OF_TRANSFORMS), LONG(B))
    DftiSetValue(h, ctypes.c_int(DFTI_INPUT_DISTANCE), LONG(L*L*L))
    st=DftiCommitDescriptor(h); assert st==0, st
    rng_x = np.random.default_rng(1234 + L)
    x = (rng_x.standard_normal((B, L, L, L)) + 1j * rng_x.standard_normal((B, L, L, L)))
    rng_c = np.random.default_rng(1000 + L)
    c = 0.1 * (rng_c.standard_normal((B, L, L, L)) + 1j * rng_c.standard_normal((B, L, L, L)))
    t0=time.perf_counter()
    for k in range(m):
        st=DftiComputeForward(h, ctypes.c_void_p(x.ctypes.data))
        z = x + c
        x = z / (1.0 + np.abs(z))
    t1=time.perf_counter()
    es=B*m*L**3
    tot+=t1-t0
    print(f'L={L:3d}  t={t1-t0:7.3f}s  ns/el-step={1e9*(t1-t0)/es:6.2f}')
print('total', tot)
EOF
