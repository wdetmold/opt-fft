Conversions cost ~3ns/el per pass — too slow. Let me quantify precisely and try a gather-vectorized version:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/g && python3 - <<'EOF'
import ctypes, numpy as np, os, time
os.sched_setaffinity(0,{0})
lib = ctypes.CDLL('/tmp/g/impl_fg.so')
for N in (36,45):
    getattr(lib,f'init_{N}')()
    f = getattr(lib,f'run_{N}'); f.argtypes=[ctypes.c_void_p]*4+[ctypes.c_long]*2
    B=1
    rng = np.random.default_rng(1)
    x0 = rng.standard_normal((B,N,N,N)) + 1j*rng.standard_normal((B,N,N,N))
    c = 0.1*(rng.standard_normal((B,N,N,N)) + 1j*rng.standard_normal((B,N,N,N)))
    one = np.zeros(B*N**3, complex); fin = np.zeros(B*N**3, complex)
    ts={}
    for m in (1,2,5):
        best=9e9
        for r in range(7):
            t0=time.perf_counter(); f(x0.ctypes.data, c.ctypes.data, one.ctypes.data, fin.ctypes.data, B, m); t1=time.perf_counter()
            best=min(best,t1-t0)
        ts[m]=best
    step=(ts[5]-ts[1])/4
    conv=ts[1]-step
    print(f'N={N}: step={1e9*step/N**3:.2f} ns/el, conv-fixed={1e6*conv:.1f} us = {1e9*conv/N**3:.2f} ns/el (4 passes)')
EOF</antml:parameter>
