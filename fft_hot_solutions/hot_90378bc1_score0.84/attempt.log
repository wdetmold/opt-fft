import ctypes, numpy as np, os, time
os.sched_setaffinity(0,{0})
cases = [(6,64,600),(8,48,400),(13,24,200),(17,16,150),(23,12,100),(36,8,60),(45,6,40),(64,4,30)]
data={}
for L,B,m in cases:
    rng = np.random.default_rng(1234+L)
    x0 = np.ascontiguousarray(rng.standard_normal((B,L,L,L)) + 1j*rng.standard_normal((B,L,L,L)))
    c = np.ascontiguousarray(0.1*(rng.standard_normal((B,L,L,L)) + 1j*rng.standard_normal((B,L,L,L))))
    out = np.empty(2*B*L**3, complex)
    data[L]=(x0,c,out,B,m)
for nm in ('/workdir/implementation.so','/tmp/g/align_test.so'):
    lib = ctypes.CDLL(nm)
    lib.init_tables(); lib.MJ_init_36(); lib.MJ_init_45()
    tot=0; res=[]
    for L,B,m in cases:
        x0,c,out,B,m = data[L]
        if L==64:
            f = lib.run64; f.argtypes=[ctypes.c_longlong]*2+[ctypes.c_void_p]*4
            call = lambda: f(B,m,x0.ctypes.data,c.ctypes.data,out.ctypes.data,out.ctypes.data+B*L**3*16)
        elif L==36:
            f = lib.MJ_run_36; f.argtypes=[ctypes.c_void_p]*4+[ctypes.c_long]*2
            call = lambda: f(x0.ctypes.data,c.ctypes.data,out.ctypes.data,out.ctypes.data+B*L**3*16,B,m)
        else:
            f = getattr(lib,f'run_{L}'); f.argtypes=[ctypes.c_void_p]*4+[ctypes.c_long]*2
            call = lambda: f(x0.ctypes.data,c.ctypes.data,out.ctypes.data,out.ctypes.data+B*L**3*16,B,m)
        ts=[]
        for r in range(5):
            t0=time.perf_counter(); call(); t1=time.perf_counter()
            ts.append(t1-t0)
        b=min(ts); tot+=b; res.append(f'{L}:{1e9*b/(B*m*L**3):.2f}')
    print(nm.split("/")[-1], f'total {tot*1000:.1f}ms |', ' '.join(res))
EOF</antml:parameter>
