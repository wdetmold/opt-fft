#include <immintrin.h>
#include <stdio.h>
#include <stdint.h>
static inline uint64_t rdtscp(void){unsigned a,d,c;__asm__ volatile("rdtscp":"=a"(a),"=d"(d),"=c"(c));return ((uint64_t)d<<32)|a;}
static double buf[1<<14] __attribute__((aligned(64)));
#define REP 1000000
// mixed loop: 8 dependent FMAs (latency chain) on zmm0 + 16 independent zmm FMAs interleaved.
// If issue >= 2/cyc, the chain dominates: 32 cyc per iter and the 16 indep fill slots.
// Measures BOTH freq (from chain) and throughput capacity simultaneously.
__attribute__((noinline)) uint64_t combo(void){
  uint64_t t0=rdtscp();
  __asm__ volatile(
    "vmovapd %[b], %%zmm0\n\tvmovapd %[b], %%zmm1\n\tmov %[rep], %%rcx\n\t1:\n\t"
    ".rept 1\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm16\n\tvfmadd231pd %%zmm1,%%zmm1,%%zmm17\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm18\n\tvfmadd231pd %%zmm1,%%zmm1,%%zmm19\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm20\n\tvfmadd231pd %%zmm1,%%zmm1,%%zmm21\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm22\n\tvfmadd231pd %%zmm1,%%zmm1,%%zmm23\n\t"
    "vfmadd213pd %%zmm1,%%zmm1,%%zmm0\n\t"
