#include <immintrin.h>
#include <stdio.h>
#include <stdint.h>
#include <time.h>
static inline uint64_t now_ns(void){struct timespec ts;clock_gettime(CLOCK_MONOTONIC,&ts);return ts.tv_sec*1000000000ull+ts.tv_nsec;}
#define N 100000000ull
// pure FMA reg-reg, 8 accumulators
__attribute__((noinline)) double fma8(void){
  __m512d a0=_mm512_set1_pd(1.0000001),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
  __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-18);
  for(uint64_t i=0;i<N/8;i++){
    a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c);
    a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
    a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
    a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
  }
  __m512d s=_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3));
  s=_mm512_add_pd(s,_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
  return _mm512_reduce_add_pd(s);
}
// FMA + load mix: 2 FMA + 1 load per "unit"
static double buf[4096] __attribute__((aligned(64)));
__attribute__((noinline)) double fma_load(int nfma, int nload){
  __m512d a0=_mm512_set1_pd(1.0000001),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
  __m512d b=_mm512_set1_pd(0.9999999), c=_mm512_set1_pd(1e-18);
  __m512d l0=c,l1=c,l2=c,l3=c;
  for(uint64_t i=0;i<N/8;i++){
    size_t off=(i*64)&2047;
    a0=_mm512_fmadd_pd(a0,b,c); a1=_mm512_fmadd_pd(a1,b,c);
    if(nload>0){l0=_mm512_add_pd(l0,_mm512_load_pd(buf+off));}
    a2=_mm512_fmadd_pd(a2,b,c); a3=_mm512_fmadd_pd(a3,b,c);
    if(nload>1){l1=_mm512_add_pd(l1,_mm512_load_pd(buf+off+8));}
    a4=_mm512_fmadd_pd(a4,b,c); a5=_mm512_fmadd_pd(a5,b,c);
    if(nload>2){l2=_mm512_add_pd(l2,_mm512_load_pd(buf+off+16));}
    a6=_mm512_fmadd_pd(a6,b,c); a7=_mm512_fmadd_pd(a7,b,c);
    if(nload>3){l3=_mm512_add_pd(l3,_mm512_load_pd(buf+off+24));}
  }
  __m512d s=_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3));
  s=_mm512_add_pd(s,_mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
  s=_mm512_add_pd(s,_mm512_add_pd(_mm512_add_pd(l0,l1),_mm512_add_pd(l2,l3)));
  return _mm512_reduce_add_pd(s);
}
int main(int argc,char**argv){
  double x=0;
  // warmup
  x+=fma8();
  uint64_t t0=now_ns(); x+=fma8(); uint64_t t1=now_ns();
  double cyc_per_iter = (t1-t0)*1e-9 * 2.994e9 / (N/8); // assume ~3GHz; report raw too
  printf("fma8: %.3f ns total, %.3f ns/iter(8 fma) -> %.2f fma/cyc@3GHz  [x=%f]\n",(t1-t0)*1e-9,(double)(t1-t0)/(N/8), 8.0/cyc_per_iter, x);
  for(int nl=1;nl<=4;nl++){
    x+=fma_load(8,nl);
    t0=now_ns(); x+=fma_load(8,nl); t1=now_ns();
    double iters=N/8;
    double ns_it=(double)(t1-t0)/iters;
    double cyc=ns_it*2.994;
    printf("fma8+%dload: %.3f ns/iter -> %.3f cyc/iter, %.2f fma/cyc, %.2f vuops/cyc [x=%f]\n",nl,ns_it,cyc,8.0/cyc,(8.0+nl+ (nl>0?nl:0))/cyc, x);
  }
  return 0;
}
