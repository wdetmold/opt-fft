    "vfmadd231pd %%zmm1,%%zmm1,%%zmm8\n\t"
    "vfmadd231pd %%zmm1,%%zmm1,%%zmm9\n\t"
    ".endr\n\t"
    "dec %%rcx\n\t"
    "jnz 1b\n\t"
    :: [b]"m"(buf[0]), [rep]"i"(REP/8) : "rcx","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","memory");
  return rdtscp()-t0;
}
// throughput: 8 FMA + 4 loads per iter block of 12 uops
__attribute__((noinline)) uint64_t tp_fma_ld(void){
  uint64_t t0=rdtscp();
  __asm__ volatile(
    "vmovapd %[b], %%zmm1\n\t"
