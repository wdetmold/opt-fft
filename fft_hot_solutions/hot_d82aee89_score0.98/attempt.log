  "vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vpermt2pd %%zmm5, %%zmm30, %%zmm8\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm5\n vpermt2pd %%zmm6, %%zmm30, %%zmm9\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vpermt2pd %%zmm7, %%zmm30, %%zmm10\n"
