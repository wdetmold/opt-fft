                best = min(best, time.perf_counter() - t0)
            res.append((eng, best/(B*m*L**3)*1e9))
        print(f"L={L:2d} B={B:3d} m={m:3d}: " + "  ".join(f"{e}={v:6.3f}" for e,v in res), flush=True)
