cat > gensoadrv.py <<'EOF'
"""Generic SoA-8 driver for one L: arenas, conversions, sweeps, run entry."""
from glib import Emit

def emit_soa_engine(e, L, emit_pass_funcs):
    """emit_pass_funcs(e, L): must define functions:
       dftz_L, dfty_L, dftx_L (in-place pencil DFT along each axis, args double* pr, double* pi)
       dftxm_L, dftym_L (map-fused: args pr, pi, cr, ci)
    """
    N3 = L*L*L
    e(f"// ============ L={L} SoA-8 ============")
    e(f"static double S{L}RE[{N3*8}] ALIGN64;")
    e(f"static double S{L}IM[{N3*8}] ALIGN64;")
    e(f"static double C{L}RE[{N3*8}] ALIGN64;")
    e(f"static double C{L}IM[{N3*8}] ALIGN64;")
    emit_pass_funcs(e, L)
    e(f"""
static void sw{L}_SyX(int y0, int pre){{
    for (int z = 0; z < {L}; z++) {{
        long off = ((long)y0*{L} + z)*8;
        dftxm_{L}(S{L}RE + off, S{L}IM + off, C{L}RE + off, C{L}IM + off);
    }}
    if (pre) {{
        for (int x = 0; x < {L}; x++) {{
            long off = ((long)x*{L} + y0)*{L}*8;
            dftz_{L}(S{L}RE + off, S{L}IM + off);
        }}
        for (int z = 0; z < {L}; z++) {{
            long off = ((long)y0*{L} + z)*8;
            dftx_{L}(S{L}RE + off, S{L}IM + off);
        }}
    }}
}}
static void sw{L}_PxY(int x0, int pre){{
    for (int z = 0; z < {L}; z++) {{
        long off = ((long)x0*{L}*{L} + z)*8;
        dftym_{L}(S{L}RE + off, S{L}IM + off, C{L}RE + off, C{L}IM + off);
    }}
    if (pre) {{
        for (int y = 0; y < {L}; y++) {{
            long off = ((long)x0*{L} + y)*{L}*8;
            dftz_{L}(S{L}RE + off, S{L}IM + off);
        }}
        for (int z = 0; z < {L}; z++) {{
            long off = ((long)x0*{L}*{L} + z)*8;
            dfty_{L}(S{L}RE + off, S{L}IM + off);
        }}
    }}
}}
void run_{L}(const double* x0, const double* c, double* out1, double* outm, long B, long m){{
    if (m < 1) m = 1;
    long vs = 2*(long){N3};
    for (long g0 = 0; g0 < B; g0 += 8) {{
        int nv = (B - g0) < 8 ? (int)(B - g0) : 8;
        const double* xg = x0 + g0*vs;
        const double* cg = c + g0*vs;
        long nfull = ({N3}/8)*8;
        if (nv == 8) {{
            for (long s = 0; s < nfull; s += 8) {{ soa_in8(xg, vs, s, S{L}RE, S{L}IM); soa_in8(cg, vs, s, C{L}RE, C{L}IM); }}
        }} else {{
            for (long s = 0; s < nfull; s += 8) {{ soa_in8_nv(xg, vs, s, S{L}RE, S{L}IM, nv); soa_in8_nv(cg, vs, s, C{L}RE, C{L}IM, nv); }}
        }}
        for (long s = nfull; s < {N3}; s++) {{   // tail sites scalar
            for (int v = 0; v < 8; v++) {{
                S{L}RE[s*8+v] = v < nv ? xg[v*vs + 2*s] : 0.0;
                S{L}IM[s*8+v] = v < nv ? xg[v*vs + 2*s + 1] : 0.0;
                C{L}RE[s*8+v] = v < nv ? cg[v*vs + 2*s] : 0.0;
                C{L}IM[s*8+v] = v < nv ? cg[v*vs + 2*s + 1] : 0.0;
            }}
        }}
        // prologue: Z,Y per plane x
        for (int x = 0; x < {L}; x++) {{
            for (int y = 0; y < {L}; y++) {{
                long off = ((long)x*{L} + y)*{L}*8;
                dftz_{L}(S{L}RE + off, S{L}IM + off);
            }}
            for (int z = 0; z < {L}; z++) {{
                long off = ((long)x*{L}*{L} + z)*8;
                dfty_{L}(S{L}RE + off, S{L}IM + off);
            }}
        }}
        for (long t = 1; t <= m; t++) {{
            int snap = (t == 1) || (t == m);
            int pre = (t < m);
            int dopre = pre && !snap;
            if (t & 1) {{ for (int y0 = 0; y0 < {L}; y0++) sw{L}_SyX(y0, dopre); }}
            else       {{ for (int xp = 0; xp < {L}; xp++) sw{L}_PxY(xp, dopre); }}
            if (t == 1) {{
                for (long s = 0; s < nfull; s += 8) soa_out8(S{L}RE, S{L}IM, s, out1 + g0*vs, vs, nv);
                for (long s = nfull; s < {N3}; s++) for (int v = 0; v < nv; v++) {{
                    out1[g0*vs + v*vs + 2*s] = S{L}RE[s*8+v]; out1[g0*vs + v*vs + 2*s+1] = S{L}IM[s*8+v]; }}
            }}
            if (t == m) {{
                for (long s = 0; s < nfull; s += 8) soa_out8(S{L}RE, S{L}IM, s, outm + g0*vs, vs, nv);
                for (long s = nfull; s < {N3}; s++) for (int v = 0; v < nv; v++) {{
                    outm[g0*vs + v*vs + 2*s] = S{L}RE[s*8+v]; outm[g0*vs + v*vs + 2*s+1] = S{L}IM[s*8+v]; }}
            }}
            if (pre && !dopre) {{
                for (long pidx = 0; pidx < {L}*{L}; pidx++) {{
                    long off = pidx*{L}*8;
                    dftz_{L}(S{L}RE + off, S{L}IM + off);
                }}
                if (t & 1) {{
                    for (int y0 = 0; y0 < {L}; y0++) for (int z = 0; z < {L}; z++) {{
                        long off = ((long)y0*{L} + z)*8;
                        dftx_{L}(S{L}RE + off, S{L}IM + off);
                    }}
                }} else {{
                    for (int x0 = 0; x0 < {L}; x0++) for (int z = 0; z < {L}; z++) {{
                        long off = ((long)x0*{L}*{L} + z)*8;
                        dfty_{L}(S{L}RE + off, S{L}IM + off);
                    }}
                }}
            }}
        }}
    }}
}}
""")
