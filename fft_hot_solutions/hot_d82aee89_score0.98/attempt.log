static void sw{L}_SyX(int y0, int pre){{
    long b0 = (long)y0*{L}*8;
    p{L}_xxm(S{L}RE + b0, S{L}IM + b0, C{L}RE + b0, C{L}IM + b0, {L}, 8);
    if (pre) {{
        for (int x = 0; x < {L}; x++)
            p{L}_zz(S{L}RE + (long)x*{XS} + (long)y0*{L}*8, S{L}IM + (long)x*{XS} + (long)y0*{L}*8, 1, 8);
