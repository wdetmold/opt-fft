c = [np.exp(-2j*np.pi*t/5) for t in range(5)]
c1, s1 = c[1].real, -c[1].imag
c2, s2 = c[2].real, -c[2].imag
u1, v1 = x[1]+x[4], x[1]-x[4]
u2, v2 = x[2]+x[3], x[2]-x[3]
X0 = x[0] + u1 + u2
s1_ = x[0] + c1*u1 + c2*u2
s2_ = x[0] + c2*u1 + c1*u2
t1_ = s1*v1 + s2*v2
t2_ = s2*v1 - s1*v2
X1 = complex(s1_.real + t1_.imag, s1_.imag - t1_.real)
X4 = complex(s1_.real - t1_.imag, s1_.imag + t1_.real)
X2 = complex(s2_.real + t2_.imag, s2_.imag - t2_.real)
X3 = complex(s2_.real - t2_.imag, s2_.imag + t2_.real)
ref = np.fft.fft(x)
got = np.array([X0, X1, X2, X3, X4])
print(np.abs(got - ref))
