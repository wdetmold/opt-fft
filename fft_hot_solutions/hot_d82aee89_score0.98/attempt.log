// microbenchmarks: FMA throughput, load throughput, mixes
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <immintrin.h>
#include <x86intrin.h>

static inline uint64_t rdtscp_() { unsigned a; return __rdtscp(&a); }

double buf[8*1024] __attribute__((aligned(64)));

#define REP8(x) x x x x x x x x
#define REP64(x) REP8(REP8(x))

// pure FMA: 8 accumulators
__attribute__((noinline)) uint64_t fma_pure(long iters) {
    __m512d a0=_mm512_set1_pd(1.0),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d b=_mm512_set1_pd(1e-9), c=_mm512_set1_pd(0.9999999);
    uint64_t t0=rdtscp_();
    for (long i=0;i<iters;i++){
        REP8(
        a0=_mm512_fmadd_pd(a0,c,b); a1=_mm512_fmadd_pd(a1,c,b);
        a2=_mm512_fmadd_pd(a2,c,b); a3=_mm512_fmadd_pd(a3,c,b);
        a4=_mm512_fmadd_pd(a4,c,b); a5=_mm512_fmadd_pd(a5,c,b);
        a6=_mm512_fmadd_pd(a6,c,b); a7=_mm512_fmadd_pd(a7,c,b);)
    }
    uint64_t t1=rdtscp_();
    a0=_mm512_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)),
                     _mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    volatile double s=_mm512_reduce_add_pd(a0); (void)s;
    return t1-t0;
}
// pure loads
__attribute__((noinline)) uint64_t load_pure(long iters) {
    __m512d a0=_mm512_setzero_pd(),a1=a0,a2=a0,a3=a0;
    uint64_t t0=rdtscp_();
    for (long i=0;i<iters;i++){
        for (int j=0;j<64;j+=8){
            a0=_mm512_or_pd(a0,_mm512_load_pd(buf+j*8));
            a1=_mm512_or_pd(a1,_mm512_load_pd(buf+j*8+16));
            a2=_mm512_or_pd(a2,_mm512_load_pd(buf+j*8+32));
            a3=_mm512_or_pd(a3,_mm512_load_pd(buf+j*8+48));
        }
    }
    uint64_t t1=rdtscp_();
    volatile double s=_mm512_reduce_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3))); (void)s;
    return t1-t0;
}
// FMA:load 2:1 mix (8 fma + 4 load per block)
__attribute__((noinline)) uint64_t mix21(long iters) {
    __m512d a0=_mm512_set1_pd(1.0),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d c=_mm512_set1_pd(0.9999999);
    uint64_t t0=rdtscp_();
    for (long i=0;i<iters;i++){
        for (int j=0;j<8;j++){
            __m512d l0=_mm512_load_pd(buf+j*64);
            __m512d l1=_mm512_load_pd(buf+j*64+16);
            __m512d l2=_mm512_load_pd(buf+j*64+32);
            __m512d l3=_mm512_load_pd(buf+j*64+48);
            a0=_mm512_fmadd_pd(a0,c,l0); a1=_mm512_fmadd_pd(a1,c,l1);
            a2=_mm512_fmadd_pd(a2,c,l2); a3=_mm512_fmadd_pd(a3,c,l3);
            a4=_mm512_fmadd_pd(a4,c,l0); a5=_mm512_fmadd_pd(a5,c,l1);
            a6=_mm512_fmadd_pd(a6,c,l2); a7=_mm512_fmadd_pd(a7,c,l3);
        }
    }
    uint64_t t1=rdtscp_();
    a0=_mm512_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)),
                     _mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    volatile double s=_mm512_reduce_add_pd(a0); (void)s;
    return t1-t0;
}
// FMA with load-op operand  a = a*c + [mem]
__attribute__((noinline)) uint64_t fma_memop(long iters) {
    __m512d a0=_mm512_set1_pd(1.0),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d c=_mm512_set1_pd(0.9999999);
    uint64_t t0=rdtscp_();
    for (long i=0;i<iters;i++){
        for (int j=0;j<8;j++){
            a0=_mm512_fmadd_pd(a0,c,_mm512_load_pd(buf+j*64));
            a1=_mm512_fmadd_pd(a1,c,_mm512_load_pd(buf+j*64+8));
            a2=_mm512_fmadd_pd(a2,c,_mm512_load_pd(buf+j*64+16));
            a3=_mm512_fmadd_pd(a3,c,_mm512_load_pd(buf+j*64+24));
            a4=_mm512_fmadd_pd(a4,c,_mm512_load_pd(buf+j*64+32));
            a5=_mm512_fmadd_pd(a5,c,_mm512_load_pd(buf+j*64+40));
            a6=_mm512_fmadd_pd(a6,c,_mm512_load_pd(buf+j*64+48));
            a7=_mm512_fmadd_pd(a7,c,_mm512_load_pd(buf+j*64+56));
        }
    }
    uint64_t t1=rdtscp_();
    a0=_mm512_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)),
                     _mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    volatile double s=_mm512_reduce_add_pd(a0); (void)s;
    return t1-t0;
}
// stores
__attribute__((noinline)) uint64_t store_pure(long iters) {
    __m512d v=_mm512_set1_pd(1.5);
    uint64_t t0=rdtscp_();
    for (long i=0;i<iters;i++){
        for (int j=0;j<64;j++) _mm512_store_pd(buf+j*8, v);
    }
    uint64_t t1=rdtscp_();
    return t1-t0;
}
// fma + store mix 4:1
__attribute__((noinline)) uint64_t fma_store(long iters) {
    __m512d a0=_mm512_set1_pd(1.0),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d b=_mm512_set1_pd(1e-9), c=_mm512_set1_pd(0.9999999);
    uint64_t t0=rdtscp_();
    for (long i=0;i<iters;i++){
        for (int j=0;j<8;j++){
            a0=_mm512_fmadd_pd(a0,c,b); a1=_mm512_fmadd_pd(a1,c,b);
            a2=_mm512_fmadd_pd(a2,c,b); a3=_mm512_fmadd_pd(a3,c,b);
            a4=_mm512_fmadd_pd(a4,c,b); a5=_mm512_fmadd_pd(a5,c,b);
            a6=_mm512_fmadd_pd(a6,c,b); a7=_mm512_fmadd_pd(a7,c,b);
            _mm512_store_pd(buf+j*16, a0); _mm512_store_pd(buf+j*16+8, a1);
        }
    }
    uint64_t t1=rdtscp_();
    volatile double s=_mm512_reduce_add_pd(a7); (void)s;
    return t1-t0;
}
// shuffle+fma mix 1:1 (vpermt2pd steals port5?)
__attribute__((noinline)) uint64_t fma_shuf(long iters) {
    __m512d a0=_mm512_set1_pd(1.0),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d b=_mm512_set1_pd(1e-9), c=_mm512_set1_pd(0.9999999);
    __m512i ix=_mm512_set_epi64(3,7,2,6,1,5,0,4);
    uint64_t t0=rdtscp_();
    for (long i=0;i<iters;i++){
        REP8(
        a0=_mm512_fmadd_pd(a0,c,b); a1=_mm512_permutexvar_pd(ix,a1);
        a2=_mm512_fmadd_pd(a2,c,b); a3=_mm512_permutexvar_pd(ix,a3);
        a4=_mm512_fmadd_pd(a4,c,b); a5=_mm512_permutexvar_pd(ix,a5);
        a6=_mm512_fmadd_pd(a6,c,b); a7=_mm512_permutexvar_pd(ix,a7);)
    }
    uint64_t t1=rdtscp_();
    a0=_mm512_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)),
                     _mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    volatile double s=_mm512_reduce_add_pd(a0); (void)s;
    return t1-t0;
}
// broadcast-load fma: a = a*c + broadcast [mem]
__attribute__((noinline)) uint64_t fma_bcast(long iters) {
    __m512d a0=_mm512_set1_pd(1.0),a1=a0,a2=a0,a3=a0,a4=a0,a5=a0,a6=a0,a7=a0;
    __m512d c=_mm512_set1_pd(0.9999999);
    uint64_t t0=rdtscp_();
    for (long i=0;i<iters;i++){
        for (int j=0;j<8;j++){
            a0=_mm512_fmadd_pd(a0,c,_mm512_set1_pd(buf[j*8]));
            a1=_mm512_fmadd_pd(a1,c,_mm512_set1_pd(buf[j*8+1]));
            a2=_mm512_fmadd_pd(a2,c,_mm512_set1_pd(buf[j*8+2]));
            a3=_mm512_fmadd_pd(a3,c,_mm512_set1_pd(buf[j*8+3]));
            a4=_mm512_fmadd_pd(a4,c,_mm512_set1_pd(buf[j*8+4]));
            a5=_mm512_fmadd_pd(a5,c,_mm512_set1_pd(buf[j*8+5]));
            a6=_mm512_fmadd_pd(a6,c,_mm512_set1_pd(buf[j*8+6]));
            a7=_mm512_fmadd_pd(a7,c,_mm512_set1_pd(buf[j*8+7]));
        }
    }
    uint64_t t1=rdtscp_();
    a0=_mm512_add_pd(_mm512_add_pd(_mm512_add_pd(a0,a1),_mm512_add_pd(a2,a3)),
                     _mm512_add_pd(_mm512_add_pd(a4,a5),_mm512_add_pd(a6,a7)));
    volatile double s=_mm512_reduce_add_pd(a0); (void)s;
    return t1-t0;
}

int main(){
    for (int i=0;i<8*1024;i++) buf[i]=1.0+i*1e-9;
    long iters=200000;
    struct { const char* name; uint64_t(*fn)(long); double ops; } tests[] = {
        {"fma_pure (64 fma)", fma_pure, 64},
        {"load_pure (64 ld)", load_pure, 64},
        {"mix21 (64fma+32ld)", mix21, 96},
        {"fma_memop (64 fma-mem)", fma_memop, 64},
        {"store_pure (64 st)", store_pure, 64},
        {"fma_store (64fma+16st)", fma_store, 80},
        {"fma_shuf (32fma+32shuf)", fma_shuf, 64},
        {"fma_bcast (64 fma-bcastmem)", fma_bcast, 64},
    };
    for (int t=0;t<8;t++){
        uint64_t best=~0ull;
        for (int r=0;r<5;r++){ uint64_t d=tests[t].fn(iters); if(d<best)best=d; }
        double tpi = (double)best/iters;  // tsc ticks per iteration (64-op block)
        printf("%-28s: %7.2f tsc/blk -> %.3f ops/tsc-cyc (x1.12 @2.9GHz: %.3f/cyc)\n",
               tests[t].name, tpi, tests[t].ops/tpi, tests[t].ops/tpi/1.1154);
    }
    return 0;
}
EOF
