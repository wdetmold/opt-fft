import numpy as np, time
import solution, base
p = (31415, 9, 7, 5, 3, 2, 9, 8, 2) + (3, 5, 2, 4, 6, 2, 3, 2)
t0=time.perf_counter(); got = solution.transform(*p); t1=time.perf_counter()
ref = base.transform(*p)
assert got.dtype == np.complex128 and got.shape == ref.shape, (got.dtype, got.shape, ref.shape)
_SIZES = (6, 8, 13, 17, 23, 36, 45, 64)
Bs = p[1:9]; off=0; w1=wm=0
for i, L in enumerate(_SIZES):
    n = Bs[i]*L**3
