<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/regen && python3 - <<'EOF'
src = open('f30.c').read()
add = '''
// ---- one-sweep-per-step fused 64 driver v2:
// odd t (y-visits):  [Zrow_t, Xmap_t, Zrow_{t+1}, Xnomap_{t+1}]   (all row-local, good locality)
// even t (z-visits): [Ymap_t, Y_{t+1}]                            (column-local, 64KB visits)
static __attribute__((always_inline)) inline
void x64lane_nm(vd *restrict X, ptrdiff_t q) {
    const ptrdiff_t S = 2*SA64;
    vd R[8], I[8];
    vd *p = X + 2*q;
    for (int a = 0; a < 8; a++) { R[a] = p[a*S]; I[a] = p[a*S + 1]; }
    bf8(&R[0],&I[0],&R[1],&I[1],&R[2],&I[2],&R[3],&I[3],
        &R[4],&I[4],&R[5],&I[5],&R[6],&I[6],&R[7],&I[7]);
    for (int k1 = 1; k1 < 8; k1++) {
        vd gr = R[k1], gi = I[k1];
        R[k1] = gr * ZTWR[k1] - gi * ZTWI[k1];
        I[k1] = gr * ZTWI[k1] + gi * ZTWR[k1];
    }
    tr8(R); tr8(I);
    bf8(&R[0],&I[0],&R[1],&I[1],&R[2],&I[2],&R[3],&I[3],
        &R[4],&I[4],&R[5],&I[5],&R[6],&I[6],&R[7],&I[7]);
    for (int k2 = 0; k2 < 8; k2++) { p[k2*S] = R[k2]; p[k2*S+1] = I[k2]; }
}
static void visY2_64(vd *restrict X, const vd *restrict C, int y, int pre) {
    sweepZrow_64(X, y);                                          // Z_t on row y
    for (int z = 0; z < 64; z++) x64lane(X, C, (ptrdiff_t)y*RY64 + z);   // X_t + c + map
    if (pre) {
        sweepZrow_64(X, y);                                      // Z_{t+1}
        for (int z = 0; z < 64; z++) x64lane_nm(X, (ptrdiff_t)y*RY64 + z); // X_{t+1}
    }
}
static void visZ2_64(vd *restrict X, const vd *restrict C, int z, int pre) {
    for (int a = 0; a < 8; a++) {                                // Y_t + c + map
        vd *p = X + 2*((ptrdiff_t)a*SA64 + z);
        const vd *c = C + 2*((ptrdiff_t)a*SA64 + z);
        k64_m(p, p + 1, 2*RY64, c, c + 1);
    }
    if (pre) for (int a = 0; a < 8; a++) {                       // Y_{t+1}
        vd *p = X + 2*((ptrdiff_t)a*SA64 + z);
        k64_p(p, p + 1, 2*RY64);
    }
}
void run64f2(long long Bll, long long mll, const double *x0, const double *c0,
           double *out1, double *outm) {
    const long NV = 262144; const long B = (long)Bll;
    long m = (long)mll; if (m < 1) m = 1;
    for (long v = 0; v < B; v++) {
        conv_in_64(x0 + (long long)v*NV*2, XP_);
        conv_in_64(c0 + (long long)v*NV*2, CP_);
        sweepY_64(XP_);     // prologue: Y_1
        for (long it = 1; it <= m; it++) {
            int snap = (it == 1) || (it == m);
            int pre = (it < m) && !snap;
            if (it & 1) { for (int y = 0; y < 64; y++) visY2_64(XP_, CP_, y, pre); }
            else        { for (int z = 0; z < 64; z++) visZ2_64(XP_, CP_, z, pre); }
            if (snap) {
                if (it == 1) conv_out_64(XP_, out1 + (long long)v*NV*2);
                if (it == m) conv_out_64(XP_, outm + (long long)v*NV*2);
                if (it < m) {   // catch-up pre for step it+1
                    if (it & 1) { // skipped [Zrow', Xnomap'] of it+1
                        sweepZ_64(XP_);
                        for (int y = 0; y < 64; y++) for (int z = 0; z < 64; z++)
                            x64lane_nm(XP_, (ptrdiff_t)y*RY64 + z);
                    } else {      // skipped [Y'] of it+1
                        sweepY_64(XP_);
                    }
                }
            }
        }
    }
}
'''
i = src.index('int probe(void)')
src = src[:i] + add + src[i:]
open('f30.c','w').write(src)
print("patched f30.c with run64f2")
