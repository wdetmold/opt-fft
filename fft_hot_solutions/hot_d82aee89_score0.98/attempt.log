// 24 FMA + 8 load + 4 store: heavy-compute stream
DEF(k_heavy,
  "vmovapd 0(%[p],%%rax), %%zmm8\n"
  "vfmadd231pd %%zmm8,%%zmm31,%%zmm0\n vfmadd231pd %%zmm8,%%zmm30,%%zmm1\n vfmadd231pd %%zmm8,%%zmm31,%%zmm2\n"
  "vmovapd 64(%[p],%%rax), %%zmm9\n"
  "vfmadd231pd %%zmm9,%%zmm31,%%zmm3\n vfmadd231pd %%zmm9,%%zmm30,%%zmm4\n vfmadd231pd %%zmm9,%%zmm31,%%zmm5\n"
  "vmovupd %%zmm0, 0(%[q],%%rax)\n"
  "vmovapd 128(%[p],%%rax), %%zmm10\n"
  "vfmadd231pd %%zmm10,%%zmm31,%%zmm6\n vfmadd231pd %%zmm10,%%zmm30,%%zmm7\n vfmadd231pd %%zmm10,%%zmm31,%%zmm0\n"
  "vmovapd 192(%[p],%%rax), %%zmm11\n"
  "vfmadd231pd %%zmm11,%%zmm31,%%zmm1\n vfmadd231pd %%zmm11,%%zmm30,%%zmm2\n vfmadd231pd %%zmm11,%%zmm31,%%zmm3\n"
  "vmovupd %%zmm4, 64(%[q],%%rax)\n"
  "vmovapd 256(%[p],%%rax), %%zmm8\n"
  "vfmadd231pd %%zmm8,%%zmm31,%%zmm4\n vfmadd231pd %%zmm8,%%zmm30,%%zmm5\n vfmadd231pd %%zmm8,%%zmm31,%%zmm6\n"
  "vmovapd 320(%[p],%%rax), %%zmm9\n"
  "vfmadd231pd %%zmm9,%%zmm31,%%zmm7\n vfmadd231pd %%zmm9,%%zmm30,%%zmm0\n vfmadd231pd %%zmm9,%%zmm31,%%zmm1\n"
  "vmovupd %%zmm2, 128(%[q],%%rax)\n"
  "vmovapd 384(%[p],%%rax), %%zmm10\n"
  "vfmadd231pd %%zmm10,%%zmm31,%%zmm2\n vfmadd231pd %%zmm10,%%zmm30,%%zmm3\n vfmadd231pd %%zmm10,%%zmm31,%%zmm4\n"
  "vmovapd 448(%[p],%%rax), %%zmm11\n"
  "vfmadd231pd %%zmm11,%%zmm31,%%zmm5\n vfmadd231pd %%zmm11,%%zmm30,%%zmm6\n vfmadd231pd %%zmm11,%%zmm31,%%zmm7\n"
  "vmovupd %%zmm3, 192(%[q],%%rax)\n", 36)

int main(){
    for (int i=0;i<64*1024;i++) buf[i]=1.0+i*1e-9;
    long iters=300000;
    struct { const char* name; double(*fn)(long); double uops; } T[] = {
        {"fma16 (16F)", k_fma16, 16},
        {"fma16_ld8 (16F 8L)", k_fma16_ld8, 24},
        {"fma16_ld4 (16F 4L)", k_fma16_ld4, 20},
        {"ld16 (16L zmm)", k_ld16, 16},
        {"ldy16 (16L ymm)", k_ldy16, 16},
        {"stream (8F 8L 4S)", k_stream, 20},
        {"fma_permil (16F 16P1)", k_fma_permil, 32},
        {"fma_permt2 (16F 16P5)", k_fma_permt2, 32},
        {"heavy (24F 8L 4S)", k_heavy, 36},
    };
    // calibrate core freq vs tsc using fma16 = 8 cycles exactly (16 FMA / 2)
    double tsc_fma=1e18;
    for (int r=0;r<7;r++){ double d=k_fma16(iters); if(d<tsc_fma)tsc_fma=d; }
    double cyc_per_tsc = 8.0 / tsc_fma;
    printf("fma16: %.3f tsc/blk -> core/tsc ratio %.4f (core ~%.2f GHz)\n", tsc_fma, cyc_per_tsc, 2.6*cyc_per_tsc);
    for (unsigned t=0;t<sizeof(T)/sizeof(T[0]);t++){
        double best=1e18;
        for (int r=0;r<7;r++){ double d=T[t].fn(iters); if(d<best)best=d; }
        double cyc = best*cyc_per_tsc;
        printf("%-24s: %7.2f cyc/blk -> %.3f uops/cyc  (FMA/cyc if F-only: %.3f)\n",
               T[t].name, cyc, T[t].uops/cyc, T[t].uops/cyc);
    }
    return 0;
}
EOF
cd /tmp/w/mb && gcc -O2 -march=native mb2.c -o mb2 && taskset -c 0 ./mb2</antml:parameter>
