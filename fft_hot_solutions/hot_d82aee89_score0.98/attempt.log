#include <stdio.h>
#include <stdint.h>
#include <x86intrin.h>
static inline uint64_t rdtscp_() { unsigned a; return __rdtscp(&a); }
__attribute__((noinline)) double imul_chain(long iters){
    uint64_t t0,t1; long i=iters;
    t0=rdtscp_();
    asm volatile(
      "mov $3, %%rax\n mov $5, %%rcx\n"
      "1:\n"
      ".rept 16\n imul %%rcx, %%rax\n .endr\n"
      "dec %[i]\n jnz 1b\n"
      : [i]"+r"(i) :: "rax","rcx");
    t1=rdtscp_();
    return (double)(t1-t0)/iters/16;  // tsc per imul (latency 3 cyc)
}
int main(){
    long iters=1000000;
    double l=1e18; for(int r=0;r<9;r++){double d=imul_chain(iters); if(d<l)l=d;}
    printf("imul serial: %.4f tsc -> core = %.3f GHz (lat3)\n", l, 3/l*2.6);
    return 0;
}
EOF
