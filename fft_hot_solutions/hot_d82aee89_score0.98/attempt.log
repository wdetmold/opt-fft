#include <stdio.h>
#include <stdint.h>
#include <immintrin.h>
#include <x86intrin.h>
static inline uint64_t rdtscp_() { unsigned a; return __rdtscp(&a); }
double buf[64*1024] __attribute__((aligned(64)));   // 512KB
double obuf[64*1024] __attribute__((aligned(64)));

// kernel loops written in asm. Each runs `iters` iterations of a block.
// Block contents described per test. Pointer advances through buf (L1-sized window 32KB wrap).

#define DEF(name, BODY, UOPS) \
__attribute__((noinline)) double name(long iters){ \
    uint64_t t0,t1; const double* p = buf; double* q = obuf; long i=iters; \
    t0=rdtscp_(); \
    asm volatile( \
      "vxorpd %%zmm0,%%zmm0,%%zmm0\n vxorpd %%zmm1,%%zmm1,%%zmm1\n" \
      "vxorpd %%zmm2,%%zmm2,%%zmm2\n vxorpd %%zmm3,%%zmm3,%%zmm3\n" \
      "vxorpd %%zmm4,%%zmm4,%%zmm4\n vxorpd %%zmm5,%%zmm5,%%zmm5\n" \
      "vxorpd %%zmm6,%%zmm6,%%zmm6\n vxorpd %%zmm7,%%zmm7,%%zmm7\n" \
      "vxorpd %%zmm30,%%zmm30,%%zmm30\n vxorpd %%zmm31,%%zmm31,%%zmm31\n" \
      "mov $0, %%rax\n" \
      "1:\n" BODY \
      "add $1024, %%rax\n and $0x1ffff, %%rax\n" \
      "dec %[i]\n jnz 1b\n" \
      : [i]"+r"(i) : [p]"r"(p), [q]"r"(q) \
      : "rax","zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7", \
        "zmm8","zmm9","zmm10","zmm11","zmm30","zmm31","memory"); \
    t1=rdtscp_(); \
    return (double)(t1-t0)/iters; }

// 16 FMA, no mem
DEF(k_fma16,
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm30,%%zmm31,%%zmm1\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vfmadd231pd %%zmm30,%%zmm31,%%zmm5\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vfmadd231pd %%zmm30,%%zmm31,%%zmm7\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm30,%%zmm31,%%zmm1\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vfmadd231pd %%zmm30,%%zmm31,%%zmm5\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vfmadd231pd %%zmm30,%%zmm31,%%zmm7\n", 16)

// 16 FMA + 8 loads (separate)
DEF(k_fma16_ld8,
  "vmovapd 0(%[p],%%rax), %%zmm8\n vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm8,%%zmm31,%%zmm1\n"
  "vmovapd 64(%[p],%%rax), %%zmm9\n vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vfmadd231pd %%zmm9,%%zmm31,%%zmm3\n"
  "vmovapd 128(%[p],%%rax), %%zmm10\n vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vfmadd231pd %%zmm10,%%zmm31,%%zmm5\n"
  "vmovapd 192(%[p],%%rax), %%zmm11\n vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vfmadd231pd %%zmm11,%%zmm31,%%zmm7\n"
  "vmovapd 256(%[p],%%rax), %%zmm8\n vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm8,%%zmm31,%%zmm1\n"
  "vmovapd 320(%[p],%%rax), %%zmm9\n vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vfmadd231pd %%zmm9,%%zmm31,%%zmm3\n"
  "vmovapd 384(%[p],%%rax), %%zmm10\n vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vfmadd231pd %%zmm10,%%zmm31,%%zmm5\n"
  "vmovapd 448(%[p],%%rax), %%zmm11\n vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vfmadd231pd %%zmm11,%%zmm31,%%zmm7\n", 24)

// 16 FMA + 4 loads
DEF(k_fma16_ld4,
  "vmovapd 0(%[p],%%rax), %%zmm8\n vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm8,%%zmm31,%%zmm1\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n"
  "vmovapd 64(%[p],%%rax), %%zmm9\n vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vfmadd231pd %%zmm9,%%zmm31,%%zmm5\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vfmadd231pd %%zmm30,%%zmm31,%%zmm7\n"
  "vmovapd 128(%[p],%%rax), %%zmm10\n vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm10,%%zmm31,%%zmm1\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n"
  "vmovapd 192(%[p],%%rax), %%zmm11\n vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vfmadd231pd %%zmm11,%%zmm31,%%zmm5\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vfmadd231pd %%zmm30,%%zmm31,%%zmm7\n", 20)

// 16 loads only
DEF(k_ld16,
  "vmovapd 0(%[p],%%rax), %%zmm0\n vmovapd 64(%[p],%%rax), %%zmm1\n"
  "vmovapd 128(%[p],%%rax), %%zmm2\n vmovapd 192(%[p],%%rax), %%zmm3\n"
  "vmovapd 256(%[p],%%rax), %%zmm4\n vmovapd 320(%[p],%%rax), %%zmm5\n"
  "vmovapd 384(%[p],%%rax), %%zmm6\n vmovapd 448(%[p],%%rax), %%zmm7\n"
  "vmovapd 512(%[p],%%rax), %%zmm0\n vmovapd 576(%[p],%%rax), %%zmm1\n"
  "vmovapd 640(%[p],%%rax), %%zmm2\n vmovapd 704(%[p],%%rax), %%zmm3\n"
  "vmovapd 768(%[p],%%rax), %%zmm4\n vmovapd 832(%[p],%%rax), %%zmm5\n"
  "vmovapd 896(%[p],%%rax), %%zmm6\n vmovapd 960(%[p],%%rax), %%zmm7\n", 16)

// 16 ymm loads
DEF(k_ldy16,
  "vmovapd 0(%[p],%%rax), %%ymm0\n vmovapd 64(%[p],%%rax), %%ymm1\n"
  "vmovapd 128(%[p],%%rax), %%ymm2\n vmovapd 192(%[p],%%rax), %%ymm3\n"
  "vmovapd 256(%[p],%%rax), %%ymm4\n vmovapd 320(%[p],%%rax), %%ymm5\n"
  "vmovapd 384(%[p],%%rax), %%ymm6\n vmovapd 448(%[p],%%rax), %%ymm7\n"
  "vmovapd 512(%[p],%%rax), %%ymm0\n vmovapd 576(%[p],%%rax), %%ymm1\n"
  "vmovapd 640(%[p],%%rax), %%ymm2\n vmovapd 704(%[p],%%rax), %%ymm3\n"
  "vmovapd 768(%[p],%%rax), %%ymm4\n vmovapd 832(%[p],%%rax), %%ymm5\n"
  "vmovapd 896(%[p],%%rax), %%ymm6\n vmovapd 960(%[p],%%rax), %%ymm7\n", 16)

// 8 FMA + 8 loads + 4 stores  (typical radix pass shape)
DEF(k_stream,
  "vmovapd 0(%[p],%%rax), %%zmm8\n vfmadd231pd %%zmm8,%%zmm31,%%zmm0\n"
  "vmovapd 64(%[p],%%rax), %%zmm9\n vfmadd231pd %%zmm9,%%zmm31,%%zmm1\n"
  "vmovupd %%zmm0, 0(%[q],%%rax)\n"
  "vmovapd 128(%[p],%%rax), %%zmm10\n vfmadd231pd %%zmm10,%%zmm31,%%zmm2\n"
  "vmovapd 192(%[p],%%rax), %%zmm11\n vfmadd231pd %%zmm11,%%zmm31,%%zmm3\n"
  "vmovupd %%zmm1, 64(%[q],%%rax)\n"
  "vmovapd 256(%[p],%%rax), %%zmm8\n vfmadd231pd %%zmm8,%%zmm31,%%zmm4\n"
  "vmovapd 320(%[p],%%rax), %%zmm9\n vfmadd231pd %%zmm9,%%zmm31,%%zmm5\n"
  "vmovupd %%zmm2, 128(%[q],%%rax)\n"
  "vmovapd 384(%[p],%%rax), %%zmm10\n vfmadd231pd %%zmm10,%%zmm31,%%zmm6\n"
  "vmovapd 448(%[p],%%rax), %%zmm11\n vfmadd231pd %%zmm11,%%zmm31,%%zmm7\n"
  "vmovupd %%zmm3, 192(%[q],%%rax)\n", 20)

// 16 FMA + 16 shuffles (vpermilpd imm = in-lane swap re/im)
DEF(k_fma_permil,
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vpermilpd $0x55, %%zmm0, %%zmm8\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm1\n vpermilpd $0x55, %%zmm1, %%zmm9\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vpermilpd $0x55, %%zmm2, %%zmm10\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n vpermilpd $0x55, %%zmm3, %%zmm11\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vpermilpd $0x55, %%zmm4, %%zmm8\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm5\n vpermilpd $0x55, %%zmm5, %%zmm9\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vpermilpd $0x55, %%zmm6, %%zmm10\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm7\n vpermilpd $0x55, %%zmm7, %%zmm11\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vpermilpd $0x55, %%zmm0, %%zmm8\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm1\n vpermilpd $0x55, %%zmm1, %%zmm9\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vpermilpd $0x55, %%zmm2, %%zmm10\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n vpermilpd $0x55, %%zmm3, %%zmm11\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vpermilpd $0x55, %%zmm4, %%zmm8\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm5\n vpermilpd $0x55, %%zmm5, %%zmm9\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vpermilpd $0x55, %%zmm6, %%zmm10\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm7\n vpermilpd $0x55, %%zmm7, %%zmm11\n", 32)

// 16 FMA + 16 vpermt2pd (full cross shuffles)
DEF(k_fma_permt2,
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vpermt2pd %%zmm1, %%zmm30, %%zmm8\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm1\n vpermt2pd %%zmm2, %%zmm30, %%zmm9\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vpermt2pd %%zmm3, %%zmm30, %%zmm10\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n vpermt2pd %%zmm4, %%zmm30, %%zmm11\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vpermt2pd %%zmm5, %%zmm30, %%zmm8\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm5\n vpermt2pd %%zmm6, %%zmm30, %%zmm9\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vpermt2pd %%zmm7, %%zmm30, %%zmm10\n"
