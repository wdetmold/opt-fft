<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/dev/gen && cat > genprime.py <<'EOF'
"""Folded symmetric prime DFT codelets (p=13,17,23) for SoA vertical data.
X_k = x0 + sum_j u_j*C_kj - i*(v_j*S_kj pattern):
  Xr_k    = A_k + D_k ; Xi_k    = B_k - E_k
  Xr_{p-k}= A_k - D_k ; Xi_{p-k}= B_k + E_k
  A_k = x0r + sum_j C_kj ur_j ; B_k = x0i + sum_j C_kj ui_j
  D_k = sum_j S_kj vi_j       ; E_k = sum_j S_kj vr_j
  X_0 = x0 + sum u_j
C_kj = cos(2pi k j / p) = sgn * ctab[t], S_kj = sin = sgn * stab[t], t = fold(k*j mod p).
Strategy per p: phase F (fold, u/v to scratch + DC); phase M: k-blocks.
For p=13: single-phase blocks KB=3 (12 acc + 12 consts). 17: KB=2 single (8 acc+16 const)
or cos/sin split. 23: cos/sin split KB=4.
"""
import numpy as np
from glib import Emit, trig, hexd

def tables(p):
    # ctab[t], stab[t] for t=1..h as hex; and sign/index mapping for (k,j)
    h = (p-1)//2
    cs = trig(p)   # cos/sin of -2pi t/p
    # cos(2pi t/p) = cs[t][0]; sin(2pi t/p) = -cs[t][1]
    ct = {t: cs[t][0] for t in range(1, h+1)}
    st = {t: -cs[t][1] for t in range(1, h+1)}
    def fold(kj):
        t = kj % p
        if t == 0: return (0, 0, 0)
        if t <= h: return (t, 1, 1)      # cos +, sin +
        return (p - t, 1, -1)            # cos(2pi t/p)=cos(2pi (p-t)/p), sin negated
    return h, ct, st, fold

def emit_prime(e, p, name, blocks, split):
    """Emit: static void name(double* pr, double* pi, const double* cr..., STRIDE macro S_).
    Variants handled by caller wrapper via store callback tokens.
    blocks: list of k-lists. split: if True, cos phase then sin phase (needs AB scratch)."""
    h, ct, st, fold = tables(p)
    e(f"// folded prime DFT p={p}, h={h}, blocks={blocks}, split={split}")
    # declare per-p constant arrays (hex baked), loaded as needed
    carr = ", ".join(hexd(ct[t]) for t in range(1, h+1))
    sarr = ", ".join(hexd(st[t]) for t in range(1, h+1))
    e(f"static const double CT{p}[{h}] ALIGN64 = {{ {carr} }};")
    e(f"static const double ST{p}[{h}] ALIGN64 = {{ {sarr} }};")

def emit_prime_pass(e, p, stride, store_cb, mapfused, scr="PSCR"):
    """Emit the body of one full folded DFT-p on a pencil at (pr,pi) with site-stride `stride` (doubles).
    store_cb(k, rexpr, iexpr) emits the store for output row k (0..p-1).
    Uses scratch PSCR for u/v: layout [j][ur ui vr vi] j=1..h (j-1 indexed)."""
    h, ct, st, fold = tables(p)
    # fold phase + DC
    e(f"{{ V x0r = VL(pr), x0i = VL(pi);")
    e(f"  V s0r = x0r, s0i = x0i;")
    for j in range(1, h+1):
        e(f"{{ V ar = VL(pr + {j*stride}), ai = VL(pi + {j*stride});")
        e(f"  V br = VL(pr + {(p-j)*stride}), bi = VL(pi + {(p-j)*stride});")
        e(f"  V ur = VADD(ar,br), ui = VADD(ai,bi), vr = VSUB(ar,br), vi = VSUB(ai,bi);")
        e(f"  VS({scr} + {(j-1)*32}, ur); VS({scr} + {(j-1)*32+8}, ui);")
        e(f"  VS({scr} + {(j-1)*32+16}, vr); VS({scr} + {(j-1)*32+24}, vi);")
        e(f"  s0r = VADD(s0r, ur); s0i = VADD(s0i, ui); }}")
    store_cb(0, "s0r", "s0i")
    e("}")
    # matvec phase: blocks of k with 4 accumulators each (A,B,D,E), single-phase
    # (constants from CT/ST arrays via VSET1 of scalar load -> broadcast; rely on GCC hoisting)
    return h

def emit_prime_func(e, p, tag, stride, KB, mapfused=False, cstride=None):
    """single-phase k-blocked folded DFT; KB k's at a time; consts broadcast-loaded per block."""
    h, ct, st, fold = tables(p)
    ks = list(range(1, h+1))
    blocks = [ks[i:i+KB] for i in range(0, len(ks), KB)]
    fname = f"p{p}{tag}" + ("m" if mapfused else "")
    args = "double* pr, double* pi"
    if mapfused: args += ", const double* cr, const double* ci"
    e(f"static __attribute__((noinline)) void {fname}({args}){{")
    e.ind += 1
    def store_plain(k, r, i):
        e(f"VS(pr + {k*stride}, {r}); VS(pi + {k*stride}, {i});")
    def store_map(k, r, i):
        e(f"{{ V zr_ = VADD({r}, VL(cr + {k*cstride})), zi_ = VADD({i}, VL(ci + {k*cstride}));")
        e(f"  MAP2(zr_, zi_);")
        e(f"  VS(pr + {k*stride}, zr_); VS(pi + {k*stride}, zi_); }}")
    store_cb = store_map if mapfused else store_plain
    emit_prime_pass(e, p, stride, store_cb, mapfused)
    for blk in blocks:
        e("{")
        # init accumulators with x0 terms
        e(f"V x0r = VL(pr + 0), x0i = VL(pi + 0);") if False else None
        # NOTE: pr[0] was already overwritten by X0 store! Must keep x0 in scratch: store x0 into PSCR tail.
        e(f"V zAr[{len(blk)}], zAi[{len(blk)}], zDr[{len(blk)}], zEr[{len(blk)}];")
        e("}")
    e.ind -= 1
    e("}")
