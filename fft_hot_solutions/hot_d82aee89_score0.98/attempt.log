  "vfmadd231pd %%zmm30,%%zmm31,%%zmm10\n vfmadd231pd %%zmm30,%%zmm31,%%zmm11\n")
TP(16,
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm30,%%zmm31,%%zmm1\n"
