      "vfmadd231pd %%zmm30,%%zmm31,%%zmm8\n vfmadd231pd %%zmm30,%%zmm31,%%zmm9\n"
      "vfmadd231pd %%zmm30,%%zmm31,%%zmm10\n vfmadd231pd %%zmm30,%%zmm31,%%zmm11\n"
      ".endr\n"
      "dec %[i]\n jnz 1b\n":[i]"+r"(i)::"zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7","zmm8","zmm9","zmm10","zmm11");
    t1=rdtscp_();
    return (double)(t1-t0)/iters/24;
}
// ymm FMA throughput
__attribute__((noinline)) double fma_tp_ymm(long iters){
    uint64_t t0,t1; long i=iters;
    t0=rdtscp_();
    asm volatile("1:\n"
      ".rept 2\n"
