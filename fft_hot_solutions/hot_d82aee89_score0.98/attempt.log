"""Driver v2 for L=36: map fused into completing pass via st36_B2map."""
from glib import Emit
from gen36 import gen as gen_kernels

def gen_driver():
    e = Emit()
    e("""
static const long long IDXR_[8] ALIGN64 = {0,2,4,6,8,10,12,14};
static const long long IDXI_[8] ALIGN64 = {1,3,5,7,9,11,13,15};
static const long long IDXLO_[8] ALIGN64 = {0,8,1,9,2,10,3,11};
static const long long IDXHI_[8] ALIGN64 = {4,12,5,13,6,14,7,15};
#define PERM2(a,idx,b) _mm512_permutex2var_pd(a, _mm512_load_si512((const void*)idx), b)
#define PERM2Z(m,a,idx,b) _mm512_maskz_permutex2var_pd(m, a, _mm512_load_si512((const void*)idx), b)
""")
    e("static inline __attribute__((always_inline)) void row36_in(const double* s, double* pr, double* pi){")
    e.ind += 1
    for g in range(4):
        e(f"{{ V a=VLU(s+{g*16}), b=VLU(s+{g*16+8});")
        e(f"  VS(pr+{g*8}, PERM2(a, IDXR_, b)); VS(pi+{g*8}, PERM2(a, IDXI_, b)); }}")
    e("{ V a=VLU(s+64);")
    e("  VS(pr+32, PERM2Z(0x0F, a, IDXR_, a)); VS(pi+32, PERM2Z(0x0F, a, IDXI_, a)); }")
    e.ind -= 1
    e("}")

    # completing pass with fused map: vertical DFT over rows spaced `stride`, then B2map.
    # cbase: natural c pointer for (row k=0, this chunk); sitestep: natural site step per row-index k
    e("""
static inline __attribute__((always_inline)) void dft36_map(double* pr, double* pi, long stride,
        const double* cbase, double* o1, double* om, long sitestep, int tail){
    st36_A(pr, pi, stride); st36_B1();
    st36_B2map(pr, pi, stride, cbase, o1, om, sitestep, tail);
}

// SyX sweep: slab fixed y0, rows x (stride PS36), chunks over z.
// completing X-pass with map; then optional pre: zpass (bundles of x-rows) + X-pass.
static void sweep36_SyX(int y0, const double* cvol, double* o1, double* om, int pre){
    double* br = ARENA36_R + (long)y0*RS36;
    double* bi = ARENA36_I + (long)y0*RS36;
    for (int ch = 0; ch < 5; ch++) {
        long so = (long)y0*36 + ch*8;   // natural site offset of (x=0,y0,z=ch*8)
        dft36_map(br + ch*8, bi + ch*8, PS36, cvol + 2*so,
                  o1 ? o1 + 2*so : 0, om ? om + 2*so : 0, 1296, ch==4);
    }
    if (pre) {
        for (int b = 0; b < 5; b++) zpass36_bundle(br + (long)b*8*PS36, bi + (long)b*8*PS36, PS36, b<4?8:4);
        for (int ch = 0; ch < 5; ch++) dft36_vert(br + ch*8, bi + ch*8, PS36);
    }
}
// PxY sweep: plane fixed x0, rows y (stride RS36)
static void sweep36_PxY(int x0, const double* cvol, double* o1, double* om, int pre){
    double* br = ARENA36_R + (long)x0*PS36;
    double* bi = ARENA36_I + (long)x0*PS36;
    for (int ch = 0; ch < 5; ch++) {
        long so = (long)x0*1296 + ch*8;
        dft36_map(br + ch*8, bi + ch*8, RS36, cvol + 2*so,
                  o1 ? o1 + 2*so : 0, om ? om + 2*so : 0, 36, ch==4);
    }
    if (pre) {
        for (int b = 0; b < 5; b++) zpass36_bundle(br + (long)b*8*RS36, bi + (long)b*8*RS36, RS36, b<4?8:4);
        for (int ch = 0; ch < 5; ch++) dft36_vert(br + ch*8, bi + ch*8, RS36);
    }
}

void run_36(const double* x0, const double* c, double* out1, double* outm, long B, long m){
    if (m < 1) m = 1;
    for (long b = 0; b < B; b++) {
        const double* xv = x0 + b*2*46656;
        const double* cv = c + b*2*46656;
        double* o1 = out1 + b*2*46656;
        double* om = outm + b*2*46656;
        for (int x = 0; x < 36; x++)
            for (int y = 0; y < 36; y++)
                row36_in(xv + ((long)x*36+y)*72, ARENA36_R + (long)x*PS36 + y*RS36,
                         ARENA36_I + (long)x*PS36 + y*RS36);
        for (int x = 0; x < 36; x++) {
            double* br = ARENA36_R + (long)x*PS36; double* bi = ARENA36_I + (long)x*PS36;
            for (int bnd = 0; bnd < 5; bnd++) zpass36_bundle(br + (long)bnd*8*RS36, bi + (long)bnd*8*RS36, RS36, bnd<4?8:4);
            for (int ch = 0; ch < 5; ch++) dft36_vert(br + ch*8, bi + ch*8, RS36);
        }
        for (long t = 1; t <= m; t++) {
            double* o1t = (t==1) ? o1 : 0;
            double* omt = (t==m) ? om : 0;
            int pre = (t < m);
            if (t & 1) { for (int y0 = 0; y0 < 36; y0++) sweep36_SyX(y0, cv, o1t, omt, pre); }
            else       { for (int xp = 0; xp < 36; xp++) sweep36_PxY(xp, cv, o1t, omt, pre); }
        }
    }
}
""")
    return e.text()

def gen_all():
    from glib import PRELUDE
    return PRELUDE + gen_kernels() + gen_driver()

if __name__ == "__main__":
    open("../impl36.c","w").write(gen_all())
    print("wrote impl36.c")
