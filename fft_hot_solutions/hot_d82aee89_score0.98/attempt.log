    t1=rdtscp_();
    return (double)(t1-t0)/iters/24;
}
int main(){
    long it=500000;
    for (int round=0; round<3; round++){
        double a=1e18,b=1e18,c=1e18,d=1e18,e=1e18;
        for(int r=0;r<7;r++){
            double x=imul_chain(it); if(x<a)a=x;
            x=fma_chain(it); if(x<b)b=x;
            x=fma_tp(it); if(x<c)c=x;
            x=fma_tp_ymm(it); if(x<d)d=x;
