"""L=36 engine: within-volume split re/im, padded rows (36->40), one-sweep-per-step.
PFA 4x9 DFT36 (no twiddles). Sweeps alternate Sy (X+map, pre Z,X) / Px (Y+map, pre Z,Y).
"""
import numpy as np
from glib import Emit, trig, hexd

L = 36
RS = 40            # padded row length (z)
PS = 36*RS         # plane stride (doubles)
NCH = 5            # z-chunks per row

def crt_maps():
    # input: n = (9*n1 + 4*n2) % 36 ; output k = (9*k1 + 28*k2) % 36
    inp = [[(9*n1 + 4*n2) % 36 for n1 in range(4)] for n2 in range(9)]
    out = [[(9*k1 + 28*k2) % 36 for k2 in range(9)] for k1 in range(4)]
    return inp, out

def emit_dft4(e, xin, xout):
    # xin/xout: lists of 4 (re,im) C exprs (V values); emits vops
    (a_r,a_i),(b_r,b_i),(c_r,c_i),(d_r,d_i) = xin
    e(f"{{ V t0r=VADD({a_r},{c_r}), t0i=VADD({a_i},{c_i});")
    e(f"  V t1r=VSUB({a_r},{c_r}), t1i=VSUB({a_i},{c_i});")
    e(f"  V t2r=VADD({b_r},{d_r}), t2i=VADD({b_i},{d_i});")
    e(f"  V t3r=VSUB({b_r},{d_r}), t3i=VSUB({b_i},{d_i});")
    o = xout
    e(f"  {o[0][0]}=VADD(t0r,t2r); {o[0][1]}=VADD(t0i,t2i);")
    e(f"  {o[2][0]}=VSUB(t0r,t2r); {o[2][1]}=VSUB(t0i,t2i);")
    # X1 = t1 - i*t3 (forward DFT, w = e^{-2pi i k/4}: X1 = t1 + w4^1*t3 = t1 - i t3)
    e(f"  {o[1][0]}=VADD(t1r,t3i); {o[1][1]}=VSUB(t1i,t3r);")
    e(f"  {o[3][0]}=VSUB(t1r,t3i); {o[3][1]}=VADD(t1i,t3r);")
    e("}")

def emit_dft3(e, xin, xout, pfx):
    # DFT3: X0 = x0+x1+x2; X1 = x0 + w*x1 + w^2*x2, w = e^{-2pi i/3} = (-1/2, -s3) s3=sqrt(3)/2
    (a_r,a_i),(b_r,b_i),(c_r,c_i) = xin
    o = xout
    e(f"{{ V ur=VADD({b_r},{c_r}), ui=VADD({b_i},{c_i});")
    e(f"  V vr=VSUB({b_r},{c_r}), vi=VSUB({b_i},{c_i});")
    e(f"  V sr=VFMA(ur,VSET1(-0.5),{a_r}), si=VFMA(ui,VSET1(-0.5),{a_i});")
    e(f"  {o[0][0]}=VADD({a_r},ur); {o[0][1]}=VADD({a_i},ui);")
    # X1 = s - i*s3*v ; X2 = s + i*s3*v   [w=-1/2 - i s3]
    e(f"  {o[1][0]}=VFMA(vi,VSET1({hexd(np.sqrt(np.longdouble(3))/2)}),sr);")
    e(f"  {o[1][1]}=VFNMA(vr,VSET1({hexd(np.sqrt(np.longdouble(3))/2)}),si);")
    e(f"  {o[2][0]}=VFNMA(vi,VSET1({hexd(np.sqrt(np.longdouble(3))/2)}),sr);")
    e(f"  {o[2][1]}=VFMA(vr,VSET1({hexd(np.sqrt(np.longdouble(3))/2)}),si);")
    e("}")

def emit_dft9(e, xin, xout):
    """DFT9 via CT 3x3: n = 3*n1 + n2 ; X[k2*3 + k1]..., twiddles w9^{n2*k1}"""
    cs = trig(9)
    # stage 1: for n2 in 0..2: DFT3 over n1 of x[3*n1+n2] -> y[n2][k1]
    names = []
    for n2 in range(3):
        trip = [xin[3*n1 + n2] for n1 in range(3)]
        outs = [(f"y{n2}{k}r", f"y{n2}{k}i") for k in range(3)]
        names.append(outs)
        e(f"V " + ", ".join(f"{r}, {i}" for r,i in outs) + ";")
        emit_dft3(e, trip, outs, f"s9a{n2}")
    # twiddle y[n2][k1] *= w9^{n2*k1}, nontrivial for n2,k1 in {1,2}
    for n2 in (1,2):
        for k1 in (1,2):
            t = (n2*k1) % 9
            wr, wi = cs[t]
            r, i = names[n2][k1]
            e(f"{{ V tr=VFNMA({i},VSET1({hexd(wi)}),VMUL({r},VSET1({hexd(wr)})));")
            e(f"  {i}=VFMA({r},VSET1({hexd(wi)}),VMUL({i},VSET1({hexd(wr)}))); {r}=tr; }}")
    # stage 2: for k1: DFT3 over n2 of y[n2][k1] -> X[3*k2 + k1]
    for k1 in range(3):
        trip = [names[n2][k1] for n2 in range(3)]
        outs = [xout[3*k2 + k1] for k2 in range(3)]
        emit_dft3(e, trip, outs, f"s9b{k1}")

def emit_dft36_vert(e, addr, stride_expr, scratch="SCR36"):
    """Two-stage PFA 4x9 DFT36 on rows addressed addr(j) (re) / addr(j)+IMOFF... We'll
    parametrize: addr gives (re_ptr_expr, im_ptr_expr) for row j at current chunk."""
    inp, out = crt_maps()
    # stage A: 9 DFT4 groups; write scratch[g*4+n1]
    for g in range(9):
        rows = inp[g]
        e(f"{{ // DFT4 g={g} rows {rows}")
        xin = []
        for t, j in enumerate(rows):
            re, im = addr(j)
            e(f"V a{t}r = VL({re}), a{t}i = VL({im});")
            xin.append((f"a{t}r", f"a{t}i"))
        xo = [(f"o{t}r", f"o{t}i") for t in range(4)]
        e("V " + ", ".join(f"{r}, {i}" for r,i in xo) + ";")
        emit_dft4(e, xin, xo)
        for n1 in range(4):
            e(f"VS({scratch} + {(g*4+n1)*16}, o{n1}r); VS({scratch} + {(g*4+n1)*16 + 8}, o{n1}i);")
        e("}")
    # stage B: 4 DFT9 over g for fixed k1(=n1 index); write back rows out[k1][k2]
    for k1 in range(4):
        e(f"{{ // DFT9 k1={k1}")
        xin = []
        for g in range(9):
            e(f"V b{g}r = VL({scratch} + {(g*4+k1)*16}), b{g}i = VL({scratch} + {(g*4+k1)*16+8});")
            xin.append((f"b{g}r", f"b{g}i"))
        xo = [(f"X{t}r", f"X{t}i") for t in range(9)]
        e("V " + ", ".join(f"{r}, {i}" for r,i in xo) + ";")
        emit_dft9(e, xin, xo)
        for k2 in range(9):
            k = out[k1][k2]
            re, im = addr(k)
            e(f"VS({re}, X{k2}r); VS({im}, X{k2}i);")
        e("}")

def gen():
    e = Emit()
    e(f"// ---------------- L=36 engine ----------------")
    e(f"#define RS36 {RS}")
    e(f"#define PS36 {PS}")
    e(f"static double ARENA36_R[{36*PS}] ALIGN64;")
    e(f"static double ARENA36_I[{36*PS}] ALIGN64;")
    e(f"static double SCR36A[{36*16}] ALIGN64;")   # stage scratch: 36 groups x (8re+8im)
    e(f"static double ZSCR36_R[{40*8}] ALIGN64;")  # z-major scratch for Z-pass (40 z x 8 lanes)
    e(f"static double ZSCR36_I[{40*8}] ALIGN64;")
    # ---- vertical DFT36 over rows spaced `stride` doubles, at chunk base p (re) q (im)
    e("static inline __attribute__((always_inline)) void dft36_vert(double* pr, double* pi, long stride){")
    e.ind += 1
    emit_dft36_vert(e, lambda j: (f"pr + {j}*stride", f"pi + {j}*stride"), scratch="SCR36A")
    e.ind -= 1
    e("}")
    # ---- Z-pass on a bundle of <=8 rows (contiguous z within row): transpose, DFT, transpose back
    # rows given by base pointers array rp/ipp (8 entries; dead rows -> point at zero row? we pass nrows)
    e("""
// transpose 8x8 tile of doubles held in 8 zmm
#define TR8(r0,r1,r2,r3,r4,r5,r6,r7) do { \\
    V u0=_mm512_unpacklo_pd(r0,r1), u1=_mm512_unpackhi_pd(r0,r1); \\
    V u2=_mm512_unpacklo_pd(r2,r3), u3=_mm512_unpackhi_pd(r2,r3); \\
    V u4=_mm512_unpacklo_pd(r4,r5), u5=_mm512_unpackhi_pd(r4,r5); \\
    V u6=_mm512_unpacklo_pd(r6,r7), u7=_mm512_unpackhi_pd(r6,r7); \\
    V s0=_mm512_shuffle_f64x2(u0,u2,0x88), s1=_mm512_shuffle_f64x2(u1,u3,0x88); \\
    V s2=_mm512_shuffle_f64x2(u0,u2,0xdd), s3=_mm512_shuffle_f64x2(u1,u3,0xdd); \\
    V s4=_mm512_shuffle_f64x2(u4,u6,0x88), s5=_mm512_shuffle_f64x2(u5,u7,0x88); \\
    V s6=_mm512_shuffle_f64x2(u4,u6,0xdd), s7=_mm512_shuffle_f64x2(u5,u7,0xdd); \\
    r0=_mm512_shuffle_f64x2(s0,s4,0x88); r4=_mm512_shuffle_f64x2(s0,s4,0xdd); \\
    r1=_mm512_shuffle_f64x2(s1,s5,0x88); r5=_mm512_shuffle_f64x2(s1,s5,0xdd); \\
    r2=_mm512_shuffle_f64x2(s2,s6,0x88); r6=_mm512_shuffle_f64x2(s2,s6,0xdd); \\
    r3=_mm512_shuffle_f64x2(s3,s7,0x88); r7=_mm512_shuffle_f64x2(s3,s7,0xdd); \\
} while(0)
""")
    e("static inline __attribute__((always_inline)) void zpass36_bundle(double* pr, double* pi, long rstride, int nrows){")
    e.ind += 1
    e("// transpose-in: 5 tiles of (8 rows x 8 z) -> ZSCR (z-major, lanes = rows)")
    e("for (int t = 0; t < 5; t++) {")
    e.ind += 1
    e("V r0,r1,r2,r3,r4,r5,r6,r7;")
    for ch in "RI":
        arr = "pr" if ch=="R" else "pi"
        dst = "ZSCR36_R" if ch=="R" else "ZSCR36_I"
        for k in range(8):
            e(f"r{k} = (nrows > {k}) ? VL({arr} + {k}*rstride + t*8) : _mm512_setzero_pd();")
        e("TR8(r0,r1,r2,r3,r4,r5,r6,r7);")
        for k in range(8):
            e(f"VS({dst} + (t*8+{k})*8, r{k});")
    e.ind -= 1
    e("}")
    e("// DFT36 on z-major scratch (stride 8 doubles)")
    e("dft36_vert(ZSCR36_R, ZSCR36_I, 8);")
    e("// transpose-out")
    e("for (int t = 0; t < 5; t++) {")
    e.ind += 1
    e("V r0,r1,r2,r3,r4,r5,r6,r7;")
    for ch in "RI":
        arr = "pr" if ch=="R" else "pi"
        src = "ZSCR36_R" if ch=="R" else "ZSCR36_I"
        for k in range(8):
            e(f"r{k} = VL({src} + (t*8+{k})*8);")
        e("TR8(r0,r1,r2,r3,r4,r5,r6,r7);")
        for k in range(8):
            e(f"if (nrows > {k}) VS({arr} + {k}*rstride + t*8, r{k});")
    e.ind -= 1
    e("}")
    e.ind -= 1
    e("}")
    return e.text()

if __name__ == "__main__":
    print(gen())
