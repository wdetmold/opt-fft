The map is the cost center (~16.5 tsc/zmm-site fused). Let me microbenchmark map variants standalone to find the fastest embodiment:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/mb && cat > mapbench.c <<'EOF'
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <immintrin.h>
#include <x86intrin.h>
typedef __m512d V;
#define VL(p) _mm512_load_pd(p)
#define VS(p,v) _mm512_store_pd(p,v)
#define VADD _mm512_add_pd
#define VSUB _mm512_sub_pd
#define VMUL _mm512_mul_pd
#define VFMA _mm512_fmadd_pd
#define VFNMA _mm512_fnmadd_pd
#define VSET1 _mm512_set1_pd
static inline uint64_t T(){ unsigned a; return __rdtscp(&a); }
static double ZR[4096] __attribute__((aligned(64)));
static double ZI[4096] __attribute__((aligned(64)));
static double CR[4096] __attribute__((aligned(64)));
static double CI[4096] __attribute__((aligned(64)));

// variant A: rsqrt14 + 2N, rcp14 + 2N (current MAP2)
__attribute__((noinline)) void mapA(long n8){
    for (long i = 0; i < n8; i++){
        V zr = VL(ZR+i*8), zi = VL(ZI+i*8);
        zr = VADD(zr, VL(CR+i*8)); zi = VADD(zi, VL(CI+i*8));
        V s = VFMA(zr, zr, VMUL(zi, zi));
        V r = _mm512_rsqrt14_pd(s);
        V h = VMUL(s, VSET1(0.5));
        V e = VFNMA(VMUL(r,r), h, VSET1(0.5));
        r = VFMA(r, e, r);
        e = VFNMA(VMUL(r,r), h, VSET1(0.5));
        r = VFMA(r, e, r);
        V m = VMUL(s, r);
        V u = VADD(VSET1(1.0), m);
        V q = _mm512_rcp14_pd(u);
        V t = VFNMA(u, q, VSET1(1.0));
        q = VFMA(q, t, q);
        t = VFNMA(u, q, VSET1(1.0));
        q = VFMA(q, t, q);
        VS(ZR+i*8, VMUL(zr, q)); VS(ZI+i*8, VMUL(zi, q));
    }
}
// variant B: float-seeded (one cvt roundtrip for both seeds)
__attribute__((noinline)) void mapB(long n8){
    for (long i = 0; i < n8; i++){
        V zr = VL(ZR+i*8), zi = VL(ZI+i*8);
        zr = VADD(zr, VL(CR+i*8)); zi = VADD(zi, VL(CI+i*8));
        V s = VFMA(zr, zr, VMUL(zi, zi));
        __m256 sf = _mm512_cvtpd_ps(s);
        __m256 rf = _mm256_rsqrt_ps(sf);
        __m256 mf = _mm256_mul_ps(sf, rf);
        __m256 uf = _mm256_add_ps(mf, _mm256_set1_ps(1.0f));
        __m256 qf = _mm256_rcp_ps(uf);
        V r = _mm512_cvtps_pd(rf);
        V q = _mm512_cvtps_pd(qf);
        V h = VMUL(s, VSET1(0.5));
        V e = VFNMA(VMUL(r,r), h, VSET1(0.5));
        r = VFMA(r, e, r);
        e = VFNMA(VMUL(r,r), h, VSET1(0.5));
        r = VFMA(r, e, r);
        e = VFNMA(VMUL(r,r), h, VSET1(0.5));
        r = VFMA(r, e, r);
        V m = VMUL(s, r);
        V u = VADD(VSET1(1.0), m);
        V t = VFNMA(u, q, VSET1(1.0));
        q = VFMA(q, t, q);
        t = VFNMA(u, q, VSET1(1.0));
        q = VFMA(q, t, q);
        VS(ZR+i*8, VMUL(zr, q)); VS(ZI+i*8, VMUL(zi, q));
    }
}
// variant C: like A but 2 sites interleaved manually
__attribute__((noinline)) void mapC(long n8){
    for (long i = 0; i < n8; i += 2){
#define ONE(k, zr, zi, q) \
        V zr = VL(ZR+(i+k)*8), zi = VL(ZI+(i+k)*8); \
        zr = VADD(zr, VL(CR+(i+k)*8)); zi = VADD(zi, VL(CI+(i+k)*8)); \
        V s##k = VFMA(zr, zr, VMUL(zi, zi)); \
        V r##k = _mm512_rsqrt14_pd(s##k); \
        V h##k = VMUL(s##k, VSET1(0.5)); \
        V e##k = VFNMA(VMUL(r##k,r##k), h##k, VSET1(0.5)); \
        r##k = VFMA(r##k, e##k, r##k); \
        e##k = VFNMA(VMUL(r##k,r##k), h##k, VSET1(0.5)); \
        r##k = VFMA(r##k, e##k, r##k); \
        V m##k = VMUL(s##k, r##k); \
        V u##k = VADD(VSET1(1.0), m##k); \
        V q = _mm512_rcp14_pd(u##k); \
        V t##k = VFNMA(u##k, q, VSET1(1.0)); \
        q = VFMA(q, t##k, q); \
        t##k = VFNMA(u##k, q, VSET1(1.0)); \
        q = VFMA(q, t##k, q);
        ONE(0, zr0, zi0, q0)
        ONE(1, zr1, zi1, q1)
#undef ONE
        VS(ZR+i*8, VMUL(zr0, q0)); VS(ZI+i*8, VMUL(zi0, q0));
        VS(ZR+(i+1)*8, VMUL(zr1, q1)); VS(ZI+(i+1)*8, VMUL(zi1, q1));
    }
}
int main(){
    for (int i=0;i<4096;i++){ ZR[i]=0.3+i*1e-5; ZI[i]=-0.2+i*2e-5; CR[i]=0.05; CI[i]=-0.03; }
    long it=30000, n8=64;  // 512 sites
    uint64_t t0,t1; double best;
    struct {const char*n; void(*f)(long);} TT[]={{"A rsqrt14/rcp14 seq",mapA},{"B float-seed",mapB},{"C 14-series x2",mapC}};
    for (int v=0;v<3;v++){
        best=1e18;
        for (int r=0;r<9;r++){ t0=T(); for(long k=0;k<it/10;k++) TT[v].f(n8); t1=T(); double d=(double)(t1-t0)/(it/10)/n8; if(d<best)best=d; }
        printf("%s: %6.2f tsc/zmm-site (%5.3f tsc/site)\n", TT[v].n, best, best/8);
    }
    return 0;
}
EOF
