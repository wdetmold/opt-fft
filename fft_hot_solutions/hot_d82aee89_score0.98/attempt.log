FMA latency/throughput need careful separation. Let me write a cleaner probe:

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cat > /tmp/w/mb/mb3.c <<'EOF'
#include <stdio.h>
#include <stdint.h>
#include <immintrin.h>
#include <x86intrin.h>
static inline uint64_t rdtscp_() { unsigned a; return __rdtscp(&a); }

// latency: single chain, 16 FMAs per iter
__attribute__((noinline)) double lat(long iters){
    uint64_t t0,t1; long i=iters;
    t0=rdtscp_();
    asm volatile(
      "vpxorq %%zmm0,%%zmm0,%%zmm0\n"
      "1:\n"
      ".rept 16\n vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n .endr\n"
      "dec %[i]\n jnz 1b\n"
      : [i]"+r"(i) :: "zmm0","zmm30","zmm31");
    t1=rdtscp_();
    return (double)(t1-t0)/iters/16;   // tsc per serial FMA
}
// throughput with N accumulators, 1 FMA per acc per block
#define TP(N, LIST) \
__attribute__((noinline)) double tp##N(long iters){ \
    uint64_t t0,t1; long i=iters; \
    t0=rdtscp_(); \
    asm volatile( \
      "1:\n" \
      ".rept 4\n" LIST ".endr\n" \
      "dec %[i]\n jnz 1b\n" \
      : [i]"+r"(i) :: "zmm0","zmm1","zmm2","zmm3","zmm4","zmm5","zmm6","zmm7", \
        "zmm8","zmm9","zmm10","zmm11","zmm12","zmm13","zmm14","zmm15"); \
    t1=rdtscp_(); \
    return (double)(t1-t0)/iters/(4*N); }

TP(8,
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm30,%%zmm31,%%zmm1\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vfmadd231pd %%zmm30,%%zmm31,%%zmm5\n"
  "vfmadd231pd %%zmm30,%%zmm31,%%zmm6\n vfmadd231pd %%zmm30,%%zmm31,%%zmm7\n")
