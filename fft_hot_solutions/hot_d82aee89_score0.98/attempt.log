    getattr(mine, f'run_{L}').argtypes = [ctypes.c_void_p]*4 + [ctypes.c_long]*2
    getattr(b00, f'run_{L}').argtypes = [ctypes.c_void_p]*4 + [ctypes.c_long]*2
def call(eng, L, B, m, px, pc, p1, pm):
    getattr(mine if eng=="mine" else b00, f"run_{L}")(px, pc, p1, pm, B, m)
