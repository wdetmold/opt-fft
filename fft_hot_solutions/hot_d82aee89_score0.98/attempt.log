import sys, time, os
import numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import solution, base

_SIZES = (6, 8, 13, 17, 23, 36, 45, 64)
def check(params, name, do_ref=True):
    t0 = time.perf_counter(); got = solution.transform(*params); t1 = time.perf_counter()
    if not do_ref:
        print(f"{name}: mine={t1-t0:.3f}s"); return t1-t0
    ref = base.transform(*params)
    Bs = params[1:9]; off = 0; ok=True; worst1=worstm=0
    for i, L in enumerate(_SIZES):
        n = Bs[i]*L**3
        for which in range(2):
            g = got[off:off+n]; r = ref[off:off+n]
            e = np.linalg.norm(g-r)/max(np.linalg.norm(r),1e-300) if n else 0
            lims = {0:1e-14}
            limm = {6:1e-4,8:3e-6,13:1e-9,17:1e-10,23:1e-10,36:1e-10,45:1e-10,64:1e-10}
            lim = 1e-14 if which==0 else limm[L]
            if which==0: worst1=max(worst1,e)
            else: worstm=max(worstm,e)
            if e >= lim: ok=False; print(f"  FAIL L={L} blk{which} err={e:.2e}")
            off += n
    print(f"{name}: mine={t1-t0:.3f}s worst1={worst1:.2e} worstm={worstm:.2e} {'OK' if ok else 'FAIL'}")
    return t1-t0

if __name__ == '__main__':
    check((7, 64, 48, 24, 16, 8, 4, 2, 1) + (10,)*8, "balanced m=10")
    check((123, 8, 8, 8, 8, 8, 8, 8, 8) + (5,)*8, "uniform B=8 m=5")
    check((5, 200, 100, 40, 20, 10, 3, 2, 1) + (30, 25, 20, 15, 12, 10, 8, 6), "mixed")
    check((99, 1, 1, 1, 1, 1, 1, 1, 1) + (1,)*8, "B=1 m=1")
    check((31, 9, 7, 5, 3, 2, 1, 1, 1) + (2, 3, 1, 2, 4, 1, 2, 3), "small odd")
EOF
cd /tmp/w/b00 && taskset -c 0 python3 check.py</antml:parameter>
