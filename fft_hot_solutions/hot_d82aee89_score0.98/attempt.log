}
__attribute__((noinline)) double fma_tp(long iters){
    uint64_t t0,t1; long i=iters;
    t0=rdtscp_();
    asm volatile("1:\n"
      ".rept 2\n"
      "vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n vfmadd231pd %%zmm30,%%zmm31,%%zmm1\n"
      "vfmadd231pd %%zmm30,%%zmm31,%%zmm2\n vfmadd231pd %%zmm30,%%zmm31,%%zmm3\n"
      "vfmadd231pd %%zmm30,%%zmm31,%%zmm4\n vfmadd231pd %%zmm30,%%zmm31,%%zmm5\n"
