<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/mb && cat >> mapbench.c <<'EOF'
// variant D: b00-style (1 Newton rsqrt + Heron in sqrt domain; quartic rcp)
__attribute__((noinline)) void mapD(long n8){
    const V VHALF = VSET1(0.5), VONE = VSET1(1.0), TINY = VSET1(1e-30);
    for (long i = 0; i < n8; i++){
        V zr = VL(ZR+i*8), zi = VL(ZI+i*8);
        zr = VADD(zr, VL(CR+i*8)); zi = VADD(zi, VL(CI+i*8));
        V m  = VFMA(zr, zr, VFMA(zi, zi, TINY));
        V r0 = _mm512_rsqrt14_pd(m);
        V t  = VMUL(m, r0);
        V hr = VMUL(r0, VHALF);
        V eh = VFNMA(t, hr, VHALF);
        V r1 = VFMA(r0, eh, r0);
        V mg0= VMUL(m, r1);
        V hr1= VMUL(r1, VHALF);
        V e2 = VFNMA(mg0, mg0, m);
        V mag= VFMA(e2, hr1, mg0);
        V u  = VADD(VONE, mag);
        V w0 = _mm512_rcp14_pd(u);
        V e3 = VFNMA(u, w0, VONE);
        V a  = VFMA(w0, e3, w0);
        V ee = VMUL(e3, e3);
        V w2 = VFMA(a, ee, a);
        VS(ZR+i*8, VMUL(zr, w2)); VS(ZI+i*8, VMUL(zi, w2));
    }
}
EOF
