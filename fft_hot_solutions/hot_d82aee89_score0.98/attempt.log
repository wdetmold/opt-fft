        }}
        for (int x = 0; x < {L}; x++) {{
            long b0 = (long)x*{XS};
            p{L}_zz(S{L}RE + b0, S{L}IM + b0, {L}*{L}, 8);   // wrong: z-pencils per (x,y): base x*XS + y*L*8 stride 8... zz with n={L} per y
        }}
