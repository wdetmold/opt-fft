import numpy as np
import solution, base
_SIZES = (6, 8, 13, 17, 23, 36, 45, 64)
tols = {6:1e-4, 8:3e-6, 13:1e-9, 17:1e-10, 23:1e-10, 36:1e-10, 45:1e-10, 64:1e-10}
rng = np.random.default_rng(99)
fails = 0
for trial in range(12):
    seed = int(rng.integers(0, 100000))
    Bs = [int(rng.integers(0, hi+1)) for hi in (40, 30, 22, 18, 12, 10, 9, 5)]
    ms = [int(rng.integers(1, 16)) for _ in range(8)]
    p = (seed, *Bs, *ms)
    got = solution.transform(*p)
    ref = base.transform(*p)
    off = 0
    for i, L in enumerate(_SIZES):
        n = Bs[i]*L**3
        for which in range(2):
            g = got[off:off+n]; r = ref[off:off+n]
            if n:
                e = np.linalg.norm(g-r)/np.linalg.norm(r)
                lim = 1e-14 if which==0 else tols[L]
                if e >= lim:
                    fails += 1
                    print(f"FAIL trial {trial} L={L} blk{which} B={Bs[i]} m={ms[i]} err={e:.2e}")
            off += n
    print(f"trial {trial} done", flush=True)
print("QA2 fails:", fails)
