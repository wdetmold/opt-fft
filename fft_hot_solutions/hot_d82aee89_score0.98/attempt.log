Installed. Now attack the universal map cost with a parallel-seed variant (rcp14 seed computed from the rsqrt seed, off the critical path):

<antml:function_calls>
<antml:invoke name="bash">
<antml:parameter name="command">cd /tmp/w/mb && cat > mapbench2.c <<'EOF'
#include <stdio.h>
#include <stdint.h>
#include <immintrin.h>
#include <x86intrin.h>
typedef __m512d V;
#define VL(p) _mm512_load_pd(p)
#define VS(p,v) _mm512_store_pd(p,v)
#define VADD _mm512_add_pd
#define VSUB _mm512_sub_pd
#define VMUL _mm512_mul_pd
#define VFMA _mm512_fmadd_pd
#define VFNMA _mm512_fnmadd_pd
#define VSET1 _mm512_set1_pd
static inline uint64_t T(){ unsigned a; return __rdtscp(&a); }
static double ZR[4096] __attribute__((aligned(64)));
static double ZI[4096] __attribute__((aligned(64)));
static double CR[4096] __attribute__((aligned(64)));
static double CI[4096] __attribute__((aligned(64)));
// E: parallel q-seed + b00-style sqrt (Heron) ; 2 q-Newtons
static __attribute__((noinline)) void mapE(long n8){
    const V VHALF = VSET1(0.5), VONE = VSET1(1.0), TINY = VSET1(1e-30);
    for (long i = 0; i < n8; i++){
        V zr = VL(ZR+i*8), zi = VL(ZI+i*8);
        zr = VADD(zr, VL(CR+i*8)); zi = VADD(zi, VL(CI+i*8));
        V m  = VFMA(zr, zr, VFMA(zi, zi, TINY));
        V r0 = _mm512_rsqrt14_pd(m);
        V u0 = VFMA(m, r0, VONE);           // approx 1+sqrt(m) (err ~2^-14)
        V q0 = _mm512_rcp14_pd(u0);         // parallel seed (err ~2^-13)
        V t  = VMUL(m, r0);
        V hr = VMUL(r0, VHALF);
        V eh = VFNMA(t, hr, VHALF);
        V r1 = VFMA(r0, eh, r0);
        V mg0= VMUL(m, r1);
        V hr1= VMUL(r1, VHALF);
        V e2 = VFNMA(mg0, mg0, m);
        V mag= VFMA(e2, hr1, mg0);
        V u  = VADD(VONE, mag);
        V e3 = VFNMA(u, q0, VONE);
        V q1 = VFMA(q0, e3, q0);
        V e4 = VFNMA(u, q1, VONE);
        V q2 = VFMA(q1, e4, q1);
        VS(ZR+i*8, VMUL(zr, q2)); VS(ZI+i*8, VMUL(zi, q2));
    }
}
// F: E with 2-site interleave
static __attribute__((noinline)) void mapF(long n8){
    const V VHALF = VSET1(0.5), VONE = VSET1(1.0), TINY = VSET1(1e-30);
    for (long i = 0; i < n8; i += 2){
#define ONE(k) \
        V zr##k = VL(ZR+(i+k)*8), zi##k = VL(ZI+(i+k)*8); \
        zr##k = VADD(zr##k, VL(CR+(i+k)*8)); zi##k = VADD(zi##k, VL(CI+(i+k)*8)); \
        V m##k  = VFMA(zr##k, zr##k, VFMA(zi##k, zi##k, TINY)); \
        V r0##k = _mm512_rsqrt14_pd(m##k); \
        V u0##k = VFMA(m##k, r0##k, VONE); \
        V q0##k = _mm512_rcp14_pd(u0##k); \
        V t##k  = VMUL(m##k, r0##k); \
        V hr##k = VMUL(r0##k, VHALF); \
        V eh##k = VFNMA(t##k, hr##k, VHALF); \
        V r1##k = VFMA(r0##k, eh##k, r0##k); \
        V mg##k= VMUL(m##k, r1##k); \
        V h1##k= VMUL(r1##k, VHALF); \
        V e2##k = VFNMA(mg##k, mg##k, m##k); \
        V mag##k= VFMA(e2##k, h1##k, mg##k); \
        V u##k  = VADD(VONE, mag##k); \
        V e3##k = VFNMA(u##k, q0##k, VONE); \
        V q1##k = VFMA(q0##k, e3##k, q0##k); \
        V e4##k = VFNMA(u##k, q1##k, VONE); \
        V q2##k = VFMA(q1##k, e4##k, q1##k); \
        VS(ZR+(i+k)*8, VMUL(zr##k, q2##k)); VS(ZI+(i+k)*8, VMUL(zi##k, q2##k));
        ONE(0)
        ONE(1)
#undef ONE
    }
}
int main(){
    for (int i=0;i<4096;i++){ ZR[i]=0.3+i*1e-5; ZI[i]=-0.2+i*2e-5; CR[i]=0.05; CI[i]=-0.03; }
    long it=30000, n8=64;
    struct {const char*n; void(*f)(long);} TT[]={{"E parallel-seed",mapE},{"F par-seed x2",mapF}};
    for (int v=0;v<2;v++){
        double best=1e18;
        for (int r=0;r<9;r++){ uint64_t t0=T(); for(long k=0;k<it/10;k++) TT[v].f(n8); uint64_t t1=T(); double d=(double)(t1-t0)/(it/10)/n8; if(d<best)best=d; }
        printf("%s: %6.2f tsc/zmm-site\n", TT[v].n, best);
    }
    // accuracy check vs exact
    mapE(64);
    double werr = 0;
    for (int i=0;i<512;i++){
        double zr = 0.3+i*1e-5+0.05, zi = -0.2+i*2e-5-0.03;
        double q = 1.0/(1.0+sqrt(zr*zr+zi*zi));
        double gr = ZR[i];
        // mapE already applied: ZR[i] = zr*q'
        double e = (gr - zr*q)/(zr*q);
        if (e<0) e=-e; if (e>werr) werr=e;
    }
    printf("max rel err vs exact: %.2e\n", werr);
    return 0;
}
EOF
