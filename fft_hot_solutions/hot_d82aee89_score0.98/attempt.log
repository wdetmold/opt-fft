"""Driver for L=36 engine."""
from glib import Emit
from gen36 import gen as gen_kernels, RS, PS

def gen_driver():
    e = Emit()
    e("""
static const long long IDXR_[8] ALIGN64 = {0,2,4,6,8,10,12,14};
static const long long IDXI_[8] ALIGN64 = {1,3,5,7,9,11,13,15};
static const long long IDXLO_[8] ALIGN64 = {0,8,1,9,2,10,3,11};
static const long long IDXHI_[8] ALIGN64 = {4,12,5,13,6,14,7,15};
#define PERM2(a,idx,b) _mm512_permutex2var_pd(a, _mm512_load_si512((const void*)idx), b)
#define PERM2Z(m,a,idx,b) _mm512_maskz_permutex2var_pd(m, a, _mm512_load_si512((const void*)idx), b)
""")
    # conv_in for one row of 36 complex from src (interleaved) to split padded row
    e("static inline __attribute__((always_inline)) void row36_in(const double* s, double* pr, double* pi){")
    e.ind += 1
    for g in range(4):
        e(f"{{ V a=VLU(s+{g*16}), b=VLU(s+{g*16+8});")
        e(f"  VS(pr+{g*8}, PERM2(a, IDXR_, b)); VS(pi+{g*8}, PERM2(a, IDXI_, b)); }}")
    e("{ V a=VLU(s+64);")
    e("  VS(pr+32, PERM2Z(0x0F, a, IDXR_, a)); VS(pi+32, PERM2Z(0x0F, a, IDXI_, a)); }")
    e.ind -= 1
    e("}")
    # map + optional snapshot for one row (36 sites); c from natural interleaved
    e("static inline __attribute__((always_inline)) void maprow36(double* pr, double* pi, const double* cs, double* o1, double* om){")
    e.ind += 1
    for g in range(5):
        n = 8 if g < 4 else 4
        e(f"{{ V zr=VL(pr+{g*8}), zi=VL(pi+{g*8});")
        if n == 8:
            e(f"  V a=VLU(cs+{g*16}), b=VLU(cs+{g*16+8});")
            e(f"  zr=VADD(zr, PERM2(a, IDXR_, b)); zi=VADD(zi, PERM2(a, IDXI_, b));")
        else:
            e(f"  V a=VLU(cs+{g*16});")
            e(f"  zr=VADD(zr, PERM2Z(0x0F, a, IDXR_, a)); zi=VADD(zi, PERM2Z(0x0F, a, IDXI_, a));")
        e(f"  MAP2(zr, zi);")
        e(f"  VS(pr+{g*8}, zr); VS(pi+{g*8}, zi);")
        e(f"  if (o1) {{")
        if n == 8:
            e(f"    VSU(o1+{g*16}, PERM2(zr, IDXLO_, zi)); VSU(o1+{g*16+8}, PERM2(zr, IDXHI_, zi));")
        else:
            e(f"    VSU(o1+{g*16}, PERM2(zr, IDXLO_, zi));")
        e(f"  }}")
        e(f"  if (om) {{")
        if n == 8:
            e(f"    VSU(om+{g*16}, PERM2(zr, IDXLO_, zi)); VSU(om+{g*16+8}, PERM2(zr, IDXHI_, zi));")
        else:
            e(f"    VSU(om+{g*16}, PERM2(zr, IDXLO_, zi));")
        e(f"  }}")
        e("}")
    e.ind -= 1
    e("}")

    # Sweep SyX: completes step via X on slab y0; map; optional pre Z,X
    e("static void sweep36_SyX(int y0, const double* cvol, double* o1, double* om, int pre){")
    e.ind += 1
    e(f"double* br = ARENA36_R + (long)y0*RS36; double* bi = ARENA36_I + (long)y0*RS36;")
    e("for (int ch = 0; ch < 5; ch++) dft36_vert(br + ch*8, bi + ch*8, PS36);")
    e("for (int x = 0; x < 36; x++) {")
    e.ind += 1
    e("long site = ((long)x*36 + y0)*36;")
    e("maprow36(br + (long)x*PS36, bi + (long)x*PS36, cvol + 2*site, o1 ? o1 + 2*site : 0, om ? om + 2*site : 0);")
    e.ind -= 1
    e("}")
    e("if (pre) {")
    e.ind += 1
    e("for (int b = 0; b < 5; b++) zpass36_bundle(br + (long)b*8*PS36, bi + (long)b*8*PS36, PS36, b<4?8:4);")
    e("for (int ch = 0; ch < 5; ch++) dft36_vert(br + ch*8, bi + ch*8, PS36);")
    e.ind -= 1
    e("}")
    e.ind -= 1
    e("}")
    # Sweep PxY
    e("static void sweep36_PxY(int x0, const double* cvol, double* o1, double* om, int pre){")
    e.ind += 1
    e(f"double* br = ARENA36_R + (long)x0*PS36; double* bi = ARENA36_I + (long)x0*PS36;")
    e("for (int ch = 0; ch < 5; ch++) dft36_vert(br + ch*8, bi + ch*8, RS36);")
    e("for (int y = 0; y < 36; y++) {")
    e.ind += 1
    e("long site = ((long)x0*36 + y)*36;")
    e("maprow36(br + (long)y*RS36, bi + (long)y*RS36, cvol + 2*site, o1 ? o1 + 2*site : 0, om ? om + 2*site : 0);")
    e.ind -= 1
    e("}")
    e("if (pre) {")
    e.ind += 1
    e("for (int b = 0; b < 5; b++) zpass36_bundle(br + (long)b*8*RS36, bi + (long)b*8*RS36, RS36, b<4?8:4);")
    e("for (int ch = 0; ch < 5; ch++) dft36_vert(br + ch*8, bi + ch*8, RS36);")
    e.ind -= 1
    e("}")
    e.ind -= 1
    e("}")

    # run entry
    e("""
void run_36(const double* x0, const double* c, double* out1, double* outm, long B, long m){
    if (m < 1) m = 1;
    for (long b = 0; b < B; b++) {
        const double* xv = x0 + b*2*46656;
        const double* cv = c + b*2*46656;
        double* o1 = out1 + b*2*46656;
        double* om = outm + b*2*46656;
        // convert in
        for (int x = 0; x < 36; x++)
            for (int y = 0; y < 36; y++)
                row36_in(xv + ((long)x*36+y)*72, ARENA36_R + (long)x*PS36 + y*RS36,
                         ARENA36_I + (long)x*PS36 + y*RS36);
        // prologue: Z then Y per x-plane
        for (int x = 0; x < 36; x++) {
            double* br = ARENA36_R + (long)x*PS36; double* bi = ARENA36_I + (long)x*PS36;
            for (int bnd = 0; bnd < 5; bnd++) zpass36_bundle(br + (long)bnd*8*RS36, bi + (long)bnd*8*RS36, RS36, bnd<4?8:4);
            for (int ch = 0; ch < 5; ch++) dft36_vert(br + ch*8, bi + ch*8, RS36);
        }
        for (long t = 1; t <= m; t++) {
            double* o1t = (t==1) ? o1 : 0;
            double* omt = (t==m) ? om : 0;
            int pre = (t < m);
            if (t & 1) { for (int y0 = 0; y0 < 36; y0++) sweep36_SyX(y0, cv, o1t, omt, pre); }
            else       { for (int xp = 0; xp < 36; xp++) sweep36_PxY(xp, cv, o1t, omt, pre); }
        }
    }
}
""")
    return e.text()

def gen_all():
    from glib import PRELUDE
    return PRELUDE + gen_kernels() + gen_driver()

if __name__ == "__main__":
    open("../impl36.c","w").write(gen_all())
    print("wrote impl36.c")
