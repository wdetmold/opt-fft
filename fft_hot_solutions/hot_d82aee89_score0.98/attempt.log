static inline uint64_t rdtscp_() { unsigned a; return __rdtscp(&a); }
__attribute__((noinline)) double imul_chain(long iters){
    uint64_t t0,t1; long i=iters;
    t0=rdtscp_();
    asm volatile("mov $3, %%rax\n mov $5, %%rcx\n1:\n.rept 16\n imul %%rcx, %%rax\n .endr\n dec %[i]\n jnz 1b\n":[i]"+r"(i)::"rax","rcx");
    t1=rdtscp_();
    return (double)(t1-t0)/iters/16;
}
__attribute__((noinline)) double fma_chain(long iters){
    uint64_t t0,t1; long i=iters;
    t0=rdtscp_();
    asm volatile("1:\n.rept 16\n vfmadd231pd %%zmm30,%%zmm31,%%zmm0\n .endr\n dec %[i]\n jnz 1b\n":[i]"+r"(i)::"zmm0");
    t1=rdtscp_();
