import sys, ctypes; sys.path.insert(0,'.')
from harness import *
import numpy as np
lib = ctypes.CDLL('./implwv.so')
for L in (36, 45, 64):
    f = getattr(lib, f'run_{L}wv')
    f.argtypes = [ctypes.c_void_p]*4 + [ctypes.c_long]*2
    for B, m in ((1,1),(2,3),(1,4)):
