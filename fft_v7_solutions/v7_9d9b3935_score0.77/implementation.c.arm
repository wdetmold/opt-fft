            _mm512_storeu_pd(dst + (size_t)xq*408 + (size_t)(zb+t)*24 + y0, v);
          }
        }
      }
      for (int y = 17 - (17 % 8); y < 17; y++) {
        const double* p = src + (size_t)(((x*17)+y)*17);
