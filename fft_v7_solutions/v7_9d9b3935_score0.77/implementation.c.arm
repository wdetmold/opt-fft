static void emitpl0_17(const double* ar, const double* ai, double* p){
  // (y,z) plane, rows stride 24 -> interleaved out rows of 2*17
  for (int y = 0; y < 17; y++) {
    const double* r = ar + (size_t)y*24; const double* q = ai + (size_t)y*24;
    double* o = p + 2*(size_t)y*17;
    ilv8(_mm512_loadu_pd(r + 0), _mm512_loadu_pd(q + 0), o + 0);
    ilv8(_mm512_loadu_pd(r + 8), _mm512_loadu_pd(q + 8), o + 16);
    ilv8_tail(_mm512_loadu_pd(r + 16), _mm512_loadu_pd(q + 16), o + 32, 1);
  }
}
static void emitpl1_17(const double* ar, const double* ai, double* p){
  // (z,y) plane (rows stride 24 over z) -> out[y][z] interleaved; transpose via tr8
  V8 TR[8] __attribute__((aligned(64))); V8 TI[8] __attribute__((aligned(64)));
  for (int yb = 0; yb < 17; yb += 8) {
