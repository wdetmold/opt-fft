    const double* pi = xi + (size_t)(((x*8)+y)*8);
    size_t base = (size_t)x*8 + y;
    for (int z = 0; z < 8; z++) { rr[base + (size_t)z*64] = scale*pr[z]; ri[base + (size_t)z*64] = scale*pi[z]; }
  }
}
static void loadC_8(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 8; x++) for (int y = 0; y < 8; y++) {
    const double* pr = xr + (size_t)(((x*8)+y)*8);
    const double* pi = xi + (size_t)(((x*8)+y)*8);
    double* ar = rr + (size_t)y*64 + x;
    double* ai = ri + (size_t)y*64 + x;
    for (int z = 0; z < 8; z++) { ar[(size_t)z*8] = scale*pr[z]; ai[(size_t)z*8] = scale*pi[z]; }
  }
}
static void emit_8(const double* rr, const double* ri, int orient, double* out){
  if (orient == 0) {
    for (int x = 0; x < 8; x++) for (int y = 0; y < 8; y++) {
      const double* ar = rr + (size_t)x*64 + (size_t)y*8;
      const double* ai = ri + (size_t)x*64 + (size_t)y*8;
      double* p = out + 2*(size_t)(((x*8)+y)*8);
      for (int z = 0; z < 8; z++) { p[2*z] = ar[z]; p[2*z+1] = ai[z]; }
    } }
  else if (orient == 1) {
    for (int x = 0; x < 8; x++) for (int y = 0; y < 8; y++) {
      size_t base = (size_t)x*8 + y;
      double* p = out + 2*(size_t)(((x*8)+y)*8);
      for (int z = 0; z < 8; z++) { p[2*z] = rr[base + (size_t)z*64]; p[2*z+1] = ri[base + (size_t)z*64]; }
    } }
  else {
    for (int x = 0; x < 8; x++) for (int y = 0; y < 8; y++) {
      const double* ar = rr + (size_t)y*64 + x;
      const double* ai = ri + (size_t)y*64 + x;
      double* p = out + 2*(size_t)(((x*8)+y)*8);
      for (int z = 0; z < 8; z++) { p[2*z] = ar[(size_t)z*8]; p[2*z+1] = ai[(size_t)z*8]; }
    } }
}
static double *S8r, *S8i, *T8r, *T8i, *cA8r, *cA8i, *cB8r, *cB8i;
static double *cC8r, *cC8i;
static void run_core_8(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  for (long b = 0; b < Bc; b++) {
    const double* xbr = x0r + (size_t)b*512; const double* xbi = x0i + (size_t)b*512;
    const double* cbr = ccr + (size_t)b*512; const double* cbi = cci + (size_t)b*512;
    load_8(xbr, xbi, 1.0, S8r, S8i);
    if (m >= 3) load_8(cbr, cbi, 0.1, cA8r, cA8i);
    loadB_8(cbr, cbi, 0.1, cB8r, cB8i);
    if (m >= 2) loadC_8(cbr, cbi, 0.1, cC8r, cC8i);
    double *cr_ = S8r, *ci_ = S8i, *tr = T8r, *ti = T8i;
    int orient = 0;
    if (m < 1) { emit_8(cr_, ci_, 0, out1 + 2*(size_t)b*512); emit_8(cr_, ci_, 0, outm + 2*(size_t)b*512); continue; }
    for (long t = 1; t <= m; t++) {
      orient = (orient + 1) % 3;
      const double* ur = orient == 1 ? cB8r : (orient == 2 ? cC8r : cA8r);
      const double* ui = orient == 1 ? cB8i : (orient == 2 ? cC8i : cA8i);
      step_8(cr_, ci_, tr, ti, ur, ui);
      { double* q; q = cr_; cr_ = tr; tr = q; q = ci_; ci_ = ti; ti = q; }
      if (t == 1) emit_8(cr_, ci_, orient, out1 + 2*(size_t)b*512);
    }
    emit_8(cr_, ci_, orient, outm + 2*(size_t)b*512);
  }
}
void run_8(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  run_core_8(Bc, m, x0r, x0i, ccr, cci, out1, outm);
}
void rungen_8(long Bc, long m, const uint64_t* wx, const uint64_t* wc, double* out1, double* outm){
  size_t n = (size_t)Bc * 512;
  gens_ensure(n);
  fill_normals2(wx, 2*(long)n, Gxr, wc, 2*(long)n, Gcr);
  run_core_8(Bc, m, Gxr, Gxr + n, Gcr, Gcr + n, out1, outm);
}

static void ay_13(const double* sr, const double* si, double* dr, double* di){
  for (int x = 0; x < 13; x++) {
    const double* pr = sr + (size_t)x*208; const double* pi = si + (size_t)x*208;
    double* qr = dr + (size_t)x*208; double* qi = di + (size_t)x*208;
    fft13_yy(pr + 0, pi + 0, qr + 0, qi + 0);
    fft13_yy(pr + 8, pi + 8, qr + 8, qi + 8);
  }
}
static void ayp_13(const double* pr, const double* pi, double* qr, double* qi){
  fft13_yy(pr + 0, pi + 0, qr + 0, qi + 0);
  fft13_yy(pr + 8, pi + 8, qr + 8, qi + 8);
}
static void axmap_13(double* sr, double* si, const double* cr, const double* ci){
  for (int p = 0; p < 208; p += 8)
    fftmap13_pp(sr + p, si + p, sr + p, si + p, cr + p, ci + p);
}
static void azp_13(const double* wr, const double* wi, double* tr, double* ti){
  V8 BR[16] __attribute__((aligned(64))); V8 BI[16] __attribute__((aligned(64)));
  static const int y0s[2] = {0, 8};
  for (int bi = 0; bi < 2; bi++) {
    int y0 = y0s[bi];
    const double* p = wr + (size_t)y0*16;
    const double* q = wi + (size_t)y0*16;
    tr8(p + 0, 16, BR + 0); tr8(q + 0, 16, BI + 0);
    tr8(p + 8, 16, BR + 8); tr8(q + 8, 16, BI + 8);
    fft13_zz((const double*)BR, (const double*)BI, tr + y0, ti + y0);
  }
}
static void step_13(double* sr, double* si, double* wr, double* wi, const double* ccr, const double* cci){
  for (int x = 0; x < 13; x++) {
    size_t o = (size_t)x*208;
    ayp_13(sr + o, si + o, wr, wi);
    azp_13(wr, wi, sr + o, si + o);
  }
  axmap_13(sr, si, ccr, cci);
}

static void load_13(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 13; x++) for (int y = 0; y < 13; y++) {
    const double* pr = xr + (size_t)(((x*13)+y)*13);
    const double* pi = xi + (size_t)(((x*13)+y)*13);
    double* ar = rr + (size_t)x*208 + (size_t)y*16;
    double* ai = ri + (size_t)x*208 + (size_t)y*16;
    for (int z = 0; z < 13; z++) { ar[z] = scale*pr[z]; ai[z] = scale*pi[z]; }
  }
}
static void loadB_13(const double* xr, const double* xi, double scale, double* rr, double* ri){
  V8 BUF[8] __attribute__((aligned(64)));
  __m512d SC = _mm512_set1_pd(scale);
  for (int x = 0; x < 13; x++) {
    int xq = x;
    for (int h = 0; h < 2; h++) {
      const double* src = h ? xi : xr;
      double* dst = h ? ri : rr;
      for (int y0 = 0; y0 + 8 <= 13; y0 += 8) {
        for (int zb = 0; zb < 13; zb += 8) {
          int zn = 13 - zb; if (zn > 8) zn = 8;
          tr8(src + (size_t)(((x*13)+y0)*13) + zb, 13, BUF);
          for (int t = 0; t < zn; t++) {
            __m512d v = _mm512_mul_pd(SC, (__m512d)BUF[t]);
            _mm512_storeu_pd(dst + (size_t)xq*208 + (size_t)(zb+t)*16 + y0, v);
          }
        }
      }
      for (int y = 13 - (13 % 8); y < 13; y++) {
        const double* p = src + (size_t)(((x*13)+y)*13);
        double* a = dst + (size_t)xq*208 + y;
        for (int z = 0; z < 13; z++) a[(size_t)z*16] = scale*p[z];
      }
    }
  }
}
static void emitpl0_13(const double* ar, const double* ai, double* p){
  // (y,z) plane, rows stride 16 -> interleaved out rows of 2*13
  for (int y = 0; y < 13; y++) {
    const double* r = ar + (size_t)y*16; const double* q = ai + (size_t)y*16;
    double* o = p + 2*(size_t)y*13;
    ilv8(_mm512_loadu_pd(r + 0), _mm512_loadu_pd(q + 0), o + 0);
    ilv8_tail(_mm512_loadu_pd(r + 8), _mm512_loadu_pd(q + 8), o + 16, 5);
  }
}
static void emitpl1_13(const double* ar, const double* ai, double* p){
  // (z,y) plane (rows stride 16 over z) -> out[y][z] interleaved; transpose via tr8
  V8 TR[8] __attribute__((aligned(64))); V8 TI[8] __attribute__((aligned(64)));
  for (int yb = 0; yb < 13; yb += 8) {
    int yn = 13 - yb; if (yn > 8) yn = 8;
    for (int zb = 0; zb < 13; zb += 8) {
      int zn = 13 - zb; if (zn > 8) zn = 8;
      tr8(ar + (size_t)zb*16 + yb, 16, TR);
      tr8(ai + (size_t)zb*16 + yb, 16, TI);
      for (int t = 0; t < yn; t++) {
        double* o = p + 2*((size_t)(yb+t)*13 + zb);
        if (zn == 8) ilv8((__m512d)TR[t], (__m512d)TI[t], o); else ilv8_tail((__m512d)TR[t], (__m512d)TI[t], o, zn);
      }
    }
  }
}
static void emit_13(const double* rr, const double* ri, int orient, double* out){
  if (orient == 0) {
    for (int x = 0; x < 13; x++)
      emitpl0_13(rr + (size_t)x*208, ri + (size_t)x*208, out + 2*(size_t)x*169);
  } else {
    for (int x = 0; x < 13; x++) {
      int xq = x;
      emitpl1_13(rr + (size_t)xq*208, ri + (size_t)xq*208, out + 2*(size_t)x*169);
    }
  }
}
static double *S13r, *S13i, *T13r, *T13i, *cA13r, *cA13i, *cB13r, *cB13i;
static double *W13r, *W13i;
static void run_core_13(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  for (long b = 0; b < Bc; b++) {
    const double* xbr = x0r + (size_t)b*2197; const double* xbi = x0i + (size_t)b*2197;
    const double* cbr = ccr + (size_t)b*2197; const double* cbi = cci + (size_t)b*2197;
    load_13(xbr, xbi, 1.0, S13r, S13i);
    if (m >= 2) load_13(cbr, cbi, 0.1, cA13r, cA13i);
    loadB_13(cbr, cbi, 0.1, cB13r, cB13i);
    double *cr_ = S13r, *ci_ = S13i, *tr = T13r, *ti = T13i;
    int orient = 0;
    if (m < 1) { emit_13(cr_, ci_, 0, out1 + 2*(size_t)b*2197); emit_13(cr_, ci_, 0, outm + 2*(size_t)b*2197); continue; }
    for (long t = 1; t <= m; t++) {
      orient ^= 1;
      const double* ur = orient ? cB13r : cA13r;
      const double* ui = orient ? cB13i : cA13i;
      step_13(cr_, ci_, W13r, W13i, ur, ui);
      if (t == 1) emit_13(cr_, ci_, orient, out1 + 2*(size_t)b*2197);
    }
    emit_13(cr_, ci_, orient, outm + 2*(size_t)b*2197);
  }
}
void run_13(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  run_core_13(Bc, m, x0r, x0i, ccr, cci, out1, outm);
}
