static void ay_23(const double* sr, const double* si, double* dr, double* di){
  for (int x = 0; x < 23; x++) {
    const double* pr = sr + (size_t)x*552; const double* pi = si + (size_t)x*552;
    double* qr = dr + (size_t)x*552; double* qi = di + (size_t)x*552;
    fft23_yy(pr + 0, pi + 0, qr + 0, qi + 0);
