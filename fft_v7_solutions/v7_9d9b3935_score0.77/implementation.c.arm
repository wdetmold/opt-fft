static void azp_23(const double* wr, const double* wi, double* tr, double* ti){
  V8 BR[24] __attribute__((aligned(64))); V8 BI[24] __attribute__((aligned(64)));
  static const int y0s[3] = {0, 8, 16};
  for (int bi = 0; bi < 3; bi++) {
    int y0 = y0s[bi];
    const double* p = wr + (size_t)y0*24;
    const double* q = wi + (size_t)y0*24;
    tr8(p + 0, 24, BR + 0); tr8(q + 0, 24, BI + 0);
    tr8(p + 8, 24, BR + 8); tr8(q + 8, 24, BI + 8);
    tr8(p + 16, 24, BR + 16); tr8(q + 16, 24, BI + 16);
    fft23_zz((const double*)BR, (const double*)BI, tr + y0, ti + y0);
  }
}
static void step_23(double* sr, double* si, double* wr, double* wi, const double* ccr, const double* cci){
  for (int x = 0; x < 23; x++) {
    size_t o = (size_t)x*552;
    ayp_23(sr + o, si + o, wr, wi);
    azp_23(wr, wi, sr + o, si + o);
  }
  axmap_23(sr, si, ccr, cci);
}

static void load_23(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 23; x++) for (int y = 0; y < 23; y++) {
    const double* pr = xr + (size_t)(((x*23)+y)*23);
    const double* pi = xi + (size_t)(((x*23)+y)*23);
    double* ar = rr + (size_t)x*552 + (size_t)y*24;
    double* ai = ri + (size_t)x*552 + (size_t)y*24;
    for (int z = 0; z < 23; z++) { ar[z] = scale*pr[z]; ai[z] = scale*pi[z]; }
  }
}
static void loadB_23(const double* xr, const double* xi, double scale, double* rr, double* ri){
  V8 BUF[8] __attribute__((aligned(64)));
  __m512d SC = _mm512_set1_pd(scale);
  for (int x = 0; x < 23; x++) {
    int xq = x;
    for (int h = 0; h < 2; h++) {
      const double* src = h ? xi : xr;
      double* dst = h ? ri : rr;
      for (int y0 = 0; y0 + 8 <= 23; y0 += 8) {
        for (int zb = 0; zb < 23; zb += 8) {
          int zn = 23 - zb; if (zn > 8) zn = 8;
          tr8(src + (size_t)(((x*23)+y0)*23) + zb, 23, BUF);
          for (int t = 0; t < zn; t++) {
            __m512d v = _mm512_mul_pd(SC, (__m512d)BUF[t]);
            _mm512_storeu_pd(dst + (size_t)xq*552 + (size_t)(zb+t)*24 + y0, v);
          }
        }
      }
      for (int y = 23 - (23 % 8); y < 23; y++) {
        const double* p = src + (size_t)(((x*23)+y)*23);
        double* a = dst + (size_t)xq*552 + y;
        for (int z = 0; z < 23; z++) a[(size_t)z*24] = scale*p[z];
      }
    }
  }
}
static void emitpl0_23(const double* ar, const double* ai, double* p){
  // (y,z) plane, rows stride 24 -> interleaved out rows of 2*23
  for (int y = 0; y < 23; y++) {
    const double* r = ar + (size_t)y*24; const double* q = ai + (size_t)y*24;
    double* o = p + 2*(size_t)y*23;
    ilv8(_mm512_loadu_pd(r + 0), _mm512_loadu_pd(q + 0), o + 0);
    ilv8(_mm512_loadu_pd(r + 8), _mm512_loadu_pd(q + 8), o + 16);
    ilv8_tail(_mm512_loadu_pd(r + 16), _mm512_loadu_pd(q + 16), o + 32, 7);
  }
}
static void emitpl1_23(const double* ar, const double* ai, double* p){
  // (z,y) plane (rows stride 24 over z) -> out[y][z] interleaved; transpose via tr8
  V8 TR[8] __attribute__((aligned(64))); V8 TI[8] __attribute__((aligned(64)));
  for (int yb = 0; yb < 23; yb += 8) {
    int yn = 23 - yb; if (yn > 8) yn = 8;
    for (int zb = 0; zb < 23; zb += 8) {
      int zn = 23 - zb; if (zn > 8) zn = 8;
      tr8(ar + (size_t)zb*24 + yb, 24, TR);
      tr8(ai + (size_t)zb*24 + yb, 24, TI);
      for (int t = 0; t < yn; t++) {
        double* o = p + 2*((size_t)(yb+t)*23 + zb);
        if (zn == 8) ilv8((__m512d)TR[t], (__m512d)TI[t], o); else ilv8_tail((__m512d)TR[t], (__m512d)TI[t], o, zn);
      }
    }
  }
}
static void emit_23(const double* rr, const double* ri, int orient, double* out){
  if (orient == 0) {
    for (int x = 0; x < 23; x++)
      emitpl0_23(rr + (size_t)x*552, ri + (size_t)x*552, out + 2*(size_t)x*529);
  } else {
    for (int x = 0; x < 23; x++) {
      int xq = x;
      emitpl1_23(rr + (size_t)xq*552, ri + (size_t)xq*552, out + 2*(size_t)x*529);
    }
  }
}
static double *S23r, *S23i, *T23r, *T23i, *cA23r, *cA23i, *cB23r, *cB23i;
static double *W23r, *W23i;
static void run_core_23(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  for (long b = 0; b < Bc; b++) {
    const double* xbr = x0r + (size_t)b*12167; const double* xbi = x0i + (size_t)b*12167;
    const double* cbr = ccr + (size_t)b*12167; const double* cbi = cci + (size_t)b*12167;
    load_23(xbr, xbi, 1.0, S23r, S23i);
    if (m >= 2) load_23(cbr, cbi, 0.1, cA23r, cA23i);
    loadB_23(cbr, cbi, 0.1, cB23r, cB23i);
    double *cr_ = S23r, *ci_ = S23i, *tr = T23r, *ti = T23i;
    int orient = 0;
    if (m < 1) { emit_23(cr_, ci_, 0, out1 + 2*(size_t)b*12167); emit_23(cr_, ci_, 0, outm + 2*(size_t)b*12167); continue; }
    for (long t = 1; t <= m; t++) {
      orient ^= 1;
      const double* ur = orient ? cB23r : cA23r;
      const double* ui = orient ? cB23i : cA23i;
      step_23(cr_, ci_, W23r, W23i, ur, ui);
      if (t == 1) emit_23(cr_, ci_, orient, out1 + 2*(size_t)b*12167);
    }
    emit_23(cr_, ci_, orient, outm + 2*(size_t)b*12167);
  }
}
void run_23(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  run_core_23(Bc, m, x0r, x0i, ccr, cci, out1, outm);
}
void rungen_23(long Bc, long m, const uint64_t* wx, const uint64_t* wc, double* out1, double* outm){
  size_t n = (size_t)Bc * 12167;
  gens_ensure(n);
  fill_normals2(wx, 2*(long)n, Gxr, wc, 2*(long)n, Gcr);
  run_core_23(Bc, m, Gxr, Gxr + n, Gcr, Gcr + n, out1, outm);
}

static void ay_36(const double* sr, const double* si, double* dr, double* di){
  for (int x = 0; x < 36; x++) {
    const double* pr = sr + (size_t)x*1448; const double* pi = si + (size_t)x*1448;
    double* qr = dr + (size_t)x*1448; double* qi = di + (size_t)x*1448;
    fft36_yy(pr + 0, pi + 0, qr + 0, qi + 0);
    fft36_yy(pr + 8, pi + 8, qr + 8, qi + 8);
    fft36_yy(pr + 16, pi + 16, qr + 16, qi + 16);
    fft36_yy(pr + 24, pi + 24, qr + 24, qi + 24);
    fft36_yy(pr + 32, pi + 32, qr + 32, qi + 32);
  }
}
static void ayp_36(const double* pr, const double* pi, double* qr, double* qi){
  fft36_yy(pr + 0, pi + 0, qr + 0, qi + 0);
  fft36_yy(pr + 8, pi + 8, qr + 8, qi + 8);
  fft36_yy(pr + 16, pi + 16, qr + 16, qi + 16);
  fft36_yy(pr + 24, pi + 24, qr + 24, qi + 24);
  fft36_yy(pr + 32, pi + 32, qr + 32, qi + 32);
}
static void axmap_36_odd(double* sr, double* si, const double* cr, const double* ci){
  for (int p = 0; p < 1440; p += 8) { ax1_36_strided_0(sr + (size_t)0*1448 + p, si + (size_t)0*1448 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_strided_1(sr + (size_t)1*1448 + p, si + (size_t)1*1448 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_strided_2(sr + (size_t)2*1448 + p, si + (size_t)2*1448 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_strided_3(sr + (size_t)3*1448 + p, si + (size_t)3*1448 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_strided_4(sr + (size_t)4*1448 + p, si + (size_t)4*1448 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_strided_5(sr + (size_t)5*1448 + p, si + (size_t)5*1448 + p); }
  for (int k1 = 0; k1 < 6; k1++)
    for (int p = 0; p < 1440; p += 8) { size_t o = (size_t)k1*8688 + p; ax2_36_consec(sr + o, si + o, cr + o, ci + o); }
}
static void axmap_36_even(double* sr, double* si, const double* cr, const double* ci){
  for (int p = 0; p < 1440; p += 8) { ax1_36_consec_0(sr + (size_t)0*8688 + p, si + (size_t)0*8688 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_consec_1(sr + (size_t)1*8688 + p, si + (size_t)1*8688 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_consec_2(sr + (size_t)2*8688 + p, si + (size_t)2*8688 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_consec_3(sr + (size_t)3*8688 + p, si + (size_t)3*8688 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_consec_4(sr + (size_t)4*8688 + p, si + (size_t)4*8688 + p); }
  for (int p = 0; p < 1440; p += 8) { ax1_36_consec_5(sr + (size_t)5*8688 + p, si + (size_t)5*8688 + p); }
  for (int k1 = 0; k1 < 6; k1++)
    for (int p = 0; p < 1440; p += 8) { size_t o = (size_t)k1*1448 + p; ax2_36_strided(sr + o, si + o, cr + o, ci + o); }
}
static void azp_36(const double* wr, const double* wi, double* tr, double* ti){
  V8 BR[40] __attribute__((aligned(64))); V8 BI[40] __attribute__((aligned(64)));
  static const int y0s[5] = {0, 8, 16, 24, 32};
  for (int bi = 0; bi < 5; bi++) {
    int y0 = y0s[bi];
    const double* p = wr + (size_t)y0*40;
    const double* q = wi + (size_t)y0*40;
    tr8(p + 0, 40, BR + 0); tr8(q + 0, 40, BI + 0);
    tr8(p + 8, 40, BR + 8); tr8(q + 8, 40, BI + 8);
    tr8(p + 16, 40, BR + 16); tr8(q + 16, 40, BI + 16);
    tr8(p + 24, 40, BR + 24); tr8(q + 24, 40, BI + 24);
    tr8(p + 32, 40, BR + 32); tr8(q + 32, 40, BI + 32);
    fft36_zz((const double*)BR, (const double*)BI, tr + y0, ti + y0);
  }
}
static void step_36(double* sr, double* si, double* wr, double* wi, const double* ccr, const double* cci, int odd){
  if (odd) {
    for (int g = 0; g < 6; g++) {
      for (int a = 0; a < 6; a++) {
        size_t o = (size_t)(6*a + g)*1448;
        ayp_36(sr + o, si + o, wr, wi);
        azp_36(wr, wi, sr + o, si + o);
      }
      switch (g) {
        case 0: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_0(sr + (size_t)0*1448 + p, si + (size_t)0*1448 + p); } break;
        case 1: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_1(sr + (size_t)1*1448 + p, si + (size_t)1*1448 + p); } break;
        case 2: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_2(sr + (size_t)2*1448 + p, si + (size_t)2*1448 + p); } break;
        case 3: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_3(sr + (size_t)3*1448 + p, si + (size_t)3*1448 + p); } break;
        case 4: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_4(sr + (size_t)4*1448 + p, si + (size_t)4*1448 + p); } break;
        case 5: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_5(sr + (size_t)5*1448 + p, si + (size_t)5*1448 + p); } break;
      }
    }
    for (int k1 = 0; k1 < 6; k1++)
      for (int p = 0; p < 1440; p += 8) { size_t o = (size_t)k1*8688 + p; ax2_36_consec(sr + o, si + o, ccr + o, cci + o); }
  } else {
    for (int g = 0; g < 6; g++) {
      for (int a = 0; a < 6; a++) {
        size_t o = (size_t)(6*g + a)*1448;
        ayp_36(sr + o, si + o, wr, wi);
        azp_36(wr, wi, sr + o, si + o);
      }
      switch (g) {
        case 0: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_0(sr + (size_t)0*8688 + p, si + (size_t)0*8688 + p); } break;
        case 1: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_1(sr + (size_t)1*8688 + p, si + (size_t)1*8688 + p); } break;
        case 2: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_2(sr + (size_t)2*8688 + p, si + (size_t)2*8688 + p); } break;
        case 3: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_3(sr + (size_t)3*8688 + p, si + (size_t)3*8688 + p); } break;
        case 4: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_4(sr + (size_t)4*8688 + p, si + (size_t)4*8688 + p); } break;
        case 5: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_5(sr + (size_t)5*8688 + p, si + (size_t)5*8688 + p); } break;
      }
    }
    for (int k1 = 0; k1 < 6; k1++)
      for (int p = 0; p < 1440; p += 8) { size_t o = (size_t)k1*1448 + p; ax2_36_strided(sr + o, si + o, ccr + o, cci + o); }
  }
}

static void load_36(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 36; x++) for (int y = 0; y < 36; y++) {
    const double* pr = xr + (size_t)(((x*36)+y)*36);
    const double* pi = xi + (size_t)(((x*36)+y)*36);
    double* ar = rr + (size_t)x*1448 + (size_t)y*40;
    double* ai = ri + (size_t)x*1448 + (size_t)y*40;
    for (int z = 0; z < 36; z++) { ar[z] = scale*pr[z]; ai[z] = scale*pi[z]; }
  }
}
static void loadB_36(const double* xr, const double* xi, double scale, double* rr, double* ri){
  V8 BUF[8] __attribute__((aligned(64)));
  __m512d SC = _mm512_set1_pd(scale);
  for (int x = 0; x < 36; x++) {
    int xq = 6*(x % 6) + x / 6;
    for (int h = 0; h < 2; h++) {
      const double* src = h ? xi : xr;
      double* dst = h ? ri : rr;
      for (int y0 = 0; y0 + 8 <= 36; y0 += 8) {
        for (int zb = 0; zb < 36; zb += 8) {
          int zn = 36 - zb; if (zn > 8) zn = 8;
          tr8(src + (size_t)(((x*36)+y0)*36) + zb, 36, BUF);
          for (int t = 0; t < zn; t++) {
            __m512d v = _mm512_mul_pd(SC, (__m512d)BUF[t]);
            _mm512_storeu_pd(dst + (size_t)xq*1448 + (size_t)(zb+t)*40 + y0, v);
          }
        }
      }
      for (int y = 36 - (36 % 8); y < 36; y++) {
        const double* p = src + (size_t)(((x*36)+y)*36);
        double* a = dst + (size_t)xq*1448 + y;
        for (int z = 0; z < 36; z++) a[(size_t)z*40] = scale*p[z];
      }
    }
  }
}
static void emitpl1_36(const double* ar, const double* ai, double* p);
static void emitp1_36(const double* rr, const double* ri, int q, double* out){
  int x = 6*(q % 6) + q / 6;
  emitpl1_36(rr + (size_t)q*1448, ri + (size_t)q*1448, out + 2*(size_t)x*1296);
}
static void emitpl0_36(const double* ar, const double* ai, double* p){
  // (y,z) plane, rows stride 40 -> interleaved out rows of 2*36
  for (int y = 0; y < 36; y++) {
    const double* r = ar + (size_t)y*40; const double* q = ai + (size_t)y*40;
    double* o = p + 2*(size_t)y*36;
    ilv8(_mm512_loadu_pd(r + 0), _mm512_loadu_pd(q + 0), o + 0);
    ilv8(_mm512_loadu_pd(r + 8), _mm512_loadu_pd(q + 8), o + 16);
    ilv8(_mm512_loadu_pd(r + 16), _mm512_loadu_pd(q + 16), o + 32);
    ilv8(_mm512_loadu_pd(r + 24), _mm512_loadu_pd(q + 24), o + 48);
    ilv8_tail(_mm512_loadu_pd(r + 32), _mm512_loadu_pd(q + 32), o + 64, 4);
  }
}
static void emitpl1_36(const double* ar, const double* ai, double* p){
  // (z,y) plane (rows stride 40 over z) -> out[y][z] interleaved; transpose via tr8
  V8 TR[8] __attribute__((aligned(64))); V8 TI[8] __attribute__((aligned(64)));
  for (int yb = 0; yb < 36; yb += 8) {
    int yn = 36 - yb; if (yn > 8) yn = 8;
    for (int zb = 0; zb < 36; zb += 8) {
      int zn = 36 - zb; if (zn > 8) zn = 8;
      tr8(ar + (size_t)zb*40 + yb, 40, TR);
      tr8(ai + (size_t)zb*40 + yb, 40, TI);
      for (int t = 0; t < yn; t++) {
        double* o = p + 2*((size_t)(yb+t)*36 + zb);
        if (zn == 8) ilv8((__m512d)TR[t], (__m512d)TI[t], o); else ilv8_tail((__m512d)TR[t], (__m512d)TI[t], o, zn);
      }
    }
  }
}
static void emit_36(const double* rr, const double* ri, int orient, double* out){
  if (orient == 0) {
    for (int x = 0; x < 36; x++)
      emitpl0_36(rr + (size_t)x*1448, ri + (size_t)x*1448, out + 2*(size_t)x*1296);
  } else {
    for (int x = 0; x < 36; x++) {
      int xq = 6*(x % 6) + x / 6;
      emitpl1_36(rr + (size_t)xq*1448, ri + (size_t)xq*1448, out + 2*(size_t)x*1296);
    }
  }
}
static double *S36r, *S36i, *T36r, *T36i, *cA36r, *cA36i, *cB36r, *cB36i;
static double *W36r, *W36i;
static void grp_planes1_36(double* sr, double* si, double* wr, double* wi, int g, int odd){
  for (int a = 0; a < 6; a++) {
