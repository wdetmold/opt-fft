    double* ai = ri + (size_t)y*36 + x;
    for (int z = 0; z < 6; z++) { ar[(size_t)z*6] = scale*pr[z]; ai[(size_t)z*6] = scale*pi[z]; }
  }
}
static void emit_6(const double* rr, const double* ri, int orient, double* out){
  if (orient == 0) {
    for (int x = 0; x < 6; x++) for (int y = 0; y < 6; y++) {
      const double* ar = rr + (size_t)x*36 + (size_t)y*6;
      const double* ai = ri + (size_t)x*36 + (size_t)y*6;
      double* p = out + 2*(size_t)(((x*6)+y)*6);
      for (int z = 0; z < 6; z++) { p[2*z] = ar[z]; p[2*z+1] = ai[z]; }
    } }
  else if (orient == 1) {
    for (int x = 0; x < 6; x++) for (int y = 0; y < 6; y++) {
      size_t base = (size_t)x*6 + y;
      double* p = out + 2*(size_t)(((x*6)+y)*6);
      for (int z = 0; z < 6; z++) { p[2*z] = rr[base + (size_t)z*36]; p[2*z+1] = ri[base + (size_t)z*36]; }
    } }
  else {
    for (int x = 0; x < 6; x++) for (int y = 0; y < 6; y++) {
      const double* ar = rr + (size_t)y*36 + x;
      const double* ai = ri + (size_t)y*36 + x;
      double* p = out + 2*(size_t)(((x*6)+y)*6);
      for (int z = 0; z < 6; z++) { p[2*z] = ar[(size_t)z*6]; p[2*z+1] = ai[(size_t)z*6]; }
    } }
}
static double *S6r, *S6i, *T6r, *T6i, *cA6r, *cA6i, *cB6r, *cB6i;
static double *cC6r, *cC6i;
static void run_core_6(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  for (long b = 0; b < Bc; b++) {
    const double* xbr = x0r + (size_t)b*216; const double* xbi = x0i + (size_t)b*216;
    const double* cbr = ccr + (size_t)b*216; const double* cbi = cci + (size_t)b*216;
    load_6(xbr, xbi, 1.0, S6r, S6i);
    if (m >= 3) load_6(cbr, cbi, 0.1, cA6r, cA6i);
    loadB_6(cbr, cbi, 0.1, cB6r, cB6i);
    if (m >= 2) loadC_6(cbr, cbi, 0.1, cC6r, cC6i);
    double *cr_ = S6r, *ci_ = S6i, *tr = T6r, *ti = T6i;
    int orient = 0;
    if (m < 1) { emit_6(cr_, ci_, 0, out1 + 2*(size_t)b*216); emit_6(cr_, ci_, 0, outm + 2*(size_t)b*216); continue; }
    for (long t = 1; t <= m; t++) {
      orient = (orient + 1) % 3;
      const double* ur = orient == 1 ? cB6r : (orient == 2 ? cC6r : cA6r);
      const double* ui = orient == 1 ? cB6i : (orient == 2 ? cC6i : cA6i);
      step_6(cr_, ci_, tr, ti, ur, ui);
      { double* q; q = cr_; cr_ = tr; tr = q; q = ci_; ci_ = ti; ti = q; }
      if (t == 1) emit_6(cr_, ci_, orient, out1 + 2*(size_t)b*216);
    }
    emit_6(cr_, ci_, orient, outm + 2*(size_t)b*216);
  }
}
void run_6(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  run_core_6(Bc, m, x0r, x0i, ccr, cci, out1, outm);
}
void rungen_6(long Bc, long m, const uint64_t* wx, const uint64_t* wc, double* out1, double* outm){
  size_t n = (size_t)Bc * 216;
  gens_ensure(n);
  fill_normals2(wx, 2*(long)n, Gxr, wc, 2*(long)n, Gcr);
  run_core_6(Bc, m, Gxr, Gxr + n, Gcr, Gcr + n, out1, outm);
}

