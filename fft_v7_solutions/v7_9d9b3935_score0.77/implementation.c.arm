  V4 t44 = K4(0.8660254037844386) * t34;
  V4 t45 = t39 + t44;
  V4 t55 = t27 - t45;
  V4 t22 = K4(0.5) * t14;
  V4 t24 = xi0 - t22;
  V4 t15 = xr2 - xr4;
  V4 t25 = K4(0.8660254037844386) * t15;
  V4 t28 = t24 - t25;
  V4 t40 = K4(0.5) * t32;
  V4 t42 = xi3 - t40;
  V4 t33 = xr5 - xr1;
  V4 t43 = K4(0.8660254037844386) * t33;
  V4 t46 = t42 - t43;
  V4 t56 = t28 - t46;
  V4 t29 = t21 - t26;
  V4 t47 = t39 - t44;
  V4 t57 = t29 + t47;
  V4 t30 = t24 + t25;
  V4 t48 = t42 + t43;
  V4 t58 = t30 + t48;
  V4 t51 = t17 - t35;
  V4 t52 = t18 - t36;
  V4 t53 = t27 + t45;
  V4 t54 = t28 + t46;
  V4 t59 = t29 - t47;
  V4 t60 = t30 - t48;
  ST4(ro + 0, t49); ST4(io + 0, t50);
  ST4(ro + 6, t55); ST4(io + 6, t56);
  ST4(ro + 12, t57); ST4(io + 12, t58);
  ST4(ro + 18, t51); ST4(io + 18, t52);
  ST4(ro + 24, t53); ST4(io + 24, t54);
  ST4(ro + 30, t59); ST4(io + 30, t60);
