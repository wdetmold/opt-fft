  V8 t21 = xr0 - t19;
  V8 t16 = xi2 - xi4;
  V8 t26 = K8(0.8660254037844386) * t16;
  V8 t27 = t21 + t26;
  V8 t37 = K8(0.5) * t31;
  V8 t39 = xr3 - t37;
  V8 t34 = xi5 - xi1;
  V8 t44 = K8(0.8660254037844386) * t34;
  V8 t45 = t39 + t44;
  V8 t55 = t27 - t45;
  V8 t22 = K8(0.5) * t14;
  V8 t24 = xi0 - t22;
  V8 t15 = xr2 - xr4;
  V8 t25 = K8(0.8660254037844386) * t15;
  V8 t28 = t24 - t25;
  V8 t40 = K8(0.5) * t32;
  V8 t42 = xi3 - t40;
  V8 t33 = xr5 - xr1;
  V8 t43 = K8(0.8660254037844386) * t33;
  V8 t46 = t42 - t43;
  V8 t56 = t28 - t46;
  V8 t29 = t21 - t26;
  V8 t47 = t39 - t44;
  V8 t57 = t29 + t47;
  V8 t30 = t24 + t25;
  V8 t48 = t42 + t43;
  V8 t58 = t30 + t48;
  V8 t51 = t17 - t35;
  V8 t52 = t18 - t36;
  V8 t53 = t27 + t45;
  V8 t54 = t28 + t46;
  V8 t59 = t29 - t47;
  V8 t60 = t30 - t48;
  ST8(ro + 0, t49); ST8(io + 0, t50);
  ST8(ro + 36, t55); ST8(io + 36, t56);
  ST8(ro + 72, t57); ST8(io + 72, t58);
  ST8(ro + 108, t51); ST8(io + 108, t52);
  ST8(ro + 144, t53); ST8(io + 144, t54);
  ST8(ro + 180, t59); ST8(io + 180, t60);
}

static __attribute__((noinline)) void fftmap6_zz(const double* ri, const double* ii, double* ro, double* io, const double* cr, const double* ci) {
  V8 xr0 = LD8(ri + 0); V8 xi0 = LD8(ii + 0);
  V8 xr1 = LD8(ri + 8); V8 xi1 = LD8(ii + 8);
  V8 xr2 = LD8(ri + 16); V8 xi2 = LD8(ii + 16);
  V8 xr3 = LD8(ri + 24); V8 xi3 = LD8(ii + 24);
  V8 xr4 = LD8(ri + 32); V8 xi4 = LD8(ii + 32);
  V8 xr5 = LD8(ri + 40); V8 xi5 = LD8(ii + 40);
  V8 t13 = xr2 + xr4;
  V8 t17 = xr0 + t13;
  V8 t31 = xr1 + xr5;
  V8 t35 = xr3 + t31;
  V8 t49 = t17 + t35;
  V8 t14 = xi2 + xi4;
  V8 t18 = xi0 + t14;
  V8 t32 = xi1 + xi5;
  V8 t36 = xi3 + t32;
  V8 t50 = t18 + t36;
  V8 t19 = K8(0.5) * t13;
  V8 t21 = xr0 - t19;
  V8 t16 = xi2 - xi4;
  V8 t26 = K8(0.8660254037844386) * t16;
  V8 t27 = t21 + t26;
  V8 t37 = K8(0.5) * t31;
  V8 t39 = xr3 - t37;
  V8 t34 = xi5 - xi1;
  V8 t44 = K8(0.8660254037844386) * t34;
  V8 t45 = t39 + t44;
  V8 t55 = t27 - t45;
  V8 t22 = K8(0.5) * t14;
  V8 t24 = xi0 - t22;
  V8 t15 = xr2 - xr4;
  V8 t25 = K8(0.8660254037844386) * t15;
  V8 t28 = t24 - t25;
  V8 t40 = K8(0.5) * t32;
  V8 t42 = xi3 - t40;
  V8 t33 = xr5 - xr1;
  V8 t43 = K8(0.8660254037844386) * t33;
  V8 t46 = t42 - t43;
  V8 t56 = t28 - t46;
  V8 t29 = t21 - t26;
  V8 t47 = t39 - t44;
  V8 t57 = t29 + t47;
  V8 t30 = t24 + t25;
  V8 t48 = t42 + t43;
  V8 t58 = t30 + t48;
  V8 t51 = t17 - t35;
  V8 t52 = t18 - t36;
  V8 t53 = t27 + t45;
  V8 t54 = t28 + t46;
  V8 t59 = t29 - t47;
  V8 t60 = t30 - t48;
  { V8 zr = t49 + LD8(cr + 0); V8 zi = t50 + LD8(ci + 0); V8 mr, mi; map8nr(zr, zi, &mr, &mi); ST8(ro + 0, mr); ST8(io + 0, mi); }
  { V8 zr = t55 + LD8(cr + 36); V8 zi = t56 + LD8(ci + 36); V8 mr, mi; map8nr(zr, zi, &mr, &mi); ST8(ro + 36, mr); ST8(io + 36, mi); }
  { V8 zr = t57 + LD8(cr + 72); V8 zi = t58 + LD8(ci + 72); V8 mr, mi; map8nr(zr, zi, &mr, &mi); ST8(ro + 72, mr); ST8(io + 72, mi); }
  { V8 zr = t51 + LD8(cr + 108); V8 zi = t52 + LD8(ci + 108); V8 mr, mi; map8nr(zr, zi, &mr, &mi); ST8(ro + 108, mr); ST8(io + 108, mi); }
  { V8 zr = t53 + LD8(cr + 144); V8 zi = t54 + LD8(ci + 144); V8 mr, mi; map8nr(zr, zi, &mr, &mi); ST8(ro + 144, mr); ST8(io + 144, mi); }
  { V8 zr = t59 + LD8(cr + 180); V8 zi = t60 + LD8(ci + 180); V8 mr, mi; map8nr(zr, zi, &mr, &mi); ST8(ro + 180, mr); ST8(io + 180, mi); }
}

