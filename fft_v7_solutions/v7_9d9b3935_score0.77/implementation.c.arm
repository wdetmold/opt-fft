static __attribute__((noinline)) void fft8_yy(const double* ri, const double* ii, double* ro, double* io) {
  V8 xr0 = LD8(ri + 0); V8 xi0 = LD8(ii + 0);
  V8 xr1 = LD8(ri + 8); V8 xi1 = LD8(ii + 8);
  V8 xr2 = LD8(ri + 16); V8 xi2 = LD8(ii + 16);
  V8 xr3 = LD8(ri + 24); V8 xi3 = LD8(ii + 24);
  V8 xr4 = LD8(ri + 32); V8 xi4 = LD8(ii + 32);
  V8 xr5 = LD8(ri + 40); V8 xi5 = LD8(ii + 40);
  V8 xr6 = LD8(ri + 48); V8 xi6 = LD8(ii + 48);
  V8 xr7 = LD8(ri + 56); V8 xi7 = LD8(ii + 56);
  V8 t17 = xr0 + xr4;
  V8 t25 = xr2 + xr6;
  V8 t52 = t17 + t25;
  V8 t21 = xr1 + xr5;
  V8 t29 = xr3 + xr7;
  V8 t56 = t21 + t29;
