}
static void loadB_17(const double* xr, const double* xi, double scale, double* rr, double* ri){
  V8 BUF[8] __attribute__((aligned(64)));
  __m512d SC = _mm512_set1_pd(scale);
  for (int x = 0; x < 17; x++) {
    int xq = x;
    for (int h = 0; h < 2; h++) {
      const double* src = h ? xi : xr;
      double* dst = h ? ri : rr;
      for (int y0 = 0; y0 + 8 <= 17; y0 += 8) {
        for (int zb = 0; zb < 17; zb += 8) {
          int zn = 17 - zb; if (zn > 8) zn = 8;
          tr8(src + (size_t)(((x*17)+y0)*17) + zb, 17, BUF);
          for (int t = 0; t < zn; t++) {
