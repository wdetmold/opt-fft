  }
  if (odd) switch (g) {
    case 0: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_0(sr + (size_t)0*1448 + p, si + (size_t)0*1448 + p); } break;
    case 1: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_1(sr + (size_t)1*1448 + p, si + (size_t)1*1448 + p); } break;
    case 2: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_2(sr + (size_t)2*1448 + p, si + (size_t)2*1448 + p); } break;
    case 3: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_3(sr + (size_t)3*1448 + p, si + (size_t)3*1448 + p); } break;
    case 4: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_4(sr + (size_t)4*1448 + p, si + (size_t)4*1448 + p); } break;
    case 5: for (int p = 0; p < 1440; p += 8) { ax1_36_strided_5(sr + (size_t)5*1448 + p, si + (size_t)5*1448 + p); } break;
  } else switch (g) {
    case 0: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_0(sr + (size_t)0*8688 + p, si + (size_t)0*8688 + p); } break;
    case 1: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_1(sr + (size_t)1*8688 + p, si + (size_t)1*8688 + p); } break;
    case 2: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_2(sr + (size_t)2*8688 + p, si + (size_t)2*8688 + p); } break;
    case 3: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_3(sr + (size_t)3*8688 + p, si + (size_t)3*8688 + p); } break;
    case 4: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_4(sr + (size_t)4*8688 + p, si + (size_t)4*8688 + p); } break;
    case 5: for (int p = 0; p < 1440; p += 8) { ax1_36_consec_5(sr + (size_t)5*8688 + p, si + (size_t)5*8688 + p); } break;
  }
}
static void grp_stage2_36(double* sr, double* si, const double* cr, const double* ci, int k1, int odd){
  if (odd) { for (int p = 0; p < 1440; p += 8) { size_t o = (size_t)k1*8688 + p; ax2_36_consec(sr + o, si + o, cr + o, ci + o); } }
  else { for (int p = 0; p < 1440; p += 8) { size_t o = (size_t)k1*1448 + p; ax2_36_strided(sr + o, si + o, cr + o, ci + o); } }
}
static void run_core_36(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  for (long b = 0; b < Bc; b++) {
    const double* xbr = x0r + (size_t)b*46656; const double* xbi = x0i + (size_t)b*46656;
    const double* cbr = ccr + (size_t)b*46656; const double* cbi = cci + (size_t)b*46656;
    load_36(xbr, xbi, 1.0, S36r, S36i);
    if (m >= 2) load_36(cbr, cbi, 0.1, cA36r, cA36i);
    loadB_36(cbr, cbi, 0.1, cB36r, cB36i);
    double* sr = S36r; double* si = S36i;
    if (m < 1) { emit_36(sr, si, 0, out1 + 2*(size_t)b*46656); emit_36(sr, si, 0, outm + 2*(size_t)b*46656); continue; }
    // step 1 planes+stage1 (odd)
    for (int g = 0; g < 6; g++) grp_planes1_36(sr, si, W36r, W36i, g, 1);
    for (long t = 1; t <= m; t++) {
      int odd = (int)(t & 1);
      const double* ur = odd ? cB36r : cA36r;
      const double* ui = odd ? cB36i : cA36i;
      for (int k1 = 0; k1 < 6; k1++) {
        grp_stage2_36(sr, si, ur, ui, k1, odd);
        if (t == 1 && m > 1) {
          // snapshot planes of this group (orientation 1)
          for (int k2 = 0; k2 < 6; k2++) { int q = odd ? (6*k1 + k2) : (k1 + 6*k2); emitp1_36(sr, si, q, out1 + 2*(size_t)b*46656); }
        }
        if (t < m) {
          int g = k1; int nodd = !odd;
          grp_planes1_36(sr, si, W36r, W36i, g, nodd);
        }
      }
    }
    if (m == 1) { emit_36(sr, si, 1, out1 + 2*(size_t)b*46656); }
    emit_36(sr, si, (int)(m & 1), outm + 2*(size_t)b*46656);
  }
}
void run_36(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  run_core_36(Bc, m, x0r, x0i, ccr, cci, out1, outm);
}
void rungen_36(long Bc, long m, const uint64_t* wx, const uint64_t* wc, double* out1, double* outm){
  size_t n = (size_t)Bc * 46656;
  gens_ensure(n);
  fill_normals2(wx, 2*(long)n, Gxr, wc, 2*(long)n, Gcr);
  run_core_36(Bc, m, Gxr, Gxr + n, Gcr, Gcr + n, out1, outm);
}

static void ay_45(const double* sr, const double* si, double* dr, double* di){
  for (int x = 0; x < 45; x++) {
    const double* pr = sr + (size_t)x*2168; const double* pi = si + (size_t)x*2168;
    double* qr = dr + (size_t)x*2168; double* qi = di + (size_t)x*2168;
    fft45_yy(pr + 0, pi + 0, qr + 0, qi + 0);
    fft45_yy(pr + 8, pi + 8, qr + 8, qi + 8);
    fft45_yy(pr + 16, pi + 16, qr + 16, qi + 16);
    fft45_yy(pr + 24, pi + 24, qr + 24, qi + 24);
    fft45_yy(pr + 32, pi + 32, qr + 32, qi + 32);
    fft45_yy(pr + 40, pi + 40, qr + 40, qi + 40);
  }
}
static void ayp_45(const double* pr, const double* pi, double* qr, double* qi){
  fft45_yy(pr + 0, pi + 0, qr + 0, qi + 0);
  fft45_yy(pr + 8, pi + 8, qr + 8, qi + 8);
  fft45_yy(pr + 16, pi + 16, qr + 16, qi + 16);
  fft45_yy(pr + 24, pi + 24, qr + 24, qi + 24);
  fft45_yy(pr + 32, pi + 32, qr + 32, qi + 32);
  fft45_yy(pr + 40, pi + 40, qr + 40, qi + 40);
}
static void ayp_45(const double* pr, const double* pi, double* qr, double* qi);
static void azp_45(const double* wr, const double* wi, double* tr, double* ti);
static void grp_planes1_45(double* sr, double* si, double* wr, double* wi, int g, int odd){
  int cnt = odd ? 5 : 9;
  for (int a = 0; a < cnt; a++) {
    size_t o = odd ? (size_t)(9*a + g)*2168 : (size_t)(9*g + a)*2168;
    ayp_45(sr + o, si + o, wr, wi);
    azp_45(wr, wi, sr + o, si + o);
  }
  if (odd) switch (g) {
    case 0: for (int p = 0; p < 2160; p += 8) ax1_45_s19_0(sr + (size_t)0*2168 + p, si + (size_t)0*2168 + p); break;
    case 1: for (int p = 0; p < 2160; p += 8) ax1_45_s19_1(sr + (size_t)1*2168 + p, si + (size_t)1*2168 + p); break;
    case 2: for (int p = 0; p < 2160; p += 8) ax1_45_s19_2(sr + (size_t)2*2168 + p, si + (size_t)2*2168 + p); break;
    case 3: for (int p = 0; p < 2160; p += 8) ax1_45_s19_3(sr + (size_t)3*2168 + p, si + (size_t)3*2168 + p); break;
    case 4: for (int p = 0; p < 2160; p += 8) ax1_45_s19_4(sr + (size_t)4*2168 + p, si + (size_t)4*2168 + p); break;
    case 5: for (int p = 0; p < 2160; p += 8) ax1_45_s19_5(sr + (size_t)5*2168 + p, si + (size_t)5*2168 + p); break;
    case 6: for (int p = 0; p < 2160; p += 8) ax1_45_s19_6(sr + (size_t)6*2168 + p, si + (size_t)6*2168 + p); break;
    case 7: for (int p = 0; p < 2160; p += 8) ax1_45_s19_7(sr + (size_t)7*2168 + p, si + (size_t)7*2168 + p); break;
    case 8: for (int p = 0; p < 2160; p += 8) ax1_45_s19_8(sr + (size_t)8*2168 + p, si + (size_t)8*2168 + p); break;
  } else switch (g) {
    case 0: for (int p = 0; p < 2160; p += 8) ax1_45_s95_0(sr + (size_t)0*19512 + p, si + (size_t)0*19512 + p); break;
    case 1: for (int p = 0; p < 2160; p += 8) ax1_45_s95_1(sr + (size_t)1*19512 + p, si + (size_t)1*19512 + p); break;
    case 2: for (int p = 0; p < 2160; p += 8) ax1_45_s95_2(sr + (size_t)2*19512 + p, si + (size_t)2*19512 + p); break;
    case 3: for (int p = 0; p < 2160; p += 8) ax1_45_s95_3(sr + (size_t)3*19512 + p, si + (size_t)3*19512 + p); break;
    case 4: for (int p = 0; p < 2160; p += 8) ax1_45_s95_4(sr + (size_t)4*19512 + p, si + (size_t)4*19512 + p); break;
  }
}
static void grp_stage2_45(double* sr, double* si, const double* cr, const double* ci, int k1, int odd){
  if (odd) { for (int p = 0; p < 2160; p += 8) { size_t o = (size_t)k1*19512 + p; ax2_45_s19(sr + o, si + o, cr + o, ci + o); } }
  else { for (int p = 0; p < 2160; p += 8) { size_t o = (size_t)k1*2168 + p; ax2_45_s95(sr + o, si + o, cr + o, ci + o); } }
}
static void azp_45(const double* wr, const double* wi, double* tr, double* ti){
  V8 BR[48] __attribute__((aligned(64))); V8 BI[48] __attribute__((aligned(64)));
  static const int y0s[6] = {0, 8, 16, 24, 32, 40};
  for (int bi = 0; bi < 6; bi++) {
    int y0 = y0s[bi];
    const double* p = wr + (size_t)y0*48;
    const double* q = wi + (size_t)y0*48;
    tr8(p + 0, 48, BR + 0); tr8(q + 0, 48, BI + 0);
    tr8(p + 8, 48, BR + 8); tr8(q + 8, 48, BI + 8);
    tr8(p + 16, 48, BR + 16); tr8(q + 16, 48, BI + 16);
    tr8(p + 24, 48, BR + 24); tr8(q + 24, 48, BI + 24);
    tr8(p + 32, 48, BR + 32); tr8(q + 32, 48, BI + 32);
    tr8(p + 40, 48, BR + 40); tr8(q + 40, 48, BI + 40);
    fft45_zz((const double*)BR, (const double*)BI, tr + y0, ti + y0);
  }
}

static void load_45(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 45; x++) for (int y = 0; y < 45; y++) {
    const double* pr = xr + (size_t)(((x*45)+y)*45);
    const double* pi = xi + (size_t)(((x*45)+y)*45);
    double* ar = rr + (size_t)x*2168 + (size_t)y*48;
    double* ai = ri + (size_t)x*2168 + (size_t)y*48;
    for (int z = 0; z < 45; z++) { ar[z] = scale*pr[z]; ai[z] = scale*pi[z]; }
  }
}
static void loadB_45(const double* xr, const double* xi, double scale, double* rr, double* ri){
  V8 BUF[8] __attribute__((aligned(64)));
  __m512d SC = _mm512_set1_pd(scale);
  for (int x = 0; x < 45; x++) {
    int xq = (x == 44) ? 44 : (9*x) % 44;
    for (int h = 0; h < 2; h++) {
      const double* src = h ? xi : xr;
      double* dst = h ? ri : rr;
      for (int y0 = 0; y0 + 8 <= 45; y0 += 8) {
        for (int zb = 0; zb < 45; zb += 8) {
          int zn = 45 - zb; if (zn > 8) zn = 8;
          tr8(src + (size_t)(((x*45)+y0)*45) + zb, 45, BUF);
          for (int t = 0; t < zn; t++) {
            __m512d v = _mm512_mul_pd(SC, (__m512d)BUF[t]);
            _mm512_storeu_pd(dst + (size_t)xq*2168 + (size_t)(zb+t)*48 + y0, v);
          }
        }
      }
      for (int y = 45 - (45 % 8); y < 45; y++) {
        const double* p = src + (size_t)(((x*45)+y)*45);
        double* a = dst + (size_t)xq*2168 + y;
        for (int z = 0; z < 45; z++) a[(size_t)z*48] = scale*p[z];
      }
    }
  }
}
static void emitpl1_45(const double* ar, const double* ai, double* p);
static void emitp1_45(const double* rr, const double* ri, int q, double* out){
  int x = (q == 44) ? 44 : (5*q) % 44;
  emitpl1_45(rr + (size_t)q*2168, ri + (size_t)q*2168, out + 2*(size_t)x*2025);
}
static void emitpl0_45(const double* ar, const double* ai, double* p){
  // (y,z) plane, rows stride 48 -> interleaved out rows of 2*45
  for (int y = 0; y < 45; y++) {
    const double* r = ar + (size_t)y*48; const double* q = ai + (size_t)y*48;
    double* o = p + 2*(size_t)y*45;
    ilv8(_mm512_loadu_pd(r + 0), _mm512_loadu_pd(q + 0), o + 0);
    ilv8(_mm512_loadu_pd(r + 8), _mm512_loadu_pd(q + 8), o + 16);
    ilv8(_mm512_loadu_pd(r + 16), _mm512_loadu_pd(q + 16), o + 32);
    ilv8(_mm512_loadu_pd(r + 24), _mm512_loadu_pd(q + 24), o + 48);
    ilv8(_mm512_loadu_pd(r + 32), _mm512_loadu_pd(q + 32), o + 64);
    ilv8_tail(_mm512_loadu_pd(r + 40), _mm512_loadu_pd(q + 40), o + 80, 5);
  }
}
static void emitpl1_45(const double* ar, const double* ai, double* p){
  // (z,y) plane (rows stride 48 over z) -> out[y][z] interleaved; transpose via tr8
  V8 TR[8] __attribute__((aligned(64))); V8 TI[8] __attribute__((aligned(64)));
  for (int yb = 0; yb < 45; yb += 8) {
    int yn = 45 - yb; if (yn > 8) yn = 8;
    for (int zb = 0; zb < 45; zb += 8) {
      int zn = 45 - zb; if (zn > 8) zn = 8;
      tr8(ar + (size_t)zb*48 + yb, 48, TR);
      tr8(ai + (size_t)zb*48 + yb, 48, TI);
      for (int t = 0; t < yn; t++) {
        double* o = p + 2*((size_t)(yb+t)*45 + zb);
        if (zn == 8) ilv8((__m512d)TR[t], (__m512d)TI[t], o); else ilv8_tail((__m512d)TR[t], (__m512d)TI[t], o, zn);
      }
    }
  }
}
static void emit_45(const double* rr, const double* ri, int orient, double* out){
  if (orient == 0) {
    for (int x = 0; x < 45; x++)
      emitpl0_45(rr + (size_t)x*2168, ri + (size_t)x*2168, out + 2*(size_t)x*2025);
  } else {
    for (int x = 0; x < 45; x++) {
      int xq = (x == 44) ? 44 : (9*x) % 44;
      emitpl1_45(rr + (size_t)xq*2168, ri + (size_t)xq*2168, out + 2*(size_t)x*2025);
    }
  }
}
static double *S45r, *S45i, *T45r, *T45i, *cA45r, *cA45i, *cB45r, *cB45i;
static double *W45r, *W45i;
static void run_core_45(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  for (long b = 0; b < Bc; b++) {
    const double* xbr = x0r + (size_t)b*91125; const double* xbi = x0i + (size_t)b*91125;
    const double* cbr = ccr + (size_t)b*91125; const double* cbi = cci + (size_t)b*91125;
    load_45(xbr, xbi, 1.0, S45r, S45i);
    if (m >= 2) load_45(cbr, cbi, 0.1, cA45r, cA45i);
    loadB_45(cbr, cbi, 0.1, cB45r, cB45i);
    double* sr = S45r; double* si = S45i;
    if (m < 1) { emit_45(sr, si, 0, out1 + 2*(size_t)b*91125); emit_45(sr, si, 0, outm + 2*(size_t)b*91125); continue; }
    for (int g = 0; g < 9; g++) grp_planes1_45(sr, si, W45r, W45i, g, 1);
    for (long t = 1; t <= m; t++) {
      int odd = (int)(t & 1);
      const double* ur = odd ? cB45r : cA45r;
      const double* ui = odd ? cB45i : cA45i;
      int n2g = odd ? 5 : 9;
      for (int k1 = 0; k1 < n2g; k1++) {
        grp_stage2_45(sr, si, ur, ui, k1, odd);
        if (t == 1 && m > 1) {
          for (int k2 = 0; k2 < 9; k2++) { int q = 9*k1 + k2; emitp1_45(sr, si, q, out1 + 2*(size_t)b*91125); }
        }
        if (t < m) grp_planes1_45(sr, si, W45r, W45i, k1, !odd);
      }
    }
    if (m == 1) { emit_45(sr, si, 1, out1 + 2*(size_t)b*91125); }
    emit_45(sr, si, (int)(m & 1), outm + 2*(size_t)b*91125);
  }
}
void run_45(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  run_core_45(Bc, m, x0r, x0i, ccr, cci, out1, outm);
}
void rungen_45(long Bc, long m, const uint64_t* wx, const uint64_t* wc, double* out1, double* outm){
  size_t n = (size_t)Bc * 91125;
  gens_ensure(n);
  fill_normals2(wx, 2*(long)n, Gxr, wc, 2*(long)n, Gcr);
  run_core_45(Bc, m, Gxr, Gxr + n, Gcr, Gcr + n, out1, outm);
}

static void ay_64(const double* sr, const double* si, double* dr, double* di){
  for (int x = 0; x < 64; x++) {
    const double* pr = sr + (size_t)x*4616; const double* pi = si + (size_t)x*4616;
    double* qr = dr + (size_t)x*4616; double* qi = di + (size_t)x*4616;
    fft64_yy(pr + 0, pi + 0, qr + 0, qi + 0);
    fft64_yy(pr + 8, pi + 8, qr + 8, qi + 8);
    fft64_yy(pr + 16, pi + 16, qr + 16, qi + 16);
    fft64_yy(pr + 24, pi + 24, qr + 24, qi + 24);
    fft64_yy(pr + 32, pi + 32, qr + 32, qi + 32);
    fft64_yy(pr + 40, pi + 40, qr + 40, qi + 40);
    fft64_yy(pr + 48, pi + 48, qr + 48, qi + 48);
    fft64_yy(pr + 56, pi + 56, qr + 56, qi + 56);
  }
}
static void ayp_64(const double* pr, const double* pi, double* qr, double* qi){
  fft64_yy(pr + 0, pi + 0, qr + 0, qi + 0);
  fft64_yy(pr + 8, pi + 8, qr + 8, qi + 8);
  fft64_yy(pr + 16, pi + 16, qr + 16, qi + 16);
  fft64_yy(pr + 24, pi + 24, qr + 24, qi + 24);
  fft64_yy(pr + 32, pi + 32, qr + 32, qi + 32);
  fft64_yy(pr + 40, pi + 40, qr + 40, qi + 40);
  fft64_yy(pr + 48, pi + 48, qr + 48, qi + 48);
  fft64_yy(pr + 56, pi + 56, qr + 56, qi + 56);
}
static void axmap_64_odd(double* sr, double* si, const double* cr, const double* ci){
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_0(sr + (size_t)0*4616 + p, si + (size_t)0*4616 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_1(sr + (size_t)1*4616 + p, si + (size_t)1*4616 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_2(sr + (size_t)2*4616 + p, si + (size_t)2*4616 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_3(sr + (size_t)3*4616 + p, si + (size_t)3*4616 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_4(sr + (size_t)4*4616 + p, si + (size_t)4*4616 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_5(sr + (size_t)5*4616 + p, si + (size_t)5*4616 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_6(sr + (size_t)6*4616 + p, si + (size_t)6*4616 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_7(sr + (size_t)7*4616 + p, si + (size_t)7*4616 + p); }
  for (int k1 = 0; k1 < 8; k1++)
    for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; size_t o = (size_t)k1*36928 + p; ax2_64_consec(sr + o, si + o, cr + o, ci + o); }
}
static void axmap_64_even(double* sr, double* si, const double* cr, const double* ci){
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_0(sr + (size_t)0*36928 + p, si + (size_t)0*36928 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_1(sr + (size_t)1*36928 + p, si + (size_t)1*36928 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_2(sr + (size_t)2*36928 + p, si + (size_t)2*36928 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_3(sr + (size_t)3*36928 + p, si + (size_t)3*36928 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_4(sr + (size_t)4*36928 + p, si + (size_t)4*36928 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_5(sr + (size_t)5*36928 + p, si + (size_t)5*36928 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_6(sr + (size_t)6*36928 + p, si + (size_t)6*36928 + p); }
  for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_7(sr + (size_t)7*36928 + p, si + (size_t)7*36928 + p); }
  for (int k1 = 0; k1 < 8; k1++)
    for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; size_t o = (size_t)k1*4616 + p; ax2_64_strided(sr + o, si + o, cr + o, ci + o); }
}
static void azp_64(const double* wr, const double* wi, double* tr, double* ti){
  V8 BR[64] __attribute__((aligned(64))); V8 BI[64] __attribute__((aligned(64)));
  static const int y0s[8] = {0, 8, 16, 24, 32, 40, 48, 56};
  for (int bi = 0; bi < 8; bi++) {
    int y0 = y0s[bi];
    const double* p = wr + (size_t)y0*72;
    const double* q = wi + (size_t)y0*72;
    tr8(p + 0, 72, BR + 0); tr8(q + 0, 72, BI + 0);
    tr8(p + 8, 72, BR + 8); tr8(q + 8, 72, BI + 8);
    tr8(p + 16, 72, BR + 16); tr8(q + 16, 72, BI + 16);
    tr8(p + 24, 72, BR + 24); tr8(q + 24, 72, BI + 24);
    tr8(p + 32, 72, BR + 32); tr8(q + 32, 72, BI + 32);
    tr8(p + 40, 72, BR + 40); tr8(q + 40, 72, BI + 40);
    tr8(p + 48, 72, BR + 48); tr8(q + 48, 72, BI + 48);
    tr8(p + 56, 72, BR + 56); tr8(q + 56, 72, BI + 56);
    fft64_zz((const double*)BR, (const double*)BI, tr + y0, ti + y0);
  }
}
static void step_64(double* sr, double* si, double* wr, double* wi, const double* ccr, const double* cci, int odd){
  if (odd) {
    for (int g = 0; g < 8; g++) {
      for (int a = 0; a < 8; a++) {
        size_t o = (size_t)(8*a + g)*4616;
        ayp_64(sr + o, si + o, wr, wi);
        azp_64(wr, wi, sr + o, si + o);
      }
      switch (g) {
        case 0: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_0(sr + (size_t)0*4616 + p, si + (size_t)0*4616 + p); } break;
        case 1: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_1(sr + (size_t)1*4616 + p, si + (size_t)1*4616 + p); } break;
        case 2: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_2(sr + (size_t)2*4616 + p, si + (size_t)2*4616 + p); } break;
        case 3: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_3(sr + (size_t)3*4616 + p, si + (size_t)3*4616 + p); } break;
        case 4: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_4(sr + (size_t)4*4616 + p, si + (size_t)4*4616 + p); } break;
        case 5: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_5(sr + (size_t)5*4616 + p, si + (size_t)5*4616 + p); } break;
        case 6: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_6(sr + (size_t)6*4616 + p, si + (size_t)6*4616 + p); } break;
        case 7: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_7(sr + (size_t)7*4616 + p, si + (size_t)7*4616 + p); } break;
      }
    }
    for (int k1 = 0; k1 < 8; k1++)
      for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; size_t o = (size_t)k1*36928 + p; ax2_64_consec(sr + o, si + o, ccr + o, cci + o); }
  } else {
    for (int g = 0; g < 8; g++) {
      for (int a = 0; a < 8; a++) {
        size_t o = (size_t)(8*g + a)*4616;
        ayp_64(sr + o, si + o, wr, wi);
        azp_64(wr, wi, sr + o, si + o);
      }
      switch (g) {
        case 0: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_0(sr + (size_t)0*36928 + p, si + (size_t)0*36928 + p); } break;
        case 1: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_1(sr + (size_t)1*36928 + p, si + (size_t)1*36928 + p); } break;
        case 2: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_2(sr + (size_t)2*36928 + p, si + (size_t)2*36928 + p); } break;
        case 3: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_3(sr + (size_t)3*36928 + p, si + (size_t)3*36928 + p); } break;
        case 4: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_4(sr + (size_t)4*36928 + p, si + (size_t)4*36928 + p); } break;
        case 5: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_5(sr + (size_t)5*36928 + p, si + (size_t)5*36928 + p); } break;
        case 6: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_6(sr + (size_t)6*36928 + p, si + (size_t)6*36928 + p); } break;
        case 7: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_7(sr + (size_t)7*36928 + p, si + (size_t)7*36928 + p); } break;
      }
    }
    for (int k1 = 0; k1 < 8; k1++)
      for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; size_t o = (size_t)k1*4616 + p; ax2_64_strided(sr + o, si + o, ccr + o, cci + o); }
  }
}

static void load_64(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 64; x++) for (int y = 0; y < 64; y++) {
    const double* pr = xr + (size_t)(((x*64)+y)*64);
    const double* pi = xi + (size_t)(((x*64)+y)*64);
    double* ar = rr + (size_t)x*4616 + (size_t)y*72;
    double* ai = ri + (size_t)x*4616 + (size_t)y*72;
    for (int z = 0; z < 64; z++) { ar[z] = scale*pr[z]; ai[z] = scale*pi[z]; }
  }
}
static void loadB_64(const double* xr, const double* xi, double scale, double* rr, double* ri){
  V8 BUF[8] __attribute__((aligned(64)));
  __m512d SC = _mm512_set1_pd(scale);
  for (int x = 0; x < 64; x++) {
    int xq = 8*(x % 8) + x / 8;
    for (int h = 0; h < 2; h++) {
      const double* src = h ? xi : xr;
      double* dst = h ? ri : rr;
      for (int y0 = 0; y0 + 8 <= 64; y0 += 8) {
        for (int zb = 0; zb < 64; zb += 8) {
          int zn = 64 - zb; if (zn > 8) zn = 8;
          tr8(src + (size_t)(((x*64)+y0)*64) + zb, 64, BUF);
          for (int t = 0; t < zn; t++) {
            __m512d v = _mm512_mul_pd(SC, (__m512d)BUF[t]);
            _mm512_storeu_pd(dst + (size_t)xq*4616 + (size_t)(zb+t)*72 + y0, v);
          }
        }
      }
      for (int y = 64 - (64 % 8); y < 64; y++) {
        const double* p = src + (size_t)(((x*64)+y)*64);
        double* a = dst + (size_t)xq*4616 + y;
        for (int z = 0; z < 64; z++) a[(size_t)z*72] = scale*p[z];
      }
    }
  }
}
static void emitpl1_64(const double* ar, const double* ai, double* p);
static void emitp1_64(const double* rr, const double* ri, int q, double* out){
  int x = 8*(q % 8) + q / 8;
  emitpl1_64(rr + (size_t)q*4616, ri + (size_t)q*4616, out + 2*(size_t)x*4096);
}
static void emitpl0_64(const double* ar, const double* ai, double* p){
  // (y,z) plane, rows stride 72 -> interleaved out rows of 2*64
  for (int y = 0; y < 64; y++) {
    const double* r = ar + (size_t)y*72; const double* q = ai + (size_t)y*72;
    double* o = p + 2*(size_t)y*64;
    ilv8(_mm512_loadu_pd(r + 0), _mm512_loadu_pd(q + 0), o + 0);
    ilv8(_mm512_loadu_pd(r + 8), _mm512_loadu_pd(q + 8), o + 16);
    ilv8(_mm512_loadu_pd(r + 16), _mm512_loadu_pd(q + 16), o + 32);
    ilv8(_mm512_loadu_pd(r + 24), _mm512_loadu_pd(q + 24), o + 48);
    ilv8(_mm512_loadu_pd(r + 32), _mm512_loadu_pd(q + 32), o + 64);
    ilv8(_mm512_loadu_pd(r + 40), _mm512_loadu_pd(q + 40), o + 80);
    ilv8(_mm512_loadu_pd(r + 48), _mm512_loadu_pd(q + 48), o + 96);
    ilv8(_mm512_loadu_pd(r + 56), _mm512_loadu_pd(q + 56), o + 112);
  }
}
static void emitpl1_64(const double* ar, const double* ai, double* p){
  // (z,y) plane (rows stride 72 over z) -> out[y][z] interleaved; transpose via tr8
  V8 TR[8] __attribute__((aligned(64))); V8 TI[8] __attribute__((aligned(64)));
  for (int yb = 0; yb < 64; yb += 8) {
    int yn = 64 - yb; if (yn > 8) yn = 8;
    for (int zb = 0; zb < 64; zb += 8) {
      int zn = 64 - zb; if (zn > 8) zn = 8;
      tr8(ar + (size_t)zb*72 + yb, 72, TR);
      tr8(ai + (size_t)zb*72 + yb, 72, TI);
      for (int t = 0; t < yn; t++) {
        double* o = p + 2*((size_t)(yb+t)*64 + zb);
        if (zn == 8) ilv8((__m512d)TR[t], (__m512d)TI[t], o); else ilv8_tail((__m512d)TR[t], (__m512d)TI[t], o, zn);
      }
    }
  }
}
static void emit_64(const double* rr, const double* ri, int orient, double* out){
  if (orient == 0) {
    for (int x = 0; x < 64; x++)
      emitpl0_64(rr + (size_t)x*4616, ri + (size_t)x*4616, out + 2*(size_t)x*4096);
  } else {
    for (int x = 0; x < 64; x++) {
      int xq = 8*(x % 8) + x / 8;
      emitpl1_64(rr + (size_t)xq*4616, ri + (size_t)xq*4616, out + 2*(size_t)x*4096);
    }
  }
}
static double *S64r, *S64i, *T64r, *T64i, *cA64r, *cA64i, *cB64r, *cB64i;
static double *W64r, *W64i;
static void grp_planes1_64(double* sr, double* si, double* wr, double* wi, int g, int odd){
  for (int a = 0; a < 8; a++) {
    size_t o = odd ? (size_t)(8*a + g)*4616 : (size_t)(8*g + a)*4616;
    ayp_64(sr + o, si + o, wr, wi);
    azp_64(wr, wi, sr + o, si + o);
  }
  if (odd) switch (g) {
    case 0: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_0(sr + (size_t)0*4616 + p, si + (size_t)0*4616 + p); } break;
    case 1: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_1(sr + (size_t)1*4616 + p, si + (size_t)1*4616 + p); } break;
    case 2: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_2(sr + (size_t)2*4616 + p, si + (size_t)2*4616 + p); } break;
    case 3: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_3(sr + (size_t)3*4616 + p, si + (size_t)3*4616 + p); } break;
    case 4: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_4(sr + (size_t)4*4616 + p, si + (size_t)4*4616 + p); } break;
    case 5: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_5(sr + (size_t)5*4616 + p, si + (size_t)5*4616 + p); } break;
    case 6: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_6(sr + (size_t)6*4616 + p, si + (size_t)6*4616 + p); } break;
    case 7: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_strided_7(sr + (size_t)7*4616 + p, si + (size_t)7*4616 + p); } break;
  } else switch (g) {
    case 0: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_0(sr + (size_t)0*36928 + p, si + (size_t)0*36928 + p); } break;
    case 1: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_1(sr + (size_t)1*36928 + p, si + (size_t)1*36928 + p); } break;
    case 2: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_2(sr + (size_t)2*36928 + p, si + (size_t)2*36928 + p); } break;
    case 3: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_3(sr + (size_t)3*36928 + p, si + (size_t)3*36928 + p); } break;
    case 4: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_4(sr + (size_t)4*36928 + p, si + (size_t)4*36928 + p); } break;
    case 5: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_5(sr + (size_t)5*36928 + p, si + (size_t)5*36928 + p); } break;
    case 6: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_6(sr + (size_t)6*36928 + p, si + (size_t)6*36928 + p); } break;
    case 7: for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; ax1_64_consec_7(sr + (size_t)7*36928 + p, si + (size_t)7*36928 + p); } break;
  }
}
static void grp_stage2_64(double* sr, double* si, const double* cr, const double* ci, int k1, int odd){
  if (odd) { for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; size_t o = (size_t)k1*36928 + p; ax2_64_consec(sr + o, si + o, cr + o, ci + o); } }
  else { for (int y = 0; y < 64; y++) for (int zc = 0; zc < 64; zc += 8) { int p = y*72 + zc; size_t o = (size_t)k1*4616 + p; ax2_64_strided(sr + o, si + o, cr + o, ci + o); } }
}
static void run_core_64(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  for (long b = 0; b < Bc; b++) {
    const double* xbr = x0r + (size_t)b*262144; const double* xbi = x0i + (size_t)b*262144;
    const double* cbr = ccr + (size_t)b*262144; const double* cbi = cci + (size_t)b*262144;
    load_64(xbr, xbi, 1.0, S64r, S64i);
    if (m >= 2) load_64(cbr, cbi, 0.1, cA64r, cA64i);
    loadB_64(cbr, cbi, 0.1, cB64r, cB64i);
    double* sr = S64r; double* si = S64i;
    if (m < 1) { emit_64(sr, si, 0, out1 + 2*(size_t)b*262144); emit_64(sr, si, 0, outm + 2*(size_t)b*262144); continue; }
    // step 1 planes+stage1 (odd)
    for (int g = 0; g < 8; g++) grp_planes1_64(sr, si, W64r, W64i, g, 1);
    for (long t = 1; t <= m; t++) {
      int odd = (int)(t & 1);
      const double* ur = odd ? cB64r : cA64r;
      const double* ui = odd ? cB64i : cA64i;
      for (int k1 = 0; k1 < 8; k1++) {
        grp_stage2_64(sr, si, ur, ui, k1, odd);
        if (t == 1 && m > 1) {
          // snapshot planes of this group (orientation 1)
          for (int k2 = 0; k2 < 8; k2++) { int q = odd ? (8*k1 + k2) : (k1 + 8*k2); emitp1_64(sr, si, q, out1 + 2*(size_t)b*262144); }
        }
        if (t < m) {
          int g = k1; int nodd = !odd;
          grp_planes1_64(sr, si, W64r, W64i, g, nodd);
        }
      }
    }
    if (m == 1) { emit_64(sr, si, 1, out1 + 2*(size_t)b*262144); }
    emit_64(sr, si, (int)(m & 1), outm + 2*(size_t)b*262144);
  }
}
void run_64(long Bc, long m, const double* x0r, const double* x0i, const double* ccr, const double* cci, double* out1, double* outm){
  run_core_64(Bc, m, x0r, x0i, ccr, cci, out1, outm);
}
void rungen_64(long Bc, long m, const uint64_t* wx, const uint64_t* wc, double* out1, double* outm){
  size_t n = (size_t)Bc * 262144;
  gens_ensure(n);
  fill_normals2(wx, 2*(long)n, Gxr, wc, 2*(long)n, Gcr);
  run_core_64(Bc, m, Gxr, Gxr + n, Gcr, Gcr + n, out1, outm);
}

static char* slab_base; static size_t slab_off, slab_cap;
static double* amem(size_t n){
  size_t bytes = ((n + 64) * sizeof(double) + 4095) & ~(size_t)4095;
  double* p = (double*)(slab_base + slab_off);
  slab_off += bytes;
  return p;
}
void setup(void){
  slab_cap = 31457280ULL + (2ULL<<20);
  void* raw = mmap(0, slab_cap + (2<<20), PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
  uintptr_t a = ((uintptr_t)raw + ((2<<20)-1)) & ~(uintptr_t)((2<<20)-1);
  slab_base = (char*)a; slab_off = 0;
  madvise(slab_base, slab_cap, MADV_HUGEPAGE);
  memset(slab_base, 0, slab_cap);
  init_wi_signed();
  S6r = amem(216); S6i = amem(216); T6r = amem(216); T6i = amem(216);
  cA6r = amem(216); cA6i = amem(216); cB6r = amem(216); cB6i = amem(216);
  cC6r = amem(216); cC6i = amem(216);
  S8r = amem(512); S8i = amem(512); T8r = amem(512); T8i = amem(512);
  cA8r = amem(512); cA8i = amem(512); cB8r = amem(512); cB8i = amem(512);
  cC8r = amem(512); cC8i = amem(512);
  S13r = amem(2704); S13i = amem(2704); T13r = amem(2704); T13i = amem(2704);
  cA13r = amem(2704); cA13i = amem(2704); cB13r = amem(2704); cB13i = amem(2704);
  W13r = amem(256); W13i = amem(256);
  S17r = amem(6936); S17i = amem(6936); T17r = amem(6936); T17i = amem(6936);
  cA17r = amem(6936); cA17i = amem(6936); cB17r = amem(6936); cB17i = amem(6936);
  W17r = amem(576); W17i = amem(576);
  S23r = amem(12696); S23i = amem(12696); T23r = amem(12696); T23i = amem(12696);
  cA23r = amem(12696); cA23i = amem(12696); cB23r = amem(12696); cB23i = amem(12696);
  W23r = amem(576); W23i = amem(576);
  S36r = amem(52128); S36i = amem(52128); T36r = amem(52128); T36i = amem(52128);
  cA36r = amem(52128); cA36i = amem(52128); cB36r = amem(52128); cB36i = amem(52128);
  W36r = amem(1600); W36i = amem(1600);
  S45r = amem(97560); S45i = amem(97560); T45r = amem(97560); T45i = amem(97560);
  cA45r = amem(97560); cA45i = amem(97560); cB45r = amem(97560); cB45i = amem(97560);
  W45r = amem(2304); W45i = amem(2304);
  S64r = amem(295424); S64i = amem(295424); T64r = amem(295424); T64i = amem(295424);
  cA64r = amem(295424); cA64i = amem(295424); cB64r = amem(295424); cB64i = amem(295424);
  W64r = amem(5184); W64i = amem(5184);
}