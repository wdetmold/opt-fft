static void load_6(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 6; x++) for (int y = 0; y < 6; y++) {
    const double* pr = xr + (size_t)(((x*6)+y)*6);
    const double* pi = xi + (size_t)(((x*6)+y)*6);
    double* ar = rr + (size_t)x*36 + (size_t)y*6;
    double* ai = ri + (size_t)x*36 + (size_t)y*6;
    for (int z = 0; z < 6; z++) { ar[z] = scale*pr[z]; ai[z] = scale*pi[z]; }
  }
}
static void loadB_6(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 6; x++) for (int y = 0; y < 6; y++) {
    const double* pr = xr + (size_t)(((x*6)+y)*6);
    const double* pi = xi + (size_t)(((x*6)+y)*6);
    size_t base = (size_t)x*6 + y;
    for (int z = 0; z < 6; z++) { rr[base + (size_t)z*36] = scale*pr[z]; ri[base + (size_t)z*36] = scale*pi[z]; }
  }
}
static void loadC_6(const double* xr, const double* xi, double scale, double* rr, double* ri){
  for (int x = 0; x < 6; x++) for (int y = 0; y < 6; y++) {
    const double* pr = xr + (size_t)(((x*6)+y)*6);
    const double* pi = xi + (size_t)(((x*6)+y)*6);
