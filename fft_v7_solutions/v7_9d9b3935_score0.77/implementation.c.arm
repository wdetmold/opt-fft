  V8 xr3 = LD8(ri + 108); V8 xi3 = LD8(ii + 108);
  V8 xr4 = LD8(ri + 144); V8 xi4 = LD8(ii + 144);
  V8 xr5 = LD8(ri + 180); V8 xi5 = LD8(ii + 180);
  V8 t13 = xr2 + xr4;
  V8 t17 = xr0 + t13;
  V8 t31 = xr1 + xr5;
  V8 t35 = xr3 + t31;
