#define K4(x) ((V4){(x),(x),(x),(x)})
#define K2(x) ((V2){(x),(x)})
#define K1(x) (x)
#define LD1(p) (*(p))
#define ST1(p,v) (*(p) = (v))
#define LD8(p) (*(const V8*)(p))
#define LD4(p) (*(const V4*)(p))
#define LD2(p) (*(const V2*)(p))
#define ST8(p,v) (*(V8*)(p) = (v))
#define ST4(p,v) (*(V4*)(p) = (v))
#define ST2(p,v) (*(V2*)(p) = (v))


